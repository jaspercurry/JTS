#!/usr/bin/env bash
# ExecCondition for jasper-usbgadget.service.
#
# Exits 0 (proceed) when the composite gadget has at least one function to
# compose AND the hardware can carry it. Exits non-zero (systemd SKIPS the
# unit cleanly — NOT a failure) when either:
#
#   1. The shared hardware resolver does not authorize the management
#      transport. Strict gadget availability is required normally; the one
#      grace is desired-host/current-peripheral while a deploy finishes before
#      reboot. Stable host and unsupported hardware fail closed.
#
#   2. No UDC under /sys/class/udc. This is the fresh-install pre-reboot case.
#
#   3. No function is wanted: network is kill-switched (JASPER_USB_NETWORK=
#      disabled) AND audio is not authorized and ready. This restores the historic
#      zero-RAM contract — libcomposite never loads, the gadget never exists.
#
# A skip (exit 1) is systemd's documented "condition not met" outcome for
# ExecCondition, distinct from a failure (exit >=255 or 1..254 → failed).
# systemd treats ExecCondition exit codes 1..254 as "skip"; we use 1.
#
# The decision itself is the shared truth table, so this can never disagree
# with jasper-usbgadget-up or jasper-usbgadget-converge.
set -uo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# shellcheck source=deploy/usbsink/jasper-usbgadget-compose.sh
source "$(dirname "$0")/jasper-usbgadget-compose.sh"

jasper_usbgadget_desired

if [[ "${WANTED}" == "0" ]]; then
    emit skip "reason=${WANTED_REASON} where=wanted"
    exit 1
fi

emit wanted "network=${WANT_NETWORK} audio=${WANT_AUDIO} audio_reason=${AUDIO_REASON}"
exit 0
