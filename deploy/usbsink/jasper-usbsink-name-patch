#!/usr/bin/env bash
# Make the USB-gadget output name track the configured Speaker Name and its
# input name track "<Speaker Name> Mic" in a connected Mac/PC audio list.
#
# Background: the host displays the UAC2 AudioStreaming interface string,
# which the kernel hardcodes as "Playback Inactive" in usb_f_uac2.ko and
# does NOT expose via configfs on 6.12. The only lever is the compiled
# module. We build a name-patched copy into the kernel's `updates/`
# directory (which modprobe searches before `kernel/`), so when the
# gadget function is created the patched module autoloads instead of the
# stock one. See deploy/usbsink/uac2_name_patch.py for the byte transform.
#
# Runs as jasper-usbgadget's ExecStartPre (best-effort, leading `-`):
# a failure here must NEVER block USB audio — it only means the host
# shows the default "Playback Inactive" label. This single hook covers
# every path that needs the name re-applied:
#   - boot / feature-enable      (override absent       -> build)
#   - rename via /system wizard  (name changed in marker -> rebuild + reload)
#   - kernel update + reboot     (new kernel, no override -> rebuild)
#
# Idempotent and cheap in steady state: a marker (patch schema + kernel ver +
# speaker name + mic name + stock-module hash) lets an unchanged boot exit in
# milliseconds without touching the module tree, running depmod, or reloading.
#
# TWO PHASES, because depmod alone measures 10.3 s on a Pi Zero 2 W -- over
# 2x jasper-usbgadget.service's 5 s TimeoutStartSec (#2176), whose value is
# the single source of truth for the source-intent reconciler's derived
# timeout budget (jasper/source_intent.py) and must not move:
#
#   publish (default, runs as jasper-usbgadget's ExecStartPre)
#     Everything cheap and everything ordering-sensitive: read the name,
#     build + integrity-gate the override, install it, then hand the slow
#     half to jasper-usbsink-name-index.service via `systemctl --no-block
#     start` and return. depmod is NEVER invoked on this path. Publishing
#     synchronously is load-bearing: on an already-indexed box (the rename
#     case) the bytes written here are exactly what the gadget-up milli-
#     seconds later autoloads, so a rename applies on that same restart.
#
#   --index (runs as jasper-usbsink-name-index.service)
#     depmod, drop a stale in-memory module, and promote the pending
#     marker. Its own unit means its own cgroup and its own generous
#     TimeoutStartSec: `( ... ) &` would leave the rebuild inside the
#     gadget's cgroup, where the `systemctl restart jasper-usbgadget` that
#     install.sh issues right after `enable --now` SIGTERMs it on every
#     deploy. It also matches the house "don't block on this" idiom
#     (deploy/bin/jasper-*-reconcile all use `systemctl --no-block`).
#
# The completion marker is promoted ONLY when depmod succeeded AND the
# published override is what the running/next bring-up actually loads --
# never merely because bytes reached the disk. modprobe follows
# modules.dep, not the filesystem, so on a bring-up where updates/ is not
# yet indexed (first enable, post-kernel-update) gadget-up loads the STOCK
# module for that session; withholding the marker keeps jasper-doctor's
# `usbsink name` check on an honest `warn` with its existing "restart
# jasper-usbgadget to re-apply" remediation, which then converges in one
# restart. Claiming `ok` while the host shows "Playback Inactive" would be
# a silent failure, which this project does not ship.
#
# Mirrors the deploy/bin/jasper-wifi-guardian self-heal idiom: oneshot,
# structured event= logs, no-op steady state, degrade-don't-break.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PATCHER="${SELF_DIR}/uac2_name_patch.py"
MODULES_ROOT="${JASPER_MODULES_ROOT:-/lib/modules}"

# Sourced for jasper_usbgadget_speaker_name only — this script composes
# nothing. Its own `emit` below deliberately shadows the fragment's.
# shellcheck source=deploy/usbsink/jasper-usbgadget-compose.sh
source "${SELF_DIR}/jasper-usbgadget-compose.sh"

INDEX_UNIT="jasper-usbsink-name-index.service"

KVER="$(uname -r)"
MODDIR="${MODULES_ROOT}/${KVER}"
UPDATES_DIR="${MODDIR}/updates"
OVERRIDE="${UPDATES_DIR}/usb_f_uac2.ko"
MARKER="${UPDATES_DIR}/.jasper-usbsink-name.marker"
# The marker the index phase will promote once depmod has actually made the
# override reachable. Written by publish only when promoting it would be a
# true statement; see the header.
PENDING="${UPDATES_DIR}/.jasper-usbsink-name.pending"
MODULES_DEP="${MODDIR}/modules.dep"
# Bump whenever the byte-transform contract changes. Schema 3 gives the
# Capture alt-setting strings their derived "<Speaker Name> Mic" label; an
# older marker must rebuild even when the kernel/name/hash are unchanged.
PATCH_SCHEMA=3

emit() {  # emit <outcome> [k=v ...]
    local outcome="$1"; shift || true
    printf 'event=usbsink_name.%s %s\n' "${outcome}" "$*" >&2
}

# --- phase 2: the slow half, owned by jasper-usbsink-name-index.service ---
run_index() {
    if ! depmod "${KVER}" 2>/dev/null; then
        # modules.dep was NOT rebuilt, so modprobe still cannot reach the
        # override. Promoting the marker here would claim a label the host
        # will never show. Leave it absent: doctor warns, next start rebuilds.
        emit "index_failed" "kver=${KVER}"
        return 0
    fi

    # Drop a stale in-memory module so a later function-create autoloads the
    # current override. Best-effort by design: gadget-up normally holds the
    # module by now, so this is usually a no-op. It is NOT what decides
    # whether the marker may be promoted -- publish already decided that
    # (the .pending contract), because rmmod cannot distinguish a loaded
    # stock module from a loaded override.
    if lsmod | awk '{print $1}' | grep -qx 'usb_f_uac2'; then
        if rmmod usb_f_uac2 2>/dev/null; then
            emit "reloaded" "detail=stale_module_unloaded"
        else
            emit "reload_skipped" "detail=usb_f_uac2_busy"
        fi
    fi

    if [[ -f "${PENDING}" ]]; then
        mv -f "${PENDING}" "${MARKER}"
        emit "applied" "kver=${KVER}"
    else
        # Re-index only: either a failure path cleaning up a removed
        # override, or a publish that declined to promise convergence.
        emit "indexed" "kver=${KVER} detail=no_pending_marker"
    fi
    return 0
}

if [[ "${1:-}" == "--index" ]]; then
    run_index
    exit 0
fi

kick_index() {
    # --no-block: the caller is jasper-usbgadget's ExecStartPre and must
    # return well inside its 5 s budget. systemd coalesces repeat start jobs
    # for the same unit, so back-to-back gadget restarts never fork two
    # concurrent depmods.
    if systemctl --no-block start "${INDEX_UNIT}" 2>/dev/null; then
        emit "index_queued" "unit=${INDEX_UNIT}"
    else
        # Non-fatal: the marker simply stays absent, doctor warns, and the
        # next gadget start rebuilds. Never fail the gadget over this.
        emit "index_kick_failed" "unit=${INDEX_UNIT}"
    fi
}

# --- desired name -----------------------------------------------------
# `:-JTS` because this script runs without `set -e`: an unreadable fragment
# (partial install) must label the module JTS, never the empty string.
NAME="$(jasper_usbgadget_speaker_name 2>/dev/null)"
NAME="${NAME:-JTS}"
MIC_NAME="${NAME} Mic"

# --- locate the STOCK module (always under kernel/, never updates/) ---
STOCK="$(find "${MODDIR}/kernel" -name 'usb_f_uac2.ko*' 2>/dev/null | head -n1)"
if [[ -z "${STOCK}" ]]; then
    emit "no_stock_module" "kver=${KVER}"
    exit 0   # nothing we can do; gadget-up still brings up USB audio
fi

if [[ ! -r "${PATCHER}" ]]; then
    emit "patcher_missing" "path=${PATCHER}"
    exit 0
fi

STOCK_HASH="$(sha256sum "${STOCK}" 2>/dev/null | awk '{print $1}')"
DESIRED_MARKER="${PATCH_SCHEMA}	${KVER}	${NAME}	${MIC_NAME}	${STOCK_HASH}"

# --- steady-state fast path ------------------------------------------
if [[ -f "${OVERRIDE}" && -f "${MARKER}" ]] \
   && [[ "$(cat "${MARKER}" 2>/dev/null)" == "${DESIRED_MARKER}" ]]; then
    emit "steady_state" "name=\"${NAME}\" kver=${KVER}"
    exit 0
fi

# --- (re)build the override ------------------------------------------
# Does the module index currently resolve usb_f_uac2 to OUR override? depmod
# records exactly one file per module name in modules.dep (updates/ wins over
# kernel/), and the request_module() that gadget-up's function-create triggers
# follows THAT record -- not the presence of a .ko on disk. So this one file
# read, taken BEFORE the override is (re)written, is what tells us whether the
# bytes published below are what the very next bring-up actually loads.
#
# Matched loosely on purpose: accept the relative form kmod writes today and
# the absolute form, with or without a compression suffix. This is also why
# the check is phrased as "prove indexed", not "prove not indexed" -- an
# unrecognised modules.dep dialect leaves override_indexed=0, which withholds
# the completion marker and leaves doctor on a warn. Failing that way costs a
# rebuild on the next start; failing the other way would report a host label
# that isn't there.
override_indexed=0
if grep -qE '^(/.*/)?updates/usb_f_uac2\.ko' "${MODULES_DEP}" 2>/dev/null; then
    override_indexed=1
fi

mkdir -p "${UPDATES_DIR}"
TMP="$(mktemp -d /tmp/usbsink-name.XXXXXX)" || { emit "mktemp_failed"; exit 0; }
trap 'rm -rf "${TMP}"' EXIT
RAW="${TMP}/usb_f_uac2.ko"

case "${STOCK}" in
    *.xz)  xz   -dc "${STOCK}" > "${RAW}" 2>/dev/null ;;
    *.zst) zstd -dc "${STOCK}" > "${RAW}" 2>/dev/null ;;
    *.gz)  gzip -dc "${STOCK}" > "${RAW}" 2>/dev/null ;;
    *)     cp "${STOCK}" "${RAW}" ;;
esac
if [[ ! -s "${RAW}" ]]; then
    emit "decompress_failed" "stock=${STOCK}"
    exit 0
fi

# Build into a temp file first, validate it (integrity gate below),
# and only then copy it into the live `updates/` path. modprobe reads
# the override solely during gadget-up, which runs strictly after this
# ExecStartPre returns, so there is no concurrent reader to tear.
OUT_TMP="${TMP}/usb_f_uac2.override.ko"
summary="$(/usr/bin/python3 "${PATCHER}" "${RAW}" "${NAME}" "${OUT_TMP}" 2>&1)"
rc=$?

if [[ ${rc} -ne 0 ]]; then
    # Any playback/capture string missing or ambiguous (rc=3), or another
    # error — leave stock in charge. Schema 3 is all-or-nothing so the marker
    # can never claim distinct input/output labels for a partial override.
    # Drop any stale override so the unpatched module autoloads and the
    # host shows the default label rather than a wrong/old name.
    emit "patch_failed" "rc=${rc} ${summary}"
    # Re-index whenever there is stale state to clear: the override file
    # itself, OR an index that still names an override already deleted by a
    # previous pass whose re-index was lost. The second case is the one with
    # teeth -- modules.dep naming a missing file makes modprobe fail, and
    # gadget-up (set -euo pipefail) then takes the USB management network
    # down with it. Repairing it on a later pass costs nothing on a healthy
    # box, where both conditions are false after the first failed pass.
    if [[ -f "${OVERRIDE}" || "${override_indexed}" == "1" ]]; then
        rm -f "${OVERRIDE}" "${MARKER}" "${PENDING}"
        emit "override_removed" "kver=${KVER}"
        kick_index
    fi
    exit 0
fi

# Integrity gate before publishing: the patcher only overwrites
# equal-length byte spans, so a correct override is a valid ELF whose
# size equals the decompressed stock. Verify both before installing.
# This is what makes the "degrades cosmetically, never breaks USB audio"
# promise hold even for a truncated/partial write — a bad override is
# never published, so the stock module autoloads and the host shows the
# default label instead of the gadget failing to come up.
raw_size=$(stat -c%s "${RAW}" 2>/dev/null || echo 0)
out_size=$(stat -c%s "${OUT_TMP}" 2>/dev/null || echo 0)
magic=$(head -c4 "${OUT_TMP}" 2>/dev/null | od -An -tx1 | tr -d ' \n')
if [[ "${out_size}" != "${raw_size}" || "${magic}" != "7f454c46" ]]; then
    emit "override_invalid" "out_size=${out_size} stock_size=${raw_size} magic=${magic}"
    if [[ -f "${OVERRIDE}" || "${override_indexed}" == "1" ]]; then
        rm -f "${OVERRIDE}" "${MARKER}" "${PENDING}"
        emit "override_removed" "kver=${KVER}"
        kick_index
    fi
    exit 0
fi

# Drop the old marker BEFORE publishing new bytes, so a kill at any point
# from here leaves "override present, marker absent" -- the state doctor
# reports as a warn and the next start rebuilds from. The inverse (marker
# describing bytes that are no longer there) would report a false ok.
rm -f "${MARKER}" "${PENDING}"
install -m 0644 "${OUT_TMP}" "${OVERRIDE}"

if [[ "${override_indexed}" == "1" ]]; then
    # modules.dep already names updates/usb_f_uac2.ko, so the gadget-up that
    # runs milliseconds after this ExecStartPre autoloads exactly the bytes
    # written above. Convergence is genuine -- arm the marker for promotion.
    printf '%s' "${DESIRED_MARKER}" > "${PENDING}"
    emit "queued" "name=\"${NAME}\" kver=${KVER} loads=override ${summary}"
else
    # First enable, or the first boot after a kernel update: updates/ is not
    # in the index yet, so gadget-up will autoload the STOCK module and the
    # host shows the default label for this session. Deliberately arm NO
    # marker -- doctor's `usbsink name` stays a truthful warn ("restart
    # jasper-usbgadget to re-apply"), and that restart converges, because
    # the index rebuild below is what makes the override reachable.
    emit "queued" "name=\"${NAME}\" kver=${KVER} loads=stock_until_restart ${summary}"
fi

kick_index
exit 0
