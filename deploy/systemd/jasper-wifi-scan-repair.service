[Unit]
Description=Repair Pi 5 brcmfmac Wi-Fi scan suppression
Documentation=file:/opt/jasper/AGENTS.md
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/opt/jasper/.venv/bin/python -m jasper.net.wifi_scan_repair --iface wlan0 --json
# Bounded: one rate-limited NL80211_CMD_CRIT_PROTOCOL_STOP attempt.
TimeoutStartSec=20
StandardOutput=journal
StandardError=journal
