[Unit]
Description=Jasper Snapcast client — plays this speaker's grouping channel in sync
# Ships DISABLED. Started by jasper-grouping-reconcile when grouping is
# enabled and valid, for BOTH roles: a leader runs its own snapclient
# (host 127.0.0.1) to play its channel locally; a follower runs only
# the client, pointed at cfg.leader_addr. When grouping is off there is
# no process and no resident RAM.
#
# Plays the synchronised stream into the music chain. Output-side
# audio, so it joins jts-audio.slice (MemorySwapMax=0) alongside
# fanin/camilla and the renderers.
#
After=jasper-camilla.service sound.target
Wants=jasper-camilla.service

# Anti-storm: cap restart attempts WITHOUT rebooting. Grouping is
# OPTIONAL and off by default, and the snapclient binary may not be
# installed — so a start failure (e.g. unreachable leader_addr, missing
# binary, bad args) must DEGRADE this speaker, not reboot it. The most
# important case: a FOLLOWER whose leader is powered off must NOT
# reboot-loop — it goes `failed`, surfaced on /state + jasper-doctor,
# and self-rejoins when the leader returns. After the burst systemd
# stops retrying (default StartLimitAction=none). Design doc §7:
# "follower degrades, visible; never reboots the household."
#
# The burst is SIX because this unit writes a ring: a SIGKILLed ring
# writer leaves its heartbeat frozen, so a successor is refused with
# -EBUSY for up to JTS_RING_WRITER_LIVENESS_TIMEOUT_NS
# (c/jts-ring-ioplug/jts_ring_shm.h), and a start limit that a burst of
# those refusals can reach PARKS the unit — the one non-self-healing
# shape. `RestartSec` below clears the window; the burst is what keeps a
# run of them from parking an endpoint. Raising 4 -> 6 PRESERVES the
# anti-storm intent above (still bounded, still no reboot) and gives a
# follower whose leader is powered off six tries in 300 s instead of four.
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
# Output-side audio: never swap to zram. Slice enforces
# MemorySwapMax=0; this unit declares scheduling priority + OOM
# ordering. NO CPU caps (forbidden on the JTS audio chain).
Slice=jts-audio.slice
Type=simple
TimeoutStopSec=5s
EnvironmentFile=-/etc/jasper/jasper.env
# Derived args, written by jasper-grouping-reconcile (the single writer).
# The root service never imports management-writable grouping.env; the
# reconciler parses it as data and emits only the fixed computed argv. It
# owns this /run file (NOT a unit RuntimeDirectory, which would be reaped
# when a sibling unit stops); it writes it before starting this unit, so
# ExecStart reads fresh args. Set for BOTH roles — a leader's client
# targets 127.0.0.1, a follower's targets cfg.leader_addr.
EnvironmentFile=-/run/jasper-grouping/snapcast-args.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES
# On the ACTIVE-endpoint path below this unit WRITES a ring, and whichever end
# opens `/dev/shm/jts-ring/grouping.ring` first creates it, 0660 & ~umask.
# systemd's default 0022 lands 0640 — group-READABLE, not group-WRITABLE — and
# BOTH ends of a ring write its header (the reader stamps read_seq and its
# heartbeat). The setgid directory (mode 3775, group jts-ring) fixes the file's
# GROUP; only the umask fixes its MODE. `deploy/tmpfiles/jts-ring.conf` states
# the rule for every ring writer. No `SupplementaryGroups=jts-ring` beside it:
# this unit declares no `User=` and runs as root, like bluealsa-aplay.
UMask=0007
# TWO player shapes. Which one this box gets is decided by
# jasper-grouping-reconcile and baked into $JASPER_SNAPCLIENT_ARGS
# above (`jasper.multiroom.reconcile._assemble_args`, branching on
# `active_endpoint`); ExecStart itself is indifferent.
#
#   DUMB member (active_endpoint false) — `--player alsa --soundcard
#   jts_ring_dac_content` (`jasper.multiroom.dac_content_ring.
#   DAC_CONTENT_RING_PCM`), the dac-content RETURN ring. An SHM ring,
#   never the raw DAC: an ALSA sink on the card would fight outputd for
#   it (the observed `Device or resource busy` failure of the first
#   bond). outputd reads that ring as its sole content source through
#   its dac_content lane and picks this member's channel there. The
#   ioplug creates the ring file at open; nothing pre-creates it.
#
#   ACTIVE-speaker endpoint (active_endpoint true — an active follower
#   or an active-speaker leader, distributed-active Slice 3) — `--player
#   alsa --soundcard jts_ring_grouping`
#   (`jasper.multiroom.grouping_ring.GROUPING_RING_PCM`). That IS an ALSA
#   sink, and it does not contend for the DAC: it writes the grouping
#   ring, this box's CamillaDSP captures THE SAME PCM (one ring device,
#   opened in both directions) and runs the crossover inside the bonded
#   path, and outputd still owns the DAC. The dac_content lane is
#   unused on this path.
ExecStart=/usr/bin/snapclient $JASPER_SNAPCLIENT_ARGS
Restart=on-failure
# Longer than the ring's writer-liveness window
# (JTS_RING_WRITER_LIVENESS_TIMEOUT_NS = 2 s, c/jts-ring-ioplug/jts_ring_shm.h):
# a killed ring writer's frozen heartbeat refuses a successor for up to that
# window, so a 2 s respawn would race its own predecessor into an avoidable
# -EBUSY. Enumerated beside that constant with every other ring writer's
# cadence; tests/test_renderer_ring_lanes.py holds the two together.
RestartSec=3s
# Snapclient logs connection-refused loops once per second while a bonded
# follower waits for its leader to return. Preserve the first burst and
# journald's suppression summary, but don't let optional grouping consume the
# persistent previous-boot evidence window.
LogRateLimitIntervalSec=60s
LogRateLimitBurst=30

# Scheduling priority (NOT a cap): the audio chain runs hot.
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=4

# OOM ordering: optional renderer, dies before core playback. -300
# puts it in the optional-renderer band (same as snapserver).
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
