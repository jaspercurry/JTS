[Unit]
Description=AEC bridge — carries XVF mic audio via software AEC3 or chip-AEC
# Captures the far-end reference from outputd's UDP final-speaker
# monitor and the near-end mic from the reconciler-selected XVF ALSA
# card (`Array` for legacy square/circular firmware, `L16K6Ch` for
# Flex LINEAR-4) channel 1 on 6-ch firmware. In opt-in chip-AEC mode,
# the same outputd
# reference also feeds the XVF USB-IN chip reference path and the
# bridge forwards a chip ASR beam to
# 127.0.0.1:JASPER_AEC_UDP_PORT (default 9876) instead of running
# WebRTC AEC3.
#
# The transport to jasper-voice is UDP localhost, not a second snd-aloop
# card — see ADR-0102.
#
# Software engine: when chip-AEC is not armed, WebRTC AEC3 runs via the
# jasper_aec3 pybind11 binding around Trixie's libwebrtc-audio-processing-1
# v1.3-3. Tuning knobs (JASPER_AEC_REF_GAIN_DB, JASPER_AEC_MIC_GAIN_DB,
# JASPER_AEC_AGC2) come from /etc/jasper/jasper.env.
#
# REPLACES the previous CamillaDSP-based bridge. The software fallback path is
# WebRTC AEC3; the chip-AEC profile bypasses that engine while reusing this
# service as the bridge from the chip beam into jasper-voice. See
# jasper/cli/aec_bridge.py.
After=jasper-fanin.service jasper-camilla.service jasper-outputd.service jasper-aec-init.service sound.target
# `Wants=` so init runs whenever bridge starts (init is a one-shot
# that applies XVF tuning; bridge depends on chip being initialised).
# The dependency remains soft for explicit custom/software routes. The
# ready marker below additionally requires the reconciler to have admitted
# this bridge, so it fails closed.
# Camilla is also a SOFT startup dependency. The current bridge reads
# the XVF mic directly and consumes outputd's final-reference UDP stream
# as its only reference source, so it has no runtime lifecycle
# dependency on CamillaDSP. Do not add Requires= or
# PartOf= back: a coordinated Camilla pause during a USB combo toggle
# otherwise clean-stops the bridge, leaves voice's UDP mic unfed, and
# triggers its 30 s progress watchdog (#1264). jasper-aec-reconcile
# remains the single owner of whether the bridge should run.
Wants=jasper-fanin.service jasper-camilla.service jasper-outputd.service jasper-aec-init.service

# jasper-aec-reconcile's published "the bridge may run" verdict; it is the
# single writer and jasper/aec_ready.py owns the path literal. See ADR-0224 for
# why this is a Condition and not the ExecCondition= probe it replaces.
# Deliberately NO After=jasper-aec-reconcile.service: that reconciler
# blocking-restarts this unit from inside its own ExecStart, so an ordering
# edge would deadlock both jobs until its TimeoutStartSec=120.
ConditionPathExists=/run/jasper-aec-reconcile/aec-bridge-ready

# Tier 4.5 — escalate to system reboot if the per-service watchdog
# spiral exceeds 4 restarts in 5 minutes. `reboot` (not `reboot-force`):
# clean unmount needed
# on a 1 GB Pi to flush dirty zram pages.
StartLimitIntervalSec=300
StartLimitBurst=4
StartLimitAction=reboot

# Stage 2 audio-protection: assign to jts-mic.slice with
# MemorySwapMax=0 — bounds VmSwap accumulation under sustained
# memory pressure.

[Service]
# Tier 1+2 of the resilience ladder. `Type=notify` makes the daemon
# emit `READY=1` (via sdnotify, see jasper/watchdog.py) before
# systemd considers it active. `WatchdogSec=30s` requires the daemon
# to pat the watchdog every < 30 s; the daemon's heartbeat thread
# only pats if its work loop has made progress recently (sentinel
# pattern). If the loop wedges (PortAudio blocked in a syscall holding
# the GIL), `WATCHDOG=1` stops firing, this timer expires, and
# `Restart=on-watchdog` revives us with a fresh process. Critically,
# this happens BEFORE the SIGTERM timeout / SIGKILL that would
# otherwise corrupt snd-aloop's kernel-side loopback_cable state and
# require a reboot.
#
# `TimeoutStopSec=5s` is the matching shorter SIGTERM grace period
# (down from systemd's default 90 s). If the daemon can't shut down
# in 5 s, it's wedged and we want to get to SIGKILL+restart fast
# rather than accumulating wedge time.
Slice=jts-mic.slice
Type=notify
WatchdogSec=30s
TimeoutStopSec=5s
# Pull JASPER_AEC_REF_GAIN_DB, JASPER_AEC_MIC_GAIN_DB, JASPER_AEC_AGC2
# from the same env file jasper-voice uses. Leading `-` makes systemd
# skip the file silently if it's absent (e.g. fresh install before
# install.sh has run); the bridge defaults are conservative
# (ref_gain=0 dB, mic_gain=0 dB, agc2=off) so a missing env file is
# safe — but the production tuning values won't be applied.
EnvironmentFile=-/etc/jasper/jasper.env
# The /wake/ computer-microphone controls own durable export intent and the
# selected source leg. Load it after the system env so the household choice
# wins without granting the web/control surface write access to /etc.
EnvironmentFile=-/var/lib/jasper/usb_mic.env
# Corpus-recorder experiment flags live under /var/lib/jasper so the
# sandboxed web UI can deliberately enable optional bridge outputs
# (reference / cheap USB / DTLN) without writing to /etc.
EnvironmentFile=-/var/lib/jasper/wake_corpus_bridge.env
ExecStart=/opt/jasper/.venv/bin/jasper-aec-bridge
# `Restart=on-failure` covers non-zero exit + signals + watchdog
# timeouts (systemd.service(5)); `on-watchdog` alone does not restart
# on the explicit `BridgeStalled` exit (code 1, raised by `_aec_loop`
# when the mic queue stays empty for JASPER_AEC_STALL_RESTART_SEC).
Restart=on-failure
RestartSec=2
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=4

# AEC-bridge intentionally does NOT elect SCHED_FIFO:
# CPUSchedulingPolicy=fifo + LimitRTTIME=200000 crash-loops the bridge — its
# CPU-heavy startup (DTLN / WebRTC-AEC3 model load runs >200 ms) hits the
# RTTIME hard limit while scheduled FIFO and gets SIGKILLed (status=9/KILL)
# before it finishes starting. The bridge keeps its Nice=-10 + realtime IO
# priority (above) and runs SCHED_OTHER as it always did. A future RT
# election must set the policy on the steady-state audio thread
# AFTER model load — not process-wide via systemd, which schedules the heavy
# init under FIFO too. LimitRTPRIO=99 stays (harmless with no policy elected) so
# that future option needs no unit change.
LimitRTPRIO=99
LimitMEMLOCK=infinity

# OOM protection (Stage 1 of memory-resilience plan). Real-time mic processing: killing
# this stops AEC and the wake loop runs raw, but the speaker can
# still play music — so we protect heavily but not as hard as
# camilla (-900). -700 keeps us well above any non-jasper process
# the kernel might consider.
OOMScoreAdjust=-700

[Install]
WantedBy=multi-user.target
