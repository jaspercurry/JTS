[Unit]
Description=Jasper renderer fan-in (per-substream → summed music reference)
After=sound.target
Before=jasper-camilla.service shairport-sync.service librespot.service bluealsa-aplay.service jasper-usbsink.service jasper-aec-bridge.service

# Tighter burst than the default-4/300 sidecar pattern: fan-in is hot-path
# infrastructure (CamillaDSP and the AEC bridge consume its output), but the
# window still absorbs a transient USB de-enumeration or suspend resume. Five
# failures in five minutes escalate to a clean reboot, matching the ladder on
# jasper-camilla / jasper-aec-bridge / jasper-voice / jasper-control. See
# ADR-0146.
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=reboot

[Service]
# The daemon sends READY=1 once its PCMs are up and the STATUS server thread is
# spawned, then pings WATCHDOG=1 every ~10 s gated on a progress sentinel the
# work loop bumps after every published period. A wedged loop stops the pings
# and systemd reaps within WatchdogSec.
Type=notify
WatchdogSec=30s

# 5 s, not the systemd default 90 s: a daemon blocked in ALSA I/O can sit on
# SIGTERM long enough to leave kernel-side ALSA state inconsistent before
# SIGKILL fires.
TimeoutStopSec=5s

# Covers every non-zero exit including a WatchdogSec timeout. RestartSec=5 lets
# a transient hardware blip settle before the retry.
Restart=on-failure
RestartSec=5

# CONFIG-class failures exit 78 (EX_CONFIG) and must NOT climb the restart
# ladder above, which would reboot the speaker every few minutes over something
# no restart can fix. The daemon uses 78 for the Ring A geometry declaration
# only, in two shapes that need DIFFERENT fixes:
#
#   1. A bad ENV DECLARATION — a rejected JASPER_FANIN_RING_WIRE_FORMAT /
#      _RING_SLOTS / slot-shearing period. Identical on every restart AND across
#      a reboot, because it is re-read from the env file each start.
#      Fix: correct the env, then `systemctl restart jasper-fanin`.
#   2. A STALE RING FILE whose header geometry differs from the one the daemon
#      builds. /dev/shm is tmpfs, so this one DOES clear on a reboot — but not
#      on a restart, which is exactly the loop the park prevents.
#      Fix: `rm /dev/shm/jts-ring/program.ring` (or reboot), then restart.
#
# Transient faults are NOT this class and keep the ordinary Restart=on-failure
# retry: a de-enumerated USB DAC, an absent snd-aloop substream, and — at the
# ring open — a .open.lock still held by the outgoing process or a tmpfs
# permission systemd-tmpfiles has not applied yet. The daemon gates the park on
# io::ErrorKind::{InvalidInput, InvalidData} so those self-heal.
#
# No SuccessExitStatus: an exit-78 park leaves the unit `failed` on purpose, so
# /state and jasper-doctor show it rather than a silently-inactive daemon.
RestartPreventExitStatus=78

# OOM ladder slot, between Camilla (-900, silence-critical) and the AEC bridge
# (-700, capture-critical): fan-in feeds both, and Camilla can emit silence for
# a moment where losing Camilla itself means total silence.
OOMScoreAdjust=-800

# Audio pages must never reach zram — decompression latency on a 1 GB Pi under
# memory pressure is the dominant jitter source. The slice is defined in
# deploy/systemd/jts-audio.slice.
Slice=jts-audio.slice

# SCHED_FIFO 30 + mlockall. Stock-kernel worst-case scheduling latency on a Pi 5
# under stress is tens of milliseconds; PREEMPT_RT is the documented escalation
# if a soak still shows xruns.
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=30

# Bounds RT-thread runaway: a FIFO thread that spins without blocking can starve
# PID 1 on the 1 GB Pi and trip the hardware watchdog into a full reboot.
# SIGXCPU at 200 ms turns that into one crashed daemon the restart ladder
# revives. Carried by every FIFO unit (camilla/fanin/outputd).
LimitRTTIME=200000

# Hardening — matches jasper-voice / jasper-outputd.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/jasper /run/jasper-fanin

# fanin stays root (final-output path) but joins the `jasper` group with
# UMask=0007 so its tts.sock / control.sock are root:jasper 0770: a UNIX socket
# needs WRITE permission to connect(), and jasper-voice / jasper-mux are not
# root. RuntimeDirectoryMode=0750 lets the group traverse to the sockets.
# systemd removes the runtime dir on stop, so the sockets never leak.
Group=jasper
UMask=0007
RuntimeDirectory=jasper-fanin
RuntimeDirectoryMode=0750

# Config chain. /etc/jasper/jasper.env is the operator's system-wide file; the
# reconciler-owned /var/lib/jasper/fanin.env is loaded LAST so its coupling and
# USB-combo keys win (systemd applies a later EnvironmentFile= over an earlier
# one). Optional (leading `-`): absent on a fresh box, where the daemon's own
# compiled defaults are live. This unit declares no Environment= — a literal
# here would beat /etc/jasper/jasper.env, the documented operator seam.
EnvironmentFile=/etc/jasper/jasper.env
EnvironmentFile=-/var/lib/jasper/fanin.env

ExecStart=/opt/jasper/bin/jasper-fanin

# Host-slaved USB clock cleanup. With JASPER_FANIN_USB_DIRECT=enabled and
# JASPER_FANIN_HOST_CLOCK=enabled the `fanin-host-clock` thread owns the
# gadget's "Capture Pitch 1000000" ctl and resets it on every clean exit — but
# SIGKILL / OOM-kill / watchdog abort / panic abort skip that, and a host must
# never stay slaved to a daemon that is no longer running.
#
# The helper re-derives the gate (BOTH flags, case-insensitively, matching the
# config parser) and the card (from JASPER_FANIN_USB_DIRECT_DEVICE, default
# hw:UAC2Gadget) before writing the neutral pitch. It exits 0 on the
# not-owner / absent-card paths and the leading `-` ignores the rest, so the
# journal stays clean. The logic lives in deploy/bin/, not an inline `sh -c`:
# systemd reads `%` in an Exec* line as a specifier escape, which silently
# mangles shell parameter expansion.
ExecStopPost=-/usr/local/sbin/jasper-fanin-pitch-neutralize

[Install]
WantedBy=multi-user.target
