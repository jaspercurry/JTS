[Unit]
Description=Export the selected JTS microphone source to the connected USB host
After=jasper-usbgadget.service jasper-aec-bridge.service sound.target
PartOf=jasper-usbgadget.service jasper-aec-bridge.service

[Service]
Type=simple
User=jasper-usbmic
Group=jasper
SupplementaryGroups=audio
RuntimeDirectory=jasper-usbmic
RuntimeDirectoryMode=0755
# Inline sh rather than the venv CLI: PartOf= two units plus
# Restart=on-failure re-runs this gate many times per boot, and importing
# the relay CLI just to answer it costs ~25 MB against MemoryMax=48M.
# The intent match mirrors jasper.usb_mic.read_intent (last assignment
# wins; whitespace then surrounding ' and " stripped) but not its 4 KiB /
# UTF-8 limits, which is safe only because jasper-usbgadget-up composes
# p_chmask through read_intent itself: a file Python calls corrupt reaches
# here as p_chmask=0.
# \\47\\42 is doubled so the quote pair reaches printf whether or not
# systemd resolves escapes inside single quotes.
# No `+`: usb_mic.env is 0644 in /var/lib/jasper 0770 root:jasper, which
# User=jasper-usbmic reads through its primary group.
# `timeout 2` on is-active mirrors the replaced _ready()'s subprocess
# timeout=2.0: a wedged system bus fails closed (aec_bridge_inactive)
# instead of stalling this gate past RestartSec=2.
ExecCondition=/bin/sh -c 'intent=/var/lib/jasper/usb_mic.env; chmask=/sys/kernel/config/usb_gadget/jts-usb-audio/functions/uac2.usb0/p_chmask; q=$$(printf "\\47\\42"); line=$$(grep -E "^[[:space:]]*JASPER_USB_MIC[[:space:]]*=" "$$intent" 2>/dev/null | tail -n 1); if ! printf "%s" "$$line" | grep -qE "^[[:space:]]*JASPER_USB_MIC[[:space:]]*=[[:space:]]*[$$q]*enabled[$$q]*[[:space:]]*$$"; then reason=intent_off_or_invalid; elif ! mask=$$(cat "$$chmask" 2>/dev/null); then reason=uac2_missing; elif [ "$$mask" != "1" ]; then reason="p_chmask_$${mask:-missing}"; elif timeout 2 systemctl is-active --quiet jasper-aec-bridge.service; then exit 0; else reason=aec_bridge_inactive; fi; echo "event=usb_mic.skip reason=$$reason" >&2; exit 1'
ExecStart=/opt/jasper/.venv/bin/jasper-usbmic
Restart=on-failure
RestartSec=2
TimeoutStopSec=3
Nice=-5
# Optional and restartable: shed with accessory/control helpers before the
# core voice/AEC path under whole-box memory pressure.
OOMScoreAdjust=-300
MemoryMax=48M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native

[Install]
WantedBy=jasper-usbgadget.service jasper-aec-bridge.service
