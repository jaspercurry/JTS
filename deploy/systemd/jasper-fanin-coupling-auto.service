# DEFAULT-RESOLUTION pass for the fan-in coupling + USB combo (campaign P3/P4).
# Runs at boot AND on every deploy (install.sh) as a Type=oneshot reconciler
# (pattern 3: the reconciler is the single env writer; the daemons read the
# resolved env). It resolves the SHIPPED default:
#   - ring coupling (shm_ring) on a solo, ring-eligible box, else loopback; and
#   - the USB low-latency combo on a gadget box, else combo-off.
# ...UNLESS the operator recorded an explicit choice
# (JASPER_FANIN_COUPLING_CHOICE=operator in fanin.env), in which case the exact
# coupling is frozen so a deliberate transport revert sticks. USB combo/direct
# authorization still converges from canonical USB intent; the operator marker
# cannot preserve capture after household Off.
#
# A no-op on an already-resolved box (the confirm path bounces no daemon), so
# the steady-state boot cost is one short reconcile with zero audio churn.
#
# Concurrency: install.sh and an operator CLI can run the same transition. The
# reconcile CLI serializes every entry behind an advisory flock
# (/run/jasper-fanin-coupling.lock) with a bounded wait and aborts loudly (unit
# lands `failed`, doctor-visible) on contention.
[Unit]
Description=Resolve the default fan-in coupling + USB combo (P3/P4 default-flip)
Documentation=file:/opt/jasper/docs/HANDOFF-audio-graph-consolidation.md
# This oneshot has no automatic Restart= loop. Every source transaction asks it
# to converge, so deliberate rapid toggles must not hit systemd's default
# successful-start rate limit.
StartLimitIntervalSec=0
# Run AFTER the audio graph is up so an arm transition (which bounces
# fan-in/outputd and reloads CamillaDSP) lands on live daemons. Wants (not
# Requires) so a degraded box still runs the pass and resolves loopback.
After=jasper-fanin.service jasper-outputd.service jasper-camilla.service jasper-control.service
Wants=jasper-fanin.service jasper-outputd.service jasper-camilla.service

# A contention-aborted --auto parks this unit failed (doctor-visible via
# check_service_runtime_state). Nothing retries it automatically — recovery
# is event-driven: next boot, deploy (install.sh runs --auto), a /sources/
# toggle (broker start), or a manual `systemctl start` per the doctor's
# remediation text. Restart=on-failure would be wrong here: a legitimate
# arm failure (rolled back to loopback) also exits 1 and would retry-loop.
[Service]
Type=oneshot
# Worst-case pass under the entry lock. The tally is NOT duplicated here: it is
# derived in code as jasper.fanin.coupling_reconcile.COUPLING_AUTO_ENUMERATED_WORST_SEC
# and this value is COUPLING_AUTO_TIMEOUT_START_SEC, which is that plus a stated
# headroom. tests/test_fanin_coupling_reconcile.py fails if the two drift; the
# previous hand-kept tallies here (review #1252, #2175, #2285 P7) drifted twice
# and are what the derivation replaces.
#
# What the old tallies omitted, and the reason this ceiling moved: every daemon
# op costs a blocking reset-failed preamble on a crash-budget unit, and the combo
# half and the coupling-flip half are ADDITIVE (reconcile_auto runs the
# coordinated restart, then delegates the flip at "Step 4") where the old tally
# treated them as alternatives. Fan-in is restarted three times on that path.
#
# THIS CEILING IS SIZED FOR A LIVE BROKER — a decision, not an oversight. A dead
# broker makes each op retry through direct systemctl, which would push the pass
# to COUPLING_AUTO_BROKER_DEAD_WORST_SEC, but a dead jasper-control broker is an
# independently loud, already-degraded mode (dashboard and /state down, doctor
# red), not the legal operating envelope. The failure semantics differ in the way
# that matters: a client bound shorter than a succeeding operation LIES and fires
# a destructive rollback, while a ceiling kill of an already-degraded slow pass
# TELLS THE TRUTH — unit visibly failed, journal explicit, next trigger retries.
# Stretching this to cover the broker-dead worst would hide every real wedge for
# the length of the ceiling, which is blindness, not conservatism.
#
# TWO RESIDUALS, stated rather than hidden:
#   * under sustained broker death AND maximally slow hardware a pass may be
#     killed here mid-heal; it retries, full recovery expects the broker back,
#     and the fail-closed usbsink rollback can recur in that window — acceptable
#     because the mode already demands operator attention;
#   * a pass can run _reconcile_camilla up to twice, and that calls
#     asyncio.run(reconcile_current_dsp()) with no timeout of its own, so no
#     finite ceiling covers it. Bounding that call is tracked separately.
#
# Erring LONG stays the safe direction within the live-broker envelope: a systemd
# kill between camilla-stop and camilla-start leaves CamillaDSP cleanly stopped,
# which OnFailure=jasper-camilla-recover does NOT catch (clean stop != failed).
TimeoutStartSec=600
# The CLI hydrates the trusted base and reconciler-owned fanin env internally.
# Do not inject the group-writable fanin.env into this root Python process:
# values such as PYTHONPATH/LD_PRELOAD must never cross the privilege boundary.
EnvironmentFile=-/etc/jasper/jasper.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES PYTHONPATH PYTHONHOME
ExecStart=/opt/jasper/.venv/bin/jasper-fanin-coupling-reconcile --auto --reason systemd
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
