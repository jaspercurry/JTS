[Unit]
Description=Re-measure XVF3800 chip-AEC alignment (audible sweeps)

[Service]
Type=oneshot
EnvironmentFile=/etc/jasper/jasper.env
ExecStart=/opt/jasper/.venv/bin/jasper-aec-commission
# The CLI's own step ceilings (reconciler-idle wait, service stop, XVF
# reset, the bounded capture/adaptation sweeps, cleanup reconcile) each
# cap at 30s or less and sum to a few minutes worst case; 15 keeps
# scheduling headroom without letting a hang camp on the audio stack.
TimeoutStartSec=15min

# Root: it stops/starts the audio services, resets the XVF over USB, and
# writes the alignment artifact. Started ONLY by explicit user action
# (jasper-control POST /aec/commission) — the sweeps are audible, so there is
# no Install section and no Restart=: a failed run must never replay itself.
User=root
Group=root
UMask=0022

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Arm reconcile writes the leg env here; ProtectSystem=full leaves /etc read-only without it.
ReadWritePaths=/etc/jasper
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SyslogIdentifier=jasper-aec-commission
