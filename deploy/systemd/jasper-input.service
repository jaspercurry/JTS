[Unit]
Description=Jasper accessory bridges (HID buttons + accessory mic adapters)
After=network.target jasper-control.service
# Passive ordering for the BLE mic adapter task this process may run:
# an optional accessory must never pull bluetooth.service up through Wants=.
After=bluetooth.service
# Wants= (not Requires=) so a jasper-control restart blip doesn't
# cascade-stop the bridge. The bridge's HTTP calls just fail and
# retry on the next keypress.
Wants=jasper-control.service

[Service]
Type=simple
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES
ExecStart=/opt/jasper/.venv/bin/jasper-input
Restart=on-failure
RestartSec=2

# WS1 Phase 3b — user drop (3b-1). Non-root service user; `input`
# (supplementary) grants /dev/input/event* (root:input on Trixie), `jasper`
# (primary) is the shared group and reaches jasper-control's restart-broker
# socket. Needs no capability — CapabilityBoundingSet= drops them all and
# SystemCallFilter=@system-service blocks the dangerous classes.
#
# `bluetooth` — the BlueZ system-bus grant the mic adapter task needs — is
# deliberately NOT listed here: systemd fails a unit 216/GROUP on a name it
# cannot resolve, bluez (which creates that group) is apt-installed after the
# service users are created, and this unit carries the volume and
# push-to-talk buttons. It reaches the process through the user's own group
# membership, added guarded by deploy/lib/install/service-users.sh — so on a
# bare image where bluez is not yet installed when the service users are
# created, the grant lands on the next deploy and the accessory mic is dead
# until then (the buttons are not).
User=jasper-input
Group=jasper
SupplementaryGroups=input
CapabilityBoundingSet=
SystemCallFilter=@system-service

# Hardening — the process reads /dev/input/event* and the published accessory
# mic sources, watches udev, talks to BlueZ, and makes localhost HTTP/UDP calls.
# /dev/input/event* access comes from the `input` supplementary group above,
# which is also why the mic adapter's former PrivateDevices=true cannot come
# across: it would hide the input nodes this process exists to read.
ProtectSystem=strict
# Its only write: the supervisor's per-bridge status.json, which
# /state.resilience.accessory_bridges reads. Under ProtectSystem=strict a bare
# mkdir under /run fails, so the directory has to come from RuntimeDirectory=;
# 0750 root-of-unit jasper-input:jasper lets jasper-control (Group=jasper)
# read it. Reaped on stop, which is what keeps the file from outliving the
# process it describes.
RuntimeDirectory=jasper-input
RuntimeDirectoryMode=0750
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RemoveIPC=true
UMask=0077
# WS1 phase-1 hardening (hardened root).
# AF_NETLINK is required for the pyudev hot-plug monitor; AF_INET for the
# localhost POST to jasper-control. The one write is covered by
# RuntimeDirectory= above, so ProtectSystem=strict needs no ReadWritePaths.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# Every peer is on this box: jasper-control over TCP, the manual mic source
# over UDP, BlueZ and the restart broker over AF_UNIX.
IPAddressDeny=any
IPAddressAllow=localhost

# Idle: one udev netlink socket + a small number of evdev fds (one per
# attached known accessory), plus — only while an accessory mic is paired — one
# D-Bus connection and one UDP socket. Both read at human gesture speed. The
# two separate units this replaced budgeted 80M+60M high / 120M+100M max; one
# interpreter needs neither interpreter base twice.
MemoryHigh=110M
MemoryMax=160M

# OOM protection (Stage 1 of memory-resilience plan). Accessory bridges: direct
# USB still works without the HID bridge, and the local mic (where there is
# one) still works without the accessory mic adapter. Moderate protection.
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
