[Unit]
Description=Snapshot the speaker's effective mDNS identity to /var/lib/jasper/identity.env
# Avahi must be up for GetHostNameFqdn to answer; the script degrades
# gracefully (falls back to the OS hostname + logs avahi_unavailable)
# if it isn't, so this is an ordering hint, not a hard requirement.
After=avahi-daemon.service
Wants=avahi-daemon.service
# jasper.identity.resolve_hostname reads this snapshot FIRST, and these two
# readers resolve at START and freeze the answer for the process lifetime
# (jasper-voice's Config.from_env -> cfg.hostname; jasper-control's
# management-host allowlist env arm). Refresh the record before they read
# it. Per-call readers are deliberately absent: they re-resolve anyway, and
# a socket-activated unit would pay this run on every cold start. The timer
# below carries the 5-minute self-heal for a rename that lands mid-uptime.
Before=jasper-voice.service jasper-control.service
# See #4123.
ConditionPathExists=!/run/jasper-install/in_progress

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jasper-identity-reconcile --reason systemd
# A handful of subprocesses (hostname, busctl, grep) — anything slower
# means D-Bus is wedged; give up rather than pile onto a sick boot.
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
