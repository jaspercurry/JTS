[Unit]
Description=Jasper USB sink host-volume observer
# Non-real-time helper for USB Audio Input. jasper-fanin owns the audio data
# plane; this Python process only watches the UAC2 gadget mixer's control FDs
# and reports host slider changes to jasper-control.
#
# It tracks the process-free readiness marker's lifecycle: the UAC2 mixer exists
# only while the uac2 function is composed. The composite gadget outlives audio
# because it can also carry the hardware-conditional management network.
After=jasper-usbsink.service jasper-control.service
Requires=jasper-usbsink.service
PartOf=jasper-usbsink.service
ConditionPathExists=/run/jasper-source-intent/allowed/usbsink

[Service]
Type=simple
TimeoutStartSec=2s
TimeoutStopSec=5s
EnvironmentFile=-/etc/jasper/jasper.env
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES
ExecStart=/opt/jasper/.venv/bin/jasper-usbsink-volume
Restart=on-failure
RestartSec=2s
Nice=5
OOMScoreAdjust=100
MemoryHigh=32M
MemoryMax=64M

[Install]
WantedBy=multi-user.target
