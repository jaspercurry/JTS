[Unit]
Description=Jasper accessory profile reconciler
# This oneshot has no automatic Restart= loop. jasper-accessory-reconcile.path
# starts it once per request file, and a rapid toggle (pair then forget) is a
# healthy burst of those, so the manager's default start-rate limit would reject
# exactly the passes that must run.
StartLimitIntervalSec=0
# Source intent owns whether BlueZ may run. Ordering is passive: neither this
# oneshot nor an optional adapter may pull bluetooth.service up through Wants=.
After=bluetooth.service
# This pass reads the coordinator's Bluetooth marker to decide whether an
# accessory mic may be published at all, so a boot pass racing ahead of the
# coordinator would decide on stale intent. Ordering only: the coordinator
# never starts this unit (it publishes a request file), so no deadlock.
After=jasper-source-intent-reconcile.service
Before=jasper-voice.service

[Service]
Type=oneshot
TimeoutStartSec=60
ExecStart=/opt/jasper/.venv/bin/jasper-accessory-reconcile --reason boot
Group=jasper

# Root-owned reconciler: reads BlueZ state, writes /var/lib/jasper/accessory-mics.env,
# and refreshes the adapter hosts + jasper-voice. Keep it as a short oneshot
# rather than granting jasper-web or jasper-input new systemctl privilege. It
# runs no `systemctl enable/disable`, so it needs no write on /etc/systemd/system.
ProtectSystem=strict
ReadWritePaths=/var/lib/jasper
CapabilityBoundingSet=
SystemCallFilter=@system-service
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
NoNewPrivileges=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
RemoveIPC=true
UMask=0022

[Install]
WantedBy=multi-user.target
