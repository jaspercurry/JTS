[Unit]
Description=Jasper accessory profile reconciler
# This oneshot has no automatic Restart= loop. jasper-accessory-reconcile.path
# starts it once per request file, and a rapid toggle (pair then forget) is a
# healthy burst of those, so the manager's default start-rate limit would reject
# exactly the passes that must run.
StartLimitIntervalSec=0
# Source intent owns whether BlueZ may run. Ordering is passive: neither this
# oneshot nor an optional adapter may pull bluetooth.service up through Wants=.
After=bluetooth.service
# The adapter units this pass starts gate on the coordinator's marker files, so
# a boot pass that races ahead of the coordinator would start nothing and report
# its own failure. Ordering only: the coordinator never starts this unit (it
# publishes a request file), so the edge cannot deadlock.
After=jasper-source-intent-reconcile.service
Before=jasper-voice.service

[Service]
Type=oneshot
TimeoutStartSec=60
ExecStart=/opt/jasper/.venv/bin/jasper-accessory-reconcile --reason boot
Group=jasper

# Root-owned reconciler: reads BlueZ state, writes /var/lib/jasper/accessory-mics.env,
# and owns adapter unit enable/start state. Keep it as a short oneshot rather
# than granting jasper-web or jasper-input new systemctl privilege.
ProtectSystem=strict
ReadWritePaths=/var/lib/jasper /etc/systemd/system
CapabilityBoundingSet=
SystemCallFilter=@system-service
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
NoNewPrivileges=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
RemoveIPC=true
UMask=0022

[Install]
WantedBy=multi-user.target
