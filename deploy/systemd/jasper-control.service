[Unit]
Description=Jasper external control surface (HTTP API for accessories / automation)
After=jasper-camilla.service network-online.target
# Wants= (not Requires=) so a camilla restart blip doesn't cascade-stop
# the control daemon. Volume dispatch goes through best_effort=True
# camilla calls — a write that hits the 2 s restart window logs a
# warning and is dropped, but the remote keeps responding and the next
# write lands. After= still orders us behind camilla on cold boot.
Wants=network-online.target jasper-camilla.service jasper-identity-reconcile.service

# Tier 4.5 — escalate to system reboot if the per-service restart
# spiral exceeds 4 restarts in 5 minutes. jasper-control is the
# recovery surface (HTTP API for the remote, /system/ dashboard);
# if it's stuck in a restart loop while the rest of the system
# looks OK, the operator can't reach the dashboard to diagnose
# — exactly the case where clean system reboot beats waiting.
# `reboot` (not `reboot-force`): clean shutdown needed for zram.
StartLimitIntervalSec=300
StartLimitBurst=4
StartLimitAction=reboot

[Service]
# Tier 1 — `Type=notify` + `WatchdogSec` mirror jasper-voice: the daemon
# sends READY=1 at startup and `WATCHDOG=1` only while the HTTP accept
# loop is actually spinning (ControlHTTPServer.service_actions bumps the
# progress sentinel in jasper/watchdog.py from inside serve_forever's
# poll loop). Before this a wedged loop was invisible to systemd — the
# process looked alive while the remote / dashboard / /state surface was
# dead. Restart=on-failure below also covers watchdog expiry.
Type=notify
WatchdogSec=30s
EnvironmentFile=/etc/jasper/jasper.env
EnvironmentFile=-/var/lib/jasper/speaker_name.env
# Spotify creds live in /var/lib/jasper-intsecrets/spotify_credentials.env (written
# by the web wizard at f1c7dee). jasper-voice / jasper-web already
# load it; jasper-control needs it too so /transport/toggle's
# title-match path can build a Spotify Web API router. Without these
# creds the router is None and the dispatcher falls straight through
# to the DACP precheck — which on iOS 17+ AirPlay 2 returns false,
# producing a 502 "doesn't accept remote control" on every remote click.
# Leading `-` makes systemd skip if the file's missing (fresh install).
EnvironmentFile=-/var/lib/jasper-intsecrets/spotify_credentials.env
# Voice provider selection written by the wizard at https://jts.local/voice/.
# Same precedence rule as jasper-voice's unit file: later EnvironmentFile=
# wins, so the wizard-written file overrides any JASPER_VOICE_PROVIDER
# default in jasper.env. The /system dashboard reads this when rendering
# the "Voice provider" row — without the overlay the dashboard shows
# whatever jasper.env defaulted to, which goes stale the moment the user
# flips providers in the wizard.
EnvironmentFile=-/var/lib/jasper/voice_provider.env
# Peering (multi-device wake arbitration). Off by default; the user
# enables it on /sound/pair/. When on, jasper-control hosts
# the peering daemon: mDNS browse, multicast UDP, UDS to voice. When
# off, no peering code runs and the Pi is invisible to siblings.
EnvironmentFile=-/var/lib/jasper/peering.env
ExecStart=/opt/jasper/.venv/bin/jasper-control
Restart=on-failure
RestartSec=2

# jasper-control runs as a dedicated non-root
# service user in the shared `jasper` group. The group is the cross-daemon
# access boundary: (1) /run/jasper-control is jasper-control:jasper 0750 and the
# broker socket is 0660 group jasper, so the non-root jasper-mux/-web reach the
# restart broker; and (2) the shared state it writes (speaker_volume.json) lands
# in group `jasper` so jasper-voice/-mux can read it.
#
# This drop is GATED on two hardware-validated things that ship in the SAME PR:
#   (a) a polkit rule (deploy/polkit/49-jasper-control.rules) — the supervisor
#       recovery paths (system_supervisor reboot, shairport_supervisor restart)
#       and the in-process restart broker call systemctl/reboot DIRECTLY as this
#       uid, which polkit now mediates instead of a uid-0 bypass; and
#   (b) group-readable config/secret env (the jasper-doctor it spawns at
#       /system/diagnostics fresh-reads every env_load.ENV_FILES file, and
#       /state fresh-reads home_assistant.env). The broad file it still reads
#       (voice_provider.env) is 0640 group jasper; HA + Spotify now come from
#       the narrower group-`jasper-intsecrets` compartment.
#
# CapabilityBoundingSet= drops ALL caps (control needs none — the privileged
# restarts go through polkit, not a capability). SystemCallFilter=@system-service
# blocks the dangerous syscall classes; it permits fork/execve, so the
# systemctl / busctl children it spawns exec cleanly (each with its own syscall
# policy). ProtectKernelLogs stays OMITTED and ProtectHome stays read-only
# (below) for those same diagnostic subprocesses.
#
# SupplementaryGroups=systemd-journal: the airplay_health and wifi_guardian
# last-action /state cards read the journal — a non-root reader needs the
# systemd-journal group. `jasper-intsecrets` grants fresh HA reads + Spotify
# token-cache writes. (The full jasper-doctor runs as ROOT via the
# jasper-doctor-json.service oneshot, so it does NOT depend on systemd-journal.)
#
# `jts-ring` (issue #2786): /state's grouping `ring` block reads the first 128
# bytes of /dev/shm/jts-ring/grouping.ring — the shared header that says whether
# the bonded endpoint's CamillaDSP is still draining what snapclient writes.
# Those files are group `jts-ring` (the setgid directory) with a mode that
# follows the creating unit's umask — 0660 from snapclient's UMask=0007, 0640
# from a unit without one; both grant the group READ, which is all this needs.
# Without the group the block reports "not readable by this process" on every
# poll and the surface is inert. An external reader is unavoidable here: the two
# ends of that ring are snapclient and CamillaDSP, and unlike Ring A/B — whose
# fan-in and outputd owners publish what they read on their own STATUS surfaces
# — neither publishes anything to aggregate.
#
# THE GRANT IS WIDER THAN THE NEED, and that is a cost/complexity choice, not an
# impossibility. The group exists to grant ring WRITE, and a file's group is its
# only handle, so joining it for a read takes the write bit along. A read-only
# default POSIX ACL on /dev/shm/jts-ring (a tmpfiles `A+` line in
# deploy/tmpfiles/jts-ring.conf, which already owns that directory) WOULD be
# narrower in capability; it was not taken because there is no ACL prior art in
# this repo, tmpfs ACL behaviour is unverified on the Pi, and it would make a
# second writer of permission state for one observability read. What keeps the
# grant read-only in practice is the code: jasper-control opens the ring
# O_RDONLY only (jasper.ring_assets.read_ring_header), pinned by
# tests/test_grouping_ring_observability.py. See deploy/tmpfiles/jts-ring.conf
# for why the group exists and exactly what it grants.
User=jasper-control
Group=jasper
SupplementaryGroups=systemd-journal jasper-intsecrets jts-ring
CapabilityBoundingSet=
SystemCallFilter=@system-service
# UMask=0007 — speaker_volume.json (written by jasper-control AND jasper-voice)
# and other shared /var/lib/jasper state are created group-writable (0660), not
# 0644, so the shared `jasper` group can write them: a 0644 file is unwritable
# by the non-owner once StateDirectory re-chowns the tree. Mirrors jasper-voice/-mux.
UMask=0007

# The privileged restart broker binds a UNIX socket at
# /run/jasper-control/restart.sock. RuntimeDirectory= makes systemd create
# (and tear down) /run/jasper-control owned by jasper-control:jasper (the unit's
# User:Group), so the broker can bind without a manual mkdir/chown. Mode 0750
# lets the `jasper` group traverse so the non-root mux/web clients can reach
# restart.sock (0660, group jasper).
RuntimeDirectory=jasper-control
RuntimeDirectoryMode=0750

# Hardening — daemon reads jasper.env, opens a localhost WebSocket to
# CamillaDSP, binds an HTTP port, persists a handful of small state
# files under /var/lib/jasper, and renders the peering Avahi service
# file when wake-response peering is enabled (see ReadWritePaths below).
ProtectSystem=strict
# `read-only` (not `true`) keeps home directories visible to diagnostic
# subprocesses while still blocking writes. ALSA routing now lives in
# /etc/asound.conf, but jasper-control still shells out to operator-facing
# tools from the /system dashboard and should not get a private, empty home.
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# jasper-control writes:
#   - /var/lib/jasper state: wizard env files it owns (aec_mode.env,
#     wake_model.env, debug.env), speaker_volume.json, and the T5.2
#     supervisor's reboot rate-limit at
#     /var/lib/jasper/system_supervisor_reboot.json.
#   - /var/lib/jasper-intsecrets: Spotify token refreshes from the transport /
#     volume path and fresh HA status reads from /state.
#   - /etc/avahi/services/jasper-peer.service when wake-response peering
#     is enabled so siblings can discover this speaker.
# Today /var writes work only because ProtectSystem=full leaves /var
# writable; /etc is read-only under that same hardening. Pin both write
# contracts explicitly so future hardening and current peering advert
# rendering cannot silently regress.
ReadWritePaths=/var/lib/jasper /var/lib/jasper-intsecrets /etc/avahi/services
# ProtectKernelLogs is intentionally OMITTED: jasper-control spawns
# jasper-doctor, whose watchdog-reset fingerprint check reads dmesg (/dev/kmsg).
# ProtectHome stays read-only (above) for the same diagnostic-subprocess reason.
# CapabilityBoundingSet= + SystemCallFilter= are set with the non-root user-drop above.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

# OOM protection (Stage 1 of memory-resilience plan). Control is the recovery surface — if
# this dies, the operator can't reach /system/, can't flip AEC mode,
# can't read the dashboard. Protected at -600, slightly less than
# voice but well above any normal process.
OOMScoreAdjust=-600
# Task-count backstop for the LAN-facing control plane. The Python
# server sheds excess HTTP requests in-process, but this caps runaway
# fork/thread bugs below the system default while leaving enough room
# for normal worker threads plus short-lived systemctl/busctl probes.
TasksMax=256

[Install]
WantedBy=multi-user.target
