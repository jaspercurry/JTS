[Unit]
Description=CamillaDSP (always-on, outputd + master_gain ducking node)
After=sound.target network.target jasper-audio-hardware-reconcile.service jasper-outputd.service jasper-fanin.service
Wants=sound.target jasper-outputd.service jasper-fanin.service
Requires=jasper-audio-hardware-reconcile.service
# 5 restarts in 60s absorbs a transient ALSA hiccup without letting a
# genuinely broken config loop forever.
StartLimitIntervalSec=60
StartLimitBurst=5
# The audio units escalate an exhausted burst to reboot only where a reboot
# can clear the failure class AND an EX_CONFIG exit fences the config class
# out of the burst (see jasper-outputd.service). CamillaDSP is neither: since
# ADR-0100 it opens no device, and 4.1.3 exits CLEAN on a rejected config, so
# the recovery handler's park is its fence (ADR-0175).
StartLimitAction=none
OnFailure=jasper-camilla-recover.service

[Service]
# MemorySwapMax=0 via the slice: zstd decompression jitter on swapped audio
# pages is audible as splotchy music.
Slice=jts-audio.slice
Type=simple
# --statefile persists the loaded config path and main_volume across restarts.
#
# There is intentionally NO positional CONFIGFILE arg: in CamillaDSP v4.x a
# positional config wins over --statefile on startup AND overwrites the
# statefile's path on every start, which would make the statefile a no-op.
# install.sh seeds the statefile to outputd-cutover.yml for first boot.
#
# Recovery from a bad correction without hand-editing the statefile: add
# --no_config to the args, restart, fix the YAML or apply a new measurement,
# then remove --no_config.
#
# Pipe guard: if the statefile points at a BONDED pipe config but the
# snapserver FIFO is dead, camilladsp 4.1.3 exits CLEAN (measured), which
# Restart=always turns into a repeated parked/recovery cycle. The guard
# repairs the statefile to the base config before launch. Best effort (`-`);
# the reconciler above is the hard startup gate.
ExecStartPre=-/usr/local/sbin/jasper-camilla-pipe-guard
ExecStart=/opt/camilladsp/camilladsp \
    -p 1234 -a 127.0.0.1 \
    --statefile /var/lib/camilladsp/outputd-statefile.yml
# Retire jasper-camilla-recover's park: this unit starting again IS what ends
# it (ADR-0175). Path duplicated from jasper/control/camilla_recover_state.py.
ExecStartPost=-/bin/rm -f /run/jasper-camilla-recover.state
# Restart=always, not on-failure: CamillaDSP has exited status=0 and left the
# speaker silently dead overnight.
Restart=always
RestartSec=2
Nice=-10
IOSchedulingClass=realtime
IOSchedulingPriority=4

# The v4.1.3 binary promotes its own ALSA thread within LimitRTPRIO; electing
# SCHED_FIFO here puts the main thread at RT too. Priority 25 is deliberately
# BELOW the two sinks that must win a starved CPU — jasper-fanin (30) and
# jasper-outputd (35). Keep 25 < 30 < 35 if any priority is retuned.
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=25
LimitRTPRIO=99

# SIGXCPU bound on an RT thread that runs without blocking: on a 1 GB Pi a
# runaway FIFO thread can starve PID 1 and trip the ~60s hardware watchdog
# into a full reboot. 200 ms is far above a normal Camilla period (well under
# a millisecond of compute). Carried by every FIFO unit (camilla/fanin/outputd).
LimitRTTIME=200000
LimitMEMLOCK=infinity

# CamillaDSP logs unstructured ALSA backend WARN lines; a degraded capture
# graph emits them many times per second and would crowd out previous-boot
# forensics in the persistent journal.
LogRateLimitIntervalSec=60s
LogRateLimitBurst=120

# -900: silencing music is the worst UX. -1000 is reserved for
# sshd / systemd-journald, so the OOM killer keeps a credible candidate.
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
