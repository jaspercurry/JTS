[Unit]
Description=Jasper Bluetooth no-code pairing agent
Requires=bluetooth.service
After=bluetooth.service
# The agent registers with BlueZ once at start and never re-registers, so a
# bluetoothd restart silently drops it; PartOf= propagates that restart here.
# The Off pass clears the marker below before it stops this unit, so the
# paired Upholds= in bluetooth.service.d/jts-timeout.conf cannot resurrect a
# parked agent.
PartOf=bluetooth.service
# Safe to restart after transient Bluetooth/OOM churn; finite so a broken
# BlueZ stack does not spin forever.
StartLimitIntervalSec=600
StartLimitBurst=20
ConditionPathExists=/run/jasper-source-intent/allowed/bluetooth

[Service]
Type=simple
TimeoutStartSec=2s
# JTS is a headless speaker. Its single default BlueZ agent advertises
# NoInputNoOutput so pairing is no-code "Just Works"; PIN/passkey/numeric
# comparison flows are rejected as unsupported.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GLIBC_TUNABLES
ExecStart=/opt/jasper/.venv/bin/jasper-bluetooth-agent
TimeoutStopSec=10s
Restart=always
RestartSec=5

# Idle process holding one system-bus connection; it polls the adapter over
# that connection and never buffers audio.
MemoryHigh=60M
MemoryMax=100M

# Optional and restartable: pairing is an occasional operator action, and
# already-bonded devices reconnect without an agent registered.
OOMScoreAdjust=-300

[Install]
WantedBy=multi-user.target
