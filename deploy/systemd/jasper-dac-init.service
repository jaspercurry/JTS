[Unit]
Description=Pin the classified output DAC's declared mixer controls
# JTS owns gain in CamillaDSP (main_volume), so every hardware stage in front
# of the speaker holds what the DacProfile registry declares. The HiFiBerry
# Studio driver writes no defaults at all: an unpinned board boots at whatever
# its MCU holds, up to +24 dB on its master control.
#
# Ordered after alsa-restore so a restored snapshot cannot outrun the pin, and
# before the renderers so the path is at declared gain when anything opens it.
# jasper-audio-hardware-reconcile restarts this unit whenever it writes a
# record naming a different DAC or card, which covers a boot where this ran
# before any record existed, and every later hotplug.
After=sound.target alsa-restore.service
Before=jasper-camilla.service shairport-sync.service librespot.service
Requires=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/jasper-dac-init
# WS1 Tier-B DAC mixer slice: amixer access works through the `audio`
# supplementary group on Apple USB-C DAC hardware, so the boot pin no longer
# needs uid 0. The udev hotplug fast path remains a root-owned exception in
# deploy/udev/99-jasper-apple-dongle.rules to preserve immediate replug repair.
User=jasper-recon
Group=jasper
SupplementaryGroups=audio
CapabilityBoundingSet=
SystemCallFilter=@system-service
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
