# /etc/systemd/system/jts-mic.slice
#
# Separate from jts-audio.slice because a swapped-out page's decompression
# jitter here delays wake-word detection (missed wakes) rather than causing
# an audible glitch — see jts-audio.slice for the MemorySwapMax=0 rationale.

[Unit]
Description=JTS mic path (AEC bridge + future mic processing) — pages never swap to zram
Before=slices.target

[Slice]
MemoryAccounting=yes
MemorySwapMax=0
ManagedOOMPreference=avoid

[Install]
WantedBy=slices.target
