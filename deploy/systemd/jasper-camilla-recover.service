[Unit]
Description=Capture and recover CamillaDSP after restart-limit exhaustion
After=local-fs.target systemd-journald.socket

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jasper-camilla-recover --reason start-limit
# 3 captures x CAPTURE_TIMEOUT_SEC 5s = 15, + the one `systemctl start
# jasper-camilla.service` blocking on its Requires= jasper-audio-hardware-
# reconcile (TimeoutStartSec=50s), + the 3s liveness wait = 68s, rounded up.
TimeoutStartSec=90
# No work runs after the SIGTERM at TimeoutStartSec (the handler holds no
# trap), so this is only the delay to SIGKILL.
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
