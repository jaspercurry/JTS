[Unit]
Description=Jasper final output owner
After=sound.target
# outputd owns the read side of Ring B, the SHM ring CamillaDSP writes its
# post-DSP program into (ADR-0100). Start it before Camilla so Camilla never
# blocks on an absent reader during boot/reload.
Before=jasper-camilla.service

StartLimitIntervalSec=300
StartLimitBurst=5
# The policy for all three audio units: an exhausted burst reboots only where
# a reboot can clear the failure class (here a wedged USB/I2S driver, which
# nothing in userspace un-wedges) AND an EX_CONFIG exit fences the config
# class out of the burst (RestartPreventExitStatus=78 below); a unit that is
# neither parks instead, which is why jasper-camilla carries none (ADR-0175).
StartLimitAction=reboot

[Service]
Type=notify
WatchdogSec=30s
TimeoutStopSec=5s
Restart=on-failure
RestartSec=5
# CONFIG-validation failures exit 78 (EX_CONFIG) and must stay off the restart
# ladder: a persistent bad config would otherwise climb the burst into the
# reboot above. ExecStopPost gives exit 78 one bounded audio-hardware
# reconcile + explicit retry for transient DAC hotplug shear; a second 78
# leaves the unit parked on the helper's marker, visible on /state + doctor.
# See ADR-0141. Recovery after a persistent park: fix the env, then
# `systemctl restart jasper-outputd`.
RestartPreventExitStatus=78

# Above Camilla (-900): this owns the DAC write loop.
OOMScoreAdjust=-950
Slice=jts-audio.slice
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=35

# SIGXCPU bound on an RT thread that runs without blocking: at the chain's
# highest FIFO priority a spin here is the most likely to starve PID 1 and
# trip the hardware watchdog into a reboot. Carried by every FIFO unit
# (camilla/fanin/outputd).
LimitRTTIME=200000

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/lib/jasper /run/jasper-outputd
# outputd stays root (it owns the DAC write loop) but joins the `jasper` group
# with UMask=0007 so its tts.sock is created root:jasper 0770 — connect()
# needs WRITE permission, so a umask-derived 0755 lets only root connect.
# RuntimeDirectoryMode=0750 (root:jasper) lets the group traverse.
Group=jasper
UMask=0007
RuntimeDirectory=jasper-outputd
RuntimeDirectoryPreserve=restart
RuntimeDirectoryMode=0750

EnvironmentFile=/etc/jasper/jasper.env
Environment="JASPER_OUTPUTD_BACKEND=alsa"
Environment="JASPER_OUTPUTD_DAC_PCM=outputd_dac"
# NO Environment= FOR JASPER_OUTPUTD_PERIOD_FRAMES / _DAC_BUFFER_FRAMES: a
# literal here wins over /etc/jasper/jasper.env above it (later line wins),
# shadowing the documented operator seam. Absent, outputd resolves both against
# its own compile-time defaults (rust/jasper-outputd/src/config.rs), which is
# the bottom layer jasper.audio_runtime_plan models.
# JASPER_OUTPUTD_CONTENT_BRIDGE is deliberately UNSET: undeclared IS the one
# transport (ADR-0100).
Environment="JASPER_OUTPUTD_CONTROL_SOCKET=/run/jasper-outputd/control.sock"
# Operator retune file, written by the audio-hardware reconciler. Keep it after
# /etc/jasper/jasper.env so a reconciler-derived DAC floor wins over a hand-set
# one — the precedence jasper.audio_runtime_plan models.
EnvironmentFile=-/var/lib/jasper/outputd.env
# Wake-corpus test mode can temporarily enable the XVF USB-IN reference fanout
# and outputd's UDP reference tap. Keep it after operator retunes so
# entering/leaving corpus mode is reversible.
EnvironmentFile=-/var/lib/jasper/wake_corpus_bridge.env
# Written ONLY by jasper-grouping-reconcile:
# JASPER_OUTPUTD_DAC_CONTENT_LANE + _CHANNEL arm the dac_content reader onto
# the dac-content RETURN ring and pin this speaker's channel. PERSISTENT (not
# /run) so a bonded speaker boots with the lane already configured. Empty
# values (written on disband) read as unset: the byte-identical solo DAC loop.
# Last env layer on purpose: the reconciler's derived state must win.
EnvironmentFile=-/var/lib/jasper/grouping-outputd.env
# If the resolved final-output card disappeared, skip the start before the main
# process opens ALSA. The fake backend opens no card, so it must pass this
# gate. ExecCondition exit 1 parks the unit inactive without consuming
# Restart=on-failure/StartLimitAction; the audio-hardware udev reconciler
# reset-failed+starts outputd when a recognized DAC role returns. Camilla is
# not gated here: it writes only to Ring B, never to a DAC.
ExecCondition=/bin/sh -c 'backend="$${JASPER_OUTPUTD_BACKEND:-alsa}"; card="$${JASPER_AUDIO_DAC_CARD:-}"; id="$${JASPER_AUDIO_DAC_ID:-unknown}"; if [ "$$backend" = "fake" ] || [ -z "$$card" ] || [ -e "/proc/asound/$$card" ]; then exit 0; fi; echo "event=outputd.output_device_gate.park reason=missing_dac output_dac_id=$$id output_dac_card=$$card outputd_backend=$$backend" >&2; exit 1'
# Refresh the output-hardware env before systemd's Restart=on-failure retry.
# The helper skips normal stops and ExecCondition parks, and reconciles at most
# once per short window across every failure class so a crash loop cannot spawn
# a reconciler pass per restart. Its --no-restart keeps that reconciler from
# controlling jasper-outputd from inside this unit's stop transaction.
ExecStopPost=-/usr/local/sbin/jasper-outputd-failure-reconcile
ExecStart=/opt/jasper/bin/jasper-outputd
# Retire the helper's park record. Type=notify, so this runs only once outputd
# has sent READY=1 — a start attempt that exits 78 again never reaches it and
# the record stands. jasper-outputd-unpark copies the record's fields plus
# unparked_at to a .last sibling before removing it (R15, #4416).
ExecStartPost=-/usr/local/sbin/jasper-outputd-unpark

[Install]
WantedBy=multi-user.target
