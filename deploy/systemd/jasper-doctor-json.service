[Unit]
Description=Capture jasper-doctor --json for the /system dashboard (root fidelity)
# Root, because jasper-doctor runs aplay/amixer probes, reads the journal, and
# `sudo -u <renderer> aplay`; run as the non-root jasper-control instead, ~7
# hardware checks fail on permissions and the dashboard shows false red.
After=jasper-control.service

[Service]
Type=oneshot
# Group=jasper so the result file — written into jasper-control's /run dir —
# is group-readable by the non-root jasper-control without being
# world-readable (the doctor JSON can name configured subsystems).
Group=jasper
# ~175 checks at concurrency 8 with a 15 s per-check ceiling. Without a bound,
# a wedged probe leaves the oneshot activating forever.
TimeoutStartSec=300
# `--out` makes the doctor exit 0 even when checks fail (the failures are in
# the JSON), so a "report with failures" never flips this unit to `failed`.
ExecStart=/opt/jasper/.venv/bin/jasper-doctor --json --out /run/jasper-control/doctor-result.json
StandardOutput=journal
StandardError=journal
# Started on demand by /system/diagnostics, never enabled — hence no [Install].
