#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Refresh output-hardware state after jasper-outputd fails, so the next
# Restart=on-failure attempt reads current config rather than the stale DAC env
# it died on. Runs from jasper-outputd.service ExecStopPost.
#
# At most one reconcile per window across every failure class: a reconciler pass
# costs a dozen-plus Python interpreters, and outputd restarts on failure into
# StartLimitAction=reboot, so a crash loop must not multiply it. Exit 78 keeps
# its ADR-0141 reconcile + no-block retry, sharing that one stamp: a repeated
# exit 78 inside a window another class already spent also parks without
# retry here, relying on the separate udev-triggered reconcile (untouched by
# this stamp) to pick up a real hardware change.
# Fail-open: always exits 0.

set -uo pipefail

RESULT="${SERVICE_RESULT:-unknown}"
STATUS="${EXIT_STATUS:-}"
RECONCILE="${JASPER_AUDIO_HARDWARE_RECONCILE:-/usr/local/sbin/jasper-audio-hardware-reconcile}"
SYSTEMCTL="${JASPER_SYSTEMCTL:-systemctl}"
CONFIG_EXIT_STATUS=78
# Remove this bound once jasper-audio-hardware-reconcile runs as one
# interpreter instead of a dozen-plus.
# Deliberately OUTSIDE RuntimeDirectory=jasper-outputd: systemd removes that
# directory when the unit stops without a restart — exactly the park this
# stamp must survive, or the 300s dedup never fires and a park-then-restart
# retries unboundedly.
RECONCILE_STAMP="${JASPER_OUTPUTD_CONFIG_RETRY_STATE:-/run/jasper-outputd-failure-reconcile.stamp}"
RECONCILE_WINDOW_SEC="${JASPER_OUTPUTD_CONFIG_RETRY_WINDOW_SEC:-300}"
# Deliberately OUTSIDE RuntimeDirectory=jasper-outputd: systemd removes that
# directory when the unit stops without a restart, which is exactly the park
# this record reports. jasper-outputd.service's ExecStartPost removes it when
# outputd next reaches READY; jasper/outputd_failure_reconcile_state.py reads it.
PARK_RECORD="${JASPER_OUTPUTD_RECONCILE_PARK_STATE:-/run/jasper-outputd-failure-reconcile.park}"

log() {
    local outcome="$1"
    shift || true
    echo "event=outputd.failure_reconcile.${outcome} result=${RESULT} exit_status=${STATUS:-none} ${*}" >&2
}

now_sec() {
    date +%s
}

reconcile_recent() {
    local last age
    last="$(cat "$RECONCILE_STAMP" 2>/dev/null || true)"
    [[ "$last" =~ ^[0-9]+$ ]] || return 1
    age=$(($(now_sec) - last))
    [[ "$age" -ge 0 && "$age" -lt "$RECONCILE_WINDOW_SEC" ]]
}

mark_reconcile() {
    mkdir -p "$(dirname "$RECONCILE_STAMP")" 2>/dev/null || true
    now_sec > "$RECONCILE_STAMP" 2>/dev/null || true
}

# Exit 78 is held by RestartPreventExitStatus=, so a pass that hands it no
# retry leaves the unit parked with nothing to bring it back. Only this script
# knows which of its branches did that, so it records the park rather than
# leaving a reader to infer one from the dedup stamp.
park_if_config() {
    [[ "$STATUS" == "$CONFIG_EXIT_STATUS" ]] || return 0
    local tmp="${PARK_RECORD}.tmp.$$"
    # tempfile+rename so a reader never sees a truncated record.
    {
        printf 'parked_at=%s\n' "$(now_sec)"
        printf 'exit_status=%s\n' "$STATUS"
        printf 'reason=%s\n' "$1"
    } >"$tmp" 2>/dev/null || true
    mv -f "$tmp" "$PARK_RECORD" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
    log park reason="$1" state="$PARK_RECORD"
}

# `exec-condition` is systemd's own SERVICE_RESULT spelling for an
# ExecCondition skip (systemd.service(5) $SERVICE_RESULT).
if [[ "$RESULT" == "success" || "$RESULT" == "exec-condition" ]]; then
    log skip reason=non_retrying_stop
    exit 0
fi

if [[ ! -x "$RECONCILE" ]]; then
    log skip reason=reconciler_unavailable path="$RECONCILE"
    park_if_config reconciler_unavailable
    exit 0
fi

if reconcile_recent; then
    log skip reason=recent state="$RECONCILE_STAMP"
    park_if_config recent
    exit 0
fi
# Stamp before reconciling: a pass that is itself killed still spends the window.
mark_reconcile

if [[ "$STATUS" == "$CONFIG_EXIT_STATUS" ]]; then
    if "$RECONCILE" --reason outputd-config-failure --no-restart; then
        "$SYSTEMCTL" reset-failed jasper-outputd.service >/dev/null 2>&1 || true
        "$SYSTEMCTL" --no-block restart jasper-outputd.service >/dev/null 2>&1 || true
        log retry reason=config_reconciled state="$RECONCILE_STAMP"
    else
        rc=$?
        log failed reason=config_reconciler_nonzero rc="$rc" state="$RECONCILE_STAMP"
        park_if_config config_reconciler_nonzero
    fi
    exit 0
fi

if "$RECONCILE" --reason outputd-failure --no-restart; then
    log ok reason=reconciled
else
    rc=$?
    log failed reason=reconciler_nonzero rc="$rc"
fi

exit 0
