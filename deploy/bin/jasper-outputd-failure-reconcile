#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Refresh output-hardware state after jasper-outputd fails.
#
# Runs from jasper-outputd.service ExecStopPost. A dual-Apple child DAC can
# disappear while the saved env still names its ALSA PCM; outputd then fails
# before systemd restarts it. Reconcile here with --no-restart so the next
# built-in Restart=on-failure attempt reads the current single-DAC/fake env
# instead of replaying stale dual-DAC config.
#
# Config exits (78) normally park the unit. One observed hotplug class can be
# repaired by the same reconcile after the USB DAC settles, so this helper gives
# exit 78 one bounded reconcile + retry per short window. Persistent bad config
# still parks instead of crash-looping into StartLimitAction=reboot. This helper
# is deliberately fail-open and always exits 0.
#
# A content-lane open failure is a different shape: exit 1, restart class, and
# deliberately so. On boot and on a width-flip deploy it means CamillaDSP has
# not yet opened its half of the snd-aloop pair, and restarting is how outputd
# waits that out (category A — see `FinalSinkStartupConfigError`'s doc comment
# in rust/jasper-outputd/src/alsa_backend.rs for why marking that open
# park-class would turn a routine wait into a silent speaker). The SAME failure
# is permanent when the peer is locked at a different width or the env drifted
# (category B): every retry fails identically and the unit rides
# Restart=on-failure into StartLimitAction=reboot. The two are one signature
# apart only by COUNT, so this helper counts consecutive content-lane failures
# and parks the unit out-of-band once the count says the lane is not opening.
# That park is TERMINAL for the boot: nothing re-arms outputd on its own. It
# comes back on a sound-card udev event (jasper-audio-hardware-reconcile does
# reset-failed + start), a deploy, jasper-camilla-recover's OnFailure pass, a
# reboot (/run wipes, so the streak is per-boot too), or an operator restart.
# The record names those paths so the operator does not have to know them.

set -uo pipefail

RESULT="${SERVICE_RESULT:-unknown}"
STATUS="${EXIT_STATUS:-}"
RECONCILE="${JASPER_AUDIO_HARDWARE_RECONCILE:-/usr/local/sbin/jasper-audio-hardware-reconcile}"
SYSTEMCTL="${JASPER_SYSTEMCTL:-systemctl}"
JOURNALCTL="${JASPER_JOURNALCTL:-journalctl}"
CONFIG_EXIT_STATUS=78
CONFIG_RETRY_STATE="${JASPER_OUTPUTD_CONFIG_RETRY_STATE:-/run/jasper-outputd/config-retry.stamp}"
CONFIG_RETRY_WINDOW_SEC="${JASPER_OUTPUTD_CONFIG_RETRY_WINDOW_SEC:-300}"

# Streak record for the content-lane park. A plain /run file, NOT
# jasper-outputd's RuntimeDirectory: the count has to survive the unit's own
# auto-restarts AND the park record has to outlive the stop that ends them,
# which a RuntimeDirectory (reaped when its unit stops) cannot do. /run still
# wipes it at boot, so a fresh boot re-derives the verdict instead of
# inheriting one.
CONTENT_LANE_STATE="${JASPER_OUTPUTD_CONTENT_LANE_STATE:-/run/jasper-outputd-content-lane.state}"
CONTENT_LANE_WINDOW_SEC="${JASPER_OUTPUTD_CONTENT_LANE_WINDOW_SEC:-300}"

# Park on the 4th consecutive content-lane failure. Two bounds fix the number:
#
#   Ceiling — jasper-outputd.service allows StartLimitBurst=5 starts per
#   StartLimitIntervalSec=300 and the 6th trips StartLimitAction=reboot, so the
#   park has to land by failure 5. Parking on 4 leaves start 5 unspent: a stop
#   job that lands late still beats the reboot.
#
#   Floor — 4 failures at RestartSec=5 is ~15 s of an unopenable lane across
#   four independent attempts, each of which already had a
#   jasper-audio-hardware-reconcile pass in front of it. What has to fit inside
#   that 15 s is the peer's arrival, and the peer is NOT gated on outputd
#   alone: jasper-camilla.service is
#   After=sound.target network.target jasper-outputd.service jasper-fanin.service,
#   so its start job waits on the LAST of the four. jasper-fanin is Type=notify
#   with no TimeoutStartSec, so it can hold that gate for the systemd default
#   (90 s) while it brings up its PCMs and STATUS. The honest margin is
#   therefore fan-in readiness plus CamillaDSP's own device open, and a fan-in
#   stall past ~20 s parks a box that a category-A transient built. That is a
#   bounded, recoverable regression and not a new one: the same stall
#   exhausted outputd's StartLimitBurst before this helper existed, and the
#   outcome there was a REBOOT. The deploy path is the easy case — it does not
#   produce the wait at all, since
#   release_camilla_content_lane_for_format_flip
#   (deploy/lib/install/systemd-units.sh) stops CamillaDSP only when the width
#   actually moves and outputd then opens first and locks the pair.
CONTENT_LANE_PARK_AFTER="${JASPER_OUTPUTD_CONTENT_LANE_PARK_AFTER:-4}"
CONTENT_LANE_JOURNAL_LINES="${JASPER_OUTPUTD_CONTENT_LANE_JOURNAL_LINES:-40}"

# Every context string outputd attaches to a content-lane open, from both
# AlsaBackend openers in rust/jasper-outputd/src/alsa_backend.rs (the
# single-ALSA lane and its composite `active_content` sibling).
# tests/test_output_recovery_scripts.py reads the strings back out of that file,
# so a reworded context cannot silently stop matching here.
CONTENT_LANE_SIGNATURE='(opening|configuring) outputd (active )?content capture PCM|starting capture PCM'

log() {
    local outcome="$1"
    shift || true
    echo "event=outputd.failure_reconcile.${outcome} result=${RESULT} exit_status=${STATUS:-none} ${*}" >&2
}

now_sec() {
    date +%s
}

config_retry_recent() {
    local last now age
    [[ -f "$CONFIG_RETRY_STATE" ]] || return 1
    last="$(cat "$CONFIG_RETRY_STATE" 2>/dev/null || true)"
    [[ "$last" =~ ^[0-9]+$ ]] || return 1
    now="$(now_sec)"
    age=$((now - last))
    [[ "$age" -ge 0 && "$age" -lt "$CONFIG_RETRY_WINDOW_SEC" ]]
}

mark_config_retry() {
    local dir
    dir="$(dirname "$CONFIG_RETRY_STATE")"
    mkdir -p "$dir" 2>/dev/null || true
    now_sec > "$CONFIG_RETRY_STATE" 2>/dev/null || true
}

journal_tail() {
    local -a cmd
    cmd=("$JOURNALCTL" --no-pager --output=cat --lines="$CONTENT_LANE_JOURNAL_LINES")
    if [[ -n "${INVOCATION_ID:-}" ]]; then
        # systemd exports the dying invocation's id to ExecStopPost, which
        # scopes the read to exactly the run that just failed.
        cmd+=("_SYSTEMD_INVOCATION_ID=${INVOCATION_ID}")
    else
        cmd+=(--unit=jasper-outputd.service --since="2 minutes ago")
    fi
    "${cmd[@]}" 2>/dev/null || true
}

content_lane_failure() {
    # An unreadable journal reads as NOT a content-lane failure. The safe
    # direction is the existing restart ladder: a park this helper cannot
    # justify from evidence is a silent speaker.
    local tail
    [[ "$STATUS" == "1" ]] || return 1
    tail="$(journal_tail)"
    [[ "$tail" =~ $CONTENT_LANE_SIGNATURE ]]
}

content_lane_streak() {
    # Echo the live consecutive-failure count, 0 when there is none. A record
    # older than the window is not a streak: outputd stayed up long enough in
    # between that these are separate events, not one lane that will not open.
    local key value count epoch now age
    count=""
    epoch=""
    if [[ -f "$CONTENT_LANE_STATE" ]]; then
        while IFS='=' read -r key value; do
            case "$key" in
                count) count="$value" ;;
                last_failure_epoch) epoch="$value" ;;
            esac
        done < "$CONTENT_LANE_STATE"
    fi
    if [[ ! "$count" =~ ^[0-9]+$ || ! "$epoch" =~ ^[0-9]+$ ]]; then
        echo 0
        return 0
    fi
    now="$(now_sec)"
    age=$((now - epoch))
    if [[ "$age" -lt 0 || "$age" -ge "$CONTENT_LANE_WINDOW_SEC" ]]; then
        echo 0
        return 0
    fi
    echo "$count"
}

# The one remediation sentence, written to the record AND the journal line so
# neither surface sends an operator to the other to learn what to do.
CONTENT_LANE_ACTION="match the content-lane width on both halves of the pair (JASPER_OUTPUTD_CONTENT_FORMAT against the CamillaDSP playback half), then: systemctl restart jasper-outputd"

write_content_lane_state() {
    local count="$1"
    shift || true
    local dir line tmp
    dir="$(dirname "$CONTENT_LANE_STATE")"
    mkdir -p "$dir" 2>/dev/null || true
    # tempfile+rename: a reader never sees a truncated record, and the park's
    # full record replaces the count-only one in one step.
    tmp="${CONTENT_LANE_STATE}.tmp.$$"
    {
        printf 'count=%s\n' "$count"
        printf 'last_failure_epoch=%s\n' "$(now_sec)"
        for line in "$@"; do
            printf '%s\n' "$line"
        done
    } > "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$CONTENT_LANE_STATE" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
}

clear_content_lane_state() {
    rm -f "$CONTENT_LANE_STATE" 2>/dev/null || true
}

park_content_lane() {
    local count="$1"
    write_content_lane_state "$count" \
        "parked_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "reason=content_lane_open_repeated" \
        "detail=jasper-outputd could not open its snd-aloop content lane on ${count} consecutive starts" \
        "action=${CONTENT_LANE_ACTION}" \
        "re_arm=nothing re-arms outputd on its own: a sound-card udev event (jasper-audio-hardware-reconcile), a deploy, jasper-camilla-recover's OnFailure pass, a reboot, or an operator restart"
    # reset-failed clears the start rate-limit counter so the recovery restart
    # is start 1 of a fresh burst rather than start 5 of the one this park
    # interrupted; stop cancels the pending Restart=on-failure. Re-runs on every
    # later failure of the same streak, so a stop job that never landed is
    # retried instead of silently lost.
    #
    # That retry has no escalation ceiling, deliberately. Each iteration is
    # bounded (one reconcile, two systemctl calls, one journal line) and loud,
    # but if an external actor keeps starting outputd into the same broken
    # width the pair repeats indefinitely — there is no machinery here that
    # gives up. The alternative, a helper that stops trying, would be a silent
    # speaker with no record of why.
    "$SYSTEMCTL" reset-failed jasper-outputd.service >/dev/null 2>&1 || true
    "$SYSTEMCTL" --no-block stop jasper-outputd.service >/dev/null 2>&1 || true
    log park reason=content_lane_open_repeated failures="$count" \
        park_after="$CONTENT_LANE_PARK_AFTER" state="$CONTENT_LANE_STATE" \
        action="\"${CONTENT_LANE_ACTION}\""
}

# `exec-condition` is systemd's own SERVICE_RESULT spelling for an
# ExecCondition skip (systemd.service(5) $SERVICE_RESULT). This read `condition`
# until 2026-08-08, which matched nothing, so an ExecCondition park fell through
# to the reconcile path it was written to skip.
if [[ "$RESULT" == "success" || "$RESULT" == "exec-condition" ]]; then
    clear_content_lane_state
    log skip reason=non_retrying_stop
    exit 0
fi

if [[ ! -x "$RECONCILE" ]]; then
    log skip reason=reconciler_unavailable path="$RECONCILE"
    exit 0
fi

if [[ "$STATUS" == "$CONFIG_EXIT_STATUS" ]]; then
    # An EX_CONFIG park is not a content-lane open failure, so it breaks any
    # streak in progress.
    clear_content_lane_state
    if config_retry_recent; then
        log skip reason=config_retry_already_attempted state="$CONFIG_RETRY_STATE"
        exit 0
    fi
    mark_config_retry
    if "$RECONCILE" --reason outputd-config-failure --no-restart; then
        "$SYSTEMCTL" reset-failed jasper-outputd.service >/dev/null 2>&1 || true
        "$SYSTEMCTL" --no-block restart jasper-outputd.service >/dev/null 2>&1 || true
        log retry reason=config_reconciled state="$CONFIG_RETRY_STATE"
    else
        rc=$?
        log failed reason=config_reconciler_nonzero rc="$rc" state="$CONFIG_RETRY_STATE"
    fi
    exit 0
fi

if content_lane_failure; then
    content_lane_failures=$(( $(content_lane_streak) + 1 ))
    if [[ "$content_lane_failures" -lt "$CONTENT_LANE_PARK_AFTER" ]]; then
        # Below the bound this is the only writer. At or above it, the park is —
        # a count-only write here would drop the reason/action fields of an
        # earlier park for as long as the reconcile below runs.
        write_content_lane_state "$content_lane_failures"
    fi
else
    content_lane_failures=0
    clear_content_lane_state
fi

# The reconcile runs first even on the failure that parks: it is what refreshes
# JASPER_OUTPUTD_CONTENT_FORMAT, so it gets its last chance at repairing the
# width before the unit stops. By the park it has already had that chance on
# every earlier failure of the streak.
if "$RECONCILE" --reason outputd-failure --no-restart; then
    log ok reason=reconciled content_lane_failures="$content_lane_failures"
else
    rc=$?
    log failed reason=reconciler_nonzero rc="$rc" \
        content_lane_failures="$content_lane_failures"
fi

if [[ "$content_lane_failures" -ge "$CONTENT_LANE_PARK_AFTER" ]]; then
    park_content_lane "$content_lane_failures"
fi

exit 0
