#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Reconcile JTS output-DAC role with the ALSA hardware currently present.
#
# This is the output-hardware counterpart to jasper-aec-reconcile:
# run once at install/boot, and run again from udev on sound-card
# add/remove/change. It is intentionally small and idempotent.

set -euo pipefail

ENV_FILE="${JASPER_ENV_FILE:-/etc/jasper/jasper.env}"
OUTPUTD_ENV_FILE="${JASPER_OUTPUTD_ENV_FILE:-/var/lib/jasper/outputd.env}"
OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_FILE"
OUTPUTD_ENV_STAGE_REJECTED=0
OUTPUTD_ENV_STAGE_FILE=""
FANIN_ENV_FILE="${JASPER_FANIN_ENV_FILE:-/var/lib/jasper/fanin.env}"
ASOUND_SOURCE_TEMPLATE="${JASPER_ASOUND_SOURCE_TEMPLATE:-/etc/jasper/asoundrc.jasper.source}"
ASOUND_TEMPLATE="${JASPER_ASOUND_TEMPLATE:-/etc/jasper/asoundrc.jasper.template}"
RENDER_ASOUND_CONF="${JASPER_RENDER_ASOUND_CONF:-/usr/local/sbin/jasper-render-asound-conf}"
SYSTEMCTL="${JASPER_SYSTEMCTL:-systemctl}"
APLAY="${JASPER_APLAY:-aplay}"
DEFAULT_OUTPUT_HARDWARE_PYTHON="python3"
if [[ -x /opt/jasper/.venv/bin/python ]]; then
    DEFAULT_OUTPUT_HARDWARE_PYTHON="/opt/jasper/.venv/bin/python"
fi
OUTPUT_HARDWARE_PYTHON="${JASPER_OUTPUT_HARDWARE_PYTHON:-$DEFAULT_OUTPUT_HARDWARE_PYTHON}"
DEFAULT_OUTPUTD_PLAYBACK_DEVICE="outputd_content_playback"
# The ACTIVE RING's playback PCM — the ONE legal active endpoint. This shell
# never CHOOSES it; the Python active-lane decision reports which endpoint the
# live graph targets, and this literal is only how the shell recognizes that
# answer. Mirrors jasper.fanin_coupling.RING_ACTIVE_PLAYBACK_DEVICE and the
# conf.d block name; pinned equal by tests/test_ring_active_endpoint.py.
RING_ACTIVE_OUTPUTD_PLAYBACK_DEVICE="jts_ring_active_playback"
DEFAULT_OUTPUTD_CAPTURE_DEVICE=""
OUTPUT_HARDWARE_STATE_PATH="${JASPER_OUTPUT_HARDWARE_STATE_PATH:-/run/jasper-output-hardware/output_hardware.json}"
I2S_HAT_INTENT_FILE="${JASPER_I2S_HAT_INTENT_FILE:-/var/lib/jasper/i2s_hat.env}"
I2S_HAT_REBOOT_REQUIRED_PATH="${JASPER_I2S_HAT_REBOOT_REQUIRED_PATH:-/run/jasper-output-hardware/i2s-hat-reboot-required}"
MANAGEMENT_TRANSPORT_MARKER="${OUTPUT_HARDWARE_STATE_PATH%/*}/management-transport.ok"
INSTALL_PROFILE_FILE="${JASPER_INSTALL_PROFILE_FILE:-/var/lib/jasper/install_profile}"
OUTPUT_TOPOLOGY_PATH="${JASPER_OUTPUT_TOPOLOGY_PATH:-/var/lib/jasper/output_topology.json}"
CAMILLA_STATEFILE="${JASPER_CAMILLA_STATEFILE:-/var/lib/camilladsp/outputd-statefile.yml}"
CAMILLA_CONF_DIR="${JASPER_CAMILLA_CONF_DIR:-/etc/camilladsp}"
JASPER_SOUND_CLI="${JASPER_SOUND_CLI:-/opt/jasper/.venv/bin/jasper-sound}"
JASPER_ACTIVE_SPEAKER_CLI="${JASPER_ACTIVE_SPEAKER_CLI:-/opt/jasper/.venv/bin/jasper-active-speaker}"
CAMILLA2_STATEFILE="${JASPER_CAMILLA2_STATEFILE:-/var/lib/camilladsp/crossover-statefile.yml}"
# The board facts the pass's Python helpers read. Same env seams the unit unsets.
PROC_ASOUND_DIR="${JASPER_PROC_ASOUND:-/proc/asound}"
PI_MODEL_FILE="${JASPER_PI_MODEL_FILE:-/proc/device-tree/model}"
BOOT_CONFIG_FILE="${JTS_BOOT_CONFIG_FILE:-/boot/firmware/config.txt}"
UDC_CLASS_DIR="${JASPER_UDC_CLASS_DIR:-/sys/class/udc}"
# In the tmpfs directory OUTPUT_HARDWARE_STATE_PATH lives in, so a reboot always
# clears it and the first pass after boot is a full one.
RECONCILE_STAMP_PATH="${OUTPUT_HARDWARE_STATE_PATH%/*}/reconcile.stamp"
RECONCILE_DEGRADED_MARKER="${OUTPUT_HARDWARE_STATE_PATH%/*}/reconcile.degraded"

# A probe this pass could not run leaves an owned value unwritten, so the state
# it produced is not one a later call may skip against -- an operator following
# a doctor remedy ("start jasper-audio-hardware-reconcile so the key is
# rendered") must get a real pass. A marker file rather than a variable: most of
# these guards run inside command substitutions, where an assignment would die
# with the subshell.
reconcile_probe_missing() {
    command -v "$1" >/dev/null 2>&1 && return 1
    : >"$RECONCILE_DEGRADED_MARKER" 2>/dev/null || true
    return 0
}

# What the box tells us and this script never writes. Split out of the list
# below only so write_reconcile_stamp can re-check it: a card that appeared or
# vanished DURING a pass was not reconciled by that pass.
#
# cards+pcm are a PROXY for the `$APLAY -L` view the pass actually enumerates
# from, not the same thing: they move on a card add/remove and on a PCM-device
# change, but two cards whose lines and device lists are identical hash equal.
reconcile_observed_paths() {
    printf '%s\n' \
        "$PROC_ASOUND_DIR/cards" \
        "$PROC_ASOUND_DIR/pcm" \
        "$PI_MODEL_FILE" \
        "$UDC_CLASS_DIR"
}

# SINGLE SOURCE OF TRUTH for the files a pass depends on. The stamp itself is
# deliberately absent: hashing it would make the fingerprint self-referential.
# asound.conf and the ring conf.d are absent because each is re-derived from
# entries that ARE listed, and naming them here would fork a path constant
# owned by jasper-render-asound-conf and jasper.ring_assets.
reconcile_input_paths() {
    reconcile_observed_paths
    printf '%s\n' \
        "$ENV_FILE" \
        "$OUTPUTD_ENV_FILE" \
        "$FANIN_ENV_FILE" \
        "$ASOUND_SOURCE_TEMPLATE" \
        "$ASOUND_TEMPLATE" \
        "$I2S_HAT_INTENT_FILE" \
        "$I2S_HAT_REBOOT_REQUIRED_PATH" \
        "$MANAGEMENT_TRANSPORT_MARKER" \
        "$INSTALL_PROFILE_FILE" \
        "$OUTPUT_TOPOLOGY_PATH" \
        "$OUTPUT_HARDWARE_STATE_PATH" \
        "$CAMILLA_STATEFILE" \
        "$CAMILLA2_STATEFILE" \
        "$CAMILLA_CONF_DIR" \
        "$BOOT_CONFIG_FILE"
}

# The hermetic tests run this script on the developer laptop, where macOS
# ships shasum and no sha256sum.
reconcile_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum
    else
        shasum -a 256
    fi | cut -d ' ' -f 1
}

# A deterministic byte stream for the paths read on stdin. Content, not mtime:
# several inputs are rewritten byte-identically by every pass (and
# $CAMILLA_CONF_DIR holds a lock file that is touched constantly), so a
# timestamp term would never settle and nothing would ever skip. A directory
# contributes the names one level down plus the contents of the regular files
# there -- enough for $CAMILLA_CONF_DIR's configs and $UDC_CLASS_DIR's links,
# and it never descends into sysfs.
reconcile_path_bytes() {
    local path entry
    while IFS= read -r path; do
        printf '\n>>> %s\n' "$path"
        if [[ -d "$path" ]]; then
            while IFS= read -r entry; do
                printf -- '--- %s\n' "${entry##*/}"
                if [[ -f "$entry" ]]; then
                    cat -- "$entry" 2>/dev/null || true
                fi
            done < <(find "$path" -mindepth 1 -maxdepth 1 2>/dev/null | LC_ALL=C sort)
        elif [[ -e "$path" ]]; then
            cat -- "$path" 2>/dev/null || true
        else
            printf 'absent\n'
        fi
    done
}

reconcile_observed_digest() {
    reconcile_observed_paths | reconcile_path_bytes | reconcile_sha256
}

reconcile_fingerprint() {
    reconcile_input_paths | reconcile_path_bytes | reconcile_sha256
}

# Fingerprinted AFTER this pass's own writes, so the next call over an
# untouched box hashes equal and skips. --no-restart is excluded: it leaves
# units deliberately un-reconciled, so it is not a state a later call may skip
# against. Never fails the pass. Deleting this file forces a full pass.
write_reconcile_stamp() {
    local fingerprint=""
    [[ "$NO_RESTART" != "1" ]] || return 0
    [[ -d "${RECONCILE_STAMP_PATH%/*}" ]] || return 0
    if [[ -e "$RECONCILE_DEGRADED_MARKER" ]]; then
        log_event "stamp_skipped" "reason=probe_unavailable"
        return 0
    fi
    # A card that appeared or vanished mid-pass was not reconciled by this pass,
    # and no second pass is queued for it: udev's start merges into this
    # already-activating oneshot. Stamping would make that staleness stick.
    if [[ "$(reconcile_observed_digest)" != "$OBSERVED_AT_PASS_START" ]]; then
        log_event "stamp_skipped" "reason=hardware_moved_mid_pass"
        return 0
    fi
    fingerprint="$(reconcile_fingerprint 2>/dev/null)" || return 0
    [[ -n "$fingerprint" ]] || return 0
    printf '%s\n' "$fingerprint" >"$RECONCILE_STAMP_PATH" 2>/dev/null || return 0
    return 0
}
REASON="manual"
PRINT_ENV=0
NO_RESTART=0
CHECK_CHANGED=0
OBSERVED_AT_PASS_START=""
I2S_HAT_DESIRED_PROFILE=""
I2S_HAT_BOOT_CHANGED=""
I2S_HAT_APPLY_ERROR=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ASOUND_RENDER_LIB="${JASPER_ASOUND_RENDER_LIB:-}"
ENV_FILE_LIB="${JASPER_ENV_FILE_LIB:-}"

# Shared quoting helper (jasper_env_quote_value) — single
# implementation for both reconcilers so the PR #534 bash-%q
# comma-corruption bug class cannot fork again.
# SCRIPT_DIR-relative sibling first, installed path as fallback:
# install.sh runs THIS script from the repo mid-install (install_alsa's
# --print-env) BEFORE install_systemd_units refreshes /usr/local/lib,
# so installed-first could pair the new script with a stale lib.
# Sibling-first keeps script and lib versions in lockstep; the
# installed copy under /usr/local/sbin has no ../lib sibling and falls
# through to the installed lib. load_asound_render_lib below matches
# this order for the same reason: the mid-install --print-env run does
# call into that lib too (apply_observed_composite_policy).
load_env_file_lib() {
    if [[ -z "$ENV_FILE_LIB" ]]; then
        if [[ -r "${SCRIPT_DIR}/../lib/jasper-env-file.sh" ]]; then
            ENV_FILE_LIB="${SCRIPT_DIR}/../lib/jasper-env-file.sh"
        else
            ENV_FILE_LIB="/usr/local/lib/jasper/jasper-env-file.sh"
        fi
    fi
    if [[ ! -r "$ENV_FILE_LIB" ]]; then
        echo "jasper-audio-hardware-reconcile: missing env-file library: ${ENV_FILE_LIB}" >&2
        exit 66
    fi
    # shellcheck disable=SC1090
    source "$ENV_FILE_LIB"
}

load_asound_render_lib() {
    if [[ -z "$ASOUND_RENDER_LIB" ]]; then
        if [[ -r "${SCRIPT_DIR}/../lib/jasper-asound-render.sh" ]]; then
            ASOUND_RENDER_LIB="${SCRIPT_DIR}/../lib/jasper-asound-render.sh"
        else
            ASOUND_RENDER_LIB="/usr/local/lib/jasper/jasper-asound-render.sh"
        fi
    fi
    if [[ ! -r "$ASOUND_RENDER_LIB" ]]; then
        echo "jasper-audio-hardware-reconcile: missing asound render library: ${ASOUND_RENDER_LIB}" >&2
        exit 66
    fi
    # The path varies at runtime (in-repo sibling vs installed fallback
    # above), but both resolve to the same library — the directive points
    # at the repo copy so shellcheck can actually analyze it. Outside the
    # repo root the directive degrades to info-level SC1091 ("not
    # following"), below the CI gate's warning severity.
    # shellcheck source=deploy/lib/jasper-asound-render.sh
    source "$ASOUND_RENDER_LIB"
}

usage() {
    cat <<'EOF'
Usage: jasper-audio-hardware-reconcile [--reason TEXT] [--print-env] [--no-restart]
                                       [--changed]

Detect the current final-output DAC role and reconcile owned JTS state:
  - registered single DAC present -> outputd_dac targets it; Apple mixer helpers disabled
  - Apple USB-C dongle present -> outputd_dac targets Apple; Apple helpers enabled
  - no recognized output DAC -> Apple helpers disabled; unknown/fallback id recorded

--print-env prints shell-quoted role variables for install.sh and performs no mutations.
--no-restart updates files/service enablement but does not restart outputd/voice.
--changed performs no mutations: it exits 0 when a pass is needed and 1 when the
  inputs match the stamp the last successful pass left (systemd ExecCondition).
EOF
}

log_event() {
    local name="$1"
    shift
    echo "event=audio_hardware_reconcile.${name} reason=${REASON} $*" >&2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reason)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            REASON="$2"
            shift 2
            ;;
        --print-env)
            PRINT_ENV=1
            shift
            ;;
        --no-restart)
            NO_RESTART=1
            shift
            ;;
        --changed)
            CHECK_CHANGED=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

# systemd ExecCondition semantics are inverted from a plain predicate: exit 0
# runs ExecStart, exit 1..254 skips the unit WITHOUT marking it failed, and 255
# or a signal fails it. So this exits 0 for "changed, run the pass". Every
# unexpected outcome exits 0 too: the pass is idempotent, so one needless run
# costs seconds while one wrongly skipped run leaves the output path stale.
# Deliberately ahead of the library loads -- a broken install must still fail
# loudly in ExecStart rather than be skipped here. REASON is not an input.
if [[ "$CHECK_CHANGED" == "1" ]]; then
    changed_fingerprint="$(reconcile_fingerprint 2>/dev/null)" || changed_fingerprint=""
    changed_stamp=""
    if [[ -f "$RECONCILE_STAMP_PATH" ]]; then
        changed_stamp="$(cat -- "$RECONCILE_STAMP_PATH" 2>/dev/null)" || changed_stamp=""
    fi
    if [[ -n "$changed_fingerprint" && "$changed_fingerprint" == "$changed_stamp" ]]; then
        log_event "skipped" "reason=unchanged fingerprint=${changed_fingerprint:0:8}"
        exit 1
    fi
    changed_fp_token="${changed_fingerprint:0:8}"
    changed_stamp_token="${changed_stamp:0:8}"
    log_event "changed" \
        "fingerprint=${changed_fp_token:-none} stamp=${changed_stamp_token:-none}"
    exit 0
fi

load_env_file_lib
load_asound_render_lib

# Quoting is the shared lib's jasper_env_quote_value (sourced by
# load_env_file_lib above); this thin alias keeps print_env readable.
quote_env_value() {
    jasper_env_quote_value "$1"
}

publish_management_transport_marker() {
    # Read by jasper-usbgadget's composition with `test -e`. In /run so a
    # reboot clears it before the boot config it describes can change.
    # Truncate in place rather than `install`: install unlinks first, and a
    # true->true republish would then leave a window where `test -e` is false.
    local marker="$MANAGEMENT_TRANSPORT_MARKER"
    if [[ "$1" != "true" ]]; then
        rm -f -- "$marker"
        return 0
    fi
    [[ -d "${OUTPUT_HARDWARE_STATE_PATH%/*}" ]] ||
        install -d -m 0755 "${OUTPUT_HARDWARE_STATE_PATH%/*}"
    : > "$marker"
}

observe_output_hardware_state() {
    local should_write="${1:-0}"
    local payload action="observed" write_arg=""
    OBSERVED_OUTPUT_VALID=0
    if [[ "$should_write" == "1" ]]; then
        write_arg="--write"
        action="written"
    fi
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        log_event "state_${action}_skip" "reason=python_unavailable path=${OUTPUT_HARDWARE_STATE_PATH}"
        return 0
    fi
    if ! payload="$(
        JASPER_APLAY="$APLAY" \
        JASPER_OUTPUT_HARDWARE_STATE_PATH="$OUTPUT_HARDWARE_STATE_PATH" \
        JASPER_OUTPUT_TOPOLOGY_PATH="$OUTPUT_TOPOLOGY_PATH" \
        "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.output_hardware --env \
            ${write_arg:+"$write_arg"} 2>/dev/null
    )"; then
        log_event "state_${action}_failed" "path=${OUTPUT_HARDWARE_STATE_PATH}"
        return 0
    fi
    # Every value is shlex-quoted by the emitter (ADR-0235 R2). A payload that
    # evals but omits a key leaves that key at its cleared value, so the two
    # the whole record hangs off are checked before anything reads the rest.
    if ! eval "$payload" ||
        [[ -z "$OBSERVED_OUTPUT_PROFILE_ID" || -z "$OBSERVED_OUTPUT_PROFILE_STATUS" ]]; then
        clear_observed_output_state
        log_event "state_${action}_failed" "reason=invalid_payload path=${OUTPUT_HARDWARE_STATE_PATH}"
        return 0
    fi
    OBSERVED_OUTPUT_VALID=1
    if [[ "$OBSERVED_OUTPUT_RECORD_CHANGED" == "1" ]]; then
        OUTPUT_HARDWARE_RECORD_CHANGED=1
    fi
    if [[ -n "$OBSERVED_OUTPUT_APPLE_CARD_IDS" ]]; then
        DONGLE_CARD="${OBSERVED_OUTPUT_APPLE_CARD_IDS%% *}"
        APPLE_DONGLE_PRESENT=1
        # APPLE_DONGLE_SERVICE_CARD stays "auto": ALSA card ids are not stable
        # across a re-enumeration (a second card with the same id becomes
        # `A_1`), and the mixer units bake this value in at install. Pinning
        # the sampled id freezes a transient name the helpers can never
        # re-resolve.
    fi
    # Never fatal: every other failure in this function logs and returns, and a
    # full /run must not skip the DAC-role policy the caller runs next.
    # --print-env's usage text promises no mutations (should_write=0), which
    # holds regardless of caller; today that spares install.sh's mid-install
    # probe of the PREVIOUS build (#4123) from flipping this gate on a stale
    # verdict.
    if [[ "$should_write" == "1" ]]; then
        publish_management_transport_marker \
            "$OBSERVED_OUTPUT_USB_MANAGEMENT_TRANSPORT_AVAILABLE" || true
    fi
    log_event "state_${action}" \
        "path=${OUTPUT_HARDWARE_STATE_PATH} profile_id=${OBSERVED_OUTPUT_PROFILE_ID:-unknown} status=${OBSERVED_OUTPUT_PROFILE_STATUS:-unknown}"
}

reconcile_i2s_hat_boot() {
    # Declared before the eval, so a payload that omits a key leaves it empty
    # -- the `case` below then exits 66 instead of tripping `set -u`, and an
    # inherited JASPER_BOOT_* from the caller's environment can never stand in.
    local payload
    local JASPER_BOOT_I2S_HAT_CHANGED="" JASPER_BOOT_I2S_HAT_PROFILE=""
    local JASPER_BOOT_BOARD_TOPOLOGY=""
    if payload="$(
        "$OUTPUT_HARDWARE_PYTHON" -m jasper.audio_hardware.usb_port_role \
            --reconcile-boot --env \
            --i2s-hat-intent-file "$I2S_HAT_INTENT_FILE"
    )"; then
        :
    elif [[ "$payload" == *'JASPER_BOOT_CONFIG_PUBLISHED_NOT_DURABLE=true'* ]]; then
        I2S_HAT_APPLY_ERROR=1
    else
        log_event "i2s_hat_apply" "result=error action=preserve_boot_config"
        exit 66
    fi
    # Every value is shlex-quoted by the emitter (ADR-0235 R2).
    eval "$payload" || exit 66
    case "$JASPER_BOOT_I2S_HAT_CHANGED" in true|false) ;; *) exit 66 ;; esac
    I2S_HAT_DESIRED_PROFILE="$JASPER_BOOT_I2S_HAT_PROFILE"
    if [[ "$JASPER_BOOT_BOARD_TOPOLOGY" == "unsupported" ]]; then
        log_event "i2s_hat_apply" "result=unavailable board_topology=unsupported"
        return 0
    fi
    I2S_HAT_BOOT_CHANGED="$JASPER_BOOT_I2S_HAT_CHANGED"
    if [[ "$I2S_HAT_APPLY_ERROR" == "1" ]]; then
        log_event "i2s_hat_apply" "result=error error=boot_config_published_not_durable"
        return 0
    fi
    log_event "i2s_hat_apply" "result=${I2S_HAT_BOOT_CHANGED:-unknown} profile=${I2S_HAT_DESIRED_PROFILE:-none}"
}

sync_i2s_hat_reboot_marker() {
    # State, not edge: install-time reconcile can write the detected HAT's boot
    # line before this service ever runs, so "changed this pass" is false while
    # the kernel still runs the old overlay. The marker tracks desired-vs-
    # observed instead. Any registered I2S profile, not just InnoMaker: a HAT
    # can be the composite's child device rather than the top-level profile_id,
    # so only the DESIRED id needs a child-devices lookup.
    local desired="$I2S_HAT_DESIRED_PROFILE" observed="$OBSERVED_OUTPUT_PROFILE_ID"
    [[ -n "$I2S_HAT_BOOT_CHANGED" && "$OBSERVED_OUTPUT_VALID" == "1" ]] || return 0
    [[ -n "$desired" && " $OBSERVED_OUTPUT_CHILD_DEVICE_IDS " == *" $desired "* ]] &&
        observed="$desired"
    if [[ "$observed" == "$desired" ]]; then
        rm -f -- "$I2S_HAT_REBOOT_REQUIRED_PATH"
        return 0
    fi
    # No HAT desired: whatever DAC is attached is not a pending boot change,
    # so only this pass having cleared the managed block pends a reboot.
    [[ -n "$desired" || "$I2S_HAT_BOOT_CHANGED" == "true" ]] || return 0
    install -d -m 0755 "$(dirname "$I2S_HAT_REBOOT_REQUIRED_PATH")"
    install -m 0644 /dev/null "$I2S_HAT_REBOOT_REQUIRED_PATH"
}

env_file_value_from() {
    local file="$1" key="$2"
    if [[ ! -f "$file" ]]; then
        return 0
    fi
    awk -v key="$key" '
        $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
            value = $0
            sub("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*", "", value)
            found = value
            seen = 1
        }
        END {
            if (seen) {
                print found
            }
        }
    ' "$file" \
        | sed -E "s/^[[:space:]]+//; s/[[:space:]]+$//; s/^[\"']//; s/[\"']$//"
}

set_env_file_var() {
    local file="$1" key="$2" value="$3"
    jasper_env_file_set "$file" "$key" "$value" 0640 0750
}

set_env_file_var_if_changed() {
    local file="$1" key="$2" value="$3"
    local current
    if [[ ! -f "$file" ]]; then
        set_env_file_var "$file" "$key" "$value"
        return 0
    fi
    if ! grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$file"; then
        set_env_file_var "$file" "$key" "$value"
        return 0
    fi
    current="$(env_file_value_from "$file" "$key")"
    if [[ "$current" == "$value" ]]; then
        return 1
    fi
    set_env_file_var "$file" "$key" "$value"
    return 0
}

env_file_value() { env_file_value_from "$ENV_FILE" "$1"; }

set_env_var() { set_env_file_var "$ENV_FILE" "$1" "$2"; }

set_env_var_if_changed() { set_env_file_var_if_changed "$ENV_FILE" "$1" "$2"; }

cleanup_outputd_env_stage() {
    if [[ -n "${OUTPUTD_ENV_STAGE_FILE:-}" && -f "$OUTPUTD_ENV_STAGE_FILE" ]]; then
        rm -f "$OUTPUTD_ENV_STAGE_FILE"
    fi
}

stage_outputd_env() {
    local dir
    dir="$(dirname "$OUTPUTD_ENV_FILE")"
    [[ -d "$dir" ]] || install -d -m 0750 "$dir"
    OUTPUTD_ENV_STAGE_FILE="$(mktemp "${dir}/.outputd.env.candidate.XXXXXX")"
    if [[ -f "$OUTPUTD_ENV_FILE" ]]; then
        cp -p "$OUTPUTD_ENV_FILE" "$OUTPUTD_ENV_STAGE_FILE"
    else
        : > "$OUTPUTD_ENV_STAGE_FILE"
        chgrp --reference="$dir" "$OUTPUTD_ENV_STAGE_FILE" 2>/dev/null || true
        chmod 0640 "$OUTPUTD_ENV_STAGE_FILE"
    fi
    OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_STAGE_FILE"
    trap cleanup_outputd_env_stage EXIT
}

validate_outputd_env_stage() {
    local detail
    if [[ -z "${OUTPUTD_ENV_STAGE_FILE:-}" ]]; then
        return 0
    fi
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        log_event "outputd_env_invalid" \
            "outputd_env=${OUTPUTD_ENV_FILE} preserved=1 reason=python_unavailable"
        return 1
    fi
    if detail="$(
        "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.audio_config \
            validate-outputd-env \
            --base-env "$ENV_FILE" \
            --outputd-env "$OUTPUTD_ENV_STAGE_FILE" \
            --outputd-label "$OUTPUTD_ENV_FILE" \
            --fanin-env "$FANIN_ENV_FILE" \
            --camilla-statefile "$CAMILLA_STATEFILE" \
            --camilla2-statefile "$CAMILLA2_STATEFILE" \
            --output-topology "$OUTPUT_TOPOLOGY_PATH" 2>&1
    )"; then
        # The validator accepted the candidate, and MAY have reported a
        # coherent-but-transient state (`ok note=...` — today the ACTIVE-ring arm
        # waypoint). Log it so the journal carries the whole reason a mid-ladder
        # box goes silent at its next Camilla load; the reconcile proceeds either way.
        #
        # Matched ANYWHERE in the captured stream, not as a prefix: this capture
        # merges stderr (`2>&1`) so the error path can log a Python traceback, and
        # any interpreter or library warning emitted first would push the marker
        # off the front. A prefix match would then drop this line silently — the
        # exact silent-failure shape this event exists to prevent. The literal is
        # pinned on both sides by
        # test_the_note_prefix_the_script_matches_is_the_one_the_cli_prints.
        if [[ "$detail" == *"ok note="* ]]; then
            log_event "outputd_env_note" \
                "outputd_env=${OUTPUTD_ENV_FILE} detail=$(jasper_asound_log_token "${detail#*ok note=}")"
        fi
        return 0
    fi
    log_event "outputd_env_invalid" \
        "outputd_env=${OUTPUTD_ENV_FILE} preserved=1 detail=$(jasper_asound_log_token "$detail")"
    return 1
}

resolve_outputd_capture_device() {
    "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.audio_config \
        outputd-capture-device --playback-device "$1"
}

# Is $2 stated at all in env file $1? An env file states a key by naming it,
# even to the empty string — which is NOT the same as omitting it, and the two
# resolve differently below.
env_file_states_key() {
    [[ -f "$1" ]] && grep -qE "^[[:space:]]*${2}[[:space:]]*=" "$1"
}

# The value outputd RUNS for one of its env keys.
#
# $1 = key, $2 = the value that applies when NO env file states it. Two things
# this has to get right, because a guard that reasons about what the daemon will
# actually open is only as true as its resolution:
#
# BOTH LAYERS. jasper-outputd.service chains EnvironmentFile=/etc/jasper/jasper.env
# then EnvironmentFile=-/var/lib/jasper/outputd.env, later wins. jasper.env is the
# DOCUMENTED operator layer and the reconciler's own convention is that an
# operator key there wins by having the generated key DROPPED from outputd.env
# (jasper_env_file_unset; pinned by
# test_reconcile_operator_env_override_survives_reconciler) — precisely the state
# an outputd.env-only read cannot see. Reading one layer made the guard blind to
# every operator override.
#
# UNSET vs EMPTY. outputd's env_str (rust/jasper-env/src/lib.rs) is
# `std::env::var(name).unwrap_or_else(|_| default)` — it falls back only when the
# variable is UNSET. A stated-but-empty JASPER_OUTPUTD_BACKEND= is therefore the
# empty string to outputd, which fails its config parse rather than meaning
# `alsa`. Resolving empty to the default would let this guard claim a backend the
# daemon will never run, so a stated key keeps its stated value and only an
# unstated one takes the default.
outputd_env_effective() {
    local key="$1" fallback="$2" file
    # Reverse precedence order: last file that states the key wins, matching the
    # unit's EnvironmentFile chain.
    for file in "$OUTPUTD_ENV_FILE" "$ENV_FILE"; do
        if env_file_states_key "$file" "$key"; then
            printf '%s' "$(env_file_value_from "$file" "$key")"
            return 0
        fi
    done
    printf '%s' "$fallback"
}

# Does the ALSA artifact ON DISK render `pcm.outputd_dac` as the null device?
#
# Reads the rendered artifact rather than re-deriving what this pass WOULD
# render, because on the endpoint-contract path this pass renders NOTHING: the
# exit is ~87 lines ahead of render_asound_if_needed, so the alias outputd
# actually opens is whatever an EARLIER pass left. Asking
# jasper_asound_outputd_dac_parked here answered a question nobody had asked —
# on a recognized -> unrecognized transition it reported "null" while the live
# artifact still said `type hw card A`, which would park a box whose DAC was
# still playing, on a detail string that was simply false.
#
# $ASOUND_TEMPLATE is the reconciler's own output and the SOURCE of this block:
# jasper-render-asound-conf copies it verbatim into asound.conf, substituting
# only __RATE_CONVERTER__. Fail closed — an absent or unreadable template is not
# evidence of a null alias, so it declines rather than assuming.
asound_artifact_parks_outputd_dac() {
    [[ -f "$ASOUND_TEMPLATE" ]] || return 1
    awk '
        /^[[:space:]]*pcm\.outputd_dac[[:space:]]*\{/ { depth = 1; next }
        depth && /\{/ { depth++ }
        depth && /^[[:space:]]*type[[:space:]]+null[[:space:]]*$/ { found = 1 }
        depth && /\}/ { depth--; if (depth <= 0) exit found ? 0 : 1 }
        END { exit found ? 0 : 1 }
    ' "$ASOUND_TEMPLATE"
}

# Turn a preserve_runtime_env fallback into the do-no-harm park when the env it
# would preserve is the CLOCKLESS PAIR.
#
# preserve_runtime_env means "this pass could not derive an answer, so change
# nothing", and that is only harmless while the env already on disk describes
# hardware this pass still sees. In one shape it does not: the preserved env
# opens the REAL ALSA backend at the single-ALSA DAC edge (`outputd_dac`) while
# the ALSA artifact on disk renders that same alias as `type null`. The null
# device accepts every write instantly, so nothing paces outputd's output loop
# from the DAC side — and nothing paces it from the content side either,
# whichever fan-in coupling is live (a shm ring never blocks, and an unfed
# loopback capture does not pace either). With no clock anywhere the RT loop
# spins flat out until LimitRTTIME SIGKILLs it, ~1 s per start; three per burst,
# then StartLimitAction=reboot. Observed live on jts.local 2026-08-14 (issue
# #2489): three consecutive reboots, absorbed by the bootloop guard.
#
# EVERY conjunct reads an artifact rather than re-deriving one. That is the whole
# discipline here: this pass writes no env and renders no ALSA before it exits,
# so the only truthful evidence about what outputd will open is what is already
# on disk. `asound_artifact_parks_outputd_dac` reads the rendered template; the
# env conjuncts read both env layers. Note the alias is also parked for an ARMED
# composite, which is why the env conjuncts matter: a composite runs
# SINK=dual_apple against its two child PCMs and never opens this alias.
#
# Exactly ONE key moves. The preserved env is known to parse and start (outputd
# logged `event=outputd.ready backend=alsa` before each kill), so every other
# key in it is already coherent; flipping the one key that governs whether ALSA
# is opened at all turns the same env into a paced idle (`run_fake` sleeps one
# period per iteration). Writing MORE would be actively worse — clearing the
# active-lane pair while a shm-ring content bridge is still armed trips
# outputd's own active-ring allowlist and parks it at exit 78.
#
# Written straight to the live file, not through the staged candidate: the
# stage's validator needs Python, and a Python that cannot answer is one of the
# ways the endpoint contract fails in the first place. Bash-only by design.
#
# Gated on OBSERVED_OUTPUT_VALID, which is what makes this pass's verdict
# authoritative enough to overrule the env on disk. A pass that could not
# observe the hardware at all knows strictly less than the pass that wrote that
# env, and it re-renders no asound either — so the two artifacts on disk stay
# the coherent pair they were, and preserving is genuinely the better bet.
# Without this conjunct a broken interpreter (which fails the observation and
# the endpoint contract together) would park a healthy recognized DAC at the
# next outputd start. #2489's box had the opposite shape: the observation
# SUCCEEDED and identified the composite, which is exactly why its verdict
# contradicted the preserved env.
#
# Returns 0 when it parked, 1 when the preserved env is left exactly as found.
park_preserved_env_if_clockless() {
    if [[ "$OBSERVED_OUTPUT_VALID" != "1" ]]; then
        return 1
    fi
    if [[ "$(outputd_env_effective JASPER_OUTPUTD_BACKEND alsa)" != "alsa" ]]; then
        return 1
    fi
    if [[ "$(outputd_env_effective JASPER_OUTPUTD_SINK single_alsa)" != "single_alsa" ]]; then
        return 1
    fi
    if [[ "$(outputd_env_effective JASPER_OUTPUTD_DAC_PCM outputd_dac)" != "outputd_dac" ]]; then
        return 1
    fi
    if ! asound_artifact_parks_outputd_dac; then
        return 1
    fi
    set_env_file_var "$OUTPUTD_ENV_FILE" "JASPER_OUTPUTD_BACKEND" "fake"
    log_event "outputd_env_clockless_park" \
        "outputd_env=${OUTPUTD_ENV_FILE} backend=alsa->fake dac_pcm=outputd_dac" \
        "asound_template=$(jasper_asound_log_token "$ASOUND_TEMPLATE")" \
        "output_dac_id=$(jasper_asound_log_token "$OUTPUT_DAC_ID")" \
        "output_dac_recognized=${OUTPUT_DAC_RECOGNIZED}" \
        "detail=preserved_env_opened_alsa_at_a_null_parked_dac"
    return 0
}

# The endpoint contract could not resolve outputd's capture half for $1. Land in
# a state that idles rather than one that spins, then fail loudly.
outputd_endpoint_contract_failed_exit() {
    local action="preserve_runtime_env"
    if park_preserved_env_if_clockless; then
        action="park_backend_fake"
    fi
    log_event "outputd_endpoint_contract_failed" \
        "playback_device=$1 action=${action}"
    exit 66
}

commit_outputd_env_stage() {
    local dir
    if [[ -z "${OUTPUTD_ENV_STAGE_FILE:-}" ]]; then
        return 1
    fi
    if ! validate_outputd_env_stage; then
        OUTPUTD_ENV_STAGE_REJECTED=1
        cleanup_outputd_env_stage
        OUTPUTD_ENV_STAGE_FILE=""
        OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_FILE"
        trap - EXIT
        return 1
    fi
    if [[ -f "$OUTPUTD_ENV_FILE" ]] && cmp -s "$OUTPUTD_ENV_STAGE_FILE" "$OUTPUTD_ENV_FILE"; then
        cleanup_outputd_env_stage
        OUTPUTD_ENV_STAGE_FILE=""
        OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_FILE"
        trap - EXIT
        return 1
    fi
    dir="$(dirname "$OUTPUTD_ENV_FILE")"
    if [[ -f "$OUTPUTD_ENV_FILE" ]]; then
        chown --reference="$OUTPUTD_ENV_FILE" "$OUTPUTD_ENV_STAGE_FILE" 2>/dev/null || true
    else
        chgrp --reference="$dir" "$OUTPUTD_ENV_STAGE_FILE" 2>/dev/null || true
    fi
    chmod 0640 "$OUTPUTD_ENV_STAGE_FILE"
    mv "$OUTPUTD_ENV_STAGE_FILE" "$OUTPUTD_ENV_FILE"
    OUTPUTD_ENV_STAGE_FILE=""
    OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_FILE"
    trap - EXIT
    return 0
}

repair_generated_env_permissions() {
    jasper_env_file_repair_permissions "$OUTPUTD_ENV_FILE" 0640 0750
    jasper_env_file_repair_permissions "$FANIN_ENV_FILE" 0640 0750
}

APPLE_DONGLE_PRESENT=0
APPLE_DONGLE_SERVICE_CARD="auto"
DONGLE_CARD="A"
OUTPUT_DAC_CARD="A"
OUTPUT_DAC_ID="unknown"
OUTPUT_DAC_RECOGNIZED=0
OUTPUTD_ACTIVE_MODE=0
OUTPUTD_ACTIVE_CHANNELS=""
# Set when this pass WROTE a record naming a different profile or card than the
# one it replaced. The mixer pin reads that record, so it is the one thing that
# has to re-run it. The emitter decides it: it reads the record it is about to
# replace.
OUTPUT_HARDWARE_RECORD_CHANGED=0
# The `jasper.cli.output_hardware --env` fields this reconciler consumes,
# cleared to what an ABSENT record means (ADR-0235 R2). Re-cleared when a
# payload evals but fails validation, so half a record can never stand next
# to half of another.
clear_observed_output_state() {
    OBSERVED_OUTPUT_PROFILE_ID=""
    OBSERVED_OUTPUT_PROFILE_STATUS=""
    OBSERVED_OUTPUT_SELECTED_CARD_ID=""
    OBSERVED_OUTPUT_CHILD_DEVICE_IDS=""
    OBSERVED_OUTPUT_APPLE_CARD_IDS=""
    # Blocker codes from the observed record, comma-joined. The record is where
    # a park's reason is written, so this is what lets `output_parked` name WHY
    # instead of only reporting `recognized=0`.
    OBSERVED_OUTPUT_BLOCKER_CODES=""
    OBSERVED_OUTPUT_RECORD_CHANGED=0
    OBSERVED_OUTPUT_USB_MANAGEMENT_TRANSPORT_AVAILABLE=""
    OBSERVED_OUTPUT_DUAL_MAPPING_OK=0
    OBSERVED_OUTPUT_DUAL_MAPPING_REASON=""
    OBSERVED_OUTPUT_DUAL_ORDER_SOURCE=""
    OBSERVED_OUTPUT_DUAL_DAC_A_PCM=""
    OBSERVED_OUTPUT_DUAL_DAC_B_PCM=""
}
clear_observed_output_state
DUAL_APPLE_DAC_A_PCM=""
DUAL_APPLE_DAC_B_PCM=""
DUAL_APPLE_ORDER_SOURCE=""
# The endpoint device `active_graph_status` reports for an accepted composite
# graph — the SECOND field of its payload.
# Empty means "no endpoint field", which set_outputd_active_lane_pair reads as
# NO ring marker (fail closed by positive equality).
DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE=""

apply_observed_single_policy() {
    # output_hardware classifies ordinary single devices from the DacProfile
    # registry. Consume that result directly so a new registered single DAC
    # does not require a second hardware regex in this shell owner.
    if [[ "$OBSERVED_OUTPUT_PROFILE_STATUS" != "ready" || -z "$OBSERVED_OUTPUT_SELECTED_CARD_ID" ]]; then
        return
    fi
    OUTPUT_DAC_CARD="$OBSERVED_OUTPUT_SELECTED_CARD_ID"
    OUTPUT_DAC_ID="$OBSERVED_OUTPUT_PROFILE_ID"
    OUTPUT_DAC_RECOGNIZED=1
}

apply_observed_composite_policy() {
    if [[ "$OBSERVED_OUTPUT_PROFILE_ID" != "dual_apple_usb_c_dac_4ch" ]]; then
        return
    fi
    if [[ "$OBSERVED_OUTPUT_PROFILE_STATUS" != "ready" ]]; then
        OUTPUT_DAC_ID="dual_apple_usb_c_dac_4ch"
        OUTPUT_DAC_CARD=""
        OUTPUT_DAC_RECOGNIZED=0
        APPLE_DONGLE_PRESENT=1
        APPLE_DONGLE_SERVICE_CARD="auto"
        log_event "dual_apple_detected" \
            "status=${OBSERVED_OUTPUT_PROFILE_STATUS:-unknown} action=park_until_ready"
        return
    fi
    if [[ "$OBSERVED_OUTPUT_DUAL_MAPPING_OK" != "1" ]]; then
        OUTPUT_DAC_ID="dual_apple_usb_c_dac_4ch"
        OUTPUT_DAC_CARD=""
        OUTPUT_DAC_RECOGNIZED=0
        APPLE_DONGLE_PRESENT=1
        APPLE_DONGLE_SERVICE_CARD="auto"
        log_event "dual_apple_detected" \
            "status=ready action=park_unstable_child_order topology_path=${OUTPUT_TOPOLOGY_PATH} reason=${OBSERVED_OUTPUT_DUAL_MAPPING_REASON:-unknown}"
        return
    fi
    DUAL_APPLE_ORDER_SOURCE="$OBSERVED_OUTPUT_DUAL_ORDER_SOURCE"
    DUAL_APPLE_DAC_A_PCM="$OBSERVED_OUTPUT_DUAL_DAC_A_PCM"
    DUAL_APPLE_DAC_B_PCM="$OBSERVED_OUTPUT_DUAL_DAC_B_PCM"
    local graph_status
    # The dual-Apple composite caps at 4 (two stereo children); the composite
    # sink is rigidly 4-channel in outputd regardless, so the dual branch needs
    # the gate's pass/fail and its ENDPOINT DEVICE, but not the returned width.
    #
    # THE ENDPOINT FIELD MUST NOT BE DISCARDED: throwing the second field away
    # is what would keep every composite unarmable no matter what the Python
    # preflights admit — the marker `active_ring_endpoint_proof` demands is
    # derived from exactly this device.
    if ! graph_status="$(active_graph_status 4)"; then
        OUTPUT_DAC_ID="dual_apple_usb_c_dac_4ch"
        OUTPUT_DAC_CARD=""
        OUTPUT_DAC_RECOGNIZED=0
        APPLE_DONGLE_PRESENT=1
        APPLE_DONGLE_SERVICE_CARD="auto"
        DUAL_APPLE_DAC_A_PCM=""
        DUAL_APPLE_DAC_B_PCM=""
        DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE=""
        # active_graph_status prints a reason on EVERY path it declines on, so
        # an empty capture here is not an unknown reason — it is the probe
        # producing no output at all (the interpreter died before printing:
        # a kill, an OOM, a crash below its own except). Name that, rather
        # than the un-derived `unknown` an operator can do nothing with.
        log_event "dual_apple_detected" \
            "status=ready action=park_until_active_graph reason=${graph_status:-active_graph_probe_no_output}"
        return
    fi
    OUTPUT_DAC_ID="dual_apple_usb_c_dac_4ch"
    OUTPUT_DAC_CARD="$DONGLE_CARD"
    OUTPUT_DAC_RECOGNIZED=1
    APPLE_DONGLE_PRESENT=1
    APPLE_DONGLE_SERVICE_CARD="auto"
    # Second field of the accepted payload ("<width> <endpoint_device>"), parsed
    # exactly as the single-DAC branch parses it: a payload with no space at all
    # has no device field, so treat it as ABSENT rather than as a device named
    # after the width.
    DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE="${graph_status#* }"
    if [[ "$DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE" == "$graph_status" ]]; then
        DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE=""
    fi
    log_event "dual_apple_detected" \
        "status=ready action=outputd_dual_sink order_source=${DUAL_APPLE_ORDER_SOURCE} dac_a_pcm=$(jasper_asound_log_token "$DUAL_APPLE_DAC_A_PCM") dac_b_pcm=$(jasper_asound_log_token "$DUAL_APPLE_DAC_B_PCM") active_endpoint=${DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE:-none}"
}

# Active-graph cutover gate. DRIVE WHAT WE USE, not the DAC's full channel count.
#
# $1 = the DAC's active-lane channel CAP — the resolved DacProfile's
# active_outputd_lane_channels (2 for single Apple, 4 for the dual-Apple
# composite, 8 for a HiFiBerry DAC8x single). On success prints the live
# endpoint config's ACTUAL playback width W (the number of physical outputs the
# speaker actually drives, in 2..cap) and returns 0 — ONLY when the current
# CamillaDSP graph, or the active-leader camilla#2 crossover graph paired with a
# camilla#1 program bake, is legal for the saved output topology, targets
# outputd's active playback lane, and its playback width is valid within the
# cap. A 100-output DAC powering a 2-way drives 2, not 100: outputd opens the
# DAC at W and the reconciler emits W as JASPER_OUTPUTD_ACTIVE_CHANNELS, so we
# never pump muted channels we are not using. Otherwise it prints a reason and
# returns non-zero so the caller fails closed: the composite shape parks, a
# coherent single stays ordinary stereo. This is the second, independent
# fail-closed layer (the asoundrc active lane is the first); never emit the wide
# env against a config that does not fit the cap.
active_graph_status() {
    local cap_channels="$1"
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        printf 'python_unavailable'
        return 1
    fi
    JASPER_CAMILLA_STATEFILE="$CAMILLA_STATEFILE" \
    JASPER_CAMILLA2_STATEFILE="$CAMILLA2_STATEFILE" \
    JASPER_OUTPUT_TOPOLOGY_PATH="$OUTPUT_TOPOLOGY_PATH" \
    JASPER_ACTIVE_GRAPH_CAP_CHANNELS="$cap_channels" \
    "$OUTPUT_HARDWARE_PYTHON" - <<'PY'
import os
import sys

try:
    cap_channels = int(os.environ["JASPER_ACTIVE_GRAPH_CAP_CHANNELS"])
except (KeyError, ValueError):
    print("active_graph_cap_channels_invalid")
    raise SystemExit(1)

try:
    from jasper.active_speaker.runtime_contract import (
        outputd_active_lane_decision,
    )

    decision = outputd_active_lane_decision(
        cap_channels,
        statefile_path=os.environ["JASPER_CAMILLA_STATEFILE"],
        crossover_statefile_path=os.environ["JASPER_CAMILLA2_STATEFILE"],
        topology_path=os.environ["JASPER_OUTPUT_TOPOLOGY_PATH"],
    )
except Exception as exc:
    detail = getattr(exc, "name", None) or type(exc).__name__
    print(f"active_graph_contract_unavailable:{type(exc).__name__}:{detail}")
    raise SystemExit(1)

if not decision.ok:
    print(decision.reason)
    raise SystemExit(1)

# Stdout payload on success is TWO fields from ONE decision: the ACTUAL driven
# width (emitted as JASPER_OUTPUTD_ACTIVE_CHANNELS so outputd opens the DAC at
# exactly W) and the ACCEPTED endpoint device (which decides
# JASPER_OUTPUTD_RING_ACTIVE_ENDPOINT). Both come from the same
# classification — a second probe for the device could disagree with the first
# about which graph it was describing.
print(decision.width, decision.endpoint_device or "")
PY
}

# Resolve a recognized single DAC's active-lane channel CAP via the Python
# DacProfile registry (active_outputd_lane_channels_for). THREE-VALUED on
# purpose, because "no lane" and "no answer" need different remedies:
#
#   <n>     the cap (e.g. 8 for a HiFiBerry DAC8x, 2 for an InnoMaker) — the
#           most active outputs outputd will drive on this DAC.
#   none    the registry ANSWERED: this profile declares no active lane.
#   (empty) NO answer — the probe itself failed, or Python is unavailable.
#
# Without the `none` sentinel both of the last two collapsed to empty, and the
# caller reported the actionable "this DAC has no active lane" for what may
# have been a transient spawn failure. That matters because this query
# swallows its own failure (`2>/dev/null || true`) so a probe death cannot
# abort the reconcile: an OOM-kill or fork-EAGAIN hitting THIS spawn while the
# recognition probe upstream still succeeds lands here with a recognized DAC
# and an empty cap. Every profile in the registry currently declares a lane, so
# that transient is in fact the likelier way to see an empty result today; a
# genuinely lane-less profile is the future case the `none` value keeps honest.
#
# The cap is the upper bound; the ACTUAL driven width is the loaded config's
# playback width, validated against this cap by the gate.
active_lane_channels_for_dac() {
    local dac_id="$1"
    if [[ -z "$dac_id" ]] || reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        return 0
    fi
    JASPER_DAC_ID_QUERY="$dac_id" "$OUTPUT_HARDWARE_PYTHON" - <<'PY' 2>/dev/null || true
import os

from jasper.audio_hardware.dac import (
    active_outputd_lane_channels_for,
    is_known_profile_id,
)

dac_id = os.environ["JASPER_DAC_ID_QUERY"]
width = active_outputd_lane_channels_for(dac_id)
if width:
    print(width)
elif is_known_profile_id(dac_id):
    # The registry answered "no lane" for a profile it knows. Distinct from
    # printing nothing, which the caller reads as "the probe gave no answer".
    # An UNKNOWN id deliberately falls through to empty: the registry has no
    # answer about it either. (The caller only asks about recognized DACs, so
    # that case does not arise in practice.)
    print("none")
PY
}

# Resolve a recognized DAC's declared final-edge ALSA sample format AND its
# outputd sink kind (DacProfile.outputd_sink — ADR-0235 R1) from ONE profile
# lookup: line 1 is the format (e.g. S32_LE for the InnoMaker HiFi AMP Pro),
# line 2 is the sink. BOTH lines or neither — it prints nothing at all when the
# id is unrecognized or Python is unavailable. A half answer is not a shape the
# caller can handle: outputd's env_str defaults only on an UNSET key, so an
# empty JASPER_OUTPUTD_SINK fails its config parse and parks it at exit 78.
#
# BLAST RADIUS — this is LIVE config, not a spare knob. jasper-outputd reads
# JASPER_OUTPUTD_DAC_FORMAT and accepts exactly {S16_LE, S24_3LE, S32_LE} or
# empty (empty/unset == S16_LE). S24_3LE is the packed 3-byte 24-bit edge, and
# the Apple USB-C dongle profile declares it. ALSA's 4-byte-word S24_LE is a
# DIFFERENT format and is NOT accepted. Any other value fails its config parse
# and parks the FINAL-OUTPUT OWNER at exit 78 — jasper-outputd-failure-reconcile
# grants one bounded retry per window, then the unit stays failed and the
# speaker is silent. outputd REQUESTS this format on its DAC PCM and parks if
# the device installs a different one, so a value the hardware cannot serve
# silences the speaker rather than being quietly converted. STATUS dac.format
# then reports what outputd's client edge negotiated — not an echo of this
# value — and the chip-AEC alignment identity records that for forensics only;
# ADR-0190 excludes it from comparison, so a changed declaration never
# invalidates a commissioned artifact. Emit sites are in apply_audio_runtime_env.
#
# This resolves BY ID, off whichever profile the caller armed — it never walks a
# composite's child_profile_ids. That is load-bearing, not incidental: outputd's
# paired composite sink has no packed-24 child write path and parks at exit 78
# on an S24_3LE child edge, so the dual-Apple composite declares S16_LE even
# though both its children ARE the dongle profile that declares S24_3LE. Passing
# the composite's id here is what answers S16_LE for that box.
#
# It prints NOTHING when the probe itself is unavailable, which is why callers on
# a recognized DAC must go through emit_dac_format_for_recognized below rather
# than writing this output straight through.
final_edge_format_for_dac() {
    local dac_id="$1"
    if [[ -z "$dac_id" ]] || reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        return 0
    fi
    JASPER_DAC_ID_QUERY="$dac_id" "$OUTPUT_HARDWARE_PYTHON" - <<'PY' 2>/dev/null || true
import os

from jasper.audio_hardware.dac import by_id, final_edge_format_for

dac_id = os.environ["JASPER_DAC_ID_QUERY"]
fmt = final_edge_format_for(dac_id)
profile = by_id(dac_id)
if fmt and profile is not None:
    print(fmt)
    print(profile.outputd_sink)
PY
}

# Emit a RECOGNIZED DAC's declared final-edge format AND outputd sink kind, or
# skip BOTH writes when the registry probe is unavailable — one profile lookup
# answers both, so they degrade together. Returns 0 when either env file value
# changed, so callers can `&& changed=1` exactly like set_env_file_var_if_changed.
#
# Mirrors the content-format branch in apply_audio_runtime_env: on a lost probe,
# preserve the previous value rather than committing a guess. Empty is a
# MEANINGFUL value on this key — outputd reads empty as S16_LE — so writing it
# here would silently NARROW a wide edge (S24_3LE on an Apple dongle, S32_LE on a
# DAC8x or InnoMaker) with no error anywhere. The edge format is also a
# chip-AEC alignment identity input, recorded for forensics only — ADR-0190
# excludes it from comparison, so this narrowing would not even be disclosed.
# On an ordinary pass — same DAC id, transient
# probe loss — nothing about the hardware changed, only our ability to ask the
# registry about it, so the previous value is still the safe one. That is NOT
# true when the DAC id itself changed on the same pass as the probe loss (a
# single -> dual upgrade, say): the preserved value was declared for the OLD id,
# not the id now armed. "Safe" here means fails loud, not silent — not
# "necessarily still correct for this box" — see the composite trade below.
#
# No previous value at all (a fresh env file, key never written): the skip
# leaves the key absent, outputd reads its own S16_LE default, and the next
# healthy pass re-emits the real value once the registry probe recovers.
#
# The accepted composite trade: on the dual-Apple composite arm, a stale WIDER
# value surviving a single -> dual upgrade (S24_3LE from the prior single-dongle
# profile) parks outputd at EX_CONFIG 78 until the next healthy pass re-emits
# S16_LE. That is accepted over hard-coding S16_LE here for the composite id,
# which would restate a registry constant in bash — the SSOT violation class
# this file marks with BLAST RADIUS blocks elsewhere. The park is loud and
# bounded, not silent.
#
# The deliberate explicit-empty write for an UNRECOGNIZED DAC is a different path
# and is unaffected: there the emptiness IS the answer, not a lost answer.
emit_dac_format_for_recognized() {
    local dac_id="$1"
    local fields dac_format dac_sink preserved
    fields="$(final_edge_format_for_dac "$dac_id")"
    dac_format="${fields%%$'\n'*}"
    dac_sink=""
    [[ "$fields" == *$'\n'* ]] && dac_sink="${fields#*$'\n'}"
    if [[ -z "$dac_format" ]]; then
        preserved="$(env_file_value_from "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_FORMAT")"
        log_event "dac_format_skip" \
            "reason=registry_probe_unavailable dac_id=${dac_id} preserved=${preserved:-absent} outputd_env=${OUTPUTD_ENV_FILE}"
        return 1
    fi
    local dac_registry_changed=0
    set_env_file_var_if_changed \
        "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_FORMAT" "$dac_format" && dac_registry_changed=1
    set_env_file_var_if_changed \
        "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_SINK" "$dac_sink" && dac_registry_changed=1
    [[ "$dac_registry_changed" == "1" ]]
}

# Resolve the CamillaDSP -> outputd content lane's sample format, via the one
# Python policy function that also decides what CamillaDSP emits
# (jasper.fanin_coupling.content_lane_format_for_coupling).
# Prints the format, or nothing when Python is unavailable.
#
# NO coupling token is passed. The ring is the one transport (ADR-0100), so
# nothing selects on one and the policy function takes no such argument at
# all. The freshness that does matter lives inside Python: the ring-wire read
# (read_declared_ring_wire_format) opens /etc/jasper/jasper.env and
# /var/lib/jasper/fanin.env itself on every call, so an operator's
# JASPER_FANIN_RING_WIRE_FORMAT pin reaches this probe with no threading from
# the shell. Flipping JASPER_FANIN_CAMILLA_COUPLING does NOT move this answer.
#
# BLAST RADIUS — this is LIVE config, not a spare knob. jasper-outputd's config
# PARSER accepts exactly {S16_LE, S24_3LE, S32_LE} or empty (empty/unset ==
# S16_LE) on this name; anything else fails the parse and parks the FINAL-OUTPUT
# OWNER at exit 78. S24_3LE parses only because both hops share ONE format
# vocabulary — outputd has no packed-24 READ path and refuses such a lane at the
# same exit 78, and this function cannot emit it in any case (the policy below
# answers only S16_LE or S32_LE). outputd reads this as the SHM RING's wire
# width (rust/jasper-outputd/src/shm_ring_source.rs), and the ring layout
# defines only S16LE and S32LE — so a hand-set S24_3LE passes the parser and is
# then refused park-class at that same exit 78. It is NOT the DAC edge —
# that is JASPER_OUTPUTD_DAC_FORMAT, a separate hop with its own declaration,
# and the two legitimately differ (an S32 content lane into the Apple dongle's
# packed S24_3LE edge, which is the widest width that device advertises).
# The content axis does NOT enter the chip-AEC alignment identity, so changing
# it forces no recommission (wide-output-path D6). Emit site is in
# apply_audio_runtime_env.
#
content_format_for_coupling() {
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        return 0
    fi
    "$OUTPUT_HARDWARE_PYTHON" - <<'PY' 2>/dev/null || true
from jasper.fanin_coupling import content_lane_format_for_coupling

print(content_lane_format_for_coupling())
PY
}

# The content-lane format to actually emit: whatever the active coupling asks
# for. Prints nothing when the coupling probe could not answer, which the caller
# reads as "leave the key alone" rather than "write a guess".
#
# There is no per-bridge narrowing here: the SHM ring is the one transport
# (ADR-0100), so there is no second bridge whose accepted width could differ
# from the coupling's own.
resolved_content_format() {
    content_format_for_coupling
}

_fallback_latency_floor_actions() {
    printf 'unset JASPER_CAMILLA_CHUNKSIZE\n'
    printf 'unset JASPER_CAMILLA_TARGET_LEVEL\n'
    printf 'unset JASPER_OUTPUTD_PERIOD_FRAMES\n'
    printf 'unset JASPER_OUTPUTD_DAC_BUFFER_FRAMES\n'
}

# Ask jasper.audio_runtime_plan for outputd.env latency-floor actions. This keeps
# precedence in one Python policy layer instead of duplicating "operator env >
# profile floor > packaged default" in bash and in jasper-doctor.
latency_floor_actions_for_dac() {
    local dac_id="$1"
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        _fallback_latency_floor_actions
        return 0
    fi
    if ! "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.audio_config \
        outputd-floor-actions \
        --profile-id "$dac_id" \
        --base-env "$ENV_FILE" \
        --outputd-env "$OUTPUTD_ENV_TARGET_FILE" 2>/dev/null; then
        _fallback_latency_floor_actions
    fi
}

route_env_actions() {
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        return 1
    fi
    "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.audio_config \
        route-actions \
        --base-env "$ENV_FILE" 2>/dev/null
}

# Route-env change flag. Route-owned runtime keys now all live in fanin.env.
ROUTE_FANIN_CHANGED=0
apply_route_env() {
    ROUTE_FANIN_CHANGED=0
    local changed=0
    local actions target kind key value file
    if ! actions="$(route_env_actions)"; then
        log_event "route_env_skip" "reason=audio_config_unavailable"
        return 1
    fi
    while read -r target kind key value; do
        [[ -n "${target:-}" ]] || continue
        if [[ "$target" == "summary" ]]; then
            continue
        fi
        case "$target" in
            fanin) file="$FANIN_ENV_FILE" ;;
            *) continue ;;
        esac
        local file_changed=0
        case "$kind" in
            set)
                if set_env_file_var_if_changed "$file" "$key" "$value"; then
                    file_changed=1
                fi
                ;;
            unset)
                if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$file" 2>/dev/null; then
                    jasper_env_file_unset "$file" "$key" 0640 0750
                    file_changed=1
                fi
                ;;
        esac
        if [[ "$file_changed" == "1" ]]; then
            changed=1
            ROUTE_FANIN_CHANGED=1
        fi
    done <<<"$actions"
    log_event "route_env" \
        "fanin_env=${FANIN_ENV_FILE} changed=${changed} fanin_changed=${ROUTE_FANIN_CHANGED}"
    if [[ "$changed" == "1" ]]; then
        return 0
    fi
    return 1
}

# Apply the active DAC latency-floor actions into the wizard-owned outputd.env.
# The decisions come from jasper.audio_runtime_plan; this function only performs
# the requested set/unset mutations and reports whether the file changed.
LATENCY_FLOOR_CHANGED=0
apply_latency_floor_env() {
    LATENCY_FLOOR_CHANGED=0
    local dac_id="$1"
    local actions kind key value
    local camilla_chunk="" camilla_target="" outputd_period="" outputd_buffer=""
    actions="$(latency_floor_actions_for_dac "$dac_id")"
    while read -r kind key value; do
        [[ -n "${kind:-}" ]] || continue
        case "$kind" in
            summary)
                case "$key" in
                    JASPER_CAMILLA_CHUNKSIZE) camilla_chunk="$value" ;;
                    JASPER_CAMILLA_TARGET_LEVEL) camilla_target="$value" ;;
                    JASPER_OUTPUTD_PERIOD_FRAMES) outputd_period="$value" ;;
                    JASPER_OUTPUTD_DAC_BUFFER_FRAMES) outputd_buffer="$value" ;;
                esac
                ;;
            set)
                if set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "$key" "$value"; then
                    LATENCY_FLOOR_CHANGED=1
                fi
                ;;
            unset)
                if grep -qE "^[[:space:]]*${key}[[:space:]]*=" "$OUTPUTD_ENV_TARGET_FILE" 2>/dev/null; then
                    jasper_env_file_unset "$OUTPUTD_ENV_TARGET_FILE" "$key" 0640 0750
                    LATENCY_FLOOR_CHANGED=1
                fi
                ;;
        esac
    done <<<"$actions"
    log_event "latency_floor" \
        "output_dac_id=${dac_id} camilla_chunksize=${camilla_chunk:-default} camilla_target_level=${camilla_target:-default} outputd_period_frames=${outputd_period:-default} outputd_dac_buffer_frames=${outputd_buffer:-default} changed=${LATENCY_FLOOR_CHANGED}"
}

print_env() {
    printf 'DONGLE_CARD=%s\n' "$(quote_env_value "$DONGLE_CARD")"
    printf 'APPLE_DONGLE_PRESENT=%s\n' "$(quote_env_value "$APPLE_DONGLE_PRESENT")"
    printf 'APPLE_DONGLE_SERVICE_CARD=%s\n' "$(quote_env_value "$APPLE_DONGLE_SERVICE_CARD")"
    printf 'OUTPUT_DAC_CARD=%s\n' "$(quote_env_value "$OUTPUT_DAC_CARD")"
    printf 'OUTPUT_DAC_ID=%s\n' "$(quote_env_value "$OUTPUT_DAC_ID")"
    printf 'OUTPUT_DAC_RECOGNIZED=%s\n' "$(quote_env_value "$OUTPUT_DAC_RECOGNIZED")"
}

render_asound_if_needed() {
    local tmp rc=0

    if [[ ! -f "$ASOUND_SOURCE_TEMPLATE" ]]; then
        log_event "asound_skip" "source_template=${ASOUND_SOURCE_TEMPLATE} missing=1"
        return 1
    fi

    # Only create an absent dir; never re-mode the existing /etc/jasper on every
    # recognized-DAC render (the installer owns its 0755) — same only-if-absent
    # discipline as the env writers (#827).
    [[ -d "$(dirname "$ASOUND_TEMPLATE")" ]] || install -d -m 0755 "$(dirname "$ASOUND_TEMPLATE")"
    tmp="$(mktemp "${ASOUND_TEMPLATE}.XXXXXX")"
    # Render to a temp and validate it BEFORE replacing the live template. A
    # card-less recognized DAC makes jasper_asound_render_template fail closed
    # (require_output_dac_card -> 64) — but set -e is suppressed here because
    # the caller invokes this function in a `&& render_changed=1` list, so an
    # ignored failure would fall straight through to the mv below and clobber
    # the working /etc/asound.conf source with the empty temp (silent failure on
    # the output path; defeats the helper's own fail-closed guard). Check the
    # return AND reject an empty render, then preserve the existing template and
    # fail loud rather than emit nothing.
    if ! jasper_asound_render_template "$ASOUND_SOURCE_TEMPLATE" "$tmp" || [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        log_event "asound_render_failed" \
            "stage=source_template source_template=${ASOUND_SOURCE_TEMPLATE} output_dac_id=${OUTPUT_DAC_ID} output_dac_card=$(jasper_asound_log_token "$OUTPUT_DAC_CARD") preserved_existing=1"
        return 1
    fi
    chmod 0644 "$tmp"

    if [[ -f "$ASOUND_TEMPLATE" ]] && cmp -s "$tmp" "$ASOUND_TEMPLATE"; then
        rm -f "$tmp"
        return 1
    fi

    # The suppressed `set -e` noted above hides a nonzero exit here too, so an
    # unchecked call would log a successful render and take the renderer-restart
    # path against an asound.conf that was never rewritten. Discarding the temp
    # on failure also keeps the next pass's template diff — and its retry.
    JASPER_ASOUND_TEMPLATE="$tmp" "$RENDER_ASOUND_CONF" || rc=$?
    if [[ "$rc" != "0" ]]; then
        rm -f "$tmp"
        log_event "asound_render_failed" \
            "stage=asound_conf rc=${rc} output_dac_id=${OUTPUT_DAC_ID} output_dac_card=$(jasper_asound_log_token "$OUTPUT_DAC_CARD") preserved_existing=1"
        # Fails the unit like the outputd_candidate_rejected exit below, for the
        # same reason: nothing has been stopped or restarted yet, while
        # continuing would restart outputd against an asound.conf naming a
        # different DAC than the outputd.env this pass already committed.
        restart_dac_init_for_record_change
        exit 78
    fi
    mv "$tmp" "$ASOUND_TEMPLATE"

    log_event "asound_rendered" \
        "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} outputd_active_mode=${OUTPUTD_ACTIVE_MODE} outputd_active_channels=$(jasper_asound_log_token "$OUTPUTD_ACTIVE_CHANNELS")"
    return 0
}

# Render the shm-ring conf.d slot period from the ACTIVE DAC's DECLARED latency
# floor (the follow-up deploy/alsa/conf.d/60-jts-ring.conf's own header asks
# for). The ring slot IS one outputd DAC period.
#
# The rule is narrow on purpose. A DAC with NO declared floor, any unrecognized
# DAC, and a declared floor whose period is not fan-in's compile-time
# RING_SLOT_FRAMES all leave the shipped conf.d untouched, so that box keeps
# whatever coupling it has today. The last case is the #2147 boundary: fan-in
# always builds Ring A at RING_SLOT_FRAMES, so rendering another period would
# CRASH shm_ring at arm (ioplug RING_ATTACH_FATAL) instead of refusing it. The
# Python layer emits a distinct reason token for it, and that DAC still gets its
# floor's outputd period/buffer geometry through outputd.env.
#
# Deliberately triggers NO restart and feeds no restart flag. The conf.d is read
# by ALSA at the next PCM open, and arming is owned by the coupling reconciler,
# which independently PREFLIGHTs conf-period vs outputd-period and fail-closes
# to loopback. A render here changes what that preflight will find; it never
# moves a live graph.
#
# The path is NOT duplicated here: with no --conf-d the Python side resolves
# jasper.ring_assets.RING_CONF_D (the SSOT) and reports back which file it
# touched. JASPER_RING_CONF_D exists for tests.
RING_CONF_D_OVERRIDE="${JASPER_RING_CONF_D:-}"
# Render the flat cutover startup graph for the CURRENTLY saved output topology.
#
# The RUNTIME sibling of install's `render_outputd_cutover_config`, through the
# same single entry (`jasper-sound render-flat-cutover` ->
# jasper.sound.camilla_yaml.render_flat_cutover_configs) so there is one writer
# and one file mode, never a second spelling.
#
# Why the reconciler and not the caller: the graph is width-matched to the saved
# topology (a mono layout hard-mutes the output it does not claim), so it goes
# STALE whenever the topology changes. The two paths that change it — the
# /sound/ topology save and jasper-output-topology-reset — both run inside
# jasper-web's sandbox, which has no /etc/camilladsp write path (WS1-deliberate;
# do not widen it). Both already kick THIS reconciler, which runs as root, so
# the render belongs here. Without it a box that was re-laid-out kept booting the
# previous topology's graph. Reset now leaves that box unconfigured and parked;
# a later explicit passive layout gets a freshly rendered flat graph.
#
# Write-on-change (the emitter compares before writing), matching this script's
# set_env_var_if_changed discipline, so boot/udev passes on a converged box do
# not churn the file. A failed render leaves the previous bytes; runtime graph
# convergence below still judges them against current intent and returns
# nonzero if it cannot prove a safe selection. At boot that failure blocks
# CamillaDSP through its required ordering on this oneshot.
render_flat_cutover_if_needed() {
    local output
    if reconcile_probe_missing "$JASPER_SOUND_CLI"; then
        log_event "flat_cutover" "result=skipped reason=cli_unavailable"
        return 0
    fi
    if ! output="$(
        JASPER_OUTPUT_TOPOLOGY_PATH="$OUTPUT_TOPOLOGY_PATH" \
        "$JASPER_SOUND_CLI" render-flat-cutover --config-dir "$CAMILLA_CONF_DIR" 2>&1
    )"; then
        log_event "flat_cutover" \
            "result=failed detail=$(jasper_asound_log_token "$output")"
        return 0
    fi
    local changed="no"
    if [[ "$output" == *"changed=yes"* ]]; then
        changed="yes"
    fi
    log_event "flat_cutover" \
        "result=ok changed=${changed} config_dir=${CAMILLA_CONF_DIR} topology=${OUTPUT_TOPOLOGY_PATH}"
}

# The graph selector is the single owner of topology -> CamillaDSP safety.
# Render first: the selected passive graph is an on-disk generated artifact,
# and loading bytes from the previous topology is the reset-only race this
# shared convergence path replaces.  This does not touch outputd; its lane is
# derived below from the final statefile after this returns.
converge_runtime_graph() {
    local output
    if reconcile_probe_missing "$JASPER_ACTIVE_SPEAKER_CLI"; then
        log_event "runtime_graph" "result=failed reason=cli_unavailable"
        return 1
    fi
    # This hardware owner never mutates live CamillaDSP. Web save/reset owns
    # immediate locked graph convergence; coupling reconciliation owns ordered
    # live route transitions. This pass only seeds the proved boot statefile,
    # including while CamillaDSP is already running.
    if ! output="$(
        JASPER_OUTPUT_TOPOLOGY_PATH="$OUTPUT_TOPOLOGY_PATH" \
        "$JASPER_ACTIVE_SPEAKER_CLI" runtime-safe-graph \
            --topology "$OUTPUT_TOPOLOGY_PATH" \
            --statefile "$CAMILLA_STATEFILE" \
            --flat-config "${CAMILLA_CONF_DIR}/outputd-cutover.yml" \
            --write-statefile 2>&1
    )"; then
        log_event "runtime_graph" \
            "result=failed detail=$(jasper_asound_log_token "$output")"
        return 1
    fi
    log_event "runtime_graph" \
        "result=ok apply_mode=write-statefile detail=$(jasper_asound_log_token "$output")"
}

# The `key value` protocol below is a WHITELIST: an unmatched key is dropped
# silently, so every key the Python renderer emits needs an arm here or it never
# reaches the journal. The renderer emits the full resolved wire (period,
# format, per-ring channels) plus how the topology read went, because a conf.d
# that shears on any of those axes fails the ioplug attach the same way.
render_ring_conf_if_needed() {
    local actions key value result="" period="" previous="" reason="" conf=""
    local sample_format="" channels_a="" channels_b="" channels_active="" topology=""
    if [[ "$OUTPUT_DAC_RECOGNIZED" != "1" ]]; then
        log_event "ring_conf" "result=skipped reason=dac_unrecognized"
        return 0
    fi
    if reconcile_probe_missing "$OUTPUT_HARDWARE_PYTHON"; then
        log_event "ring_conf" "result=skipped reason=python_unavailable"
        return 0
    fi
    if ! actions="$(
        "$OUTPUT_HARDWARE_PYTHON" -m jasper.cli.audio_config \
            render-ring-conf-wire \
            --profile-id "$OUTPUT_DAC_ID" \
            --conf-d "$RING_CONF_D_OVERRIDE" \
            --output-topology "$OUTPUT_TOPOLOGY_PATH" 2>&1
    )"; then
        log_event "ring_conf" \
            "result=failed output_dac_id=${OUTPUT_DAC_ID} detail=$(jasper_asound_log_token "$actions")"
        return 0
    fi
    while read -r key value; do
        [[ -n "${key:-}" ]] || continue
        case "$key" in
            result) result="$value" ;;
            period_frames) period="$value" ;;
            previous_period_frames) previous="$value" ;;
            sample_format) sample_format="$value" ;;
            ring_a_channels) channels_a="$value" ;;
            ring_b_channels) channels_b="$value" ;;
            # The ACTIVE ring block's RENDERED width — the value that landed in
            # the conf.d, not a claim that an active ring exists. render_ring_conf_wire
            # coerces a None active width to RING_CONF_DEFAULT_CHANNELS, so a
            # plain stereo box journals ring_active_channels=2 while having no
            # active ring at all; the number always matches the file, which is
            # what makes it useful for diagnosing an attach.
            #
            # The renderer has always printed it; this whitelist had no arm for
            # it, and the case above drops an unmatched key SILENTLY (see the
            # comment on this function), so the one number a roleful/composite
            # box's render is actually about was the one number event=ring_conf
            # never carried. Pre-existing gap, load-bearing since P8b item 1d
            # made the active width per-box.
            ring_active_channels) channels_active="$value" ;;
            topology) topology="$value" ;;
            reason) reason="$value" ;;
            conf) conf="$value" ;;
        esac
    done <<<"$actions"
    log_event "ring_conf" \
        "result=${result:-unknown} output_dac_id=${OUTPUT_DAC_ID} period_frames=${period:-none} previous_period_frames=${previous:-none} sample_format=${sample_format:-none} ring_a_channels=${channels_a:-none} ring_b_channels=${channels_b:-none} ring_active_channels=${channels_active:-none} topology=${topology:-none} reason=${reason:-none} ring_conf=$(jasper_asound_log_token "$conf")"
}

# The mixer pin is restarted only when the record it reads CHANGED —
# including the boot where it ran before any record existed — because
# RemainAfterExit makes a plain `start` a no-op otherwise, and a restart per
# pass would spawn an interpreter on every udev sound event (ADR-0226).
# --no-block: the unit is ordered Before= camilla and the renderers, and a
# blocking job would make this pass wait on whatever else is moving there.
# Called both from gate_role_services and from every early exit between the
# record write and gate_role_services (a same-pass I2S HAT apply error or a
# rejected/failed render/env candidate), so a pass that aborts there still
# restarts the pin its own changed record earned — the record itself may no
# longer differ by the time a later pass reaches gate_role_services.
restart_dac_init_for_record_change() {
    [[ "$OUTPUT_HARDWARE_RECORD_CHANGED" == "1" ]] || return 0
    "$SYSTEMCTL" reset-failed jasper-dac-init.service 2>/dev/null || true
    "$SYSTEMCTL" --no-block restart jasper-dac-init.service || true
    log_event "dac_init_restarted" "output_dac_id=${OUTPUT_DAC_ID:-unknown}"
}

gate_role_services() {
    local apple_output=0
    if [[ ( "$OUTPUT_DAC_ID" == "apple_usb_c_dongle" || "$OUTPUT_DAC_ID" == "dual_apple_usb_c_dac_4ch" ) && "$APPLE_DONGLE_PRESENT" == "1" ]]; then
        apple_output=1
    fi
    # The mixer pin is enabled on every box: which controls a DAC pins is the
    # registry's answer, and jasper-dac-init is where it is asked.
    "$SYSTEMCTL" enable jasper-dac-init.service
    if [[ "$OUTPUT_HARDWARE_RECORD_CHANGED" == "1" ]]; then
        restart_dac_init_for_record_change
    else
        "$SYSTEMCTL" reset-failed jasper-dac-init.service 2>/dev/null || true
        "$SYSTEMCTL" start jasper-dac-init.service || true
    fi
    if [[ "$apple_output" == "1" ]]; then
        "$SYSTEMCTL" enable jasper-headphone-monitor.service
        # Ensure the monitor is running idempotently — do NOT restart it. This
        # gate runs on every udev/reconcile pass, and a deploy's core-audio
        # bounce fires it several times inside the unit's StartLimitIntervalSec;
        # a restart-per-pass burned StartLimitBurst and left the monitor parked
        # 'start-limit-hit' with nothing to revive it (reset-failed only lived in
        # the disabled branch below). reset-failed clears any such parked state
        # (incl. a box still on the old build); start is then a no-op when it is
        # already running. The monitor self-resolves the card in its own poll
        # loop, so it never needs a re-exec here.
        "$SYSTEMCTL" reset-failed jasper-headphone-monitor.service 2>/dev/null || true
        "$SYSTEMCTL" start jasper-headphone-monitor.service || true
        log_event "apple_services" "state=enabled output_dac_id=${OUTPUT_DAC_ID}"
    else
        "$SYSTEMCTL" disable --now jasper-headphone-monitor.service 2>/dev/null || true
        "$SYSTEMCTL" reset-failed jasper-headphone-monitor.service 2>/dev/null || true
        log_event "apple_services" "state=disabled output_dac_id=${OUTPUT_DAC_ID}"
    fi
}

park_output_audio() {
    if [[ "$NO_RESTART" == "1" ]]; then
        log_event "output_park_skip" "output_dac_id=${OUTPUT_DAC_ID} recognized=${OUTPUT_DAC_RECOGNIZED} no_restart=1"
        return
    fi
    "$SYSTEMCTL" --no-block stop jasper-voice.service jasper-outputd.service 2>/dev/null || true
    "$SYSTEMCTL" reset-failed jasper-voice.service jasper-outputd.service 2>/dev/null || true
    log_event "output_parked" "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} recognized=${OUTPUT_DAC_RECOGNIZED} observed_blockers=$(jasper_asound_log_token "${OBSERVED_OUTPUT_BLOCKER_CODES:-none}")"
}

restart_audio_if_needed() {
    local restart_needed="$1" install_profile="full"
    if [[ "$restart_needed" != "1" || "$NO_RESTART" == "1" ]]; then
        return
    fi
    # Only a genuinely absent marker gets the historical full brain default.
    if [[ -e "$INSTALL_PROFILE_FILE" || -L "$INSTALL_PROFILE_FILE" ]]; then
        install_profile="unknown"
        [[ ! -f "$INSTALL_PROFILE_FILE" || ! -r "$INSTALL_PROFILE_FILE" ]] || install_profile="$(sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;q;}' "$INSTALL_PROFILE_FILE")"
        [[ -n "$install_profile" ]] || install_profile="unknown"
    fi
    if [[ "$install_profile" == "full" ]]; then "$SYSTEMCTL" stop jasper-voice.service 2>/dev/null || true; fi
    "$SYSTEMCTL" reset-failed jasper-outputd.service 2>/dev/null || true
    # These two are SEPARATE --no-block transactions and are deliberately left
    # unordered: this function runs from udev and from install, where a blocking
    # restart can deadlock against the jobs it is waiting on. So the outputd
    # restart may still be queued when jasper-aec-reconcile drives
    # jasper-aec-init against the OLD outputd, whose STATUS still reports the
    # previous output geometry and final-edge format. Correctness does not
    # depend on winning that race: require_outputd_env_loaded in
    # jasper/cli/aec_init.py refuses to certify a STATUS older than
    # $OUTPUTD_ENV_FILE and exits 3, on which the aec reconciler drops the box
    # to software AEC3 and publishes "disclosed_stale" — it keeps hearing, and
    # a later pass re-arms the chip once outputd has restarted (ADR-0101).
    "$SYSTEMCTL" --no-block restart jasper-outputd.service 2>/dev/null || true
    if [[ "$install_profile" == "full" ]]; then "$SYSTEMCTL" --no-block restart jasper-aec-reconcile.service 2>/dev/null || true; fi
    log_event "audio_restarted" "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} brain_restarted=$([[ "$install_profile" == "full" ]] && printf 1 || printf 0) install_profile=$(jasper_asound_log_token "${install_profile:0:32}")"
}

# Bounce ONLY jasper-outputd for any committed outputd.env-only change — a
# latency-floor re-emit (e.g. one buffer-size integer), a runtime backend/sink
# change, or an active-lane width change. None of these can move the mic/input
# profile (that is owned by the DAC identity, gated separately). Unlike
# restart_audio_if_needed this must NOT stop jasper-voice or kick
# jasper-aec-reconcile: outputd is the UDP sender to the bridge's :9891
# reference receiver, the tap is invariant stereo, and the bridge is a bound
# receiver that survives an outputd bounce; jasper-voice depends on outputd only
# softly (Wants=/After=). So wake detection stays up across the restart instead
# of being deafened for ~10-15 s on a routine /sources/ toggle (#1257).
restart_outputd_only() {
    if [[ "$NO_RESTART" == "1" ]]; then
        log_event "outputd_only_restart_skip" \
            "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} no_restart=1"
        return
    fi
    "$SYSTEMCTL" reset-failed jasper-outputd.service 2>/dev/null || true
    "$SYSTEMCTL" --no-block restart jasper-outputd.service 2>/dev/null || true
    log_event "outputd_only_restarted" "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD}"
}

# Restart fan-in when its route-owned environment changed.
restart_route_runtime_if_needed() {
    local fanin_changed="${1:-0}"
    if [[ "$NO_RESTART" == "1" ]]; then
        return
    fi
    if [[ "$fanin_changed" == "1" ]]; then
        "$SYSTEMCTL" reset-failed jasper-fanin.service 2>/dev/null || true
        "$SYSTEMCTL" --no-block restart jasper-fanin.service 2>/dev/null || true
    fi
    log_event "route_runtime_restarted" \
        "fanin_env=${FANIN_ENV_FILE} fanin_restarted=${fanin_changed}"
}

# Ask the coupling reconciler to converge after every successful runtime-graph
# convergence.
#
# THE DAC-SWAP EDGE (#2285 P7, convergence design section 4.1). udev already
# reaches THIS script on every controlC* add/remove/change, and until now the
# chain stopped here: a swapped DAC got a re-rendered asound.conf and a bounced
# outputd, but nothing re-derived the fan-in coupling, so a box that should now
# be on the ring stayed on loopback until someone typed the arm by hand. This
# start is the missing edge.
#
# Topology can change the coupling verdict without changing DAC identity or any
# rendered bytes: reset leaves a fresh speaker unconfigured/loopback, then an
# explicit passive stereo save makes it Ring-B eligible. The final runtime graph
# convergence is therefore the bounded trigger. The auto pass is idempotent and
# decides from persisted topology; this script does not duplicate that policy.
#
# WHY THE PAIR CANNOT PING-PONG, since the coupling pass kicks this script back.
# The coupling pass may synchronously kick this script back while its own
# oneshot is still active. This function uses `systemctl --no-block start`; that
# start coalesces into the already-active oneshot rather than queueing a restart.
# Thus each external topology/hardware event causes at most one follow-up pass.
#
# --no-block IS LOAD-BEARING, not a nicety. The coupling pass kicks this unit
# back SYNCHRONOUSLY (up to its own start timeout) during its arm. A blocking
# start here would have this script waiting on a pass that is waiting on this
# script. systemd also coalesces starts of an already-running oneshot, so a
# udev storm collapses to one queued pass rather than a queue of them.
kick_fanin_coupling_auto_if_needed() {
    local dac_changed="${1:-0}" render_moved="${2:-0}" result=""
    if [[ "$NO_RESTART" == "1" ]]; then
        result="skipped_no_restart"
    else
        "$SYSTEMCTL" --no-block start jasper-fanin-coupling-auto.service 2>/dev/null || true
        result="started"
    fi
    log_event "coupling_kick" \
        "result=${result} dac_env_changed=${dac_changed} render_changed=${render_moved}"
}

start_outputd_if_recognized() {
    if [[ "$NO_RESTART" == "1" ]]; then
        log_event "outputd_start_skip" "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} recognized=1 no_restart=1"
        return
    fi
    "$SYSTEMCTL" reset-failed jasper-outputd.service 2>/dev/null || true
    "$SYSTEMCTL" --no-block start jasper-outputd.service 2>/dev/null || true
    log_event "outputd_start_requested" "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} recognized=1"
}

# THE SINGLE WRITER of the active-lane PAIR. JASPER_OUTPUTD_ACTIVE_LANE and
# JASPER_OUTPUTD_RING_ACTIVE_ENDPOINT are ONE FACT with two consumers, not two
# facts: outputd bails at startup on the incoherent pair (marker set, lane
# clear), because that combination can only mean this writer is broken.
#
# So every path that states one states the other, here, from one decision. The
# four call sites below (composite / active / non-active / parked) each pass the
# lane value and the ACCEPTED ENDPOINT DEVICE that the SAME
# outputd_active_lane_decision reported — never a second probe, never a value
# derived some other way. tests/test_ring_active_endpoint.py walks every
# JASPER_OUTPUTD_ACTIVE_LANE write site in this file and fails if any writes one
# key without the other.
#
# Args: $1 = lane value ("1" or ""), $2 = accepted endpoint device (may be
# empty). Echoes nothing; returns 0 iff either key CHANGED, matching
# set_env_file_var_if_changed's contract so the caller's `&& changed=1` idiom is
# unchanged.
set_outputd_active_lane_pair() {
    local lane="$1" endpoint_device="${2:-}"
    local ring_endpoint="" pair_changed=0
    # Positive equality against the named device, never "not the ALSA lane": an
    # unrecognized endpoint must resolve to NO marker (fail closed), which a
    # negative test would invert into a spurious arm.
    if [[ "$lane" == "1" && "$endpoint_device" == "$RING_ACTIVE_OUTPUTD_PLAYBACK_DEVICE" ]]; then
        ring_endpoint="1"
    fi
    set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_ACTIVE_LANE" "$lane" && pair_changed=1
    set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_RING_ACTIVE_ENDPOINT" "$ring_endpoint" && pair_changed=1
    [[ "$pair_changed" == "1" ]]
}

# The RETIRED content lane's capture PCM, HEALED rather than restated.
#
# outputd stopped reading this key with the lane (ADR-0100), so this reconciler
# no longer states it — but a box that reconciled before that carries the old
# line, and set_env_file_var_if_changed is a per-key upsert: a key nobody writes
# is never touched again, so the leftover would outlive the lane forever. Two
# shapes make it harmful rather than inert. A present-but-empty value defeats
# the absent-key default in jasper.audio_runtime_plan's retired-route describer
# (`.get(key, default)` answers absence, not emptiness), which reports a
# permanent post-DSP route disconnection no reconcile can clear; and on an
# ACTIVE -> PASSIVE move the same leftover can fail the staged validator
# outright (exit 78, outputd_env_invalid preserved=1).
#
# REMOVED, never written empty: emptiness is the value that causes shape one,
# and this file's rule that it "always states a definitive value for every
# conditional key" is kept — for a key outputd no longer reads, the definitive
# value is no line at all.
#
# REMOVAL CONDITION: dies with jasper.audio_runtime_plan's describer read —
# once nothing reads the key, no box needs healing off it.
drop_retired_content_pcm() {
    env_file_states_key "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_CONTENT_PCM" || return 1
    jasper_env_file_unset \
        "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_CONTENT_PCM" 0640 0750
}

apply_audio_runtime_env() {
    local changed=0
    local active_channels="" active_mode=0 graph_status="" active_lane_cap=""
    local content_format="" dac_format="" active_graph_payload="" active_endpoint_device=""
    drop_retired_content_pcm && changed=1
    # The CONTENT lane's width is a function of the fan-in coupling, never of the
    # DAC — an unrecognized card still has a definitive answer, so unlike
    # JASPER_OUTPUTD_DAC_FORMAT (which needs a recognized profile to query and is
    # therefore cleared to explicit-empty when parked) this key is emitted once,
    # ahead of the per-hardware branches, and is always definitive. That keeps the
    # same no-stale-value property the explicit-empty convention buys the DAC axis:
    # a hot-swap cannot leave a width the box is not running.
    content_format="$(resolved_content_format)"
    if [[ -n "$content_format" ]]; then
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_CONTENT_FORMAT" "$content_format" && changed=1
    else
        # No answer at all: the Python policy probe is unavailable. Leave whatever
        # the box already has rather than writing a guess — a hardcoded fallback
        # here would be a second spelling of DEFAULT_PLAYBACK_FORMAT, and an empty
        # value would silently narrow a wide box (outputd reads empty as S16_LE).
        : >"$RECONCILE_DEGRADED_MARKER" 2>/dev/null || true
        log_event "content_format_skip" \
            "reason=coupling_probe_unavailable outputd_env=${OUTPUTD_ENV_FILE}"
    fi
    if [[ "$OUTPUT_DAC_ID" == "dual_apple_usb_c_dac_4ch" && "$OUTPUT_DAC_RECOGNIZED" == "1" ]]; then
        OUTPUTD_ACTIVE_MODE=0
        OUTPUTD_ACTIVE_CHANNELS=""
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_BACKEND" "alsa" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_PCM" "dual_apple_usb_c_dac_4ch" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_A_PCM" "$DUAL_APPLE_DAC_A_PCM" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_B_PCM" "$DUAL_APPLE_DAC_B_PCM" && changed=1
        # Two LIVE outputd keys (DAC_FORMAT, SINK) from one registry probe; a
        # lost probe skips BOTH. See emit_dac_format_for_recognized.
        emit_dac_format_for_recognized "$OUTPUT_DAC_ID" && changed=1
        dac_format="$(env_file_value_from "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_FORMAT")"
        # Composite width is fixed at 4 (two stereo children); clear the
        # single-sink width knob so a stale value from a prior active single
        # DAC cannot reach outputd (which rejects != 4 on the composite sink).
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_ACTIVE_CHANNELS" "" && changed=1
        # The 4-ch composite sink is still fenced off the stereo-only TTS mixer
        # and dac_content lane by its width (content_channels=4 != 2) — outputd's
        # `is_full_range_stereo_lr_sink` was NOT widened in P8b item 1.
        #
        # What DID change: the composite may now be an ACTIVE-ring endpoint, so
        # the pair is STAGED when — and only when — the accepted graph names the
        # ring device. Deliberately narrower than the single-DAC branch, which
        # sets lane=1 for any accepted active graph: an ALOOP composite keeps the
        # unconditional clear it has today, byte for byte. `active_lane` is inert
        # on a composite at runtime (every guard that reads it already excludes
        # this sink on width or sink_mode), so writing =1 there would change no
        # behaviour — but it WOULD churn outputd.env and /state on boxes this
        # campaign has no business touching. Scope the new write to the path the
        # change is for; leave the other one alone.
        if [[ "$DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE" == "$RING_ACTIVE_OUTPUTD_PLAYBACK_DEVICE" ]]; then
            set_outputd_active_lane_pair "1" "$DUAL_APPLE_ACTIVE_ENDPOINT_DEVICE" && changed=1
        else
            set_outputd_active_lane_pair "" "" && changed=1
        fi
        log_event "runtime_env" \
            "mode=dual_apple content_format=${content_format:-unset} dac_format=${dac_format:-unset} outputd_env=${OUTPUTD_ENV_FILE} changed=${changed}"
    elif [[ "$OUTPUT_DAC_RECOGNIZED" == "1" ]]; then
        # A coherent single DAC runs the active lane ONLY when it declares one
        # (DacProfile.active_outputd_lane_channels = the cap) AND an
        # legal active-speaker graph whose playback width fits within that cap
        # is the live CamillaDSP config. We DRIVE WHAT WE USE: the gate returns
        # the config's ACTUAL driven width W (2..cap), and we emit that as
        # JASPER_OUTPUTD_ACTIVE_CHANNELS so outputd opens the DAC at exactly W —
        # a DAC8x running a 2-way drives 2 outputs, not 8. Fail-closed: without
        # a confirmed in-cap active graph the DAC stays ordinary stereo
        # (byte-identical to the pre-active path), so a recognized DAC8x is a
        # normal stereo speaker until commissioning loads its active baseline.
        active_lane_cap="$(active_lane_channels_for_dac "$OUTPUT_DAC_ID")"
        # Three outcomes, three remedies. All resolve passive (fail-closed);
        # they differ only in what an operator reading the journal should do.
        if [[ "$active_lane_cap" == "none" ]]; then
            # The registry answered: this DAC declares no active outputd lane,
            # so the width gate never ran. Fixed only by choosing a different
            # layout at /sound/setup/ — re-running anything here cannot change
            # it. Same literal, same meaning, as the /sound/setup/ save-guard's
            # refusal reason.
            graph_status="dac_no_active_lane"
            active_lane_cap=""
        elif [[ -n "$active_lane_cap" ]]; then
            # The gate ran; graph_status carries its own decline reason. On
            # success the payload is "<width> <endpoint_device>" from ONE
            # decision — split here rather than probed twice, so the width the
            # DAC is opened at and the endpoint the marker names always describe
            # the same classification of the same graph.
            if active_graph_payload="$(active_graph_status "$active_lane_cap")"; then
                active_mode=1
                active_channels="${active_graph_payload%% *}"
                active_endpoint_device="${active_graph_payload#* }"
                # A payload with no space at all means no device field; treat it
                # as absent rather than as a device named after the width.
                if [[ "$active_endpoint_device" == "$active_graph_payload" ]]; then
                    active_endpoint_device=""
                fi
            else
                graph_status="$active_graph_payload"
                active_channels=""
                active_endpoint_device=""
            fi
        else
            # No answer at all on a RECOGNIZED DAC: the lane-cap probe itself
            # failed (it swallows its own failure so it cannot abort the
            # reconcile). Transient — the next pass converges — so this must
            # NOT be reported as the permanent dac_no_active_lane.
            graph_status="lane_probe_failed"
        fi
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_BACKEND" "alsa" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_PCM" "outputd_dac" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_A_PCM" "" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_B_PCM" "" && changed=1
        # Two LIVE outputd keys (DAC_FORMAT, SINK) from one registry probe; a
        # lost probe skips BOTH. See emit_dac_format_for_recognized.
        emit_dac_format_for_recognized "$OUTPUT_DAC_ID" && changed=1
        dac_format="$(env_file_value_from "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_FORMAT")"
        if [[ "$active_mode" == "1" ]]; then
            OUTPUTD_ACTIVE_MODE=1
            OUTPUTD_ACTIVE_CHANNELS="$active_channels"
            set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_ACTIVE_CHANNELS" "$active_channels" && changed=1
            # Belt-and-suspenders for the latent outputd-TTS-mixer hazard: an
            # active 2-way speaker is ALSO 2-channel, so outputd's bare
            # content_channels==2 check would wrongly permit its post-crossover
            # TTS mixer / content bridge here. Mark the lane explicitly so outputd
            # fails those stereo-only features closed (full-range-to-tweeter
            # safety). Active-mode voice rides fanin, upstream of the crossover.
            # The endpoint device travels with it, from the same decision.
            set_outputd_active_lane_pair "1" "$active_endpoint_device" && changed=1
            log_event "runtime_env" \
                "mode=single_alsa_active active_channels=${active_channels} active_lane_cap=${active_lane_cap} active_endpoint=${active_endpoint_device:-unset} content_format=${content_format:-unset} dac_format=${dac_format:-unset} outputd_env=${OUTPUTD_ENV_FILE} changed=${changed}"
        else
            OUTPUTD_ACTIVE_MODE=0
            OUTPUTD_ACTIVE_CHANNELS=""
            # Clear the width knob so outputd defaults to stereo; a stale active
            # width would otherwise mis-size the (stereo) content lane.
            set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_ACTIVE_CHANNELS" "" && changed=1
            # Leaving active mode: clear the active-lane PAIR so a stale =1
            # cannot keep the stereo-only TTS mixer / content bridge fenced off on
            # an ordinary passive stereo DAC, and a stale ring-endpoint marker
            # cannot outlive the lane it was written with.
            set_outputd_active_lane_pair "" "" && changed=1
            log_event "runtime_env" \
                "mode=single_alsa content_format=${content_format:-unset} dac_format=${dac_format:-unset} outputd_env=${OUTPUTD_ENV_FILE} changed=${changed} active_graph=${graph_status:-none}"
        fi
    else
        OUTPUTD_ACTIVE_MODE=0
        OUTPUTD_ACTIVE_CHANNELS=""
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_BACKEND" "fake" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_SINK" "single_alsa" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_PCM" "outputd_dac" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_A_PCM" "" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DUAL_DAC_B_PCM" "" && changed=1
        # Unrecognized/parked: no profile to query, so clear rather than
        # query. Explicit empty (not omitted) matches ACTIVE_CHANNELS /
        # ACTIVE_LANE just below: this reconciler-owned file always states a
        # definitive value for every conditional key, so a DAC hot-swap from
        # a recognized to an unrecognized card cannot leave a stale format.
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_DAC_FORMAT" "" && changed=1
        set_env_file_var_if_changed "$OUTPUTD_ENV_TARGET_FILE" "JASPER_OUTPUTD_ACTIVE_CHANNELS" "" && changed=1
        set_outputd_active_lane_pair "" "" && changed=1
        log_event "runtime_env" \
            "mode=parked content_format=${content_format:-unset} dac_format=${dac_format:-unset} outputd_env=${OUTPUTD_ENV_FILE} changed=${changed}"
    fi
    if [[ "$changed" == "1" ]]; then
        return 0
    fi
    return 1
}

OBSERVED_AT_PASS_START="$(reconcile_observed_digest)"
if [[ "$PRINT_ENV" == "1" ]]; then
    observe_output_hardware_state 0
    apply_observed_single_policy
    apply_observed_composite_policy
    print_env
    exit 0
fi
# From here the pass mutates, so no stamp may stand until one completes. An
# abort in the window before the first state write (an OOM kill of one of the
# Python spawns, TimeoutStartSec) would otherwise leave a predecessor's stamp
# valid and the retry would be condition-skipped and report success.
rm -f -- "$RECONCILE_STAMP_PATH" "$RECONCILE_DEGRADED_MARKER"
reconcile_i2s_hat_boot
observe_output_hardware_state 1
sync_i2s_hat_reboot_marker
if [[ "$I2S_HAT_APPLY_ERROR" == "1" ]]; then
    restart_dac_init_for_record_change
    exit 74
fi
apply_observed_single_policy
apply_observed_composite_policy

if ! DEFAULT_OUTPUTD_CAPTURE_DEVICE="$(
    resolve_outputd_capture_device "$DEFAULT_OUTPUTD_PLAYBACK_DEVICE"
)" || [[ -z "$DEFAULT_OUTPUTD_CAPTURE_DEVICE" ]]; then
    outputd_endpoint_contract_failed_exit "$DEFAULT_OUTPUTD_PLAYBACK_DEVICE"
fi

env_changed=0
# dac_env_changed tracks ONLY a DAC-identity/card move — the class of change
# that can shift the mic/input profile and therefore requires stopping voice.
# env_changed stays the coarse "anything moved" flag for the complete log line.
dac_env_changed=0
outputd_env_changed=0
# outputd_committed becomes 1 only when the staged outputd.env is actually
# written (commit_outputd_env_stage returns 0). It is NOT outputd_env_changed,
# which is set pre-commit and can be cleared when validation rejects the stage.
outputd_committed=0
stage_outputd_env
set_env_var_if_changed "JASPER_AUDIO_DAC_ID" "$OUTPUT_DAC_ID" && { env_changed=1; dac_env_changed=1; }
set_env_var_if_changed "JASPER_AUDIO_DAC_CARD" "$OUTPUT_DAC_CARD" && { env_changed=1; dac_env_changed=1; }
apply_audio_runtime_env && outputd_env_changed=1
# A route change also counts toward env_changed so the outputd/audio restart
# still fires when appropriate.
if apply_route_env; then
    env_changed=1
fi
# Emit the active DAC's codified latency floor (#27). For a recognized DAC this
# is its profile floor (or cleared when the profile declares none); for an
# unrecognized/parked DAC clear any stale floor with an empty id.
if [[ "$OUTPUT_DAC_RECOGNIZED" == "1" ]]; then
    apply_latency_floor_env "$OUTPUT_DAC_ID"
else
    apply_latency_floor_env ""
fi
if [[ "$LATENCY_FLOOR_CHANGED" == "1" ]]; then
    outputd_env_changed=1
fi
if [[ "$outputd_env_changed" == "1" ]]; then
    if commit_outputd_env_stage; then
        env_changed=1
        outputd_committed=1
    fi
else
    cleanup_outputd_env_stage
    OUTPUTD_ENV_STAGE_FILE=""
    OUTPUTD_ENV_TARGET_FILE="$OUTPUTD_ENV_FILE"
    trap - EXIT
fi
if [[ "$OUTPUTD_ENV_STAGE_REJECTED" == "1" ]]; then
    # A REFUSED reconcile leaves the box running exactly as it was found.
    #
    # The staged candidate was rejected, so `preserved=1`: the runtime
    # outputd.env is byte-unchanged and this exit precedes every render. The box
    # is therefore still running the configuration it was running a second ago —
    # and it was running it because an earlier pass of THIS validator accepted
    # it. Stopping anything here converts a healthy box into a silent one on
    # behalf of a change that never landed.
    #
    # `preserved=1` scopes to outputd.env, which is the staged file. A DAC
    # identity move (JASPER_AUDIO_DAC_ID/_CARD) is written straight to
    # $ENV_FILE above and is NOT rolled back here — but it was not rolled back
    # by the old park either, which only silenced outputd rather than resolving
    # the split. outputd keeps its own previously-validated env against an
    # unchanged asound.conf, so a geometry or missing-card mismatch fails its
    # open loudly: silence or a loud failure, never wrong audio.
    #
    # It used to `park_output_audio` (stop jasper-voice + jasper-outputd) before
    # exiting. On jts3 2026-08-11 that stopped jasper-voice cleanly — Result=success,
    # NRestarts=0 — and nothing restarted it: the household lost the assistant
    # with no cue, no doctor delta, and no journal line saying so, until an
    # operator ran `systemctl start jasper-aec-reconcile` by hand
    # (captures/r7b-jts3-arm-20260811T111338Z, files 15 and 18).
    #
    # Ordering, not restoration: this was the FIRST stop this run would perform.
    # Every remaining call site that can stop a unit is downstream of this exit —
    # gate_role_services (`disable --now`), restart_audio_if_needed, and the
    # unrecognized-DAC park_output_audio — so validating before it is free and no
    # output unit needs restoring (the mixer pin below is not one of those).
    # The loud signal is unchanged: exit 78 fails the unit, and
    # `outputd_env_invalid preserved=1 detail=...` names the contradiction.
    log_event "outputd_candidate_rejected" \
        "action=preserve_runtime_env services=unchanged output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD}"
    restart_dac_init_for_record_change
    exit 78
fi
repair_generated_env_permissions

render_changed=0
render_asound_if_needed && render_changed=1
render_ring_conf_if_needed
# The first candidate publishes DAC and latency facts for graph rendering. It
# is deliberately not the final lane decision: a topology replacement parks
# before saving, while a boot with a topology/statefile disagreement is refused
# by the validator. After convergence below, a second validated candidate is
# the only one that may enable final output.
render_flat_cutover_if_needed
runtime_converge_failed=0
if converge_runtime_graph; then
    # The first candidate was intentionally built before graph convergence so
    # it could publish current DAC/floor facts for the renderer. Re-derive the
    # active-lane pair once the statefile names the graph that is actually live;
    # this is the only pass whose outputd decision may start final output.
    stage_outputd_env
    if apply_audio_runtime_env; then
        outputd_env_changed=1
    fi
    if commit_outputd_env_stage; then
        env_changed=1
        outputd_committed=1
    fi
    if [[ "$OUTPUTD_ENV_STAGE_REJECTED" == "1" ]]; then
        # Keep the previously validated preliminary candidate.  Do not restart
        # any service against a lane that the final graph failed to validate.
        runtime_converge_failed=1
        log_event "runtime_graph" \
            "result=failed reason=post_convergence_outputd_env_rejected action=preserve_preliminary_env"
        restart_dac_init_for_record_change
        exit 78
    fi
else
    # A live topology-replacement caller already parked before saving, so keep
    # the preliminary non-active outputd candidate rather than deriving an
    # active lane from an old graph. At boot the statefile may still be stale;
    # jasper-camilla Requires this oneshot and therefore cannot start after this
    # nonzero result.
    runtime_converge_failed=1
fi
gate_role_services
if [[ "$OUTPUT_DAC_RECOGNIZED" == "1" ]]; then
    # A DAC-identity or asound (render) change can move the mic/input profile,
    # so it takes the full path: stop jasper-voice, restart outputd, kick the
    # AEC reconciler. A committed change that touches ONLY outputd.env — a
    # floor re-emit, a runtime backend/sink change, or an active-lane width
    # change — cannot move the input profile, so it bounces outputd alone and
    # leaves wake detection up. Fail-safe: skipping the voice stop requires BOTH
    # dac_env_changed==0 AND render_changed==0 — any uncertainty (either flag
    # set) falls through to the full path (#1257).
    if [[ "$dac_env_changed" == "1" || "$render_changed" == "1" ]]; then
        restart_audio_if_needed 1
    elif [[ "$outputd_committed" == "1" ]]; then
        restart_outputd_only
    else
        start_outputd_if_recognized
    fi
    restart_route_runtime_if_needed "$ROUTE_FANIN_CHANGED"
    # Recognized DACs only. An unrecognized one has just taken park_output_audio
    # below; there is no output for a coupling to converge onto, and the park is
    # the loud end state (#2261), not a state to reconcile out of here.
    if [[ "$runtime_converge_failed" == "0" ]]; then
        kick_fanin_coupling_auto_if_needed "$dac_env_changed" "$render_changed"
    fi
else
    restart_route_runtime_if_needed "$ROUTE_FANIN_CHANGED"
    park_output_audio
fi

log_event "complete" \
    "output_dac_id=${OUTPUT_DAC_ID} output_dac_card=${OUTPUT_DAC_CARD} outputd_active_mode=${OUTPUTD_ACTIVE_MODE} outputd_active_channels=$(jasper_asound_log_token "$OUTPUTD_ACTIVE_CHANNELS") recognized=${OUTPUT_DAC_RECOGNIZED} env_changed=${env_changed} render_changed=${render_changed} dac_env_changed=${dac_env_changed} outputd_committed=${outputd_committed} runtime_converge_failed=${runtime_converge_failed}"
[[ "$runtime_converge_failed" == "0" ]] || exit 1
write_reconcile_stamp
