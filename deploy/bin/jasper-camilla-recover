#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Recovery handler for jasper-camilla.service start-limit exhaustion, run from
# its OnFailure=. Captures the ALSA ownership evidence a reboot would destroy,
# makes ONE bounded restart attempt, and parks the graph on a written record if
# that attempt does not hold (ADR-0175).

set -uo pipefail

REASON="manual"
SYSTEMCTL="${JASPER_SYSTEMCTL:-systemctl}"
RUN_DIR="${JASPER_CAMILLA_RECOVER_RUN_DIR:-/run}"
ASOUND_ROOT="${JASPER_ASOUND_ROOT:-/proc/asound}"
DEV_SND_ROOT="${JASPER_DEV_SND_ROOT:-/dev/snd}"
# jasper-camilla.service is Restart=always/RestartSec=2, so a doomed instance
# has replaced itself within ~2.5 s of dying; 3 s gives that cycle a margin.
LIVENESS_WAIT_SEC="${JASPER_CAMILLA_RECOVER_LIVENESS_WAIT_SEC:-3}"
# The park is terminal for the BOOT, so the record lives in /run: a reboot
# re-arms the graph by wiping it. Path and field vocabulary are the reader's
# contract (jasper/control/camilla_recover_state.py, ADR-0141).
PARK_STATE="${JASPER_CAMILLA_RECOVER_PARK_STATE:-${RUN_DIR%/}/jasper-camilla-recover.state}"

usage() {
    cat <<'EOF'
Usage: jasper-camilla-recover [--reason TEXT]

Capture ALSA ownership evidence and make one bounded restart attempt after
jasper-camilla.service exhausts its restart burst. Emits structured
event=camilla.recover.* lines on stderr and always exits 0, so the recovery
handler itself never starts a systemd failure cascade.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reason)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            REASON="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

quote_token() {
    printf '%q' "$1"
}

emit() {
    local name="$1"
    shift
    printf 'event=camilla.recover.%s' "$name" >&2
    while [[ $# -gt 0 ]]; do
        local key="$1"
        local value="${2:-}"
        shift 2
        printf ' %s=%s' "$key" "$(quote_token "$value")" >&2
    done
    printf '\n' >&2
}

# Seconds one evidence capture may run. Evidence must never spend the restart
# attempt's budget: a single `systemctl status` capture has been observed
# taking 19 s of this handler's deadline. Bash-native rather than coreutils
# `timeout`, which deploy/lib/jasper-camilla-guard-common.sh already treats as
# optional here.
CAPTURE_TIMEOUT_SEC=5

run_bounded() {
    local out="$1"
    shift
    "$@" >"$out" 2>&1 &
    local child=$!
    # The watchdog's own stdio goes to /dev/null: killing it below leaves its
    # `sleep` orphaned for up to CAPTURE_TIMEOUT_SEC, and an orphan holding
    # this handler's journal pipe would keep the pipe open that long after the
    # handler is done.
    ( sleep "$CAPTURE_TIMEOUT_SEC"; kill -TERM "$child" 2>/dev/null ) \
        >/dev/null 2>&1 &
    local watchdog=$!
    wait "$child" 2>/dev/null
    local status=$?
    kill -TERM "$watchdog" 2>/dev/null
    wait "$watchdog" 2>/dev/null
    return "$status"
}

run_capture() {
    local label="$1"
    shift
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        emit capture_unavailable label "$label" command "$cmd"
        return 0
    fi

    local tmp
    tmp="$(mktemp "${RUN_DIR%/}/camilla-recover.${label}.XXXXXX" 2>/dev/null)" || {
        emit capture_error label "$label" reason "mktemp_failed"
        return 0
    }
    emit capture_begin label "$label" command "$*"
    run_bounded "$tmp" "$@"
    local status=$?
    while IFS= read -r line; do
        emit capture_line label "$label" line "$line"
    done <"$tmp"
    rm -f "$tmp"
    emit capture_end label "$label" status "$status"
    return 0
}

capture_asound_status() {
    if [[ ! -d "$ASOUND_ROOT" ]]; then
        emit capture_absent label "asound_status" path "$ASOUND_ROOT"
        return 0
    fi

    local found=0
    while IFS= read -r -d '' status_file; do
        found=1
        emit asound_status_begin path "$status_file"
        while IFS= read -r line; do
            emit asound_status_line path "$status_file" line "$line"
        done <"$status_file"
        emit asound_status_end path "$status_file"
    done < <(find "$ASOUND_ROOT" -path '*pcm*/sub*/status' -type f -print0 2>/dev/null)

    if [[ "$found" -eq 0 ]]; then
        emit capture_absent label "asound_status" path "$ASOUND_ROOT"
    fi
}

capture_dev_snd_holders() {
    if [[ ! -d "$DEV_SND_ROOT" ]]; then
        emit capture_absent label "dev_snd" path "$DEV_SND_ROOT"
        return 0
    fi

    local devices=()
    local device
    for device in "$DEV_SND_ROOT"/*; do
        [[ -e "$device" ]] || continue
        devices+=("$device")
    done
    if [[ "${#devices[@]}" -eq 0 ]]; then
        emit capture_absent label "dev_snd" path "$DEV_SND_ROOT"
        return 0
    fi

    run_capture fuser fuser -v "${devices[@]}"
    run_capture lsof lsof "${devices[@]}"
}

unit_action() {
    local action="$1"
    local unit="$2"
    "$SYSTEMCTL" "$action" "$unit" >/dev/null 2>&1
    local status=$?
    emit unit_action action "$action" unit "$unit" status "$status"
    return 0
}

# The remediation sentence, written to the record AND the journal line so
# neither surface sends an operator to the other to learn what to do.
PARK_ACTION="free whatever holds CamillaDSP's ring endpoints or fix why it will not load (the capture_line/asound_status_line evidence in this journal names the holder), then: systemctl start jasper-camilla.service"
PARK_RE_ARM="nothing re-arms the core graph on its own: an operator 'systemctl start jasper-camilla.service', a deploy, or a reboot (the record lives in /run, so the park is per-boot)"

write_park_record() {
    local tmp
    mkdir -p "$(dirname "$PARK_STATE")" 2>/dev/null || true
    # tempfile+rename so a reader never sees a truncated record.
    tmp="${PARK_STATE}.tmp.$$"
    {
        printf 'parked_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'reason=%s\n' "$1"
        printf 'detail=%s\n' "$2"
        printf 'action=%s\n' "$PARK_ACTION"
        printf 're_arm=%s\n' "$PARK_RE_ARM"
    } >"$tmp" 2>/dev/null || true
    mv -f "$tmp" "$PARK_STATE" 2>/dev/null || rm -f "$tmp" 2>/dev/null || true
}

# The floor for a pass that cannot converge the graph (ADR-0175). reset-failed
# clears the exhausted burst and stop cancels Restart=always, so the unit
# cannot reach `failed` on its own and this handler's OnFailure= trigger is
# disarmed.
#
# ORDER: the record is written after the stop is ENQUEUED. Because
# jasper-camilla.service retires the record from its own ExecStartPost, the two
# orders trade different interleavings. Writing first lets a pending
# auto-restart delete the record of a park that still stands — a silent park.
# Writing second lets an external start that beats the stop job leave a record
# saying parked while CamillaDSP runs — a visible, wrong doctor row that the
# next start retires. The second is the recoverable half.
park_core_graph() {
    local reason="$1"
    local detail="$2"
    local stop_status
    unit_action reset-failed jasper-camilla.service
    # --no-block: a blocking stop of a daemon wedged on a busy ALSA device can
    # run to TimeoutStopSec (90 s default, none declared on the unit) inside a
    # handler that is itself deadlined, and a SIGTERM before the record write
    # would stop CamillaDSP with nothing recording why.
    "$SYSTEMCTL" --no-block stop jasper-camilla.service >/dev/null 2>&1
    stop_status=$?
    emit unit_action action "stop" unit "jasper-camilla.service" \
        status "$stop_status" mode "no_block"
    write_park_record "$reason" "$detail"
    emit park reason "$reason" detail "$detail" state "$PARK_STATE" \
        action "$PARK_ACTION" re_arm "$PARK_RE_ARM"
}

restart_camilla_once() {
    unit_action reset-failed jasper-camilla.service
    "$SYSTEMCTL" start jasper-camilla.service >/dev/null 2>&1
    local status=$?
    emit unit_action action "start" unit "jasper-camilla.service" status "$status"

    local detail="jasper-camilla.service would not start after one bounded restart attempt"
    if [[ "$status" -eq 0 ]]; then
        # `systemctl start` on a Type=simple unit returns 0 the instant the
        # process forks, so a CamillaDSP that starts and then exits on a busy
        # ALSA device still reads as success above. A bare `is-active` cannot
        # tell a live process from a fresh corpse -- RestartSec=2 means a
        # doomed instance reads "active" again ~2.5 s after each death.
        # NRestarts was reset by the reset-failed above, so a rise after the
        # wait means systemd already replaced the instance this pass started.
        sleep "$LIVENESS_WAIT_SEC"
        local nrestarts
        nrestarts="$("$SYSTEMCTL" show -p NRestarts --value jasper-camilla.service 2>/dev/null)"
        if [[ "$nrestarts" =~ ^[0-9]+$ ]] && (( nrestarts > 0 )); then
            emit liveness_check unit "jasper-camilla.service" nrestarts "$nrestarts" verdict "died_after_start"
            status=1
            detail="jasper-camilla.service started but exited again (NRestarts=${nrestarts}) within ${LIVENESS_WAIT_SEC}s of one bounded restart attempt"
        fi
        # A non-numeric/empty NRestarts means the probe was inconclusive; err
        # toward declaring recovery rather than parking a graph that might be
        # fine (a wrongly parked box is deaf until a human acts).
    fi

    if [[ "$status" -ne 0 ]]; then
        park_core_graph camilla_start_failed "$detail"
    else
        emit recovered action "camilla_restarted"
    fi
}

emit start reason "$REASON" service_result "${SERVICE_RESULT:-unknown}" exit_status "${EXIT_STATUS:-unknown}" invocation_id "${INVOCATION_ID:-unknown}"

# A standing park is checked BEFORE the captures: re-entry has to be a cheap
# no-op, and the run that wrote the record already captured the evidence that
# diagnosed it. The record is present only while the park stands —
# jasper-camilla.service's ExecStartPost retires it — so re-entry is gated on
# the cause, not on a clock.
if [[ -s "$PARK_STATE" ]]; then
    emit suppressed reason "parked" state "$PARK_STATE"
    exit 0
fi

capture_dev_snd_holders
capture_asound_status
run_capture service_state "$SYSTEMCTL" --no-pager --plain --full status jasper-camilla.service

restart_camilla_once
exit 0
