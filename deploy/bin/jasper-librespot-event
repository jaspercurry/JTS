#!/bin/sh
# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0
#
# librespot --onevent hook: merge this event's env vars into the state
# file that jasper.librespot_state reads (mux, volume_observers,
# jasper-control, the renderer client).
#
# librespot 0.8.0 has no local control API; it fires this command once
# per player event with the state in env vars (PLAYER_EVENT, VOLUME,
# TRACK_ID, ...), unfiltered — a moving volume slider is many events a
# minute — inside its own MemoryMax=200M cgroup on a 415 MB Pi Zero 2 W.
# So: POSIX sh, no interpreter, and `mv` is the only process this starts.
#
# Keys absent from an event keep their previous value, so a consumer
# reading between events sees the whole session, not the last event.
set -u

STATE=${JASPER_LIBRESPOT_STATE:-/run/librespot/state.env}
TMP=$STATE.tmp.$$

# 0644: non-root JTS daemons in other groups read this non-secret
# renderer telemetry, and librespot.service's UMask=0007 would
# otherwise publish it 0660.
umask 022

event=${PLAYER_EVENT-}
fresh=''
NL='
'

fail() {
    rm -f "$TMP"
    exit 1
}

# Emit one assignment and mark its key as rewritten by this event.
emit() {
    # A newline in a value would forge extra KEY=value lines that then
    # carry forward forever. librespot's event vars are ids, integers,
    # URIs and enums, so dropping the key (it keeps its previous value)
    # costs nothing and needs no escaping format.
    case $2 in *"$NL"*) return ;; esac
    fresh="$fresh $1"
    printf '%s=%s\n' "$1" "$2" || fail
}

case $STATE in
    */*) dir=${STATE%/*}
         [ -d "$dir" ] || mkdir -p "$dir" || fail ;;
esac

{
    emit LAST_EVENT "$event"
    [ "${PLAYER_EVENT+x}" ] && emit PLAYER_EVENT "$PLAYER_EVENT"
    [ "${TRACK_ID+x}" ] && emit TRACK_ID "$TRACK_ID"
    [ "${VOLUME+x}" ] && emit VOLUME "$VOLUME"
    [ "${POSITION_MS+x}" ] && emit POSITION_MS "$POSITION_MS"
    [ "${CLIENT_ID+x}" ] && emit CLIENT_ID "$CLIENT_ID"
    [ "${OLD_TRACK_ID+x}" ] && emit OLD_TRACK_ID "$OLD_TRACK_ID"
    [ "${NEW_TRACK_ID+x}" ] && emit NEW_TRACK_ID "$NEW_TRACK_ID"
    [ "${DURATION_MS+x}" ] && emit DURATION_MS "$DURATION_MS"
    [ "${REASON+x}" ] && emit REASON "$REASON"
    [ "${URI+x}" ] && emit URI "$URI"
    [ "${ITEM_TYPE+x}" ] && emit ITEM_TYPE "$ITEM_TYPE"
    [ "${PLAY_REQUEST_ID+x}" ] && emit PLAY_REQUEST_ID "$PLAY_REQUEST_ID"

    # Coarse playing/paused/stopped so consumers don't re-derive it.
    case $event in
        playing|started)
            emit PLAYING 1; emit PAUSED 0; emit STOPPED 0 ;;
        paused)
            emit PLAYING 0; emit PAUSED 1; emit STOPPED 0 ;;
        stopped)
            emit PLAYING 0; emit PAUSED 0; emit STOPPED 1 ;;
        session_disconnected)
            emit PLAYING 0; emit PAUSED 0; emit STOPPED 1
            emit SESSION_ACTIVE 0 ;;
        session_connected)
            emit SESSION_ACTIVE 1 ;;
    esac

    # Carry forward every key this event did not rewrite.
    if [ -f "$STATE" ]; then
        while IFS= read -r line; do
            case $line in *=*) ;; *) continue ;; esac
            case " $fresh " in *" ${line%%=*} "*) continue ;; esac
            printf '%s\n' "$line" || fail
        done < "$STATE"
    fi
} > "$TMP" || fail

# Atomic publish: readers see the previous file or this one, never a
# partial write, and never a temp file left behind on failure.
mv -f "$TMP" "$STATE" || fail
