#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# jasper-apply-airplay-mode — render /etc/shairport-sync.conf from the
# template at /etc/shairport-sync.conf.template, substituting:
#   - disable_synchronization based on /var/lib/jasper/airplay_mode.env
#   - AirPlay device name based on JASPER_SPEAKER_NAME (in
#     /var/lib/jasper/speaker_name.env)
#   - audio_backend_latency_offset_in_seconds derived from the active
#     CamillaDSP config's samplerate/chunksize/target_level, jasper-fanin's
#     live output delay (else Ring A's slot capacity, parsed from the
#     shipped ALSA ring conf), the CamillaDSP->outputd Ring B queue (also
#     parsed from that conf), and jasper-outputd's live DAC delay (else
#     JASPER_OUTPUTD_DAC_BUFFER_FRAMES); AND, only while this speaker is an
#     active bonded leader, the Snapcast round-trip playout buffer
#     (JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC, written by
#     jasper-grouping-reconcile). Absent on solo/follower => unchanged. The
#     formula is restated once, beside the placeholder in
#     deploy/shairport-sync.conf.template.
#   - output_device from the renderer-lane map (U3/P6d):
#     /var/lib/jasper/renderer_lanes.env's JASPER_SHAIRPORT_DEVICE line,
#     written by `jasper-audio-config renderer-lanes` — shairport_ring_lane
#     when the airplay lane is armed, shairport_substream otherwise. A
#     missing map or missing key falls back to shairport_substream, the
#     shipped snd-aloop lane, so an unarmed box renders byte-identically.
#     This script READS the map's already-resolved value; it never parses
#     the armed set, so the armed→device rule stays stated once, in
#     jasper/renderer_lanes.py.
#
# Invoked from three places:
#   1. shairport-sync.service ExecStartPre (so every restart picks up
#      the current mode). This is also what makes a lane flip land on the
#      unit's next start, and why the Tier-3 wedge supervisor's recovery
#      restart follows the lane map for free.
#   2. install.sh (so a fresh install lands with the conf rendered).
#   3. jasper-airplay-mode CLI and the /airplay/ web UI, after they
#      update the env file and before they try-restart shairport if active.
#
# Env input:
#   JASPER_AIRPLAY_FREE_RUNNING — "yes" / "no". Default: "no".
#   JASPER_SPEAKER_NAME         — display name shown in renderer pickers.
#                                 Default: JTS.
#   JASPER_CAMILLA_STATEFILE    — CamillaDSP statefile path.
#                                 Default: /var/lib/camilladsp/outputd-statefile.yml.
#   JASPER_CAMILLA_DEFAULT_CONFIG — fallback CamillaDSP config path.
#                                   Default: /etc/camilladsp/outputd-cutover.yml.
#   JASPER_RING_ALSA_CONF       — the shipped ALSA ring conf declaring Ring
#                                 A/B's period_frames + n_slots (installed
#                                 verbatim from
#                                 deploy/alsa/conf.d/60-jts-ring.conf),
#                                 parsed for the ring-geometry latency terms
#                                 below so a future ring retune propagates
#                                 without a code change.
#                                 Default: /etc/alsa/conf.d/60-jts-ring.conf.
#   JASPER_OUTPUTD_ENV_FILE     — optional outputd retune file used to
#                                 read JASPER_OUTPUTD_DAC_BUFFER_FRAMES,
#                                 the fallback when outputd STATUS offers
#                                 no live DAC delay. The
#                                 renderer intentionally ignores
#                                 outputd knobs from /etc/jasper/jasper.env
#                                 and the process environment because the
#                                 outputd unit overrides those with
#                                 packaged defaults before loading this
#                                 retune file.
#                                 Default: /var/lib/jasper/outputd.env.
#   JASPER_GROUPING_AIRPLAY_ENV_FILE — optional reconciler-owned file
#                                 carrying JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC,
#                                 the bonded-leader Snapcast round-trip
#                                 delay folded into the offset. Absent on
#                                 solo/follower (the common case) => the
#                                 offset is byte-identical to before.
#                                 Default: /var/lib/jasper/grouping-airplay.env.
#   JASPER_RENDERER_LANES_ENV   — the renderer-lane map read for
#                                 JASPER_SHAIRPORT_DEVICE (see the
#                                 output_device note above). Absent =>
#                                 shairport_substream.
#                                 Default: /var/lib/jasper/renderer_lanes.env.
# File outputs:
#   /etc/shairport-sync.conf — atomic write via /etc/shairport-sync.conf.tmp.
#
# Exits 0 on success. Logs to stderr.

set -euo pipefail

TEMPLATE="${JASPER_SHAIRPORT_TEMPLATE:-/etc/shairport-sync.conf.template}"
TARGET="${JASPER_SHAIRPORT_CONF:-/etc/shairport-sync.conf}"
ENV_FILE="${JASPER_AIRPLAY_MODE_ENV:-/var/lib/jasper/airplay_mode.env}"
JASPER_ENV_FILE="${JASPER_ENV_FILE:-/etc/jasper/jasper.env}"
SPEAKER_NAME_FILE="${JASPER_SPEAKER_NAME_FILE:-/var/lib/jasper/speaker_name.env}"
CAMILLA_STATEFILE="${JASPER_CAMILLA_STATEFILE:-/var/lib/camilladsp/outputd-statefile.yml}"
CAMILLA_DEFAULT_CONFIG="${JASPER_CAMILLA_DEFAULT_CONFIG:-/etc/camilladsp/outputd-cutover.yml}"
# Shipped ALSA ring conf (deploy/alsa/conf.d/60-jts-ring.conf, installed
# verbatim) declaring Ring A/B's period_frames + n_slots — the single
# source of truth for the ring-queue latency terms below.
RING_ALSA_CONF="${JASPER_RING_ALSA_CONF:-/etc/alsa/conf.d/60-jts-ring.conf}"
OUTPUTD_ENV_FILE="${JASPER_OUTPUTD_ENV_FILE:-/var/lib/jasper/outputd.env}"
# Reconciler-owned env file (jasper-grouping-reconcile) carrying the
# bonded-leader AirPlay offset delta. ABSENT/empty on solo + followers,
# so a non-bonded speaker derives the byte-identical solo offset.
GROUPING_AIRPLAY_ENV_FILE="${JASPER_GROUPING_AIRPLAY_ENV_FILE:-/var/lib/jasper/grouping-airplay.env}"
# The renderer-lane map (single writer: `jasper-audio-config renderer-lanes`).
# Read — never written — for the resolved JASPER_SHAIRPORT_DEVICE.
RENDERER_LANES_FILE="${JASPER_RENDERER_LANES_ENV:-/var/lib/jasper/renderer_lanes.env}"
FANIN_STATUS_SOCKET="${JASPER_FANIN_STATUS_SOCKET:-/run/jasper-fanin/control.sock}"
OUTPUTD_STATUS_SOCKET="${JASPER_OUTPUTD_STATUS_SOCKET:-/run/jasper-outputd/control.sock}"
DEFAULT_OUTPUTD_DAC_BUFFER_FRAMES=3072
# Ring A/B slot-geometry fallback, used only if RING_ALSA_CONF itself is
# unreadable (e.g. a non-ring topology, or a box that predates
# ring-platform.sh). Matches the shipped 60-jts-ring.conf defaults:
# period_frames 128, n_slots 2. Ring A counts the full 2-slot capacity —
# it runs pinned full in steady state (STATUS full_waits/published ratio
# ~1.0, rust/jasper-fanin/src/config.rs's RING_SLOT_FRAMES/ring_slots) —
# while Ring B counts only the one-slot floor: there is no equivalent
# pinned-full evidence for it, so only the proven minimum is charged.
DEFAULT_RING_A_LATENCY_FRAMES=256
DEFAULT_RING_B_LATENCY_FRAMES=128

if [[ ! -f "$TEMPLATE" ]]; then
    echo "jasper-apply-airplay-mode: template missing at $TEMPLATE" >&2
    exit 1
fi

camilla_config_path() {
    local configured=""
    if [[ -r "$CAMILLA_STATEFILE" ]]; then
        configured="$(
            awk '
                /^[[:space:]]*config_path[[:space:]]*:/ {
                    sub(/^[^:]*:[[:space:]]*/, "")
                    sub(/[[:space:]]*$/, "")
                    print
                    exit
                }
            ' "$CAMILLA_STATEFILE"
        )"
    fi

    if [[ -n "$configured" && -r "$configured" ]]; then
        printf '%s\n' "$configured"
    else
        printf '%s\n' "$CAMILLA_DEFAULT_CONFIG"
    fi
}

camilla_devices_int() {
    local config="$1"
    local key="$2"
    awk -v key="$key" '
        /^[[:space:]]*devices:[[:space:]]*($|#)/ {
            in_devices = 1
            next
        }
        in_devices && /^[^[:space:]#][^:]*:[[:space:]]*($|#)/ {
            exit
        }
        in_devices {
            line = $0
            sub(/[[:space:]]*#.*/, "", line)
            pattern = "^[[:space:]]*" key "[[:space:]]*:[[:space:]]*"
            if (line ~ pattern) {
                sub(pattern, "", line)
                sub(/[[:space:]]*$/, "", line)
                if (line ~ /^[0-9]+$/) {
                    print line
                    exit
                }
            }
        }
    ' "$config"
}

ring_conf_pcm_int() {
    local pcm_name="$1"
    local key="$2"
    # ALSA's own conf syntax is `key value` (space separated, no colon) —
    # distinct from CamillaDSP's YAML that camilla_devices_int above parses.
    [[ -r "$RING_ALSA_CONF" ]] || return 0
    awk -v pcm="$pcm_name" -v key="$key" '
        $0 ~ ("^pcm\\." pcm "[[:space:]]*\\{") {
            in_block = 1
            next
        }
        in_block && /^[[:space:]]*}/ {
            in_block = 0
            next
        }
        in_block {
            line = $0
            sub(/[[:space:]]*#.*/, "", line)
            pattern = "^[[:space:]]*" key "[[:space:]]+"
            if (line ~ pattern) {
                sub(pattern, "", line)
                sub(/[[:space:]]*$/, "", line)
                if (line ~ /^[0-9]+$/) {
                    print line
                    exit
                }
            }
        }
    ' "$RING_ALSA_CONF"
}

env_file_value() {
    local file="$1"
    local key="$2"
    [[ -r "$file" ]] || return 0
    awk -F= -v key="$key" '
        $1 ~ "^[[:space:]]*" key "[[:space:]]*$" {
            sub(/^[^=]*=[[:space:]]*/, "")
            sub(/[[:space:]]*(#.*)?$/, "")
            print
            exit
        }
    ' "$file"
}

positive_int_or_default() {
    local value="$1"
    local default="$2"
    value="${value//[[:space:]]/}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$default"
    fi
}

nonnegative_int_or_empty() {
    local value="$1"
    value="${value//[[:space:]]/}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ "$value" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$value"
    fi
}

status_json_value() {
    local socket="$1"
    local dotted_path="$2"
    local python="${JASPER_STATUS_PYTHON:-}"
    if [[ -z "$python" ]]; then
        if [[ -x /opt/jasper/.venv/bin/python ]]; then
            python=/opt/jasper/.venv/bin/python
        elif command -v python3 >/dev/null 2>&1; then
            python=python3
        else
            return 0
        fi
    fi
    [[ -S "$socket" ]] || return 0
    "$python" - "$socket" "$dotted_path" <<'PY' 2>/dev/null || true
import json
import socket
import sys

sock_path, dotted_path = sys.argv[1], sys.argv[2]
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    sock.settimeout(1.0)
    sock.connect(sock_path)
    sock.sendall(b"STATUS\n")
    chunks = []
    while True:
        chunk = sock.recv(65536)
        if not chunk:
            break
        chunks.append(chunk)
finally:
    sock.close()

value = json.loads(b"".join(chunks).decode("utf-8"))
for part in dotted_path.split("."):
    if not isinstance(value, dict):
        sys.exit(0)
    value = value.get(part)
if isinstance(value, bool) or value is None:
    sys.exit(0)
if isinstance(value, (int, float, str)):
    print(value)
PY
}

outputd_dac_buffer_frames() {
    local value
    value="$(env_file_value "$OUTPUTD_ENV_FILE" JASPER_OUTPUTD_DAC_BUFFER_FRAMES || true)"
    positive_int_or_default "$value" "$DEFAULT_OUTPUTD_DAC_BUFFER_FRAMES"
}

# Ring A (fan-in -> CamillaDSP, pcm.jts_ring_capture / program.ring): the
# shipped ring's full slot capacity, period_frames x n_slots. Falls back to
# DEFAULT_RING_A_LATENCY_FRAMES if RING_ALSA_CONF can't be read or parsed.
ring_a_latency_frames_default() {
    local period slots
    period="$(ring_conf_pcm_int jts_ring_capture period_frames || true)"
    slots="$(ring_conf_pcm_int jts_ring_capture n_slots || true)"
    if [[ "$period" =~ ^[0-9]+$ && "$slots" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$((period * slots))"
    else
        printf '%s\n' "$DEFAULT_RING_A_LATENCY_FRAMES"
    fi
}

# Ring B (CamillaDSP -> outputd, pcm.jts_ring_playback / content.ring): one
# slot's worth (period_frames alone — see DEFAULT_RING_B_LATENCY_FRAMES's
# comment for why this doesn't get the x n_slots multiplier Ring A gets).
# Falls back to DEFAULT_RING_B_LATENCY_FRAMES if RING_ALSA_CONF can't be
# read or parsed.
ring_b_latency_frames() {
    local period
    period="$(ring_conf_pcm_int jts_ring_playback period_frames || true)"
    if [[ "$period" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$period"
    else
        printf '%s\n' "$DEFAULT_RING_B_LATENCY_FRAMES"
    fi
}

fanin_output_latency_frames() {
    local value
    value="$(status_json_value "$FANIN_STATUS_SOCKET" output.snd_pcm_delay_frames || true)"
    value="$(nonnegative_int_or_empty "$value")"
    if [[ -n "$value" ]]; then
        echo "jasper-apply-airplay-mode: using fanin STATUS output.snd_pcm_delay_frames=$value" >&2
        printf '%s\n' "$value"
    else
        value="$(ring_a_latency_frames_default)"
        echo "jasper-apply-airplay-mode: fanin STATUS delay unavailable; using Ring A's ring-queue capacity (${value} frames)" >&2
        printf '%s\n' "$value"
    fi
}

outputd_dac_latency_frames() {
    local value
    value="$(status_json_value "$OUTPUTD_STATUS_SOCKET" dac.snd_pcm_delay_frames || true)"
    value="$(nonnegative_int_or_empty "$value")"
    if [[ -n "$value" ]]; then
        echo "jasper-apply-airplay-mode: using outputd STATUS dac.snd_pcm_delay_frames=$value" >&2
        printf '%s\n' "$value"
    else
        echo "jasper-apply-airplay-mode: outputd STATUS delay unavailable; using configured DAC buffer fallback" >&2
        outputd_dac_buffer_frames
    fi
}

bonded_extra_delay_sec() {
    # Extra fixed downstream delay (SECONDS) to fold into the offset while
    # this speaker is an active bonded LEADER: the Snapcast round-trip
    # playout buffer its own output gains over solo. Written by
    # jasper-grouping-reconcile into GROUPING_AIRPLAY_ENV_FILE as
    # JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC. ABSENT/empty on solo and
    # followers => 0.0 => byte-identical solo offset. A non-numeric or
    # negative value is ignored (0.0) so a bad write can never advance
    # playout PAST the anchor (a worse desync than the lag we correct).
    local value
    value="$(env_file_value "$GROUPING_AIRPLAY_ENV_FILE" \
        JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC || true)"
    value="${value//[[:space:]]/}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf '%s\n' "$value"
    else
        printf '0.0\n'
    fi
}

derive_audio_backend_latency_offset() {
    local config
    local sample_rate
    local chunksize
    local target_level
    local fanin_output_latency
    local ring_b_latency
    local outputd_dac_latency
    local bonded_extra_sec

    config="$(camilla_config_path)"
    if [[ ! -r "$config" ]]; then
        echo "jasper-apply-airplay-mode: Camilla config missing at $config; using latency offset 0.0" >&2
        printf '0.000000'
        return
    fi

    sample_rate="$(camilla_devices_int "$config" samplerate || true)"
    chunksize="$(camilla_devices_int "$config" chunksize || true)"
    target_level="$(camilla_devices_int "$config" target_level || true)"

    if [[ -z "$sample_rate" || -z "$chunksize" ]]; then
        echo "jasper-apply-airplay-mode: could not read samplerate/chunksize from $config; using latency offset 0.0" >&2
        printf '0.000000'
        return
    fi

    # CamillaDSP defaults target_level to chunksize when target_level is
    # absent. The AirPlay offset compensates only the added fixed backend
    # delay above that implicit one-chunk baseline.
    if [[ -z "$target_level" ]]; then
        target_level="$chunksize"
    fi

    # Ring A: fan-in's output queue (between jasper-fanin and
    # CamillaDSP/AEC). This is downstream of shairport's private input
    # lane, so it is also invisible to shairport's snd_pcm_delay(). Prefer
    # the live ALSA delay surfaced by jasper-fanin STATUS; a ring box
    # reports none (ADR-0100 left no playback PCM to sample), so in
    # practice Ring A's parsed slot capacity below is what the offset uses.
    fanin_output_latency="$(fanin_output_latency_frames)"

    # Ring B: CamillaDSP's output queue into outputd. Also downstream of
    # shairport's private lane and of CamillaDSP, so shairport cannot
    # observe it via snd_pcm_delay() either. No live STATUS path for this
    # one (see ring_b_latency_frames) — it comes straight from the shipped
    # ring geometry.
    ring_b_latency="$(ring_b_latency_frames)"

    # outputd's DAC queue is downstream of shairport's private lane
    # and of CamillaDSP. shairport cannot observe it via
    # snd_pcm_delay(), so account for the branch-owned output owner
    # explicitly. Prefer outputd's live snd_pcm_delay over the configured
    # buffer size because ALSA/DAC presentation delay can be larger than
    # the requested buffer.
    outputd_dac_latency="$(outputd_dac_latency_frames)"

    # Bonded-leader-only extra delay (seconds): the Snapcast round-trip
    # playout buffer. 0.0 unless jasper-grouping-reconcile wrote it for an
    # active bonded leader, so solo + follower offsets are unchanged.
    bonded_extra_sec="$(bonded_extra_delay_sec)"

    awk -v sample_rate="$sample_rate" \
        -v chunksize="$chunksize" \
        -v target_level="$target_level" \
        -v fanin_output_latency="$fanin_output_latency" \
        -v ring_b_latency="$ring_b_latency" \
        -v outputd_dac_latency="$outputd_dac_latency" \
        -v bonded_extra_sec="$bonded_extra_sec" '
        BEGIN {
            if (sample_rate <= 0) {
                printf "0.000000"
                exit
            }
            # Term by term: see the derivation beside
            # audio_backend_latency_offset_in_seconds in
            # deploy/shairport-sync.conf.template.
            #
            # NB: any single-quote (apostrophe) in this comment block would
            # close the surrounding awk single-quoted string and break
            # the script — do not paraphrase.
            #
            # CamillaDSP holds at least one full chunk, plus any extra fill
            # target_level asks for above that baseline (never negative —
            # a target BELOW chunksize is still one chunk of real buffering).
            camilla_term = target_level - chunksize
            if (camilla_term < 0) {
                camilla_term = 0
            }
            camilla_term = camilla_term + chunksize
            invisible_frames = fanin_output_latency + camilla_term + ring_b_latency + outputd_dac_latency
            offset = -((invisible_frames / sample_rate) + bonded_extra_sec)
            if ((offset > -0.0000005) && (offset < 0.0000005)) {
                offset = 0
            }
            printf "%.6f", offset
        }
    '
}

# Source the airplay_mode.env file if it exists. Default the variable
# AFTER sourcing so an explicit-but-empty value still falls back to the
# safe default.
if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE" 2>/dev/null || true
fi
# U3/P6d: the renderer device comes from the lane map's already-resolved
# JASPER_SHAIRPORT_DEVICE line (shairport_ring_lane when the airplay lane
# is armed, shairport_substream otherwise). Empty/missing — a fleet box
# with no map, or a map written before the airplay row existed — falls
# back to shairport_substream, the shipped snd-aloop lane. Reading the
# RESOLVED value (never the armed set) keeps the armed→device rule stated
# once, in jasper/renderer_lanes.py.
#
# Known precedence divergence, accepted: env_file_value takes the FIRST
# matching assignment (awk `print; exit`), while the map's Python reader
# (jasper.renderer_lanes._env_file_value) and systemd's EnvironmentFile=
# both take the LAST. Unreachable through the supported path — the map's
# single writer (render_renderer_lanes_env) emits each key exactly once —
# so only a hand-edited duplicate line could split the readers, and the
# doctor's "shairport-sync.conf: output_device" coherence check names the
# resulting armed-vs-rendered disagreement rather than leaving it silent.
renderer_device="$(env_file_value "$RENDERER_LANES_FILE" JASPER_SHAIRPORT_DEVICE || true)"
if [[ -z "$renderer_device" ]]; then
    renderer_device="shairport_substream"
fi
# Also source jasper.env (mode 0640, readable by root only — this
# script runs with the leading `+` privilege escalation from
# shairport-sync.service's ExecStartPre, so root-read is fine).
if [[ -r "$JASPER_ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$JASPER_ENV_FILE" 2>/dev/null || true
fi
if [[ -r "$SPEAKER_NAME_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$SPEAKER_NAME_FILE" 2>/dev/null || true
fi
mode="${JASPER_AIRPLAY_FREE_RUNNING:-no}"

airplay_name="${JASPER_SPEAKER_NAME:-JTS}"

case "$mode" in
    yes|YES|true|TRUE|1)
        disable_sync="yes"
        human="free-running (music-only, no A/V or multi-room sync)"
        ;;
    no|NO|false|FALSE|0)
        disable_sync="no"
        human="synced (matches AirPlay sender clock; needed for video A/V sync or multi-room)"
        ;;
    *)
        echo "jasper-apply-airplay-mode: invalid JASPER_AIRPLAY_FREE_RUNNING='$mode'; defaulting to no" >&2
        disable_sync="no"
        human="synced (defaulted from invalid value)"
        ;;
esac

latency_offset="$(derive_audio_backend_latency_offset)"
airplay_name_sed="$(printf '%s' "$airplay_name" | sed -e 's/[\/&]/\\&/g')"
# The map's writer only ever renders two known literals here, but the value
# crosses a sed replacement like the speaker name does, so it gets the same
# escape rather than a trust argument.
renderer_device_sed="$(printf '%s' "$renderer_device" | sed -e 's/[\/&]/\\&/g')"

tmp="${TARGET}.tmp.$$"
trap 'rm -f "$tmp"' EXIT

sed -e "s/__DISABLE_SYNCHRONIZATION__/${disable_sync}/g" \
    -e "s/__AIRPLAY_NAME__/${airplay_name_sed}/g" \
    -e "s/__AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__/${latency_offset}/g" \
    -e "s/__RENDERER_DEVICE__/${renderer_device_sed}/g" \
    "$TEMPLATE" > "$tmp"

# Validate the substitution actually happened — refuse to install a
# conf that still contains a placeholder (something went wrong with
# the template or the sed). shairport would otherwise fail to parse it
# and crash-loop.
if grep -qE "__DISABLE_SYNCHRONIZATION__|__AIRPLAY_NAME__|__AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__|__RENDERER_DEVICE__" "$tmp"; then
    echo "jasper-apply-airplay-mode: placeholder still present in rendered conf — refusing to install" >&2
    exit 2
fi

chmod 0644 "$tmp"
mv -f "$tmp" "$TARGET"
trap - EXIT

echo "jasper-apply-airplay-mode: $TARGET rendered for mode $human, name '$airplay_name', renderer device '$renderer_device', latency offset ${latency_offset}s" >&2
