#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# jasper-apply-airplay-mode — render /etc/shairport-sync.conf from the
# template at /etc/shairport-sync.conf.template, substituting:
#   - disable_synchronization based on /var/lib/jasper/airplay_mode.env
#   - AirPlay device name based on JASPER_SPEAKER_NAME (in
#     /var/lib/jasper/speaker_name.env)
#   - audio_backend_latency_offset_in_seconds derived from the active
#     CamillaDSP config's samplerate/chunksize/target_level, Ring A
#     (fan-in -> CamillaDSP) and Ring B (CamillaDSP -> outputd), and
#     jasper-outputd's live DAC delay (else the JASPER_OUTPUTD_DAC_BUFFER_FRAMES
#     its own env layers resolve, else the packaged default);
#     AND, only while this speaker is an active bonded leader, the Snapcast
#     round-trip playout buffer (JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC,
#     written by jasper-grouping-reconcile). Absent on solo/follower
#     => unchanged. The formula is restated once, beside the placeholder
#     in deploy/shairport-sync.conf.template. Full derivation: ADR-0205.
#     Ring A/B each prefer live daemon STATUS, then a jasper.ring_assets
#     parse of the shipped ALSA ring conf, then a hardcoded default — see
#     ring_a_latency_frames / ring_b_latency_frames below.
#   - output_device from the renderer-lane map (U3/P6d):
#     /var/lib/jasper/renderer_lanes.env's JASPER_SHAIRPORT_DEVICE line,
#     written by `jasper-audio-config renderer-lanes` — shairport_ring_lane
#     when the airplay lane is armed, shairport_substream otherwise. A
#     missing map or missing key falls back to shairport_substream, the
#     shipped snd-aloop lane, so an unarmed box renders byte-identically.
#     This script READS the map's already-resolved value; it never parses
#     the armed set, so the armed→device rule stays stated once, in
#     jasper/renderer_lanes.py.
#
# Invoked from three places:
#   1. shairport-sync.service ExecStartPre (so every restart picks up
#      the current mode). This is also what makes a lane flip land on the
#      unit's next start, and why the Tier-3 wedge supervisor's recovery
#      restart follows the lane map for free.
#   2. install.sh (so a fresh install lands with the conf rendered).
#   3. jasper-airplay-mode CLI and the /airplay/ web UI, after they
#      update the env file and before they try-restart shairport if active.
#
# Env input:
#   JASPER_AIRPLAY_FREE_RUNNING — "yes" / "no". Default: "no".
#   JASPER_SPEAKER_NAME         — display name shown in renderer pickers.
#                                 Default: JTS.
#   JASPER_CAMILLA_STATEFILE    — CamillaDSP statefile path.
#                                 Default: /var/lib/camilladsp/outputd-statefile.yml.
#   JASPER_CAMILLA_DEFAULT_CONFIG — fallback CamillaDSP config path.
#                                   Default: /etc/camilladsp/outputd-cutover.yml.
#   JASPER_RING_ALSA_CONF       — the shipped ALSA ring conf
#                                 (deploy/alsa/conf.d/60-jts-ring.conf,
#                                 installed verbatim), consulted only as
#                                 Ring A/B's PARSED fallback tier (via
#                                 jasper.ring_assets) when neither daemon's
#                                 live STATUS is available. Not read
#                                 directly by this script — see
#                                 ring_conf_parsed_frames.
#                                 Default: /etc/alsa/conf.d/60-jts-ring.conf.
#   JASPER_OUTPUTD_ENV_FILE     — optional outputd retune file, the first
#                                 layer read for
#                                 JASPER_OUTPUTD_DAC_BUFFER_FRAMES when
#                                 outputd STATUS offers no live DAC delay
#                                 (layer order: outputd_dac_buffer_frames).
#                                 Default: /var/lib/jasper/outputd.env.
#   JASPER_GROUPING_AIRPLAY_ENV_FILE — optional reconciler-owned file
#                                 carrying JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC,
#                                 the bonded-leader Snapcast round-trip
#                                 delay folded into the offset. Absent on
#                                 solo/follower (the common case) => the
#                                 offset is byte-identical to before.
#                                 Default: /var/lib/jasper/grouping-airplay.env.
#   JASPER_RENDERER_LANES_ENV   — the renderer-lane map read for
#                                 JASPER_SHAIRPORT_DEVICE (see the
#                                 output_device note above). Absent =>
#                                 shairport_substream.
#                                 Default: /var/lib/jasper/renderer_lanes.env.
#   JASPER_STATUS_PYTHON        — interpreter used for both the daemon
#                                 STATUS reads and the jasper.ring_assets
#                                 parse. Default: /opt/jasper/.venv/bin/python
#                                 if present, else python3 on PATH.
# File outputs:
#   /etc/shairport-sync.conf — atomic write via /etc/shairport-sync.conf.tmp.
#
# Exits 0 on success. Logs to stderr.

set -euo pipefail

TEMPLATE="${JASPER_SHAIRPORT_TEMPLATE:-/etc/shairport-sync.conf.template}"
TARGET="${JASPER_SHAIRPORT_CONF:-/etc/shairport-sync.conf}"
ENV_FILE="${JASPER_AIRPLAY_MODE_ENV:-/var/lib/jasper/airplay_mode.env}"
JASPER_ENV_FILE="${JASPER_ENV_FILE:-/etc/jasper/jasper.env}"
SPEAKER_NAME_FILE="${JASPER_SPEAKER_NAME_FILE:-/var/lib/jasper/speaker_name.env}"
CAMILLA_STATEFILE="${JASPER_CAMILLA_STATEFILE:-/var/lib/camilladsp/outputd-statefile.yml}"
CAMILLA_DEFAULT_CONFIG="${JASPER_CAMILLA_DEFAULT_CONFIG:-/etc/camilladsp/outputd-cutover.yml}"
# Ring A/B's PARSED fallback source (jasper.ring_assets), consulted only
# when neither daemon's live STATUS answers — see ring_conf_parsed_frames.
RING_ALSA_CONF="${JASPER_RING_ALSA_CONF:-/etc/alsa/conf.d/60-jts-ring.conf}"
OUTPUTD_ENV_FILE="${JASPER_OUTPUTD_ENV_FILE:-/var/lib/jasper/outputd.env}"
# Reconciler-owned env file (jasper-grouping-reconcile) carrying the
# bonded-leader AirPlay offset delta. ABSENT/empty on solo + followers,
# so a non-bonded speaker derives the byte-identical solo offset.
GROUPING_AIRPLAY_ENV_FILE="${JASPER_GROUPING_AIRPLAY_ENV_FILE:-/var/lib/jasper/grouping-airplay.env}"
# The renderer-lane map (single writer: `jasper-audio-config renderer-lanes`).
# Read — never written — for the resolved JASPER_SHAIRPORT_DEVICE.
RENDERER_LANES_FILE="${JASPER_RENDERER_LANES_ENV:-/var/lib/jasper/renderer_lanes.env}"
FANIN_STATUS_SOCKET="${JASPER_FANIN_STATUS_SOCKET:-/run/jasper-fanin/control.sock}"
OUTPUTD_STATUS_SOCKET="${JASPER_OUTPUTD_STATUS_SOCKET:-/run/jasper-outputd/control.sock}"
# jasper-outputd's compile-time DAC-buffer default, reached when neither env
# layer names the key. Python-free, like the ring defaults below, because this
# tier is what answers when the venv is the broken thing;
# test_airplay_default_dac_buffer_matches_the_runtime_plan pins it equal to
# jasper.audio_runtime_plan's copy so a retune cannot desync lip-sync silently.
DEFAULT_OUTPUTD_DAC_BUFFER_FRAMES=3072
# Ring A/B slot-geometry LAST-TIER fallback, reached only when both live
# STATUS and the jasper.ring_assets parse (see ring_conf_parsed_frames) are
# unavailable. Matches the shipped 60-jts-ring.conf: period_frames 128,
# n_slots 2. Ring A counts the full 2-slot capacity — it runs pinned full
# in steady state (STATUS full_waits/published ratio ~1.0,
# rust/jasper-ring/src/layout.rs's RING_SLOT_FRAMES, and fan-in's
# ring_slots) — while
# Ring B counts only the one-slot floor: there is no equivalent pinned-full
# evidence for it, so only the proven minimum is charged.
# test_ring_a_and_ring_b_defaults_match_shipped_conf_via_ring_assets pins
# these equal to a fresh jasper.ring_assets parse of the real shipped file,
# so a retune that moves the conf and forgets these constants fails loud.
DEFAULT_RING_A_LATENCY_FRAMES=256
DEFAULT_RING_B_LATENCY_FRAMES=128

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE_LIB="${JASPER_ENV_FILE_LIB:-}"

# Shared env-file reader (jasper_env_file_get). Sibling-first, installed path
# as fallback — same order and rationale as jasper-aec-reconcile's loader,
# which states it; the installed copy has no ../lib sibling and falls through.
#
# Absent or unusable is NOT fatal here, unlike in the reconcilers.
# install_renderers seeds /etc/shairport-sync.conf by running the INSTALLED
# copy of this script, and it runs before install_systemd_units publishes the
# lib — so on a fresh install the lib genuinely is not there yet and an exit
# would abort install.sh. Every read below already has a documented fallback
# (no / JTS / shairport_substream / the packaged DAC buffer), and that fallback
# IS the seed render; shairport-sync's ExecStartPre re-renders with the real
# lib on the next start. The stub says so on stderr rather than rendering
# defaults silently — readable is not usable either, since a zeroed lib
# sources cleanly and defines nothing.
load_env_file_lib() {
    if [[ -z "$ENV_FILE_LIB" ]]; then
        if [[ -r "${SCRIPT_DIR}/../lib/jasper-env-file.sh" ]]; then
            ENV_FILE_LIB="${SCRIPT_DIR}/../lib/jasper-env-file.sh"
        else
            ENV_FILE_LIB="/usr/local/lib/jasper/jasper-env-file.sh"
        fi
    fi
    if [[ -r "$ENV_FILE_LIB" ]]; then
        # shellcheck disable=SC1090
        source "$ENV_FILE_LIB"
    fi
    if ! declare -F jasper_env_file_get >/dev/null; then
        echo "jasper-apply-airplay-mode: env-file library unavailable (${ENV_FILE_LIB}); rendering from defaults" >&2
        jasper_env_file_get() { return 1; }
    fi
}
load_env_file_lib

if [[ ! -f "$TEMPLATE" ]]; then
    echo "jasper-apply-airplay-mode: template missing at $TEMPLATE" >&2
    exit 1
fi

camilla_config_path() {
    local configured=""
    if [[ -r "$CAMILLA_STATEFILE" ]]; then
        configured="$(
            awk '
                /^[[:space:]]*config_path[[:space:]]*:/ {
                    sub(/^[^:]*:[[:space:]]*/, "")
                    sub(/[[:space:]]*$/, "")
                    print
                    exit
                }
            ' "$CAMILLA_STATEFILE" || true
        )"
    fi

    if [[ -n "$configured" && -r "$configured" ]]; then
        printf '%s\n' "$configured"
    else
        printf '%s\n' "$CAMILLA_DEFAULT_CONFIG"
    fi
}

# Scans devices: ONCE for samplerate, chunksize, and target_level together
# — the three separate camilla_devices_int calls this replaced each forked
# their own awk process for just one key (each exiting as soon as it found
# its key or the block ended, so the saving here is three process forks
# collapsed to one, not scan depth). Prints the three values, in that
# order, "|"-joined on one line; a key the block never sets prints as an
# empty field.
#
# Deliberately NOT converged onto jasper.camilla_config_contract's
# parse_camilla_devices_config (the repo's richer Camilla YAML reader).
# Several helpers below are already python-free like this one, but this
# is the one python-free reader on the HARD-REQUIRED path: missing
# samplerate/chunksize fails the whole offset computation (falls to
# 0.0), with no further tier to fall through to. The STATUS and
# ring_assets tiers below are different in kind, not just in being
# python-free — they were already python-OPTIONAL, each with its own
# next tier to degrade to. Converging this one onto a python parser
# would gate AirPlay startup on venv health for the first time.
camilla_devices_ints() {
    local config="$1"
    awk '
        BEGIN {
            n = split("samplerate chunksize target_level", keys, " ")
        }
        /^[[:space:]]*devices:[[:space:]]*($|#)/ {
            in_devices = 1
            next
        }
        in_devices && /^[^[:space:]#][^:]*:[[:space:]]*($|#)/ {
            exit
        }
        in_devices {
            line = $0
            sub(/[[:space:]]*#.*/, "", line)
            for (i = 1; i <= n; i++) {
                key = keys[i]
                if (result[key] != "") continue
                pattern = "^[[:space:]]*" key "[[:space:]]*:[[:space:]]*"
                if (line ~ pattern) {
                    value = line
                    sub(pattern, "", value)
                    sub(/[[:space:]]*$/, "", value)
                    if (value ~ /^[0-9]+$/) result[key] = value
                }
            }
        }
        END {
            print result["samplerate"] "|" result["chunksize"] "|" result["target_level"]
        }
    ' "$config"
}

# The caller below strips surrounding whitespace/quotes, then a leading
# zero run (bash's own `$(( ))` misreads a leading-zero numeral as octal —
# "008" is a parse error, "010" silently means 8, not ten — and every
# resolved value here eventually crosses a bash arithmetic multiply), then
# bound to 6 digits: a generous ceiling no real frame count needs (>20s at
# 48kHz) that keeps every downstream $(( )) safely inside bash's signed
# 64-bit range regardless of what a hand-edited env file contains.
_strip_and_bound_int() {
    local value="$1"
    value="${value//[[:space:]]/}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ "$value" =~ ^0*([0-9]+)$ ]]; then
        value="${BASH_REMATCH[1]}"
    fi
    printf '%s\n' "$value"
}

nonnegative_int_or_empty() {
    local value
    value="$(_strip_and_bound_int "$1")"
    if [[ "$value" =~ ^[0-9]{1,6}$ ]]; then
        printf '%s\n' "$value"
    fi
}

# The interpreter shared by every daemon-STATUS read and the
# jasper.ring_assets parse below. Prefer the runtime venv (so `import
# jasper.*` resolves without a PYTHONPATH), then bare python3 on PATH.
# Empty output (nothing on stdout) means "no usable interpreter" — every
# caller treats that as its tier failing, never as a hard error.
resolve_jasper_python() {
    local python="${JASPER_STATUS_PYTHON:-}"
    if [[ -n "$python" ]]; then
        printf '%s\n' "$python"
        return 0
    fi
    if [[ -x /opt/jasper/.venv/bin/python ]]; then
        printf '%s\n' /opt/jasper/.venv/bin/python
        return 0
    fi
    if command -v python3 >/dev/null 2>&1; then
        printf '%s\n' python3
    fi
}

# One-fetch contract: a daemon's STATUS reply already carries every field
# this script wants from it in one JSON blob, so this connects and reads
# ONCE per call (via jasper.route_latency.status_socket.
# read_status_socket_or_none, the module that already owns this connect+
# `STATUS\n`+recv-to-EOF+parse mechanic for doctor/AEC/route-latency
# callers) and pulls out however many dotted paths are asked for — never
# one connect+read per field.
#
# Contract: exactly one field per requested dotted path, in that order,
# "|"-joined on one line — a call site's IFS-read must list exactly as
# many variables as paths, or a missing one silently absorbs the next
# path's value into the last variable and degrades that tier without
# erroring. A field is empty when it is absent/null/non-scalar in the
# reply, OR when its string form contains "|" or a newline (never emit a
# value that would shear the join — every JTS STATUS field today is a
# plain number, so this is a defensive floor, not an observed case). The
# WHOLE line is empty when the fetch itself fails (no python, no jasper
# import, no socket, connect/read/parse error) — every caller already
# treats an empty field as "this tier has nothing." Trade-off, deliberate:
# one connect per socket means every field comes from one consistent
# snapshot, but it also means a transient connect failure now empties
# that daemon's whole live tier at once, where per-field fetching failed
# each field independently.
status_json_values() {
    local socket="$1"
    shift
    local python
    python="$(resolve_jasper_python || true)"
    [[ -n "$python" ]] || return 0
    [[ -S "$socket" ]] || return 0
    "$python" - "$socket" "$@" <<'PY' 2>/dev/null || true
import sys

try:
    from jasper.route_latency.status_socket import read_status_socket_or_none
except ImportError:
    sys.exit(0)

sock_path = sys.argv[1]
dotted_paths = sys.argv[2:]
status = read_status_socket_or_none(sock_path)
if status is None:
    sys.exit(0)

fields = []
for dotted_path in dotted_paths:
    value = status
    for part in dotted_path.split("."):
        if not isinstance(value, dict):
            value = None
            break
        value = value.get(part)
    if isinstance(value, bool) or not isinstance(value, (int, float, str)):
        value = None
    elif isinstance(value, str) and ("|" in value or "\n" in value):
        value = None
    fields.append("" if value is None else str(value))
print("|".join(fields))
PY
}

# Ring A/B geometry parsed straight from the shipped ALSA ring conf via
# jasper.ring_assets — the production authority for this file's schema
# (brace-MATCHED block bodies, torn-conf detection across the file's
# shared period_frames). Never a bash/awk re-parse of that schema: a
# from-scratch line scanner cannot see a nested `hint { ... }` block, an
# Allman-style opening brace on its own line, or a torn conf declaring two
# different period_frames values the way this module's own tests already
# pin it must.
#
# mode="capacity" prints period_frames x n_slots for the named PCM block
# (Ring A's tier); mode="period" prints period_frames alone, shared by
# every ring so pcm_name is unused in that mode but still passed for one
# uniform call shape (Ring B's tier). Empty output on any failure — no
# python, no jasper import, conf unreadable, or a torn/absent block — so
# the caller falls through to its next tier rather than failing the render.
ring_conf_parsed_frames() {
    local pcm_name="$1"
    local mode="$2"
    local python
    python="$(resolve_jasper_python || true)"
    [[ -n "$python" ]] || return 0
    "$python" - "$RING_ALSA_CONF" "$pcm_name" "$mode" <<'PY' 2>/dev/null || true
import sys

try:
    from jasper.ring_assets import ring_conf_n_slots, ring_conf_period_frames
except ImportError:
    sys.exit(0)

conf_d, pcm_name, mode = sys.argv[1], sys.argv[2], sys.argv[3]
period = ring_conf_period_frames(conf_d)
if period is None:
    sys.exit(0)
if mode == "period":
    print(period)
    sys.exit(0)
slots = ring_conf_n_slots(pcm_name, conf_d)
if slots is None:
    sys.exit(0)
print(period * slots)
PY
}

# What jasper-outputd resolves JASPER_OUTPUTD_DAC_BUFFER_FRAMES to, walking
# the unit's EnvironmentFile layers highest-precedence first: the
# reconciler-owned outputd.env, then /etc/jasper/jasper.env, then the daemon's
# compile-time default. jasper-outputd.service pins NO `Environment=` for this
# key precisely so that order holds. A key that is PRESENT but empty or
# non-numeric is terminal, as it is for systemd: the daemon then sees that
# value, not a lower layer's, and falls to its own default.
outputd_dac_buffer_frames() {
    local file raw value
    for file in "$OUTPUTD_ENV_FILE" "$JASPER_ENV_FILE"; do
        raw="$(jasper_env_file_get "$file" JASPER_OUTPUTD_DAC_BUFFER_FRAMES)" || continue
        value="$(nonnegative_int_or_empty "$raw")"
        if [[ -n "$value" && "$value" -gt 0 ]]; then
            printf '%s\n' "$value"
            return
        fi
        break
    done
    printf '%s\n' "$DEFAULT_OUTPUTD_DAC_BUFFER_FRAMES"
}

# Ring A (fan-in -> CamillaDSP, pcm.jts_ring_capture / program.ring).
# Richest evidence first:
#   tier=live-status (ALSA delay) — fanin STATUS output.snd_pcm_delay_frames,
#     the real ALSA queue depth on a LOOPBACK-topology box. This field
#     predates the ring and stays correct there; it is always null on the
#     ring topology (ADR-0100 left no playback PCM to sample), which is
#     exactly when the next tier is what actually answers.
#   tier=live-status (ring occupancy) — output.ring.occupancy (the live
#     write_seq-read_seq depth, refreshed every render period) times
#     output.period_frames (the ring's slot size). Absent whenever
#     output.ring itself is absent — a non-ring topology, i.e. exactly the
#     case the tier above already answered.
#   tier=parsed — jasper.ring_assets's period_frames x n_slots for
#     pcm.jts_ring_capture, reached only when fanin's STATUS is entirely
#     unavailable (daemon down, no socket).
#   tier=default — DEFAULT_RING_A_LATENCY_FRAMES, reached only when the
#     conf itself cannot be read or parsed either.
ring_a_latency_frames() {
    # Args: fanin's pre-fetched output.snd_pcm_delay_frames,
    # output.ring.occupancy, output.period_frames — one status_json_values
    # call per render (see derive_audio_backend_latency_offset) supplies
    # all three; this function fetches nothing itself.
    local value
    value="$(nonnegative_int_or_empty "$1")"
    if [[ -n "$value" ]]; then
        echo "jasper-apply-airplay-mode: ring_a tier=live-status basis=alsa-delay frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi

    local occupancy period
    occupancy="$(nonnegative_int_or_empty "$2")"
    period="$(nonnegative_int_or_empty "$3")"
    if [[ -n "$occupancy" && -n "$period" ]]; then
        value="$((occupancy * period))"
        echo "jasper-apply-airplay-mode: ring_a tier=live-status basis=ring-occupancy occupancy=$occupancy period_frames=$period frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi

    value="$(ring_conf_parsed_frames jts_ring_capture capacity || true)"
    if [[ "$value" =~ ^[0-9]+$ ]]; then
        echo "jasper-apply-airplay-mode: ring_a tier=parsed frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi

    echo "jasper-apply-airplay-mode: ring_a tier=default frames=$DEFAULT_RING_A_LATENCY_FRAMES" >&2
    printf '%s\n' "$DEFAULT_RING_A_LATENCY_FRAMES"
}

# Ring B (CamillaDSP -> outputd, pcm.jts_ring_playback / content.ring).
#   tier=live-status — outputd STATUS shm_ring.occupancy (live
#     write_seq-read_seq depth, refreshed every DAC period) times
#     shm_ring.slot_frames. Absent whenever shm_ring itself is unconfigured
#     (non-ring topology) or outputd predates the field.
#   tier=parsed — jasper.ring_assets's period_frames for pcm.jts_ring_playback
#     (one slot's worth, NOT x n_slots — unlike Ring A there is no
#     pinned-full evidence for Ring B, so only the proven one-slot floor is
#     charged; see DEFAULT_RING_B_LATENCY_FRAMES's comment above).
#   tier=default — DEFAULT_RING_B_LATENCY_FRAMES.
ring_b_latency_frames() {
    # Args: outputd's pre-fetched shm_ring.occupancy, shm_ring.slot_frames
    # — see ring_a_latency_frames's comment; same one-fetch-per-render
    # contract, outputd's socket instead of fanin's.
    local occupancy slot_frames value
    occupancy="$(nonnegative_int_or_empty "$1")"
    slot_frames="$(nonnegative_int_or_empty "$2")"
    if [[ -n "$occupancy" && -n "$slot_frames" ]]; then
        value="$((occupancy * slot_frames))"
        echo "jasper-apply-airplay-mode: ring_b tier=live-status occupancy=$occupancy slot_frames=$slot_frames frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi

    value="$(ring_conf_parsed_frames jts_ring_playback period || true)"
    if [[ "$value" =~ ^[0-9]+$ ]]; then
        echo "jasper-apply-airplay-mode: ring_b tier=parsed frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi

    echo "jasper-apply-airplay-mode: ring_b tier=default frames=$DEFAULT_RING_B_LATENCY_FRAMES" >&2
    printf '%s\n' "$DEFAULT_RING_B_LATENCY_FRAMES"
}

outputd_dac_latency_frames() {
    # Arg: outputd's pre-fetched dac.snd_pcm_delay_frames — same fetch as
    # ring_b_latency_frames's args, shared once per render (see
    # derive_audio_backend_latency_offset), not fetched again here.
    local value
    value="$(nonnegative_int_or_empty "$1")"
    if [[ -n "$value" ]]; then
        echo "jasper-apply-airplay-mode: outputd_dac tier=live-status frames=$value" >&2
        printf '%s\n' "$value"
        return
    fi
    value="$(outputd_dac_buffer_frames)"
    echo "jasper-apply-airplay-mode: outputd_dac tier=default frames=$value" >&2
    printf '%s\n' "$value"
}

bonded_extra_delay_sec() {
    # Extra fixed downstream delay (SECONDS) to fold into the offset while
    # this speaker is an active bonded LEADER: the Snapcast round-trip
    # playout buffer its own output gains over solo. Written by
    # jasper-grouping-reconcile into GROUPING_AIRPLAY_ENV_FILE as
    # JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC. ABSENT/empty on solo and
    # followers => 0.0 => byte-identical solo offset. A non-numeric or
    # negative value is ignored (0.0) so a bad write can never advance
    # playout PAST the anchor (a worse desync than the lag we correct).
    local value
    value="$(jasper_env_file_get "$GROUPING_AIRPLAY_ENV_FILE" \
        JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC || true)"
    value="${value//[[:space:]]/}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    if [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        printf '%s\n' "$value"
    else
        printf '0.0\n'
    fi
}

derive_audio_backend_latency_offset() {
    local config
    local sample_rate
    local chunksize
    local target_level
    local ring_a_latency
    local ring_b_latency
    local outputd_dac_latency
    local bonded_extra_sec
    local camilla_fields
    local fanin_fields outputd_fields
    local fanin_delay_frames fanin_ring_occupancy fanin_period_frames
    local outputd_ring_occupancy outputd_slot_frames outputd_dac_delay_frames

    config="$(camilla_config_path || true)"
    if [[ ! -r "$config" ]]; then
        echo "jasper-apply-airplay-mode: Camilla config missing at $config; using latency offset 0.0" >&2
        printf '0.000000'
        return
    fi

    camilla_fields="$(camilla_devices_ints "$config" || true)"
    IFS='|' read -r sample_rate chunksize target_level <<< "$camilla_fields"

    if [[ -z "$sample_rate" || -z "$chunksize" ]]; then
        echo "jasper-apply-airplay-mode: could not read samplerate/chunksize from $config; using latency offset 0.0" >&2
        printf '0.000000'
        return
    fi

    # CamillaDSP defaults target_level to chunksize when target_level is
    # absent. The AirPlay offset compensates only the added fixed backend
    # delay above that implicit one-chunk baseline.
    if [[ -z "$target_level" ]]; then
        target_level="$chunksize"
    fi

    # ONE STATUS fetch per daemon per render (status_json_values), not one
    # per dotted field: fanin serves Ring A's three candidate fields and
    # outputd serves Ring B's and the DAC's in a single JSON reply apiece,
    # so a fetch per field cost four extra round-trips for nothing — six
    # total (3 fanin + 3 outputd), unconditionally: fanin's ALSA-delay
    # field is null every period on the only transport (ADR-0100 deleted
    # the loopback route this field once served), so the old code always
    # walked the 3-field path on both sockets, never fewer.
    fanin_fields="$(status_json_values "$FANIN_STATUS_SOCKET" \
        output.snd_pcm_delay_frames output.ring.occupancy output.period_frames || true)"
    IFS='|' read -r fanin_delay_frames fanin_ring_occupancy fanin_period_frames <<< "$fanin_fields"
    outputd_fields="$(status_json_values "$OUTPUTD_STATUS_SOCKET" \
        shm_ring.occupancy shm_ring.slot_frames dac.snd_pcm_delay_frames || true)"
    IFS='|' read -r outputd_ring_occupancy outputd_slot_frames outputd_dac_delay_frames <<< "$outputd_fields"

    # Ring A: fan-in's output queue (between jasper-fanin and
    # CamillaDSP/AEC). This is downstream of shairport's private input
    # lane, so it is also invisible to shairport's snd_pcm_delay(). See
    # ring_a_latency_frames for the tier cascade.
    ring_a_latency="$(ring_a_latency_frames \
        "$fanin_delay_frames" "$fanin_ring_occupancy" "$fanin_period_frames" || true)"

    # Ring B: CamillaDSP's output queue into outputd. Also downstream of
    # shairport's private lane and of CamillaDSP, so shairport cannot
    # observe it via snd_pcm_delay() either. See ring_b_latency_frames.
    ring_b_latency="$(ring_b_latency_frames \
        "$outputd_ring_occupancy" "$outputd_slot_frames" || true)"

    # outputd's DAC queue is downstream of shairport's private lane
    # and of CamillaDSP. shairport cannot observe it via
    # snd_pcm_delay(), so account for the branch-owned output owner
    # explicitly. Prefer outputd's live snd_pcm_delay over the configured
    # buffer size because ALSA/DAC presentation delay can be larger than
    # the requested buffer.
    outputd_dac_latency="$(outputd_dac_latency_frames "$outputd_dac_delay_frames" || true)"

    # Bonded-leader-only extra delay (seconds): the Snapcast round-trip
    # playout buffer. 0.0 unless jasper-grouping-reconcile wrote it for an
    # active bonded leader, so solo + follower offsets are unchanged.
    bonded_extra_sec="$(bonded_extra_delay_sec || true)"

    # LC_ALL=C: printf "%.6f" renders the decimal point per the process
    # locale, and a comma-decimal (e.g. de_DE.UTF-8) would write a
    # rendered conf shairport-sync cannot parse as a number, crash-looping
    # ExecStartPre. Pin the C locale on this one invocation rather than
    # trust every future caller's environment.
    LC_ALL=C awk -v sample_rate="$sample_rate" \
        -v chunksize="$chunksize" \
        -v target_level="$target_level" \
        -v ring_a_latency="$ring_a_latency" \
        -v ring_b_latency="$ring_b_latency" \
        -v outputd_dac_latency="$outputd_dac_latency" \
        -v bonded_extra_sec="$bonded_extra_sec" '
        BEGIN {
            if (sample_rate <= 0) {
                printf "0.000000"
                exit
            }
            # Term by term: see the derivation beside
            # audio_backend_latency_offset_in_seconds in
            # deploy/shairport-sync.conf.template, and ADR-0205 for the
            # full four-term ledger and empirical validation path.
            #
            # NB: any single-quote (apostrophe) in this comment block would
            # close the surrounding awk single-quoted string and break
            # the script — do not paraphrase.
            #
            # CamillaDSP holds at least one full chunk, plus any extra fill
            # target_level asks for above that baseline (never negative —
            # a target BELOW chunksize is still one chunk of real buffering).
            camilla_term = target_level - chunksize
            if (camilla_term < 0) {
                camilla_term = 0
            }
            camilla_term = camilla_term + chunksize
            invisible_frames = ring_a_latency + camilla_term + ring_b_latency + outputd_dac_latency
            offset = -((invisible_frames / sample_rate) + bonded_extra_sec)
            if ((offset > -0.0000005) && (offset < 0.0000005)) {
                offset = 0
            }
            printf "%.6f", offset
        }
    '
}

# U3/P6d: the renderer device comes from the lane map's already-resolved
# JASPER_SHAIRPORT_DEVICE line (shairport_ring_lane when the airplay lane
# is armed, shairport_substream otherwise). Empty/missing — a fleet box
# with no map, or a map written before the airplay row existed — falls
# back to shairport_substream, the shipped snd-aloop lane. Reading the
# RESOLVED value (never the armed set) keeps the armed→device rule stated
# once, in jasper/renderer_lanes.py.
renderer_device="$(jasper_env_file_get "$RENDERER_LANES_FILE" JASPER_SHAIRPORT_DEVICE || true)"
if [[ -z "$renderer_device" ]]; then
    renderer_device="shairport_substream"
fi

# Mode and display name, layered lowest-precedence first: inherited
# environment (install.sh and the CLI can pass one), then airplay_mode.env,
# then jasper.env, then speaker_name.env. A file that DEFINES the key wins
# even when empty; the `:-` defaults below turn that empty into the fallback.
mode="${JASPER_AIRPLAY_FREE_RUNNING:-}"
airplay_name="${JASPER_SPEAKER_NAME:-}"
for env_layer in "$ENV_FILE" "$JASPER_ENV_FILE" "$SPEAKER_NAME_FILE"; do
    if layer_value="$(jasper_env_file_get "$env_layer" JASPER_AIRPLAY_FREE_RUNNING)"; then
        mode="$layer_value"
    fi
    if layer_value="$(jasper_env_file_get "$env_layer" JASPER_SPEAKER_NAME)"; then
        airplay_name="$layer_value"
    fi
done
mode="${mode:-no}"
airplay_name="${airplay_name:-JTS}"

case "$mode" in
    yes|YES|true|TRUE|1)
        disable_sync="yes"
        human="free-running (music-only, no A/V or multi-room sync)"
        ;;
    no|NO|false|FALSE|0)
        disable_sync="no"
        human="synced (matches AirPlay sender clock; needed for video A/V sync or multi-room)"
        ;;
    *)
        echo "jasper-apply-airplay-mode: invalid JASPER_AIRPLAY_FREE_RUNNING='$mode'; defaulting to no" >&2
        disable_sync="no"
        human="synced (defaulted from invalid value)"
        ;;
esac

latency_offset="$(derive_audio_backend_latency_offset)"
airplay_name_sed="$(printf '%s' "$airplay_name" | sed -e 's/[\/&]/\\&/g')"
# The map's writer only ever renders two known literals here, but the value
# crosses a sed replacement like the speaker name does, so it gets the same
# escape rather than a trust argument.
renderer_device_sed="$(printf '%s' "$renderer_device" | sed -e 's/[\/&]/\\&/g')"

tmp="${TARGET}.tmp.$$"
trap 'rm -f "$tmp"' EXIT

sed -e "s/__DISABLE_SYNCHRONIZATION__/${disable_sync}/g" \
    -e "s/__AIRPLAY_NAME__/${airplay_name_sed}/g" \
    -e "s/__AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__/${latency_offset}/g" \
    -e "s/__RENDERER_DEVICE__/${renderer_device_sed}/g" \
    "$TEMPLATE" > "$tmp"

# Validate the substitution actually happened — refuse to install a
# conf that still contains a placeholder (something went wrong with
# the template or the sed). shairport would otherwise fail to parse it
# and crash-loop.
if grep -qE "__DISABLE_SYNCHRONIZATION__|__AIRPLAY_NAME__|__AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__|__RENDERER_DEVICE__" "$tmp"; then
    echo "jasper-apply-airplay-mode: placeholder still present in rendered conf — refusing to install" >&2
    exit 2
fi

chmod 0644 "$tmp"
mv -f "$tmp" "$TARGET"
trap - EXIT

echo "jasper-apply-airplay-mode: $TARGET rendered for mode $human, name '$airplay_name', renderer device '$renderer_device', latency offset ${latency_offset}s" >&2
