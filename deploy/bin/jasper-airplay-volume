#!/bin/sh

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# jasper-airplay-volume — shairport-sync's volume hooks, and the one inbound
# path from an AirPlay sender's volume control to the JTS master fader
# (ADR-0206). Two invocations, both wired from the rendered config:
#
#   jasper-airplay-volume <db>             general.run_this_when_volume_is_set
#   jasper-airplay-volume --session-start  sessioncontrol.run_this_before_play_begins
#
# Fire-and-forget by contract: shairport runs both with cmd_blocking off, a
# dropped volume nudge is harmless, and a wedged hook is not — so every
# failure path exits 0 having done nothing. The value is delivered to
# jasper-control's /volume/set as a SOURCE-ATTRIBUTED observation, so the
# coordinator's active-source gate, echo window, measurement hold and the
# CamillaDSP clamps all apply unchanged. This script never touches a fader.

set -u

# systemd exports RUNTIME_DIRECTORY for shairport-sync.service's
# RuntimeDirectory=shairport-sync and the hook inherits it; the literal is
# the fallback for a hand-run invocation.
runtime_dir="${RUNTIME_DIRECTORY:-/run/shairport-sync}"
[ -d "$runtime_dir" ] || exit 0
state="${runtime_dir}/airplay-volume.pct"
lock="${runtime_dir}/airplay-volume.lock"
session_start="${runtime_dir}/airplay-session-start"
# jasper-control is always localhost, and 8780 is jasper/control/client.py's
# DEFAULT_PORT — the one module that owns this contract. JASPER_CONTROL_PORT
# is that client's own override, read here for the same reason.
url="http://127.0.0.1:${JASPER_CONTROL_PORT:-8780}/volume/set"

# shairport fires this before the connect-time volume push, so the volume
# invocation that follows can tell a session snapshot from a user's nudge.
if [ "${1:-}" = "--session-start" ]; then
    : > "$session_start" 2>/dev/null || true
    exit 0
fi

# AirPlay carries volume as dB over [-30, 0]. -144 is its mute sentinel and
# needs no branch of its own: it clamps to -30 dB, which is 0%, which is the
# coordinator's content mute (CamillaDSP main_mute is asserted at level 0).
# A sender's mute button therefore actually silences the speaker. LC_ALL=C
# keeps the decimal separator a dot whatever locale the service inherits.
pct="$(
    LC_ALL=C awk -v raw="${1:-}" 'BEGIN {
        if (raw !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1
        db = raw + 0
        if (db > 0) db = 0
        if (db < -30) db = -30
        # Round half up, deliberately: -14.85 dB is exactly 50.5 %, and 51
        # is the answer this scale gives.
        printf "%d", int((db + 30) * 100 / 30 + 0.5)
    }' 2>/dev/null
)" || exit 0

printf '%s\n' "$pct" > "${state}.tmp.$$" 2>/dev/null || exit 0
mv -f "${state}.tmp.$$" "$state" 2>/dev/null || exit 0
# $pct above is already the value just written to $state; the winning
# holder's very first pass below uses it directly instead of re-reading
# the file we ourselves just wrote.
pct_fresh=1

last=""
attempt=0
# Three tenures is the ceiling. A tenure ends either settled (nothing left to
# post) or at its own pass ceiling, and only an unsettled hand-off starts
# another — so a drag longer than one tenure keeps tracking, while a
# jasper-control that refuses every write still stops in bounded time.
while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    # One poster at a time. A slider drag or a held volume key fires a burst
    # of these; every loser has already published its value above, so
    # dropping it costs nothing — the holder re-reads the file on every pass
    # but the first and ends on the newest value. flock's lock is released
    # by the kernel when the holder dies, so an OOM kill cannot strand it.
    exec 9>"$lock" || exit 0
    flock -n 9 || exit 0
    # 25 passes x 200 ms covers a five-second drag. 200 ms is half
    # CamillaDSP's 400 ms fader ramp, so a held key reads as one continuous
    # ramp instead of a ramp restarted per message.
    passes=0
    failures=0
    while [ "$passes" -lt 25 ]; do
        if [ "$pct_fresh" -eq 1 ]; then
            pct_fresh=0
        else
            pct="$(cat "$state" 2>/dev/null)" || break
        fi
        [ "$pct" = "$last" ] && break
        body="{\"percent\": ${pct}, \"source\": \"airplay\""
        # `rm` succeeds only for the process that actually removes the
        # marker, so consuming it IS the test. Its presence means shairport
        # is opening a session: `observation_initial` then makes the
        # coordinator defer this one write while a mute is latched — the
        # same flag USBSINK's bridge uses. Only a session's first post
        # carries it.
        if rm "$session_start" 2>/dev/null; then
            body="${body}, \"observation_initial\": true"
        fi
        # `last` advances only on a 2xx. A 409 (active-speaker output not
        # ready) or a timeout therefore retries the same value on the next
        # pass instead of being recorded as delivered.
        if curl -fsS --max-time 0.4 \
            -H 'Content-Type: application/json' \
            -d "${body}}" \
            "$url" >/dev/null 2>&1; then
            last="$pct"
            failures=0
        else
            failures=$((failures + 1))
            # Three straight rejections is a daemon that is not going to take
            # this write. Stop quietly instead of hammering it for the rest of
            # the tenure — a lost nudge is the accepted failure mode, and the
            # next volume message starts a fresh holder anyway.
            [ "$failures" -ge 3 ] && exit 0
        fi
        passes=$((passes + 1))
        sleep 0.2
    done
    # Release, THEN re-read. A value published between this tenure's last
    # read and its break would otherwise never be posted: the writer that
    # published it has already exited after failing to acquire the lock. Any
    # writer arriving after this point acquires the now-free lock itself, so
    # losing the re-acquire below means the value is in better hands.
    exec 9>&-
    newest="$(cat "$state" 2>/dev/null)" || exit 0
    [ "$newest" = "$last" ] && exit 0
done
