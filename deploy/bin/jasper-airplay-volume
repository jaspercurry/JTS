#!/bin/sh

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# jasper-airplay-volume — shairport-sync's volume hooks, and the one inbound
# path from an AirPlay sender's volume control to the JTS master fader
# (ADR-0206). Two invocations, both wired from the rendered config:
#
#   jasper-airplay-volume <db>             general.run_this_when_volume_is_set
#   jasper-airplay-volume --session-start  sessioncontrol.run_this_before_play_begins
#
# Fire-and-forget by contract: shairport runs both with cmd_blocking off, a
# dropped volume nudge is harmless, and a wedged hook is not — so every
# failure path exits 0 having done nothing. The value is delivered to
# jasper-control's /volume/set as a SOURCE-ATTRIBUTED observation, so the
# coordinator's active-source gate, echo window, measurement hold and the
# CamillaDSP clamps all apply unchanged. This script never touches a fader.

set -u

# systemd exports RUNTIME_DIRECTORY for shairport-sync.service's
# RuntimeDirectory=shairport-sync and the hook inherits it; the literal is
# the fallback for a hand-run invocation.
runtime_dir="${RUNTIME_DIRECTORY:-/run/shairport-sync}"
[ -d "$runtime_dir" ] || exit 0
state="${runtime_dir}/airplay-volume.pct"
# The level a new session restores audio at: the last non-zero percent this
# hook delivered, which is the last level the owner actually listened at.
restore_state="${runtime_dir}/airplay-restore.pct"
lock="${runtime_dir}/airplay-volume.lock"
session_start="${runtime_dir}/airplay-session-start"
# jasper-control is always localhost on jasper/control/client.py's
# CONTROL_PORT — the one module that owns this contract.
url="http://127.0.0.1:8780/volume/set"

# shairport fires this before the connect-time volume push, so the volume
# invocation that follows can tell a session snapshot from a user's nudge.
if [ "${1:-}" = "--session-start" ]; then
    : > "$session_start" 2>/dev/null || true
    exit 0
fi

# AirPlay carries volume as dB over [-30, 0]. -144 is its mute sentinel and
# needs no branch of its own: it clamps to -30 dB, which is 0%, which is the
# coordinator's content mute (CamillaDSP main_mute is asserted at level 0).
# A sender's mute button therefore actually silences the speaker. LC_ALL=C
# keeps the decimal separator a dot whatever locale the service inherits.
pct="$(
    LC_ALL=C awk -v raw="${1:-}" 'BEGIN {
        if (raw !~ /^-?[0-9]+(\.[0-9]+)?$/) exit 1
        db = raw + 0
        if (db > 0) db = 0
        if (db < -30) db = -30
        # Round half up, deliberately: -14.85 dB is exactly 50.5 %, and 51
        # is the answer this scale gives.
        printf "%d", int((db + 30) * 100 / 30 + 0.5)
    }' 2>/dev/null
)" || exit 0

printf '%s\n' "$pct" > "${state}.tmp.$$" 2>/dev/null || exit 0
mv -f "${state}.tmp.$$" "$state" 2>/dev/null || exit 0

# Deliver one level, $2 carrying any extra JSON fields. `last` advances only
# on a 2xx. A 409 (active-speaker output not ready) or a timeout therefore
# retries the same value on the next pass instead of being recorded as
# delivered, and three straight rejections is a daemon that is not going to
# take this write: stop quietly instead of hammering it for the rest of the
# tenure — a lost nudge is the accepted failure mode, and the next volume
# message starts a fresh holder anyway.
post() {
    if curl -fsS --max-time 0.4 \
        -H 'Content-Type: application/json' \
        -d "{\"percent\": ${1}, \"source\": \"airplay\"${2}}" \
        "$url" >/dev/null 2>&1; then
        last="$1"
        failures=0
        # Zero is a mute, never a level to come back to, so it never becomes
        # the restore point.
        if [ "$1" -gt 0 ] &&
            printf '%s\n' "$1" > "${restore_state}.tmp.$$" 2>/dev/null; then
            mv -f "${restore_state}.tmp.$$" "$restore_state" 2>/dev/null || true
        fi
        return 0
    fi
    failures=$((failures + 1))
    [ "$failures" -ge 3 ] && exit 0
    return 1
}

last=""
attempt=0
# Three tenures is the ceiling. A tenure ends either settled (nothing left to
# post) or at its own pass ceiling, and only an unsettled hand-off starts
# another — so a drag longer than one tenure keeps tracking, while a
# jasper-control that refuses every write still stops in bounded time.
while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    # One poster at a time. A slider drag or a held volume key fires a burst
    # of these; every loser has already published its value above, so
    # dropping it costs nothing — the holder re-reads the file each pass and
    # ends on the newest value. flock's lock is released by the kernel when
    # the holder dies, so an OOM kill cannot strand it.
    # Every external command forked below, while fd 9 is open, inherits it
    # and is safe ONLY because it runs foreground-synchronous: backgrounding
    # ANY of them would hold the flock past this tenure and silently
    # self-block the next acquire.
    exec 9>"$lock" || exit 0
    flock -n 9 || exit 0
    # 25 passes x 200 ms covers a five-second drag. 200 ms is half
    # CamillaDSP's 400 ms fader ramp, so a held key reads as one continuous
    # ramp instead of a ramp restarted per message.
    passes=0
    failures=0
    while [ "$passes" -lt 25 ]; do
        pct="$(cat "$state" 2>/dev/null)" || break
        initial=""
        # A session start is not a drag. macOS animates the sender's slider up
        # from the bottom of its scale to the real level — measured on jts3 as
        # ~10 messages 200 ms apart, 6 % to 63 % over ~2 s — so replaying the
        # burst dips the speaker tens of dB before it swells back, while
        # merely waiting the animation out leaves the speaker muted for two
        # seconds after content is already flowing (a session teardown's -144
        # left it at 0 %). So restore audio first, at the level the owner last
        # listened at, and only then hold the animation: wait for two
        # unchanged passes (400 ms, two message intervals) and adopt the level
        # it settles on. Normally the two are the same value and the settled
        # post is skipped as already delivered.
        # `rm` succeeds only for the process that actually removes the marker,
        # so consuming it IS the claim on this session start. Both of a
        # session's posts carry `observation_initial`, which makes the
        # coordinator defer them while a mute is latched at the speaker — the
        # same flag USBSINK's bridge uses. A user's nudge carries no marker
        # and still tracks the slider step by step.
        if rm "$session_start" 2>/dev/null; then
            initial=", \"observation_initial\": true"
            restore="$(cat "$restore_state" 2>/dev/null)" || restore=""
            if [ -n "$restore" ] && [ "$restore" != "$last" ]; then
                post "$restore" "$initial"
            fi
            settled=0
            while [ "$settled" -lt 2 ] && [ "$passes" -lt 25 ]; do
                sleep 0.2
                passes=$((passes + 1))
                probe="$(cat "$state" 2>/dev/null)" || break
                if [ "$probe" = "$pct" ]; then
                    settled=$((settled + 1))
                else
                    settled=0
                    pct="$probe"
                fi
            done
        fi
        [ "$pct" = "$last" ] && break
        post "$pct" "$initial"
        passes=$((passes + 1))
        sleep 0.2
    done
    # Release, THEN re-read. A value published between this tenure's last
    # read and its break would otherwise never be posted: the writer that
    # published it has already exited after failing to acquire the lock. Any
    # writer arriving after this point acquires the now-free lock itself, so
    # losing the re-acquire below means the value is in better hands.
    exec 9>&-
    newest="$(cat "$state" 2>/dev/null)" || exit 0
    [ "$newest" = "$last" ] && exit 0
done
# Without this the exhausted-tenure path would exit with the status of the
# test above (1), against the fire-and-forget contract at the top of the file.
exit 0
