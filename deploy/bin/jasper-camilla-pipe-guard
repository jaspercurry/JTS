#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# jasper-camilla-pipe-guard — break the dead-pipe recovery-loop chain.
#
# Runs as ExecStartPre= on jasper-camilla.service (the CORE music
# daemon, whose bounded OnFailure recovery handler can park the graph).
#
# Why ExecStartPre and not only OnFailure=: preventing a known dead-pipe start
# preserves the pipe evidence and avoids spending the bounded recovery budget.
#
# The measured failure modes (camilladsp 4.1.3 on jts3, 2026-06-11):
#   - File sink path ABSENT (snapserver stopped; its RuntimeDirectory
#     reaped) -> "Playback error: No such file or directory" + CLEAN
#     exit 0. With Restart=always + RestartSec=2 + StartLimitBurst=5/60s,
#     that would exhaust the burst and invoke the bounded non-rebooting
#     jasper-camilla-recover path repeatedly as operators retry the graph.
#   - FIFO present, NO reader -> camilladsp blocks in open(2) and the
#     blocked open is not interrupted by SIGTERM (alive-but-silent).
#
# Pure bash, no Python import cost (<5 ms in the solo steady state:
# one statefile read + one sed + one awk). Mirrors jasper-wifi-guardian's
# shape and test seams (env-overridable paths, structured
# `event=camilla_pipe_guard.<outcome>` lines on stderr).

set -uo pipefail

# shellcheck disable=SC2034  # the sourced common guard library's log() reads it
JASPER_CAMILLA_GUARD_EVENT=camilla_pipe_guard
# shellcheck disable=SC2034  # consumed by the sourced common guard library
BASE_CONFIG="${JASPER_CAMILLA_BASE_CONFIG:-/etc/camilladsp/outputd-cutover.yml}"
# shellcheck disable=SC2034  # consumed by the sourced common guard library
RUNTIME_SAFE_GRAPH="${JASPER_RUNTIME_SAFE_GRAPH:-/opt/jasper/.venv/bin/jasper-active-speaker}"
SNAPFIFO="${JASPER_GROUPING_SNAPFIFO:-/run/jasper-snapserver/snapfifo}"
# Seconds the reader-presence probe waits before declaring "no reader".
# shellcheck disable=SC2034  # consumed by the sourced common guard library
PROBE_TIMEOUT="${JASPER_PIPE_GUARD_PROBE_TIMEOUT:-0.5}"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMMON_LIB="${JASPER_CAMILLA_GUARD_COMMON_LIB:-}"
if [ -z "$COMMON_LIB" ]; then
    if [ -r "${SCRIPT_DIR}/../lib/jasper-camilla-guard-common.sh" ]; then
        COMMON_LIB="${SCRIPT_DIR}/../lib/jasper-camilla-guard-common.sh"
    else
        COMMON_LIB="/usr/local/lib/jasper/jasper-camilla-guard-common.sh"
    fi
fi
# shellcheck disable=SC1090  # runtime path is repo-sibling or installed fallback
# The library owns log() and the statefile default, so the two lines a guard can
# emit before it is readable are spelled out at these call sites.
if [ ! -r "$COMMON_LIB" ] || ! source "$COMMON_LIB"; then
    echo "event=camilla_pipe_guard.skip reason=common_lib_unavailable" >&2
    exit 0
fi
if ! declare -F camilla_guard_repair_statefile >/dev/null \
        || ! declare -F camilla_guard_check_playback_pipe_or_repair >/dev/null; then
    echo "event=camilla_pipe_guard.skip reason=common_lib_invalid" >&2
    exit 0
fi

STATEFILE="$JASPER_CAMILLA_STATEFILE"

[ -r "$STATEFILE" ] || { log skip reason=no_statefile; exit 0; }

config_path=$(
    sed -n 's/^[[:space:]]*config_path:[[:space:]]*//p' "$STATEFILE" \
        | head -1 | tr -d '"' | tr -d "'"
)
[ -n "$config_path" ] || { log skip reason=no_config_path; exit 0; }
[ -r "$config_path" ] || { log skip reason=config_unreadable "path=$config_path"; exit 0; }

playback_filename=$(
    awk '
        /^[[:space:]]*playback:[[:space:]]*$/ { in_play = 1; next }
        # A new top-level (or sibling) "<key>:" block ends the playback map.
        in_play && /^[[:space:]]*[a-zA-Z_]+:[[:space:]]*$/ { in_play = 0 }
        in_play && /^[[:space:]]*filename:[[:space:]]*/ {
            sub(/^[[:space:]]*filename:[[:space:]]*/, "")
            gsub(/["'\'']/, "")
            print
            exit
        }
    ' "$config_path"
)

if [ -z "$playback_filename" ]; then
    log ok reason=solo_config
    exit 0
fi

# Bonded pipe config. Healthy only if the FIFO exists AND has a reader.
if [ "$playback_filename" = "$SNAPFIFO" ]; then
    camilla_guard_check_playback_pipe_or_repair \
        "$SNAPFIFO" fifo_absent no_reader pipe_healthy pipe_exists_probe_unavailable \
        "$config_path" \
        "camilla starts on runtime-contract-safe graph; next reconcile re-applies the live lane when its pipe is healthy"
fi

# A File sink that is not the snapserver FIFO. Since #2135 the common case is
# the PARKED graph (/dev/null, every output hard muted) on a roleful topology
# that has not staged a startup graph yet — not an unrecognised bonded pipe. Both
# are "nothing for this guard to repair", but they need distinguishable labels or
# a parked box reads as a mystery pipe in the journal.
if [ "$playback_filename" = "/dev/null" ]; then
    log ok reason=parked_null_sink
    exit 0
fi

log ok reason=non_snapcast_playback_pipe
exit 0
