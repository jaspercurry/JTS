#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Reconcile JTS mic/AEC state with the audio hardware currently present.
#
# This is intentionally a small policy layer around /etc/jasper/jasper.env
# and systemd. It keeps a stale JASPER_MIC_DEVICE=udp:PORT from stranding
# jasper-voice when the XVF Array is unplugged, while leaving a narrow config
# hook for microphone variants via JASPER_MIC_DEVICE_CANDIDATES.

set -euo pipefail

ENV_FILE="${JASPER_ENV_FILE:-/etc/jasper/jasper.env}"
MODE_FILE="${JASPER_AEC_MODE_FILE:-/var/lib/jasper/aec_mode.env}"
VOICE_PROVIDER_FILE="${JASPER_VOICE_PROVIDER_FILE:-/var/lib/jasper/voice_provider.env}"
VOICE_PROVIDER_IDS_FILE="${JASPER_VOICE_PROVIDER_IDS_FILE:-/var/lib/jasper/voice_provider_ids}"
# Persistent NEGATIVE marker for the voice-input gate. This reconciler is the
# SINGLE WRITER: created on every "no usable voice input, park voice" path,
# removed on every "voice input available, (re)start voice" path.
# jasper-voice.service gates ExecStart on its ABSENCE
# (ConditionPathExists=!<this path>), so a no-input box never
# start-crash-loops. PERSISTENT (/var/lib/jasper, not /run) so a no-input box
# stays gated across reboot before any reconcile runs; absence fails OPEN
# (voice runs). The path is duplicated as a literal in jasper-voice.service and
# jasper/voice/input_presence.py; agreement is pinned by
# tests/test_voice_input_gate.py.
#
# "Usable voice input" is an OR over TWO owners: a local microphone (this
# script) and a paired accessory microphone (jasper-accessory-reconcile — see
# accessory_mic_present below). This script stays the single writer of the
# derived AND; the accessory owner asks it to re-derive by starting this unit.
VOICE_INPUT_ABSENT_MARKER="${JASPER_VOICE_INPUT_ABSENT_MARKER:-/var/lib/jasper/voice-input-absent}"
# The chip_aec_health record jasper-aec-init publishes for the pass it ran, as
# shell assignments. aec_init.py owns the path literal (ALIGNMENT_RECORD_PATH)
# and is its only writer; this script is its only reader. Absent means the run
# reached no verdict, which for a zero exit is a fully applied alignment.
ALIGNMENT_RECORD_FILE="${JASPER_AEC_ALIGNMENT_RECORD_FILE:-/run/jasper-aec-init/alignment}"
# A 2-channel XVF is still a microphone (ADR-0101): the box captures from it
# directly and says what the flash would buy. Same remedy the doctor's
# check_xvf_firmware_6ch names, in the same vocabulary.
XVF_2CH_DISCLOSURE="echo cancellation unavailable until DFU flash to 6-channel firmware"
XVF_2CH_ACTION="Re-flash the XVF to 6-channel firmware; BRINGUP.md 'XVF firmware: switch to 6-channel variant via DFU' has the procedure"
# install.sh's verified-install marker, and the /run record of which build the
# last voice (re)start was made under. Read together they answer "is the
# running jasper-voice already this build?".
#
# Why a mic reconciler cares about a build id: it is the only thing that
# restarts jasper-voice on a deploy. scripts/deploy-to-pi.sh deliberately does
# NOT restart voice itself ("Voice is mic-hardware-dependent, so do not restart
# jasper-voice directly here"), so a change gate that looked only at env
# contents would let a deploy leave the daemon on the previous build's Python.
# A changed manifest is therefore a voice-relevant change.
#
# The stamp lives in /run, not /var/lib, deliberately: a reboot must forget it,
# because a freshly-booted box has no running jasper-voice to protect and the
# unconditional restart is what starts it.
INSTALL_MANIFEST="${JASPER_INSTALL_MANIFEST:-/var/lib/jasper/build.txt}"
VOICE_RESTART_STAMP="${JASPER_VOICE_RESTART_STAMP:-/run/jasper-aec-reconcile/voice-restart.stamp}"
# One-shot intent marker: a caller whose kick MEANS "restart the voice/AEC
# stack" (not "hardware may have drifted") touches this file before starting
# the unit, because a systemctl kick can carry no arguments. Sole writer
# today: jasper.cli.enhanced_aec_install._refresh_aec_runtime, whose verified
# v2 engine changes nothing this script's change tests can see (the engine
# lives in a venv, not in env files). Consumed (removed) by the next real
# pass, which then refuses to skip; CHECK-only passes leave it for the pass
# that can act on it. The path literal is duplicated in that Python writer
# and pinned by tests/test_aec_reconcile.py.
VOICE_RESTART_INTENT_MARKER="${JASPER_VOICE_RESTART_INTENT_MARKER:-/run/jasper-aec-reconcile/voice-restart-intent}"
# This script's published verdict "the AEC bridge may run", read through
# jasper-aec-bridge.service's ConditionPathExists= (ADR-0224). Volatile (/run,
# not /var/lib) so an empty boot means "no verdict yet". The path literal is
# duplicated in that unit and jasper/aec_ready.py; agreement is pinned by
# tests/test_aec_bridge_systemd.py.
AEC_BRIDGE_READY_MARKER="${JASPER_AEC_BRIDGE_READY_MARKER:-/run/jasper-aec-reconcile/aec-bridge-ready}"
ASOUND_ROOT="${JASPER_ASOUND_ROOT:-/proc/asound}"
SYSTEMCTL="${JASPER_SYSTEMCTL:-systemctl}"
DEFAULT_MIC_DEVICE_CANDIDATES="Array,L16K2Ch,L16K6Ch,C16K2Ch,C16K6Ch"
DEFAULT_MIC_PROFILE_PYTHON="python3"
if [[ -x /opt/jasper/.venv/bin/python ]]; then
    DEFAULT_MIC_PROFILE_PYTHON="/opt/jasper/.venv/bin/python"
fi
MIC_PROFILE_PYTHON="${JASPER_MIC_PROFILE_PYTHON:-$DEFAULT_MIC_PROFILE_PYTHON}"
MIC_PROFILE_STATE_PATH="${JASPER_MIC_PROFILE_STATE_PATH:-/run/jasper-mic-profile/xvf3800.json}"
OUTPUTD_CONTROL_SOCKET="${JASPER_OUTPUTD_CONTROL_SOCKET:-/run/jasper-outputd/control.sock}"
COMMISSION_MARKER="${JASPER_AEC_COMMISSION_MARKER:-/run/jasper-chip-aec-commission/active}"
PROC_ROOT="${JASPER_PROC_ROOT:-/proc}"
REASON="manual"
OUTPUTD_RESTART_NEEDED=0
# Sticky "this pass changed something jasper-voice would pick up by
# restarting" flag — see mark_voice_restart_if_changed and
# voice_restart_can_be_skipped.
VOICE_RESTART_NEEDED=0
INSTALLED_BUILD_ID=""
# Deferred voice restart for the "no local mic, accessory mic paired" case.
# Set by stop_voice, flushed by restart_voice_for_accessory_mic once the
# calling path's JASPER_MIC_DEVICE fixups have been written.
ACCESSORY_VOICE_RESTART_NEEDED=0
# Opt-in lab observation only. Production DAC authorization is fixed profile
# data and never depends on this short live clock sample.
CHIP_REF_OBSERVE=0
MIC_PROFILE_RESOLUTION_STATUS="unavailable"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE_LIB="${JASPER_ENV_FILE_LIB:-}"

# Shared quoting/env-file writer (jasper_env_quote_value /
# jasper_env_file_set). SCRIPT_DIR-relative sibling first, installed
# path as fallback: install.sh can run the REPO copy of a reconciler
# mid-install (install_alsa's --print-env) BEFORE install_systemd_units
# refreshes /usr/local/lib, so installed-first could pair a new script
# with a stale lib. Sibling-first keeps script and lib versions in
# lockstep wherever the script runs from; the installed copy under
# /usr/local/sbin has no ../lib/jasper-env-file.sh sibling, so it falls
# through to the installed lib. This deliberately diverges from
# load_asound_render_lib's installed-first order in
# jasper-audio-hardware-reconcile — see the rationale comment there
# (the render lib's functions are never exercised by a mid-install
# repo-script run, so its order is left alone).
load_env_file_lib() {
    if [[ -z "$ENV_FILE_LIB" ]]; then
        if [[ -r "${SCRIPT_DIR}/../lib/jasper-env-file.sh" ]]; then
            ENV_FILE_LIB="${SCRIPT_DIR}/../lib/jasper-env-file.sh"
        else
            ENV_FILE_LIB="/usr/local/lib/jasper/jasper-env-file.sh"
        fi
    fi
    if [[ ! -r "$ENV_FILE_LIB" ]]; then
        echo "jasper-aec-reconcile: missing env-file library: ${ENV_FILE_LIB}" >&2
        exit 66
    fi
    # shellcheck disable=SC1090
    source "$ENV_FILE_LIB"
}
load_env_file_lib

usage() {
    cat <<'EOF'
Usage: jasper-aec-reconcile [--reason TEXT]

Reconcile microphone/AEC systemd state:
  - auto + supported 6-channel XVF present -> JASPER_MIC_DEVICE=udp:PORT, AEC on
  - auto + direct mic present only -> JASPER_MIC_DEVICE=<mic>, AEC off
  - owned mic config + no mic present -> clear stale UDP, stop voice
  - custom JASPER_MIC_DEVICE -> leave voice config alone, keep AEC off

Every pass publishes its bridge verdict to the ready marker
jasper-aec-bridge.service gates on.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --reason)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            REASON="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

log() {
    echo "jasper-aec-reconcile[$REASON]: $*" >&2
}

ensure_parent_dir() {
    local dir
    dir="$(dirname "$1")"
    [[ -d "$dir" ]] || install -d -m 0755 "$dir" 2>/dev/null
}

# Publish / withdraw the bridge verdict. Best-effort, like the voice-input gate
# writers: a marker we cannot write costs a bridge start, not correctness, and
# the next pass retries. Publishing must PRECEDE any start/restart of the
# bridge — PID 1 evaluates ConditionPathExists when it runs the job, and a
# condition-skipped restart still exits 0.
publish_aec_bridge_ready() {
    if ensure_parent_dir "$AEC_BRIDGE_READY_MARKER" \
        && printf 'reason=%s\n' "$REASON" \
            > "$AEC_BRIDGE_READY_MARKER" 2>/dev/null; then
        return 0
    fi
    log "event=aec_reconcile.aec_ready_marker_write_failed marker=${AEC_BRIDGE_READY_MARKER}"
}

revoke_aec_bridge_ready() {
    rm -f "$AEC_BRIDGE_READY_MARKER" 2>/dev/null || true
}

# Withdraw FIRST, on every pass, and republish only where a verdict settles.
# Load-bearing for the bridge's StartLimitAction=reboot, and why no EXIT trap
# is needed — ADR-0224 has the derivation.
revoke_aec_bridge_ready

commission_marker_live() {
    local line pid
    [[ -f "$COMMISSION_MARKER" ]] || return 1
    IFS= read -r line < "$COMMISSION_MARKER" || return 1
    pid="${line#pid=}"
    [[ "$line" == "pid=${pid}" && "$pid" =~ ^[1-9][0-9]*$ && -d "$PROC_ROOT/$pid" ]]
}

# The commissioner owns every lifecycle mutation while its process is alive.
# Its one volatile USB reset fires hotplug; that pass — and every other pass
# under a live marker — mutates nothing and the bridge verdict stays
# withdrawn. The single exception is the commissioner's OWN arm call, keyed on
# --reason below: the resting software-AEC3 env has no chip-ref writer armed
# and the commissioning preflight needs outputd carrying one, and only this
# script writes that vector. The reason literal is mirrored by
# jasper.cli.aec_commission.ARM_RECONCILE_REASON (pinned in
# tests/test_aec_reconcile.py). A reason-keyed dispatch also keeps a stale or
# PID-reused marker harmless: no caller but the live commissioner passes it.
COMMISSION_ARM_REASON="chip-aec-commission-arm"
COMMISSION_ARM=0
if commission_marker_live; then
    log "commissioning marker present; foreground commissioner owns AEC lifecycle"
    # The verdict simply stays withdrawn: the commissioner stops the bridge for
    # its audible measurement and never starts it again, and its cleanup pass
    # runs marker-free and republishes.
    if [[ "$REASON" == "$COMMISSION_ARM_REASON" ]]; then
        COMMISSION_ARM=1
    else
        exit 0
    fi
elif [[ -e "$COMMISSION_MARKER" ]]; then
    log "removing stale commissioning marker"
    rm -f "$COMMISSION_MARKER"
fi

clear_mic_profile_state() {
    JASPER_XVF_PRESENT=0
    JASPER_XVF_VARIANT=""
    JASPER_XVF_DISPLAY_NAME=""
    JASPER_XVF_GEOMETRY=""
    JASPER_XVF_ALSA_CARD=""
    JASPER_XVF_CAPTURE_CHANNELS=""
    JASPER_XVF_CHIP_BEAM_PLAN=""
    JASPER_XVF_CHIP_AEC_SUPPORTED=0
    JASPER_XVF_RECOMMENDED_PROFILE=""
    JASPER_XVF_REASON="$1"
    JASPER_XVF_CHIP_REF_PCM_ACCESS="hw"
    JASPER_XVF_CHIP_REF_DEVICE="0"
    JASPER_XVF_CHIP_REF_RATE="16000"
    JASPER_XVF_CHIP_REF_PERIOD="128"
    JASPER_XVF_CHIP_REF_BUFFER="256"
}

observe_mic_profile_state() {
    local payload args
    args=(-m jasper.cli.xvf_profile --asound-root "$ASOUND_ROOT" --env)
    # An arm-only pass can observe mid-commission (the commissioner's volatile
    # XVF reset fires hotplug while the card is off the bus); caching that
    # transient absence would mislead every state-file reader until the
    # post-commission pass.
    if [[ "$COMMISSION_ARM" != "1" ]]; then
        args+=(--state-path "$MIC_PROFILE_STATE_PATH" --write-state)
    fi
    if ! command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1; then
        log "mic profile resolver unavailable at ${MIC_PROFILE_PYTHON}; non-custom routing will fail closed"
        clear_mic_profile_state "mic profile resolver unavailable"
        MIC_PROFILE_RESOLUTION_STATUS="unavailable"
        return 0
    fi
    if payload="$("$MIC_PROFILE_PYTHON" "${args[@]}")"; then
        # Output is produced by jasper.cli.xvf_profile with shlex.quote.
        eval "$payload"
        MIC_PROFILE_RESOLUTION_STATUS="resolved"
        log "mic_profile variant=${JASPER_XVF_VARIANT:-unknown} geometry=${JASPER_XVF_GEOMETRY:-unknown} card=${JASPER_XVF_ALSA_CARD:-unknown} chip_beam_plan=${JASPER_XVF_CHIP_BEAM_PLAN:-none} chip_aec_supported=${JASPER_XVF_CHIP_AEC_SUPPORTED:-0}"
    else
        log "mic profile resolver failed; non-custom routing will fail closed"
        clear_mic_profile_state "mic profile resolver failed"
        MIC_PROFILE_RESOLUTION_STATUS="failed"
    fi
}

load_env_file() {
    local file="$1"
    if [[ -f "$file" ]]; then
        set -a
        # Runtime-only env files (/etc/jasper/jasper.env and the
        # wizard-owned /var/lib/jasper/*.env) — they don't exist in the
        # repo, so shellcheck can never follow them. Directives bind to
        # the next command, so this must sit on the `source` line itself.
        # shellcheck source=/dev/null
        source "$file"
        set +a
    fi
}

ensure_mode_file() {
    local inferred_profile
    if [[ -f "$MODE_FILE" ]]; then
        # File exists. Seed any missing keys so an older deploy's
        # mode file picks up the new leg defaults on next reconcile.
        # Existing values for already-present keys are left alone.
        if ! grep -q '^JASPER_WAKE_LEG_RAW=' "$MODE_FILE"; then
            printf 'JASPER_WAKE_LEG_RAW=1\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_WAKE_LEG_DTLN=' "$MODE_FILE"; then
            printf 'JASPER_WAKE_LEG_DTLN=0\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_WAKE_LEG_CHIP_AEC=' "$MODE_FILE"; then
            printf 'JASPER_WAKE_LEG_CHIP_AEC=0\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_WAKE_LEG_CHIP_AEC_150=' "$MODE_FILE"; then
            printf 'JASPER_WAKE_LEG_CHIP_AEC_150=0\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_WAKE_LEG_CHIP_AEC_210=' "$MODE_FILE"; then
            printf 'JASPER_WAKE_LEG_CHIP_AEC_210=0\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_AEC_CHIP_REF_OBSERVE=' "$MODE_FILE"; then
            printf 'JASPER_AEC_CHIP_REF_OBSERVE=0\n' >> "$MODE_FILE"
        fi
        if ! grep -q '^JASPER_AUDIO_INPUT_PROFILE=' "$MODE_FILE"; then
            if inferred_profile="$(infer_audio_input_profile_from_mode_file)"; then
                printf 'JASPER_AUDIO_INPUT_PROFILE=%s\n' \
                    "$inferred_profile" >> "$MODE_FILE"
            fi
        fi
        return
    fi
    # Only create an absent dir; never re-mode /var/lib/jasper (0770 root:jasper)
    # on a boot/udev reconcile — re-moding it to 0755 strips the group-write bit
    # the non-root daemons need (same trap as #827).
    local mode_file_dir
    mode_file_dir="$(dirname "$MODE_FILE")"
    [[ -d "$mode_file_dir" ]] || install -d -m 0755 "$mode_file_dir"
    printf 'JASPER_AUDIO_INPUT_PROFILE=auto\nJASPER_AEC_MODE=auto\nJASPER_WAKE_LEG_RAW=1\nJASPER_WAKE_LEG_DTLN=0\nJASPER_WAKE_LEG_CHIP_AEC=0\nJASPER_WAKE_LEG_CHIP_AEC_150=0\nJASPER_WAKE_LEG_CHIP_AEC_210=0\nJASPER_AEC_CHIP_REF_OBSERVE=0\n' > "$MODE_FILE"
    chmod 0644 "$MODE_FILE"
}

# Atomic single-key env upsert. Quoting + write semantics live in the
# shared lib (see load_env_file_lib above) so this script and
# jasper-audio-hardware-reconcile cannot drift — bash %q quoting is NOT
# usable here (bash 5.2 backslash-escapes commas, corrupting ALSA
# specs like plughw:CARD=Array,DEV=0 and breaking read-back
# idempotence).
set_env_var() {
    # /etc/jasper/jasper.env is non-secret runtime config. jasper-control
    # fresh-reads it for /state after this reconciler mutates AEC/profile
    # keys, so keep the file group-readable (install migration owns group).
    mark_voice_restart_if_changed "$2" "$3"
    jasper_env_file_set "$1" "$2" "$3" 0640 0755
}

# Keys this reconciler publishes for humans and status surfaces (/state, the
# /wake page, the doctor) and that no daemon consumes as a runtime input.
# Everything else set_env_var writes counts as a voice-relevant change, so a
# key added later is voice-relevant BY DEFAULT and a forgotten classification
# produces the safe direction (a restart), never a suppressed one.
#
# The exclusion is load-bearing, not tidiness: JASPER_AEC_CHIP_AEC_DAC_DETAIL
# embeds outputd's live `chip_ref_sro_ppm=` clock estimate, which moves on
# essentially every pass on a chip-AEC box. Counting it as a change would
# leave the gate permanently tripped on exactly the hardware whose bounce it
# exists to stop — a guard nobody can trip.
#
# Excluding the gate/alignment STATUS keys is safe because their consequences
# are not excluded: when the DAC gate or the alignment verdict actually flips,
# LEG_CHIP_AEC flips with it and that reaches JASPER_AEC_CHIP_AEC_ENABLED and
# JASPER_MIC_DEVICE, both of which are counted. The alignment status is also
# read directly by the chip-AEC skip check below, which demands "ready".
#
# tests/test_aec_reconcile.py pins every name here against the keys the script
# actually writes: a typo would silently promote a descriptive key back to
# voice-relevant and re-arm the bounce.
VOICE_IRRELEVANT_ENV_KEYS="\
JASPER_XVF_DISPLAY_NAME JASPER_XVF_REASON JASPER_XVF_RECOMMENDED_PROFILE \
JASPER_AEC_CHIP_AEC_TESTING_REQUESTED JASPER_AEC_CHIP_AEC_DAC_ID \
JASPER_AEC_CHIP_AEC_DAC_STATUS JASPER_AEC_CHIP_AEC_DAC_SOURCE \
JASPER_AEC_CHIP_AEC_DAC_DETAIL \
JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON \
JASPER_AEC_CHIP_AEC_ALIGNMENT_ACTION JASPER_AEC_CHIP_AEC_ALIGNMENT_SELECTION"

voice_relevant_env_key() {
    case " ${VOICE_IRRELEVANT_ENV_KEYS} " in
        *" $1 "*)
            return 1
            ;;
    esac
    return 0
}

# The pass-start snapshot of $ENV_FILE that mark_voice_restart_if_changed
# compares against. Taken from the SHELL immediately after load_env_file
# "$ENV_FILE" (so the shared lib's own parse supplies the unquoted values),
# and never refreshed: the live shell variables are NOT a usable "before",
# because observe_mic_profile_state and the chip-AEC policy resolver eval
# resolver payloads over them mid-pass — comparing a resolved value against
# itself made all ten JASPER_XVF_* writes a tautology that could never trip
# the gate. Names are captured too (PASS_START_ENV_KEYS) so "absent at pass
# start" reads as "", the same answer an absent key gave before.
PASS_START_ENV_KEYS=""
snapshot_pass_start_env() {
    local line key
    PASS_START_ENV_KEYS=""
    [[ -r "$ENV_FILE" ]] || return 0
    while IFS= read -r line; do
        [[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
        key="${line%%=*}"
        case " ${PASS_START_ENV_KEYS} " in
            *" ${key} "*) continue ;;
        esac
        printf -v "PASS_START_${key}" '%s' "${!key-}"
        PASS_START_ENV_KEYS="${PASS_START_ENV_KEYS} ${key}"
    done < "$ENV_FILE"
}

# The voice half of mark_outputd_restart_if_changed, and the same test: is the
# value this pass is about to write different from the one the pass STARTED
# with on disk? Sticky and one-directional — once a difference is seen, this
# pass restarts. The comparison base is the pass-start snapshot above, never
# ${!key-}: a key the resolver evals before the write would otherwise compare
# equal by construction, and a forgotten eval site must fail toward
# restarting, not toward silence.
mark_voice_restart_if_changed() {
    local key="$1"
    local desired="$2"
    local snap="PASS_START_${key}"
    local current=""
    case " ${PASS_START_ENV_KEYS} " in
        *" ${key} "*) current="${!snap-}" ;;
    esac
    if [[ "$current" != "$desired" ]] && voice_relevant_env_key "$key"; then
        VOICE_RESTART_NEEDED=1
    fi
}

# One-shot intent: consume the marker a caller left when its kick MEANS
# "restart" (see VOICE_RESTART_INTENT_MARKER above), and treat an install
# pass the same way. install.sh invokes this script directly with
# --reason install BEFORE write_build_manifest seals the transaction, so
# that pass reads the PREVIOUS build's manifest — gating it on "did the
# manifest change" would skip exactly the restart that rolls the freshly
# copied /opt/jasper code into the daemon (the Pi-local `sudo bash
# install.sh` path has no later kick to catch it; the laptop deploy path
# does, which is also why the old-manifest stamp this pass records is
# harmless — the post-install kick mismatches it and restarts, the same
# two-restarts-per-deploy shape every install had before the gate existed).
consume_voice_restart_intent() {
    local reason=""
    if [[ "$REASON" == "install" ]]; then
        VOICE_RESTART_NEEDED=1
        log "event=aec_reconcile.voice_restart_intent reason=install"
    fi
    [[ -e "$VOICE_RESTART_INTENT_MARKER" ]] || return 0
    reason="$(cat "$VOICE_RESTART_INTENT_MARKER" 2>/dev/null | tr -cd 'a-zA-Z0-9_.-' || true)"
    rm -f "$VOICE_RESTART_INTENT_MARKER" 2>/dev/null || true
    VOICE_RESTART_NEEDED=1
    log "event=aec_reconcile.voice_restart_intent reason=${reason:-unspecified}"
}

read_installed_build_id() {
    INSTALLED_BUILD_ID="$(cat "$INSTALL_MANIFEST" 2>/dev/null || true)"
}

# What the running jasper-voice was started FROM, beyond $ENV_FILE — whose
# contents mark_voice_restart_if_changed already compares key by key.
#
# Three inputs, and each is here because a real caller depends on it:
#
#   * the installed build. This reconciler is the only thing that restarts
#     voice on a deploy (see INSTALL_MANIFEST above).
#   * the accessory microphone sources another owner publishes. Pairing a
#     remote writes that file and hands the restart back to this script
#     (jasper.accessories.reconcile.refresh_voice_input) WITHOUT stopping
#     voice, and the daemon reads the file at startup — so a live daemon has
#     to be restarted to see a newly-paired remote.
#   * the grouping-derived voice env another owner publishes
#     ($GROUPING_VOICE_ENV_FILE, an EnvironmentFile= of jasper-voice.service).
#     A bond/unbond rewrites it (TTS socket / mix stage / park flag) and hands
#     the restart to this script (jasper.multiroom.reconcile, step 3b) —
#     again without stopping voice and without touching $ENV_FILE, so the
#     stamp is the only place a non-parked leader's route flip is visible.
#
# Every other caller that kicks this reconciler either mutates $ENV_FILE (the
# /wake profile, leg, and AEC-mode endpoints), stops jasper-voice first (the
# chip-AEC commissioner's STOP_UNITS, the wake-corpus recorder), or declares
# intent explicitly (install passes, the enhanced-AEC activation marker — see
# voice_restart_intent below). None of those can be silently skipped.
voice_start_inputs() {
    probe_accessory_mics
    printf '%s\naccessory_mic_sources=%s\ngrouping_voice_env:\n%s\n' \
        "$INSTALLED_BUILD_ID" "$ACCESSORY_MIC_SOURCES" \
        "$(cat "$GROUPING_VOICE_ENV_FILE" 2>/dev/null || true)"
}

# True only when the running voice daemon was (re)started by a pass of this
# script that saw the same inputs. An absent stamp, an accessory probe that
# could not answer, or a grouping env that exists but cannot be read all
# resolve to FALSE: "I cannot prove nothing changed" must resolve to
# restarting. (An absent manifest needs no guard of its own:
# record_voice_restart_stamp refuses to write a stamp without one, so the
# absent-stamp check already covers it.)
voice_start_inputs_match_stamp() {
    local stamped
    probe_accessory_mics
    [[ "$ACCESSORY_MIC_PROBE_STATUS" == "resolved" ]] || return 1
    if [[ -e "$GROUPING_VOICE_ENV_FILE" && ! -r "$GROUPING_VOICE_ENV_FILE" ]]; then
        return 1
    fi
    stamped="$(cat "$VOICE_RESTART_STAMP" 2>/dev/null || true)"
    [[ -n "$stamped" && "$stamped" == "$(voice_start_inputs)" ]]
}

# Best-effort, like the gate-marker writers: a stamp we fail to write only
# costs the NEXT pass a restart it could have skipped. A stamp we cannot make
# current is REMOVED rather than left stale — a stale-but-matching stamp is the
# one failure that could suppress a restart that was needed.
record_voice_restart_stamp() {
    if [[ -n "$INSTALLED_BUILD_ID" ]] \
        && ensure_parent_dir "$VOICE_RESTART_STAMP" \
        && voice_start_inputs > "$VOICE_RESTART_STAMP" 2>/dev/null; then
        return 0
    fi
    rm -f "$VOICE_RESTART_STAMP" 2>/dev/null || true
}

# Real exit codes, not run_systemctl's `|| true`: the gate is asking a
# question, not issuing an order.
unit_active_and_enabled() {
    "$SYSTEMCTL" is-active --quiet "$1" >/dev/null 2>&1 \
        && "$SYSTEMCTL" is-enabled --quiet "$1" >/dev/null 2>&1
}

# Would restarting jasper-voice change anything the household can hear?
#
# The bug this answers: deploy/udev/99-jasper-aec-reconcile.rules fires on
# EVERY sound-card add|remove (deliberately id-agnostic — the policy lives
# here), and every mic-bearing branch below then restarts jasper-voice
# unconditionally. Plugging in a measurement microphone to take a room
# measurement therefore took the assistant down with it: ~8 s of deafness
# measured on jts3 (2026-08-18) for the chip-AEC bounce, and up to ~55 s worst
# case (see jasper-aec-reconcile.service's TimeoutStartSec note).
#
# Every condition is something a skip would silently lose, and anything
# unknown answers "restart": a false restart costs a few seconds of annoyance,
# a false skip costs a deaf speaker until the next event.
voice_restart_can_be_skipped() {
    [[ "$VOICE_RESTART_NEEDED" == "0" ]] || return 1
    # A pass that would clear the park marker is UN-parking voice, which is
    # the whole reason to restart it.
    [[ ! -e "$VOICE_INPUT_ABSENT_MARKER" ]] || return 1
    # voice_provider.env is not in $ENV_FILE, so a provider that went missing
    # or invalid is invisible to the change test above; restart_voice's park
    # branch has to run.
    voice_provider_configured || return 1
    voice_start_inputs_match_stamp || return 1
    unit_active_and_enabled jasper-voice.service || return 1
}

# The AEC stack's half of the same question. enable_start_aec blocking-restarts
# jasper-aec-init and the bridge, a mic outage of its own, and bouncing the
# bridge while leaving voice up would strand the daemon on a dead UDP carrier —
# so the two are gated TOGETHER, and only an already-running stack may skip.
aec_stack_bounce_can_be_skipped() {
    unit_active_and_enabled jasper-aec-init.service \
        && unit_active_and_enabled jasper-aec-bridge.service \
        && voice_restart_can_be_skipped
}

write_mic_profile_env() {
    set_env_var "$ENV_FILE" JASPER_XVF_PRESENT "${JASPER_XVF_PRESENT:-0}"
    set_env_var "$ENV_FILE" JASPER_XVF_VARIANT "${JASPER_XVF_VARIANT:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_DISPLAY_NAME "${JASPER_XVF_DISPLAY_NAME:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_GEOMETRY "${JASPER_XVF_GEOMETRY:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_ALSA_CARD "${JASPER_XVF_ALSA_CARD:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_CAPTURE_CHANNELS "${JASPER_XVF_CAPTURE_CHANNELS:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_CHIP_BEAM_PLAN "${JASPER_XVF_CHIP_BEAM_PLAN:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_CHIP_AEC_SUPPORTED "${JASPER_XVF_CHIP_AEC_SUPPORTED:-0}"
    set_env_var "$ENV_FILE" JASPER_XVF_RECOMMENDED_PROFILE "${JASPER_XVF_RECOMMENDED_PROFILE:-}"
    set_env_var "$ENV_FILE" JASPER_XVF_REASON "${JASPER_XVF_REASON:-}"
}

# Publish THIS script's half of the voice-input question, for jasper-voice.
#
# The gate marker is the AND of both halves' absences, so it cannot say WHICH
# half is satisfied — and the daemon needs exactly that. With no local
# microphone it must plan ZERO wake legs and serve the accessory's button
# instead of opening a primary leg against a card that is not there, which is
# the daemon half of issue #2205.
#
# The daemon must NOT re-derive this from its own config. `Config.mic_device`
# defaults to the literal "Array" when JASPER_MIC_DEVICE is unset, and the
# no-mic branches below deliberately write FALLBACK_MIC to clear a stale
# udp:PORT — so "empty or odd mic_device" is not evidence of absence on any
# real box. One owner, one derivation, published once.
#
# Three values, and the third is not padding:
#   1        a candidate capture card is present — the same `PRESENT_MIC`
#            probe every mic-selecting branch below already trusts.
#   0        positively no candidate capture card is present. This is the ONLY
#            value that lets the daemon skip its primary wake leg, which keeps
#            "there is no room mic" distinguishable from "the room mic should
#            be here and isn't" — the latter must still raise and park, or a
#            broken mic would silently downgrade to push-to-talk on a speaker
#            with no remote.
#   unknown  a custom JASPER_MIC_DEVICE: an operator device this script
#            deliberately does not manage, whose name need not appear in
#            MIC_CANDIDATES at all, so PRESENT_MIC says nothing about it.
#            Writing 1 would claim a check we did not perform; writing nothing
#            would let a stale 0 from an earlier pass silently downgrade a
#            custom-mic speaker to push-to-talk. Unknown reads as "plan the
#            leg", i.e. exactly today's behaviour.
#
# Written ONCE per pass, before the branch tree, so no RECONCILING path can
# exit leaving a stale value behind, and every restart_voice below picks up the
# fresh one. One exit precedes it: the live-commissioning-marker hand-off,
# where the foreground commissioner owns every lifecycle mutation. Same shape
# as write_mic_profile_env above.
write_local_mic_presence_env() {
    local value="unknown"
    if is_owned_mic_value "$CURRENT_MIC" "$UDP_DEVICE"; then
        if [[ -n "$PRESENT_MIC" ]]; then
            value="1"
        else
            value="0"
        fi
    fi
    set_env_var "$ENV_FILE" JASPER_LOCAL_MIC_PRESENT "$value"
    log "local mic presence: ${value} (candidate=${PRESENT_MIC:-<none>})"
}

mark_outputd_restart_if_changed() {
    local key="$1"
    local desired="$2"
    local current="${!key-}"
    if [[ "$current" != "$desired" ]]; then
        OUTPUTD_RESTART_NEEDED=1
    fi
}

normalize_mode() {
    local mode="${1:-auto}"
    mode="$(printf '%s' "$mode" | tr '[:upper:]' '[:lower:]')"
    case "$mode" in
        auto|"")
            echo "auto"
            ;;
        disabled|disable|off|false|0|no)
            echo "disabled"
            ;;
        *)
            log "unknown JASPER_AEC_MODE=${mode}; treating as disabled"
            echo "disabled"
            ;;
    esac
}

# Normalize the JASPER_WAKE_LEG_* booleans to "1" or "0". The wizard
# only writes "1" / "0", but operators editing aec_mode.env by hand
# might use yes/no/true/false. Default is supplied by the caller —
# RAW defaults on, DTLN defaults off.
normalize_bool() {
    local value="${1:-}"
    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
    case "$value" in
        1|on|true|yes|y|enabled|enable)
            echo "1"
            ;;
        0|off|false|no|n|disabled|disable|"")
            echo "0"
            ;;
        *)
            log "unknown bool ${value}; treating as 0"
            echo "0"
            ;;
    esac
}

# jasper.audio_profile_state owns this vocabulary; the shim emits it as shell
# assignments to the variables set below.
#
# ADR-0101: an unresolvable vocabulary is unmeasured, not a demotion. Callers
# pre-seed the selection as written and ignore the non-zero return, so a
# missing interpreter carries the declared profile and leaves mode and legs
# exactly as configured. Only a name the vocabulary does not have is demoted —
# without the resolver this script cannot route it, and unrouted is `custom`.
AUDIO_INPUT_PROFILE="custom"
AUDIO_INPUT_PROFILE_KNOWN="1"
AUDIO_INPUT_PROFILE_HAS_LEGS="0"
CHIP_AEC_TESTING_REQUESTED="0"
CHIP_AEC_PROFILE_SEEKS="0"
CHIP_AEC_PROFILE_NEEDS_MIC_READY="0"
read_audio_input_profile() {
    local payload
    if command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1 \
        && payload="$("$MIC_PROFILE_PYTHON" -m jasper.cli.audio_input_profile "$@")"; then
        # Output is produced by jasper.cli.audio_input_profile with shlex.quote.
        eval "$payload"
        return 0
    fi
    log "audio input profile resolver unavailable at ${MIC_PROFILE_PYTHON}; carrying the selection as written"
    case "$AUDIO_INPUT_PROFILE" in
        xvf_chip_aec_testing)
            CHIP_AEC_TESTING_REQUESTED="1"
            ;;
        auto|xvf_chip_aec|xvf_software_aec3|direct_mic|custom) ;;
        *)
            log "unroutable JASPER_AUDIO_INPUT_PROFILE=${AUDIO_INPUT_PROFILE} without the resolver; treating as custom"
            AUDIO_INPUT_PROFILE="custom"
            ;;
    esac
    return 1
}

normalize_output_dac_id() {
    local dac_id="${1:-unknown}"
    dac_id="$(printf '%s' "$dac_id" | tr '[:upper:]' '[:lower:]' | tr '-' '_')"
    dac_id="${dac_id//\'/}"
    dac_id="${dac_id//\"/}"
    if [[ -z "$dac_id" ]]; then
        dac_id="unknown"
    fi
    echo "$dac_id"
}

CHIP_AEC_DAC_GATE_DAC=""
CHIP_AEC_DAC_GATE_TESTING=""
CHIP_AEC_DAC_GATE_OK=0
CHIP_AEC_DAC_GATE_STATUS="needs_calibration"
CHIP_AEC_DAC_GATE_SOURCE="unresolved"
CHIP_AEC_DAC_GATE_DETAIL=""
CHIP_AEC_GATE_CARRY_NOTE="chip-AEC DAC gate could not be evaluated; carrying last verdict"

# ADR-0101: a gate that could not be evaluated is unmeasured, not a "no". Carry
# the verdict last resolved for the SAME DAC — write_chip_aec_gate_env records
# it for exactly this read — so a missing interpreter cannot drop a
# commissioned box off chip-AEC. An absent id or status, or a different DAC,
# withholds the record — never the selection; jasper.chip_aec_policy's module
# docstring owns the rule.
carry_chip_aec_dac_gate() {
    local dac_id="$1" testing="$2" detail
    [[ -n "${JASPER_AEC_CHIP_AEC_DAC_ID:-}" ]] || return 1
    [[ -n "${JASPER_AEC_CHIP_AEC_DAC_STATUS:-}" ]] || return 1
    [[ "$(normalize_output_dac_id "$JASPER_AEC_CHIP_AEC_DAC_ID")" == "$dac_id" ]] || return 1
    # One record, both selections — ChipAecGate.permits is this same mapping:
    # `approved` is the only status the automatic profile arms on, while a
    # testing selection may arm any status.
    if [[ "${JASPER_AEC_CHIP_AEC_DAC_STATUS}" == "approved" || "$testing" == "1" ]]; then
        CHIP_AEC_DAC_GATE_OK=1
    else
        CHIP_AEC_DAC_GATE_OK=0
    fi
    detail="${JASPER_AEC_CHIP_AEC_DAC_DETAIL:-}"
    # Idempotent across passes: a carried record is re-recorded each pass the
    # resolver stays down, so strip the note before re-appending it.
    detail="${detail%"; ${CHIP_AEC_GATE_CARRY_NOTE}"}"
    CHIP_AEC_DAC_GATE_STATUS="$JASPER_AEC_CHIP_AEC_DAC_STATUS"
    CHIP_AEC_DAC_GATE_SOURCE="runtime_env_carried"
    CHIP_AEC_DAC_GATE_DETAIL="${detail:+${detail}; }${CHIP_AEC_GATE_CARRY_NOTE}"
    log "chip-AEC DAC gate resolver unavailable for output_dac=${dac_id}; carrying last verdict status=${CHIP_AEC_DAC_GATE_STATUS} permitted=${CHIP_AEC_DAC_GATE_OK}"
}

refresh_chip_aec_dac_gate() {
    local dac_id testing payload args
    dac_id="$(normalize_output_dac_id "${1:-unknown}")"
    testing="${2:-0}"
    if [[ "$CHIP_AEC_DAC_GATE_DAC" == "$dac_id" \
        && "$CHIP_AEC_DAC_GATE_TESTING" == "$testing" ]]; then
        return
    fi
    CHIP_AEC_DAC_GATE_DAC="$dac_id"
    CHIP_AEC_DAC_GATE_TESTING="$testing"
    CHIP_AEC_DAC_GATE_OK=0
    CHIP_AEC_DAC_GATE_STATUS="needs_calibration"
    CHIP_AEC_DAC_GATE_SOURCE="policy_unavailable"
    CHIP_AEC_DAC_GATE_DETAIL=""
    if ! command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1; then
        carry_chip_aec_dac_gate "$dac_id" "$testing" \
            || CHIP_AEC_DAC_GATE_DETAIL="chip-AEC policy unavailable: python not found at ${MIC_PROFILE_PYTHON}"
        return
    fi
    args=(-m jasper.cli.chip_aec_policy
        --dac-id "$dac_id"
        --outputd-socket "$OUTPUTD_CONTROL_SOCKET"
        --shell-env)
    if [[ "$testing" == "1" ]]; then
        args+=(--testing-requested)
    fi
    if ! payload="$("$MIC_PROFILE_PYTHON" "${args[@]}")"; then
        carry_chip_aec_dac_gate "$dac_id" "$testing" \
            || CHIP_AEC_DAC_GATE_DETAIL="chip-AEC policy resolver failed"
        return
    fi
    # Output is produced by jasper.cli.chip_aec_policy with shlex.quote.
    eval "$payload"
    CHIP_AEC_DAC_GATE_DAC="${JASPER_CHIP_AEC_DAC_GATE_DAC:-$dac_id}"
    CHIP_AEC_DAC_GATE_OK="${JASPER_CHIP_AEC_DAC_GATE_PERMITTED:-0}"
    CHIP_AEC_DAC_GATE_STATUS="${JASPER_CHIP_AEC_DAC_GATE_STATUS:-needs_calibration}"
    CHIP_AEC_DAC_GATE_SOURCE="${JASPER_CHIP_AEC_DAC_GATE_SOURCE:-unknown}"
    CHIP_AEC_DAC_GATE_DETAIL="${JASPER_CHIP_AEC_DAC_GATE_DETAIL:-}"
}

chip_aec_dac_supported() {
    refresh_chip_aec_dac_gate "${1:-unknown}" "${2:-0}"
    [[ "$CHIP_AEC_DAC_GATE_OK" == "1" ]]
}

chip_aec_dac_detail() {
    refresh_chip_aec_dac_gate "${1:-unknown}" "${2:-0}"
    echo "$CHIP_AEC_DAC_GATE_DETAIL"
}

log_chip_aec_dac_gate_if_dynamic() {
    refresh_chip_aec_dac_gate "${1:-unknown}" "${2:-0}"
    if [[ "$CHIP_AEC_DAC_GATE_OK" == "1" ]]; then
        log "chip-AEC DAC gate permits output_dac=$(normalize_output_dac_id "${1:-unknown}") status=${CHIP_AEC_DAC_GATE_STATUS} source=${CHIP_AEC_DAC_GATE_SOURCE}: ${CHIP_AEC_DAC_GATE_DETAIL}"
    fi
}

write_chip_aec_gate_env() {
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_TESTING_REQUESTED "$CHIP_AEC_TESTING_REQUESTED"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_DAC_ID "$CHIP_AEC_DAC_GATE_DAC"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_DAC_STATUS "$CHIP_AEC_DAC_GATE_STATUS"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_DAC_SOURCE "$CHIP_AEC_DAC_GATE_SOURCE"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_DAC_DETAIL "$CHIP_AEC_DAC_GATE_DETAIL"
}

chip_aec_mic_supported() {
    [[ "${JASPER_XVF_CHIP_AEC_SUPPORTED:-0}" == "1" ]] \
        && [[ -n "${JASPER_XVF_CHIP_BEAM_PLAN:-}" ]]
}

chip_aec_mic_detail() {
    if chip_aec_mic_supported; then
        echo "supported beam_plan=${JASPER_XVF_CHIP_BEAM_PLAN}"
    else
        echo "${JASPER_XVF_REASON:-mic has no validated production chip-AEC beam plan}"
    fi
}

# Why chip-AEC is not armed, from whichever half blocks it. The mic dominates:
# no DAC verdict makes chip-AEC usable without a beam plan to emit.
chip_aec_block_detail() {
    if ! chip_aec_mic_supported; then
        chip_aec_mic_detail
    else
        chip_aec_dac_detail "$1" "$2"
    fi
}

mode_file_value() {
    local key="$1"
    local default="$2"
    local line
    if [[ -f "$MODE_FILE" ]]; then
        line="$(grep -E "^${key}=" "$MODE_FILE" | tail -n 1 || true)"
        if [[ -n "$line" ]]; then
            printf '%s\n' "${line#*=}"
            return
        fi
    fi
    printf '%s\n' "$default"
}

# The closest profile for a mode file written before profiles existed. A
# subshell, so seeding never disturbs the pass's own selection; exits non-zero
# when the resolver is down, which leaves the key unseeded for the next pass
# rather than stamping a guess.
infer_audio_input_profile_from_mode_file() (
    read_audio_input_profile --infer \
        --mode="$(normalize_mode "$(mode_file_value JASPER_AEC_MODE auto)")" \
        --leg-raw="$(mode_file_value JASPER_WAKE_LEG_RAW 1)" \
        --leg-dtln="$(mode_file_value JASPER_WAKE_LEG_DTLN 0)" \
        --leg-chip-aec="$(mode_file_value JASPER_WAKE_LEG_CHIP_AEC 0)" \
        --leg-chip-aec-150="$(mode_file_value JASPER_WAKE_LEG_CHIP_AEC_150 0)" \
        --leg-chip-aec-210="$(mode_file_value JASPER_WAKE_LEG_CHIP_AEC_210 0)" \
        || return 1
    printf '%s\n' "$AUDIO_INPUT_PROFILE"
)

# The shell runs the probes; the shim already said which profiles they apply
# to. A profile that does not seek chip-AEC returns before the DAC gate is
# queried at all, so an unasked gate keeps its unresolved record.
chip_aec_can_arm() {
    [[ "$CHIP_AEC_PROFILE_SEEKS" == "1" ]] || return 1
    if [[ "$CHIP_AEC_PROFILE_NEEDS_MIC_READY" == "1" ]] \
        && ! aec_ready "$AEC_MIC_DEVICE"; then
        return 1
    fi
    chip_aec_mic_supported \
        && chip_aec_dac_supported "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"
}

apply_audio_input_profile() {
    local chip_available=0
    MANAGED_XVF_PARK_REASON=""
    MANAGED_XVF_DISCLOSURE=""
    # The publish_alignment_record disposition (and, where the remedy is this
    # script's own firmware vocabulary, the action) for MANAGED_XVF_DISCLOSURE.
    MANAGED_XVF_DISCLOSURE_ARGS=(disclosed)
    if managed_xvf_policy_applies; then
        AEC_MODE="auto"
        LEG_RAW="0"
        LEG_DTLN="0"
        LEG_CHIP_AEC="0"
        LEG_CHIP_AEC_150="0"
        LEG_CHIP_AEC_210="0"
        if aec_ready "$AEC_MIC_DEVICE" \
            && chip_aec_mic_supported \
            && chip_aec_dac_supported "$AUDIO_DAC_ID" "0"; then
            LEG_CHIP_AEC="1"
            log_chip_aec_dac_gate_if_dynamic "$AUDIO_DAC_ID" "0"
        elif ! aec_ready "$AEC_MIC_DEVICE"; then
            # Not 6-channel. A present, voice-eligible card is still a mic, so
            # it is captured directly and disclosed; only an absent card or a
            # measurement-class instrument (protected driver) parks.
            if voice_mic_present "$AEC_MIC_DEVICE"; then
                MANAGED_XVF_DISCLOSURE="$XVF_2CH_DISCLOSURE"
                MANAGED_XVF_DISCLOSURE_ARGS=(disclosed --action "$XVF_2CH_ACTION")
            else
                MANAGED_XVF_PARK_REASON="no usable managed XVF capture device present"
            fi
        else
            # No beam plan, or no codified DAC timing: the 6-channel mic still
            # carries the software AEC3 leg the non-managed `auto` path uses.
            LEG_RAW="1"
            MANAGED_XVF_DISCLOSURE="$(chip_aec_block_detail "$AUDIO_DAC_ID" "0")"
            MANAGED_XVF_DISCLOSURE_ARGS=(dac_uncalibrated)
        fi
        return
    fi
    [[ "$AUDIO_INPUT_PROFILE_HAS_LEGS" == "1" ]] || return 0
    if chip_aec_can_arm; then
        chip_available=1
        log_chip_aec_dac_gate_if_dynamic "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"
    elif [[ "$AUDIO_INPUT_PROFILE" == "xvf_chip_aec" ]]; then
        log "requested xvf_chip_aec but output_dac=${AUDIO_DAC_ID} is not calibrated for chip AEC: $(chip_aec_block_detail "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"); using software AEC3"
    elif [[ "$AUDIO_INPUT_PROFILE" == "xvf_chip_aec_testing" ]]; then
        log "requested xvf_chip_aec_testing but chip-AEC cannot be armed for output_dac=${AUDIO_DAC_ID}: $(chip_aec_block_detail "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"); using software AEC3"
    elif [[ "$AUDIO_INPUT_PROFILE" == "auto" ]] && aec_ready "$AEC_MIC_DEVICE"; then
        log "chip-AEC unavailable for output_dac=${AUDIO_DAC_ID}: $(chip_aec_block_detail "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"); using software AEC3"
    fi
    read_audio_input_profile --profile="$AUDIO_INPUT_PROFILE" \
        --chip-available="$chip_available" || true
}

# Map wake-leg booleans to the underlying env vars that
# jasper-aec-bridge and jasper-voice each read at startup. When the
# bridge isn't going to run (bridge_running="0"), clear them all —
# they're meaningless without a bridge emitting on the UDP ports,
# and a stale JASPER_MIC_DEVICE_RAW=udp:9877 leaves the voice
# secondary UdpMicCapture spinning on a port nobody talks to.
#
# Single-chip mutual exclusion (chip-AEC): the XVF chip can emit EITHER
# the software legs (raw :9877 / DTLN :9878 alongside AEC3 :9876) OR the
# chip-AEC beams, not both — Option-A means in chip-AEC mode the bridge
# forwards the chip-AEC beam into :9876 (session + Tier-1 heartbeat
# carrier). Extra fixed 150°/210° wake detectors on :9887/:9888 are
# per-beam custom opt-ins, so the default chip-AEC profile opens only
# one wake detector. When chip-AEC is on we clear raw/DTLN, and vice versa.
#
# The booleans themselves stay preserved in $MODE_FILE — that's the
# user's wizard-managed intent. We just don't *apply* them when the
# bridge is down. When the user re-enables AEC, the legs they had
# configured come back automatically on the next reconcile pass.
write_leg_env() {
    local bridge_running="$1"
    local leg_raw="$2"
    local leg_dtln="$3"
    local leg_chip_aec="$4"
    local leg_chip_aec_150="${5:-0}"
    local leg_chip_aec_210="${6:-0}"
    local raw_udp dtln_udp dtln_flag chip_150_udp chip_210_udp chip_flag
    local ref_source outputd_chip_ref_pcm outputd_ref_target observe_flag
    local outputd_chip_ref_rate outputd_chip_ref_period outputd_chip_ref_buffer
    local bridge_ref_host bridge_ref_port producer_was_active
    # outputd's final speaker monitor is the bridge's only reference
    # source, in every state. The retired `alsa` value the parked
    # branches below used to write named the snd-aloop tap the bridge no
    # longer reads (U4 / P7-1). Those states stop the bridge outright —
    # `stop_disable_aec` for bridge_running="0", `park_managed_xvf` for
    # "reference" — so what they publish is a resting value, not a live
    # transport choice; publishing the one supported value keeps the
    # parked file self-consistent for whoever reads it next.
    ref_source="outputd_udp"
    producer_was_active=0
    if [[ -n "${JASPER_OUTPUTD_CHIP_REF_PCM-}" || -n "${JASPER_OUTPUTD_REFERENCE_UDP_TARGET-}" ]]; then
        producer_was_active=1
    fi
    if [[ "$bridge_running" == "1" && "$leg_chip_aec" == "1" ]]; then
        # Chip-AEC production mode (Option-A): the chip-AEC beam is
        # forwarded into :9876 as the session/heartbeat carrier. Optional
        # fixed-beam wake detectors are only advertised to jasper-voice
        # when the matching advanced toggle is on.
        if [[ "$leg_chip_aec_150" == "1" ]]; then
            chip_150_udp="udp:${AEC_UDP_PORT_CHIP_AEC_150}"
        else
            chip_150_udp=""
        fi
        if [[ "$leg_chip_aec_210" == "1" ]]; then
            chip_210_udp="udp:${AEC_UDP_PORT_CHIP_AEC_210}"
        else
            chip_210_udp=""
        fi
        chip_flag="1"
        # Production chip-AEC, not observe mode: the chip-ref writer is
        # armed because the chip IS the mic path here.
        observe_flag="0"
        raw_udp=""
        dtln_udp=""
        dtln_flag="0"
        bridge_ref_host="127.0.0.1"
        bridge_ref_port="${AEC_OUTPUTD_REF_UDP_PORT}"
        outputd_chip_ref_pcm="${OUTPUTD_CHIP_REF_PCM}"
        outputd_ref_target="${bridge_ref_host}:${bridge_ref_port}"
        outputd_chip_ref_rate="${OUTPUTD_CHIP_REF_SAMPLE_RATE}"
        outputd_chip_ref_period="${OUTPUTD_CHIP_REF_PERIOD_FRAMES}"
        outputd_chip_ref_buffer="${OUTPUTD_CHIP_REF_BUFFER_FRAMES}"
    elif [[ "$bridge_running" == "reference" ]]; then
        raw_udp=""
        dtln_udp=""
        dtln_flag="0"
        chip_150_udp=""
        chip_210_udp=""
        # Init needs the production flag while bridge/voice remain parked.
        chip_flag="1"
        observe_flag="0"
        bridge_ref_host="127.0.0.1"
        bridge_ref_port="${AEC_OUTPUTD_REF_UDP_PORT}"
        outputd_chip_ref_pcm="${OUTPUTD_CHIP_REF_PCM}"
        outputd_ref_target=""
        outputd_chip_ref_rate="${OUTPUTD_CHIP_REF_SAMPLE_RATE}"
        outputd_chip_ref_period="${OUTPUTD_CHIP_REF_PERIOD_FRAMES}"
        outputd_chip_ref_buffer="${OUTPUTD_CHIP_REF_BUFFER_FRAMES}"
    elif [[ "$bridge_running" == "1" ]]; then
        # Software-leg mode: raw/DTLN as configured, chip beams cleared.
        # The far-end reference still comes from outputd's final speaker
        # monitor so software AEC, chip-AEC, corpus, and diagnostics all
        # consume the same reference contract.
        if [[ "$leg_raw" == "1" ]]; then
            raw_udp="udp:${AEC_UDP_PORT_RAW}"
        else
            raw_udp=""
        fi
        if [[ "$leg_dtln" == "1" ]]; then
            dtln_udp="udp:${AEC_UDP_PORT_DTLN}"
            dtln_flag="1"
        else
            dtln_udp=""
            dtln_flag="0"
        fi
        chip_150_udp=""
        chip_210_udp=""
        chip_flag="0"
        bridge_ref_host="127.0.0.1"
        bridge_ref_port="${AEC_OUTPUTD_REF_UDP_PORT}"
        # Explicit custom/lab observation only; this never authorizes a
        # production DAC or changes the software-AEC3 mic path.
        if [[ "$CHIP_REF_OBSERVE" == "1" && -n "${OUTPUTD_CHIP_REF_PCM}" ]]; then
            outputd_chip_ref_pcm="${OUTPUTD_CHIP_REF_PCM}"
            observe_flag="1"
        else
            outputd_chip_ref_pcm=""
            observe_flag="0"
        fi
        outputd_ref_target="${bridge_ref_host}:${bridge_ref_port}"
        outputd_chip_ref_rate="${OUTPUTD_CHIP_REF_SAMPLE_RATE}"
        outputd_chip_ref_period="${OUTPUTD_CHIP_REF_PERIOD_FRAMES}"
        outputd_chip_ref_buffer="${OUTPUTD_CHIP_REF_BUFFER_FRAMES}"
    else
        raw_udp=""
        dtln_udp=""
        dtln_flag="0"
        chip_150_udp=""
        chip_210_udp=""
        chip_flag="0"
        observe_flag="0"
        bridge_ref_host="127.0.0.1"
        bridge_ref_port="${AEC_OUTPUTD_REF_UDP_PORT}"
        outputd_chip_ref_pcm=""
        outputd_ref_target=""
        outputd_chip_ref_rate="${OUTPUTD_CHIP_REF_SAMPLE_RATE}"
        outputd_chip_ref_period="${OUTPUTD_CHIP_REF_PERIOD_FRAMES}"
        outputd_chip_ref_buffer="${OUTPUTD_CHIP_REF_BUFFER_FRAMES}"
    fi
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE_RAW "$raw_udp"
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE_DTLN "$dtln_udp"
    set_env_var "$ENV_FILE" JASPER_AEC_DTLN_ENABLED "$dtln_flag"
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE_CHIP_AEC_150 "$chip_150_udp"
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE_CHIP_AEC_210 "$chip_210_udp"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_ENABLED "$chip_flag"
    set_env_var "$ENV_FILE" JASPER_AEC_REF_SOURCE "$ref_source"
    set_env_var "$ENV_FILE" JASPER_AEC_OUTPUTD_REF_UDP_HOST "$bridge_ref_host"
    set_env_var "$ENV_FILE" JASPER_AEC_OUTPUTD_REF_UDP_PORT "$bridge_ref_port"

    if [[ "$observe_flag" == "1" ]]; then
        log "chip-ref observe mode: arming chip-ref writer for drift measurement; mic path stays software AEC3"
    fi

    mark_outputd_restart_if_changed JASPER_OUTPUTD_CHIP_REF_PCM "$outputd_chip_ref_pcm"
    mark_outputd_restart_if_changed JASPER_OUTPUTD_REFERENCE_UDP_TARGET "$outputd_ref_target"
    mark_outputd_restart_if_changed JASPER_OUTPUTD_CHIP_REF_OBSERVE "$observe_flag"
    if [[ "$chip_flag" == "1" || "$producer_was_active" == "1" ]]; then
        mark_outputd_restart_if_changed JASPER_OUTPUTD_CHIP_REF_SAMPLE_RATE "$outputd_chip_ref_rate"
        mark_outputd_restart_if_changed JASPER_OUTPUTD_CHIP_REF_PERIOD_FRAMES "$outputd_chip_ref_period"
        mark_outputd_restart_if_changed JASPER_OUTPUTD_CHIP_REF_BUFFER_FRAMES "$outputd_chip_ref_buffer"
    fi
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_CHIP_REF_PCM "$outputd_chip_ref_pcm"
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_REFERENCE_UDP_TARGET "$outputd_ref_target"
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_CHIP_REF_OBSERVE "$observe_flag"
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_CHIP_REF_SAMPLE_RATE "$outputd_chip_ref_rate"
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_CHIP_REF_PERIOD_FRAMES "$outputd_chip_ref_period"
    set_env_var "$ENV_FILE" JASPER_OUTPUTD_CHIP_REF_BUFFER_FRAMES "$outputd_chip_ref_buffer"
    # Keep producer detection for repeated transitions aligned with the env file.
    JASPER_OUTPUTD_CHIP_REF_PCM="$outputd_chip_ref_pcm"
    JASPER_OUTPUTD_REFERENCE_UDP_TARGET="$outputd_ref_target"
}

card_id_from_spec() {
    local spec="$1"
    if [[ "$spec" =~ CARD=([^,]+) ]]; then
        echo "${BASH_REMATCH[1]}"
    elif [[ "$spec" =~ ^(hw|plughw):([^,]+) ]]; then
        echo "${BASH_REMATCH[2]}"
    else
        echo "$spec"
    fi
}

card_stream_file() {
    local spec="$1"
    local card
    card="$(card_id_from_spec "$spec")"
    echo "${ASOUND_ROOT}/${card}/stream0"
}

mic_present() {
    local spec="$1"
    [[ -f "$(card_stream_file "$spec")" ]]
}

# --- measurement-class microphone exclusion ---------------------------------
#
# A calibrated measurement microphone (the /correction/ wizard's UMIK-2 and
# friends) enumerates as an ordinary capture card, and it must NEVER become the
# voice/wake input: it carries no wake or AEC contract, so selecting one would
# silently swap the household's room mic for an instrument.
#
# Identity is the USB vid:pid, never the serial — a UMIK-2's USB serial
# descriptor is the literal "00000" on every unit. The ids are owned by
# jasper.audio_measurement.calibration and reach bash through
# `python -m jasper.cli.measurement_mic`, the same bridge shape
# observe_mic_profile_state uses for the mic profile, so no second copy of the
# vocabulary lives here. Resolved AT MOST ONCE per pass, and only once a card
# that is actually present turns out to expose a USB id — a box with no USB
# capture card never pays for the interpreter.
#
# Defense in depth, not the only defense: DEFAULT_MIC_DEVICE_CANDIDATES is a
# closed allowlist no measurement mic appears in, so on a stock box this
# excludes nothing. It is here for a box whose operator widened
# JASPER_MIC_DEVICE_CANDIDATES, and it fails OPEN — a resolver that cannot
# answer excludes nothing, because refusing to classify must never be able to
# leave a speaker with no microphone at all.
MEASUREMENT_USB_IDS=""
MEASUREMENT_USB_IDS_STATUS="unresolved"

card_usbid() {
    local card path
    card="$(card_id_from_spec "$1")"
    path="${ASOUND_ROOT}/${card}/usbid"
    if [[ -r "$path" ]]; then
        # The kernel writes %04x:%04x, so this only normalises a hand-made
        # test fixture and strips the trailing newline.
        tr '[:upper:]' '[:lower:]' < "$path" | tr -d '[:space:]' || true
    fi
}

resolve_measurement_usb_ids() {
    local payload
    [[ "$MEASUREMENT_USB_IDS_STATUS" == "unresolved" ]] || return 0
    if ! command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1; then
        MEASUREMENT_USB_IDS_STATUS="unavailable"
        log "measurement-mic registry unavailable at ${MIC_PROFILE_PYTHON}; measurement mics are NOT excluded from the mic candidates this pass"
        return 0
    fi
    # stderr is deliberately NOT redirected: a traceback from a partial deploy
    # is the whole diagnostic, same as probe_accessory_mics.
    if payload="$("$MIC_PROFILE_PYTHON" -m jasper.cli.measurement_mic)"; then
        MEASUREMENT_USB_IDS="$(printf '%s' "$payload" | tr '\n' ' ')"
        MEASUREMENT_USB_IDS_STATUS="resolved"
    else
        MEASUREMENT_USB_IDS_STATUS="failed"
        log "measurement-mic registry probe failed (see the message above); measurement mics are NOT excluded from the mic candidates this pass"
    fi
    return 0
}

# The single resolve point, and it must run in the PARENT shell: every caller
# of measurement_class_card below sits inside a command substitution, and a
# memo set in a subshell dies with it — the registry would be re-resolved,
# and the interpreter re-spawned, once per candidate probe.
#
# Skipped outright when no candidate exposes a USB id, so a box with no USB
# capture card never pays for the interpreter at all.
prime_measurement_usb_ids() {
    local candidate
    for candidate in "${MIC_CANDIDATES[@]}"; do
        if [[ -n "$(card_usbid "$candidate")" ]]; then
            resolve_measurement_usb_ids
            return 0
        fi
    done
}

measurement_class_card() {
    local usbid
    # Unresolved means priming found nothing to classify, or the resolver
    # could not answer: either way, exclude nothing (fail open).
    [[ "$MEASUREMENT_USB_IDS_STATUS" == "resolved" ]] || return 1
    usbid="$(card_usbid "$1")"
    # No USB id: an absent card, or an I2S/virtual capture device. Cannot be a
    # registered USB measurement mic.
    [[ -n "$usbid" ]] || return 1
    case " ${MEASUREMENT_USB_IDS} " in
        *" ${usbid} "*)
            return 0
            ;;
    esac
    return 1
}

# "Present AND eligible to carry the voice/wake path."
#
# mic_present stays a pure hardware fact (it is also what
# derive_profile_managed_aec_mic_device asks about an XVF the profile resolver
# has already identified); this is the SELECTION predicate, so a measurement
# mic can never be chosen however wide the candidate list is.
#
# Note the scope. This stops the reconciler from SELECTING one; an operator's
# explicit JASPER_MIC_DEVICE remains their own, exactly as is_owned_mic_value
# already promises. What changes for a widened candidate list is that a
# measurement card sitting in JASPER_MIC_DEVICE now reads as "no candidate
# present", so the stale value is cleared and voice parks rather than opening
# an instrument.
voice_mic_present() {
    mic_present "$1" && ! measurement_class_card "$1"
}

mic_channels() {
    local spec="$1"
    local stream channels
    stream="$(card_stream_file "$spec")"
    if [[ ! -f "$stream" ]]; then
        echo 0
        return
    fi
    # /proc/asound/<card>/stream0 has separate Playback and Capture
    # blocks, each with its own "Channels:" line. We need the Capture
    # one — the XVF chip's Playback endpoint is 2-ch even when Capture
    # is 6-ch on the 6-ch firmware. Pinning to ^Capture: prevents a
    # silent fallback to direct-mic when AEC should be enabled.
    channels="$(awk '/^Capture:/{cap=1} cap && /Channels:[[:space:]]*[0-9]+/{print; exit}' "$stream" \
        | grep -oE "[0-9]+" \
        | head -1)"
    echo "${channels:-0}"
}

aec_ready() {
    local mic="$1"
    # Channel count alone is not eligibility: a 6-channel measurement-class
    # card would pass the format check and put the software-AEC stack on an
    # instrument. Selection predicates exclude measurement mics everywhere,
    # including here.
    [[ "$(mic_channels "$mic")" == "6" ]] && ! measurement_class_card "$mic"
}

managed_xvf_card_present() {
    [[ "$MIC_PROFILE_RESOLUTION_STATUS" == "resolved" ]] \
        && [[ "${JASPER_XVF_PRESENT:-0}" == "1" ]] \
        && [[ -n "${JASPER_XVF_ALSA_CARD:-}" ]]
}

managed_xvf_policy_applies() {
    [[ "${AUDIO_INPUT_PROFILE:-custom}" != "custom" ]] \
        && { managed_xvf_card_present \
            || [[ "$MIC_PROFILE_RESOLUTION_STATUS" != "resolved" ]]; }
}

# When the chip is flashed from the 2-ch firmware to the 6-ch firmware
# (the BRINGUP path), ALSA assigns mixer slots for the new ch2-5 with
# default values of off / 0 dB. `alsactl restore` then persists that
# state across reboot — silencing the raw mics in the kernel
# independently of the chip's own configuration, with no surface that
# would let the operator notice. Force the capture channels open
# whenever we confirm the chip is on 6-ch firmware. Idempotent; safe
# to run on every reconcile pass.
#
# Canonical reference for these mixer names + the rationale: the
# `jasper.mics.xvf3800` Python profile. This reconciler is bash and
# can't import Python; if the names or channel count change in the
# profile, update them here too. The doctor's `check_xvf_mixer_state`
# reads from the profile and flags drift if the two get out of sync.
ensure_capture_mixer_open() {
    local spec="$1"
    local card
    card="$(card_id_from_spec "$spec")"
    amixer -c "$card" cset name='Headset Capture Switch' \
        on,on,on,on,on,on >/dev/null 2>&1 || true
    amixer -c "$card" cset name='Headset Capture Volume' \
        60,60,60,60,60,60 >/dev/null 2>&1 || true
    alsactl store >/dev/null 2>&1 || true
}

split_candidates() {
    local raw="$1"
    raw="${raw//,/ }"
    # shellcheck disable=SC2206
    MIC_CANDIDATES=($raw)
}

mic_candidates_contains() {
    local needle="$1"
    local candidate
    for candidate in "${MIC_CANDIDATES[@]}"; do
        [[ "$candidate" == "$needle" ]] && return 0
    done
    return 1
}

prepend_mic_candidate() {
    local candidate="$1"
    [[ -n "$candidate" ]] || return 0
    mic_candidates_contains "$candidate" && return 0
    MIC_CANDIDATES=("$candidate" "${MIC_CANDIDATES[@]}")
}

profile_managed_mic_resolution() {
    # `custom` is the escape hatch for operator-managed mic routing. Every
    # selectable product profile is reconciler-owned: the detected mic
    # profile supplies the concrete ALSA card, so swapping XVF variants cannot
    # leave an old card id pinned in /etc/jasper/jasper.env.
    [[ "${AUDIO_INPUT_PROFILE:-custom}" != "custom" ]]
}

derive_profile_managed_aec_mic_device() {
    local detected_card old_card
    profile_managed_mic_resolution || return 0
    detected_card="${JASPER_XVF_ALSA_CARD:-}"
    [[ -n "$detected_card" ]] || return 0
    mic_present "$detected_card" || return 0

    old_card="${AEC_MIC_DEVICE:-}"
    AEC_MIC_DEVICE="$detected_card"
    prepend_mic_candidate "$detected_card"
    if [[ -n "$old_card" && "$old_card" != "$detected_card" ]]; then
        log "event=aec_reconcile.aec_mic_device_rederived profile=${AUDIO_INPUT_PROFILE} old=${old_card} new=${detected_card} variant=${JASPER_XVF_VARIANT:-unknown} reason=detected_xvf_profile_wins"
    elif [[ -z "$old_card" ]]; then
        log "event=aec_reconcile.aec_mic_device_derived profile=${AUDIO_INPUT_PROFILE} new=${detected_card} variant=${JASPER_XVF_VARIANT:-unknown}"
    fi
}

first_candidate() {
    local candidate
    if [[ ${#MIC_CANDIDATES[@]} -gt 0 ]]; then
        # Prefer a candidate that could actually carry voice. This value
        # becomes FALLBACK_MIC, which the no-mic branches write into
        # JASPER_MIC_DEVICE to clear a stale udp: selection, and which seeds
        # JASPER_AEC_MIC_DEVICE — so naming a measurement mic here would park
        # a speaker whose published microphone is an instrument.
        for candidate in "${MIC_CANDIDATES[@]}"; do
            if ! measurement_class_card "$candidate"; then
                echo "$candidate"
                return 0
            fi
        done
        # Every candidate is a present measurement mic: a configuration with
        # no voice microphone at all. NEVER name the instrument here — this
        # value seeds JASPER_MIC_DEVICE and JASPER_AEC_MIC_DEVICE, and a later
        # consumer that trusts the name (a park marker cleared by accessory
        # pairing, an operator reading jasper.env) must not be handed a
        # measurement card. The stock first candidate is a real card name on
        # every supported box and simply parks while absent.
        echo "${DEFAULT_MIC_DEVICE_CANDIDATES%%,*}"
    else
        echo "$AEC_MIC_DEVICE"
    fi
}

first_present_candidate() {
    local candidate
    for candidate in "${MIC_CANDIDATES[@]}"; do
        if voice_mic_present "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

is_candidate_value() {
    local value="$1"
    local candidate
    for candidate in "${MIC_CANDIDATES[@]}"; do
        [[ "$value" == "$candidate" ]] && return 0
    done
    return 1
}

is_owned_mic_value() {
    local value="$1"
    local udp_device="$2"
    [[ -z "$value" ]] && return 0
    [[ "$value" == "$udp_device" ]] && return 0
    [[ "$value" == udp:* ]] && return 0
    [[ "$value" =~ ^hw:[0-9]+,1$ ]] && return 0
    is_candidate_value "$value" && return 0
    return 1
}

run_systemctl() {
    "$SYSTEMCTL" "$@" || true
}

# Where the reconciler-owned voice drop-in lives. Overridable so the test
# harness can point it at a temp tree, like JASPER_SYSTEMCTL does for systemctl.
JASPER_SYSTEMD_DIR="${JASPER_SYSTEMD_DIR:-/etc/systemd/system}"
VOICE_BRIDGE_WANT_DROPIN="${JASPER_SYSTEMD_DIR}/jasper-voice.service.d/10-aec-bridge-want.conf"

set_voice_bridge_want() {
    # $1 = "on" to make jasper-voice pull the bridge, "off" to stop it.
    #
    # The want cannot be static in the unit: `Wants=` starts a unit even when
    # it is disabled, so a box with no local mic -- a streambox answering
    # through a paired Bluetooth remote on the accessory path -- would start
    # the AEC stack anyway. This reconciler already decides whether the bridge
    # runs, so it decides whether voice wants it, from the same places.
    local want_dir
    want_dir="$(dirname "${VOICE_BRIDGE_WANT_DROPIN}")"
    if [[ "$1" == "on" ]]; then
        mkdir -p "${want_dir}" || return 0
        printf '[Unit]\nWants=jasper-aec-bridge.service\n' \
            > "${VOICE_BRIDGE_WANT_DROPIN}" || return 0
    else
        [[ -e "${VOICE_BRIDGE_WANT_DROPIN}" ]] || return 0
        rm -f "${VOICE_BRIDGE_WANT_DROPIN}" || return 0
    fi
    run_systemctl daemon-reload
}

reset_failed_units() {
    local unit
    for unit in "$@"; do
        # `reset-failed` is intentionally unconditional: besides clearing
        # a failed state, systemd also clears the unit's start-rate
        # counters. A controlled deploy/reconcile/toggle sequence can
        # otherwise accumulate enough clean restarts to hit
        # StartLimitAction=reboot even though no service is unhealthy.
        run_systemctl reset-failed "$unit"
    done
}

stop_disable_aec() {
    # The mirror of enable_start_aec's flag, and the reason it keys on
    # is-active rather than on env deltas: the gate compares FILE states, but
    # the RUNNING daemon's environment is unobservable — jasper-voice may have
    # been started under an older udp: topology even when today's file already
    # names a card. A live bridge is the one observable hint that a UDP
    # carrier may still be in use, so tearing it down must carry a voice
    # restart with it. If the bridge is already down this is a no-op and must
    # NOT force a restart, or every direct-mic and AEC-disabled box would
    # bounce voice on every pass.
    if "$SYSTEMCTL" is-active --quiet jasper-aec-bridge.service >/dev/null 2>&1; then
        VOICE_RESTART_NEEDED=1
    fi
    revoke_aec_bridge_ready
    run_systemctl stop jasper-aec-bridge.service jasper-aec-init.service
    run_systemctl disable jasper-aec-bridge.service jasper-aec-init.service
    set_voice_bridge_want off
    reset_failed_units jasper-aec-bridge.service jasper-aec-init.service
}

# The teardown every "no bridge is carrying the mic" exit shares — parks,
# direct-mic handovers, the disabled and custom-mic routes alike. Stopping,
# disabling and clearing are correct at all of them: none wants a bridge, and
# a stopped-but-enabled one is not a resting state.
#
# Disabling as well as stopping is the load-bearing half. The bridge's
# Restart=on-failure/RestartSec=2 retries an enabled failed unit past
# StartLimitBurst=4 into ITS StartLimitAction=reboot, and a transient success
# opens the single-open XVF capture device jasper-voice may be holding
# directly — worst case a disclosed_stale box, whose alignment status the
# published verdict admits. The UDP legs go with it: a
# JASPER_MIC_DEVICE_RAW=udp: left from an attempt leaves voice's secondary
# UdpMicCapture spinning on a port nobody talks to.
stop_aec_and_clear_legs() {
    stop_disable_aec
    write_leg_env "0" "0" "0" "0" "0" "0"
    restart_outputd_if_needed
}

enable_start_aec() {
    # Bouncing the bridge replaces the UDP carrier jasper-voice reads, so a
    # pass that runs this can never also gate off the voice restart that
    # follows it: the daemon would be left reading a socket that just went
    # away. Caller-independent, so no call site can forget it.
    VOICE_RESTART_NEEDED=1
    publish_aec_bridge_ready
    run_systemctl enable jasper-aec-init.service jasper-aec-bridge.service
    set_voice_bridge_want on
    reset_failed_units jasper-aec-init.service jasper-aec-bridge.service
    # `restart` not `start`: jasper-aec-init is Type=oneshot with
    # RemainAfterExit=yes, so `start` is a no-op once it's run
    # successfully. Any chip-side param changes from a code deploy
    # (HPF cutoff, SHF_BYPASS, future tuning) would silently NOT
    # re-apply until the next reboot. `restart` forces re-execution.
    # Discovered 2026-05-15 after a deploy left chip params at their
    # previous boot-time values despite code expecting newer ones.
    run_systemctl restart jasper-aec-init.service
    run_systemctl restart jasper-aec-bridge.service
}

# The ACCESSORY half of the voice-input gate.
#
# "Is there usable voice input on this box?" is an OR over two independently
# owned facts: a locally-attached microphone (this reconciler's job) and a
# paired accessory microphone (jasper-accessory-reconcile's job, published as
# JASPER_MANUAL_MIC_SOURCES). The gate marker below is the AND of their
# absences, so every park-for-no-local-mic path has to consult this first.
#
# We do NOT look at BlueZ and we do NOT parse the env file in shell: the
# published file IS the accessory verdict, and jasper.accessories.mic_env owns
# its path and format (which is why no path literal appears here).
#
# Same principle as grouping_voice_parked — another owner's derived fact is
# never re-derived in bash — but a different mechanism, deliberately.
# JASPER_GROUPING_VOICE_PARK=1 is a fixed exact line, so a `grep -Fxq` IS a
# faithful read. JASPER_MANUAL_MIC_SOURCES carries a structured, variable value
# that jasper/config.py validates, so a shell match would be a second parser
# free to disagree with the daemon's. We shell out instead, the way
# observe_mic_profile_state already does for the mic-profile resolver.
#
# Every failure is fail-CLOSED (the marker gets written, exactly the pre-change
# behaviour) but NOT silent, and not reported as the same fact. "I could not
# tell" and "I checked and there is nothing" are different, and the difference
# reaches the operator: the marker's reason line is surfaced verbatim through
# /state.microphone.reason and the doctor's `microphone` headline. Somebody
# debugging "my remote does nothing" must not be handed a confident wrong
# answer when a partial /opt/jasper deploy left the probe module unimportable.
#
# Three answers, mirroring observe_mic_profile_state's
# unavailable/failed/resolved (plus `unprobed`, the pre-probe sentinel the
# memo above keys on, which no decision path ever reads):
#   unavailable — no interpreter to ask
#   failed      — asked, and it could not answer (stderr goes to the journal).
#                 Covers an unimportable module, an unreadable file, AND a file
#                 that reads but does not parse: a corrupt file naming a remote
#                 is not evidence that no remote is paired, and reporting it as
#                 such is what sent an operator looking in the wrong place.
#   resolved    — asked and got an answer; ACCESSORY_MIC_SOURCES may be empty
#                 (no key, or an empty value — those are answers, not failures)
#
# Probed at most ONCE per pass. The published file cannot change under a
# running pass, and two callers now ask: stop_voice's park decision and the
# voice-restart gate's stamp (voice_start_inputs). Memoising keeps that one
# interpreter spawn, and keeps one failure to one journal line.
ACCESSORY_MIC_SOURCES=""
ACCESSORY_MIC_PROBE_STATUS="unprobed"

probe_accessory_mics() {
    local payload
    [[ "$ACCESSORY_MIC_PROBE_STATUS" == "unprobed" ]] || return 0
    ACCESSORY_MIC_SOURCES=""
    if ! command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1; then
        ACCESSORY_MIC_PROBE_STATUS="unavailable"
        log "accessory mic probe unavailable at ${MIC_PROFILE_PYTHON}; accessory microphone state is UNKNOWN, not absent"
        return 0
    fi
    # stderr is deliberately NOT redirected: a traceback from a partial deploy
    # is the whole diagnostic, and observe_mic_profile_state does the same.
    if payload="$("$MIC_PROFILE_PYTHON" -m jasper.accessories.mic_env)"; then
        ACCESSORY_MIC_PROBE_STATUS="resolved"
        # Source ids never contain whitespace (the parser rejects any that do),
        # so this only strips the trailing newline.
        ACCESSORY_MIC_SOURCES="${payload//[[:space:]]/}"
    else
        ACCESSORY_MIC_PROBE_STATUS="failed"
        log "accessory mic probe failed (see the message above); accessory microphone state is UNKNOWN, not absent"
    fi
    # Belt-and-braces, and no longer a formality: accessory_mic_present calls
    # this in condition context (its own [[ ]] supplies the exit status), but
    # voice_start_inputs and voice_start_inputs_match_stamp call it as a PLAIN
    # statement under `set -e` — if any branch above ever ends on a non-zero
    # command, losing this return would abort the whole pass at those call
    # sites instead of restarting voice. Today every branch already ends 0,
    # so no test can force the difference; called out rather than silently
    # trusted.
    return 0
}

accessory_mic_present() {
    probe_accessory_mics
    [[ "$ACCESSORY_MIC_PROBE_STATUS" == "resolved" && -n "$ACCESSORY_MIC_SOURCES" ]]
}

# Mic-presence gate marker writers. mark = "no usable voice input, voice is
# parked"; clear = "voice
# input is available". jasper-voice.service's ConditionPathExists=!<marker>
# reads the absence. Neither may abort a reconcile pass — but a failed mark
# still has to park voice, so the two fall back to `disable`/`enable` on the
# unit, which is the same axis and stays symmetric across the pair.
#
# Every caller must mark BEFORE it stops jasper-aec-bridge: in the window
# between the stop and the mark voice is stoppable but not gated, so anything
# that starts it there (boot ordering, a Wants= pull, an operator) binds the
# bridge's dead udp: carrier.
# Do NOT re-mode the parent dir here — same trap as ensure_mode_file (#827).
mark_voice_input_absent() {
    local reason="${1:-no usable microphone present}"
    # The parent dir (/var/lib/jasper) is guaranteed by ensure_mode_file,
    # which runs earlier in every non-check-only pass; we deliberately do
    # NOT create or re-mode it here (re-moding 0770 root:jasper -> 0755
    # strips the group-write bit the non-root daemons need — the #827
    # trap).
    if printf 'reason=%s\n' "$reason" > "$VOICE_INPUT_ABSENT_MARKER" 2>/dev/null; then
        chmod 0644 "$VOICE_INPUT_ABSENT_MARKER" 2>/dev/null || true
        log "voice input absent: marked ${VOICE_INPUT_ABSENT_MARKER} (${reason}); jasper-voice gated off until a mic appears"
        return
    fi
    # No marker means no gate, and exit 66 cannot stand in for one: it needs a
    # capture device that will not OPEN (InputDeviceUnavailable,
    # jasper/audio_io.py), and a udp: carrier always binds — see
    # park_managed_xvf. `disable` is weaker than the gate (it closes the
    # boot/enable-driven start, not an explicit `systemctl restart`), but it is
    # a stop that actually fires, where the exit-66 backstop this branch used
    # to name is a stop that cannot. clear_voice_input_absent re-enables.
    log "event=aec_reconcile.voice_input_marker_write_failed marker=${VOICE_INPUT_ABSENT_MARKER} reason=${reason}"
    run_systemctl disable jasper-voice.service
}

clear_voice_input_absent() {
    if [[ -e "$VOICE_INPUT_ABSENT_MARKER" ]]; then
        rm -f "$VOICE_INPUT_ABSENT_MARKER" 2>/dev/null || true
        log "voice input present: cleared ${VOICE_INPUT_ABSENT_MARKER}; jasper-voice gate open"
    fi
    # The other half of the mark fallback above, and unconditional for the same
    # reason the mark's `disable` is: this pass cannot know whether an earlier
    # one disabled the unit instead of writing the marker. Every route that
    # opens the gate goes through here, including the custom-mic route that
    # otherwise leaves voice config untouched — a park we imposed is ours to
    # lift.
    run_systemctl enable jasper-voice.service
}

restart_voice() {
    if voice_restart_can_be_skipped; then
        log "event=aec_reconcile.voice_restart_skipped reason=no_voice_relevant_change profile=${AUDIO_INPUT_PROFILE:-unknown} mic=${CURRENT_MIC:-<unset>}"
        return
    fi
    # Voice input is available — either a local mic (the mic-present paths) or
    # a paired accessory microphone (restart_voice_for_accessory_mic below) —
    # so open the presence gate before (re)starting. Done even on the
    # provider-unset branch below: the input axis is genuinely satisfied;
    # the separate `disable --now` parks voice on the provider axis.
    clear_voice_input_absent
    if ! voice_provider_configured; then
        log "voice provider unset or invalid; leaving jasper-voice parked"
        run_systemctl disable --now jasper-voice.service
        reset_failed_units jasper-voice.service
        return
    fi
    reset_failed_units jasper-voice.service
    # No `enable` here: clear_voice_input_absent above owns that half of the
    # gate, on every route that opens it.
    # Queue the voice restart and let this oneshot exit. jasper-voice is
    # Type=notify and may wait on other reconcilers during boot; a blocking
    # restart from inside this reconciler can leave both jobs waiting on each
    # other after an unbond/provider/mic change.
    run_systemctl --no-block restart jasper-voice.service
    record_voice_restart_stamp
}

park_managed_xvf() {
    # Deliberately NOT accessory-aware, unlike stop_voice. This path parks a
    # box whose voice input is genuinely unusable — a broken daemon underneath
    # the mic, or no eligible capture device at all — and it leaves
    # JASPER_MIC_DEVICE pointing at the AEC bridge's udp:PORT while
    # stop_disable_aec has just stopped that bridge. Starting voice here would
    # bind an unfed UDP socket and stall the wake loop into jasper-voice's
    # WatchdogSec=30s. That is an UNBOUNDED ~35 s restart loop (30 s watchdog +
    # RestartSec=5), not a reboot: 20 cycles at that cadence take ~700 s, so
    # the unit's StartLimitBurst=20/StartLimitIntervalSec=300 window never
    # fills and StartLimitAction=reboot never fires. Nothing else stops it —
    # exit 66 needs a device that will not open, and a udp: socket always
    # opens. That is why disclose_stale_chip_aec normalises the mic device
    # before it starts voice.
    local reason="$1"
    mark_voice_input_absent "$reason"
    revoke_aec_bridge_ready
    run_systemctl stop jasper-voice.service jasper-aec-bridge.service
    reset_failed_units jasper-voice.service jasper-aec-bridge.service
    log "managed XVF parked: ${reason}"
}

# The one shape every "chip-AEC could not be brought up on a managed XVF" exit
# shares: record the fault, publish the reference-only leg vector, hand outputd
# that settled vector once, then park. NOT stop_aec_and_clear_legs — that one
# publishes the all-zero vector and leaves voice's gate alone, which is the
# direct-mic/disabled resting state, not a park.
park_to_reference_leg() {
    local disposition="$1" park_reason="$2"
    # FIRST, ahead of the env writes and the blocking outputd bounce below:
    # this is reached from a bridge restart that just failed for real, so
    # Restart=on-failure is re-arming every 2 s and the ~6-8 s those steps take
    # is enough standing marker to spend the rest of StartLimitBurst.
    # park_managed_xvf withdraws again; the call is idempotent.
    revoke_aec_bridge_ready
    publish_alignment_record "$disposition" || true
    write_leg_env "reference" "0" "0" "1" "0" "0"
    restart_outputd_if_needed
    park_managed_xvf "$park_reason"
}

# Copy the record now in the JASPER_AEC_CHIP_AEC_ALIGNMENT_* variables into
# $ENV_FILE. Every call site is guarded on a non-custom AUDIO_INPUT_PROFILE — the
# xvf_*-only branch tests it directly, the rest inherit it from
# managed_xvf_policy_applies — so a custom profile never writes these keys AND
# never clears them, and the stamp is never `custom`. That is what leaves a
# leftover for a consumer with no stamp to check. A mode file predating
# JASPER_AUDIO_INPUT_PROFILE reaches those guards already stamped — see
# ensure_mode_file's backfill, which runs before any of this.
# jasper.chip_aec_policy's module docstring owns the reading rule, for this
# record and the DAC one alike; jasper.audio_profile_state applies it here.
#
# Apostrophes are STRIPPED from the reason, not quoted. It is the only free text
# this script routes into $ENV_FILE, and deploy/lib/jasper-env-file.sh's header
# forbids apostrophe-bearing values in a file systemd reads through
# EnvironmentFile=: bash `source` and systemd's parser disagree on the '\''
# idiom the writer would emit, so the daemons and this script would read
# different values.
commit_alignment_record() {
    local reason="${JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON:-}"
    reason="${reason//\'/}"
    JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON="${reason:0:400}"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS "${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-}"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON "${JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON:-}"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_ALIGNMENT_ACTION "${JASPER_AEC_CHIP_AEC_ALIGNMENT_ACTION:-}"
    set_env_var "$ENV_FILE" JASPER_AEC_CHIP_AEC_ALIGNMENT_SELECTION "${JASPER_AEC_CHIP_AEC_ALIGNMENT_SELECTION:-}"
}

# Load one record's shell assignments and commit them. A payload with no STATUS
# key, or one `eval` rejects, leaves the last record standing and reports it: a
# half-eval'd payload must never reach commit_alignment_record, and every caller
# runs this from a condition, where errexit is suspended and a failed `eval`
# would otherwise fall through to a commit of whatever the previous pass set.
_apply_alignment_payload() {
    local payload="$1"
    [[ "$payload" == *"JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS="* ]] || return 1
    eval "$payload" || return 1
    commit_alignment_record
}

# Publish jasper.chip_aec_health's record for a disposition token, plus
# --reason/--action for the dispositions whose text this script measured itself.
# ADR-0101: an unresolvable vocabulary is unmeasured, not a demotion — with no
# interpreter the last record stands, as carry_chip_aec_dac_gate carries the
# last DAC verdict, rather than this script keeping a second copy of the strings.
publish_alignment_record() {
    local payload=""
    if command -v "$MIC_PROFILE_PYTHON" >/dev/null 2>&1; then
        # Output is produced by jasper.chip_aec_health with shlex.quote.
        payload="$("$MIC_PROFILE_PYTHON" -m jasper.cli.chip_aec_policy \
            --alignment "$@" --selection "$AUDIO_INPUT_PROFILE" || true)"
    fi
    _apply_alignment_payload "$payload" && return 0
    log "chip-AEC alignment vocabulary unavailable at ${MIC_PROFILE_PYTHON}; carrying the last record"
    return 1
}

# The record jasper-aec-init published for the pass that just ran. Bounded read
# of exactly the four keys it owns; anything else in the file is not this
# contract.
publish_init_alignment_record() {
    local payload
    [[ -r "$ALIGNMENT_RECORD_FILE" ]] || return 1
    payload="$(head -c 4096 "$ALIGNMENT_RECORD_FILE" \
        | grep -E "^JASPER_AEC_CHIP_AEC_ALIGNMENT_(STATUS|REASON|ACTION|SELECTION)=" \
        || true)"
    _apply_alignment_payload "$payload"
}

# ADR-0101: a chip-AEC path that cannot be armed leaves the box running and
# complaining, never deaf. It falls back to the best leg the mic can carry —
# the software AEC3 leg the non-managed `auto` path already uses, or the chip's
# plain capture when the bridge cannot run — and discloses what it lost.
# The caller publishes the `disclosed_stale` record first; this runs the
# fallback and reports the reason that record carries.
disclose_stale_chip_aec() {
    local reason="${JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON:-}"
    local bridge_up=0
    # Software AEC3 reads the 6-channel capture endpoint; on anything else
    # there is no bridge to run and the direct handover below is the only leg.
    if aec_ready "$AEC_MIC_DEVICE"; then
        # This publication MUST stay ahead of the bounce gate below. Its
        # per-key change detection is the only thing that sees a pass whose leg
        # vector MOVED: everything this path writes earlier (the DAC gate
        # record, the alignment status) is voice-irrelevant by design, so a
        # gate consulted first would hold on the very pass that revokes the DAC
        # verdict and leave the chip legs armed under a disclosure claiming
        # software AEC3. Pinned by
        # test_a_revoked_dac_verdict_flips_a_settled_chip_aec_box_onto_aec3.
        #
        # It is also what jasper-aec-init needs to re-run under its bypass
        # profile (JASPER_AEC_CHIP_AEC_ENABLED=0) so the chip stops holding a
        # half-applied alignment — which is why the attempt cannot be hoisted
        # above it. jasper-outputd is NOT bounced here: this is an attempt, not
        # a verdict, and the output owner is handed the leg vector the pass
        # settles on, once, below.
        write_leg_env "1" "1" "0" "0" "0" "0"
        # enable_start_aec blocking-restarts init and the bridge — a mic outage
        # of its own. A disclosure is LONG-LIVED by design, so paying that on
        # every udev event, deploy and wizard save for as long as it stands is
        # the deafness the gate exists to stop.
        if aec_stack_bounce_can_be_skipped; then
            # The skip still has to re-admit the live bridge for its NEXT
            # start; enable_start_aec publishes on the other branch.
            publish_aec_bridge_ready
            log "event=aec_reconcile.disclosed_bounce_skipped reason=no_voice_relevant_change alignment=disclosed_stale profile=${AUDIO_INPUT_PROFILE:-unknown}"
        else
            enable_start_aec
        fi
        # `systemctl restart` exits 0 when a start condition SKIPS the unit, so
        # its status is not evidence anything is running — if the bypass init
        # re-run above failed, the condition skips and the "restart" still
        # succeeds. Ask the unit instead: only an ACTIVE bridge is writing
        # udp:${AEC_UDP_PORT}.
        if "$SYSTEMCTL" is-active --quiet jasper-aec-bridge.service; then
            bridge_up=1
        fi
    fi
    if [[ "$bridge_up" == "1" ]]; then
        # AEC3 now feeds the same udp:PORT carrier the chip beam did.
        restart_outputd_if_needed
        set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$UDP_DEVICE"
        log "chip-AEC disclosed stale: ${reason}; running software AEC3"
    else
        # Nothing writes that carrier, and jasper-voice bound to an unfed
        # socket stalls into the watchdog restart loop park_managed_xvf
        # describes.
        stop_aec_and_clear_legs
        set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$AEC_MIC_DEVICE"
        log "chip-AEC disclosed stale: ${reason}; AEC bridge is not active, using direct mic ${AEC_MIC_DEVICE}"
    fi
    restart_voice
}

activate_managed_chip_aec() {
    # The expensive bounce: this stops voice AND the bridge, blocking-restarts
    # jasper-aec-init, and only then brings voice back — the ~8 s of deafness
    # a measurement-mic hotplug cost on jts3. A pass that changed nothing would
    # re-derive the identical alignment it already verified, so skip the whole
    # sequence when the stack it would rebuild is already up and settled.
    #
    # `disclosed_stale` with the chip ARMED is settled: aec-init applied the
    # banked K and the bridge is carrying its beam, exactly as on a `ready`
    # box, and that state is long-lived by design — re-bouncing it on every
    # udev sound-card event, deploy and wizard save for as long as the
    # disclosure stands is the deafness this gate exists to stop. The
    # software-AEC3 fallback sub-state (chip NOT armed) is excluded on
    # purpose: it keeps bouncing so the outputd ordering race that produced it
    # can heal on a later pass.
    if [[ "${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-}" == "ready" \
        || ( "${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-}" == "disclosed_stale" \
            && "${JASPER_AEC_CHIP_AEC_ENABLED:-0}" == "1" ) ]] \
        && aec_stack_bounce_can_be_skipped; then
        publish_aec_bridge_ready
        log "event=aec_reconcile.chip_aec_bounce_skipped reason=no_voice_relevant_change alignment=${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-unknown} profile=${AUDIO_INPUT_PROFILE:-unknown} mic=${CURRENT_MIC:-<unset>}"
        return 0
    fi
    # Past this point the sequence stops voice, so the restart_voice at the end
    # must not be able to gate itself off.
    VOICE_RESTART_NEEDED=1
    publish_alignment_record checking || true
    mark_voice_input_absent "validating commissioned chip-AEC alignment"
    run_systemctl stop jasper-voice.service jasper-aec-bridge.service
    reset_failed_units jasper-voice.service jasper-aec-bridge.service
    # Init must sample outputd's final writer; bridge/voice stay parked.
    write_leg_env "1" "0" "0" "1" "0" "0"
    if ! restart_outputd_if_needed "strict"; then
        park_to_reference_leg reference_producer_down \
            "chip-reference producer failed; inspect jasper-outputd"
        return 1
    fi
    run_systemctl enable jasper-aec-init.service jasper-aec-bridge.service
    set_voice_bridge_want on
    reset_failed_units jasper-aec-init.service jasper-aec-bridge.service
    # aec-init writes AND unlinks this record from one `finally`, which a
    # SIGKILL, an OOM kill or an unmet `Requires=` never reaches. Clear it here
    # so absence means "this pass reached no verdict" rather than "the pass
    # before it did": a shipped box's steady-state record is `disclosed_stale`,
    # and a killed init reading back as that would send the household to the
    # commissioner for a failure the fault branch below is what describes.
    rm -f "$ALIGNMENT_RECORD_FILE"
    if "$SYSTEMCTL" restart jasper-aec-init.service; then
        # A zero exit that published no record applied its alignment cleanly.
        publish_init_alignment_record || publish_alignment_record applied || true
        log "chip-AEC alignment ${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-unknown}: ${JASPER_AEC_CHIP_AEC_ALIGNMENT_REASON:-}"
        # `ready` and `disclosed_stale` are both running states (ADR-0101) and
        # aec-init just applied the alignment, so the verdict is settled before
        # the bridge is asked to start — its condition is read from the marker.
        publish_aec_bridge_ready
        # The restart's own status is necessary but not sufficient, for the
        # reason disclose_stale_chip_aec names: it also exits 0 when a start
        # condition SKIPS the unit, and publish above is best-effort — a marker
        # that failed to write would leave a skipped restart looking like
        # success, then `ready` and a voice restart onto a udp: carrier nothing
        # feeds. Ask the unit too.
        if ! "$SYSTEMCTL" restart jasper-aec-bridge.service \
            || ! "$SYSTEMCTL" is-active --quiet jasper-aec-bridge.service; then
            park_to_reference_leg bridge_failed \
                "chip-AEC bridge failed; inspect jasper-aec-bridge"
            return 1
        fi
        restart_voice
        return 0
    fi
    # ADR-0101: aec-init's own record decides what a failed run costs.
    # `disclosed_stale` says nothing observably broke — no banked K to arm the
    # chip with, or a jasper-outputd that has not loaded the current output
    # declaration — so the box keeps hearing on software AEC3 and carries the
    # remedy the record names. Anything else, a run that published nothing
    # included, is a fault.
    if publish_init_alignment_record \
        && [[ "${JASPER_AEC_CHIP_AEC_ALIGNMENT_STATUS:-}" == "disclosed_stale" ]]; then
        disclose_stale_chip_aec
        return 0
    fi
    park_to_reference_leg reapply_failed \
        "chip-AEC alignment reapply failed; inspect jasper-aec-init"
    return 1
}

# Dumb-follower profile: an ACTIVE
# bonded FOLLOWER parks jasper-voice AND the AEC stack — the leader owns
# the mic/wake/AI session, and the parked daemons free ~310 MB on a 1 GB
# Pi. The signal is the Python-validated derived flag the grouping
# reconciler writes into grouping-voice.env (exact line match, mirroring
# valid_voice_provider's posture) — bond-validity logic is NEVER
# re-derived in shell. Missing/unreadable file = not parked (fail-open:
# a broken read must never park a solo speaker's voice).
GROUPING_VOICE_ENV_FILE="${JASPER_GROUPING_VOICE_ENV_FILE:-/var/lib/jasper/grouping-voice.env}"

grouping_voice_parked() {
    [[ -r "$GROUPING_VOICE_ENV_FILE" ]] || return 1
    grep -Fxq "JASPER_GROUPING_VOICE_PARK=1" "$GROUPING_VOICE_ENV_FILE"
}

voice_provider_configured() {
    local line provider
    if [[ -f "$VOICE_PROVIDER_FILE" ]]; then
        line="$(grep -E '^JASPER_VOICE_PROVIDER=' "$VOICE_PROVIDER_FILE" | tail -n 1 || true)"
        provider="${line#JASPER_VOICE_PROVIDER=}"
        provider="${provider%%[[:space:]]*}"
        valid_voice_provider "$provider" && return 0
    fi
    valid_voice_provider "${JASPER_VOICE_PROVIDER:-}"
}

valid_voice_provider() {
    local provider="$1"
    # Install-time artifact generated from jasper.voice.catalog.
    # Keep this boot/hotplug safety gate shell-only: if the manifest is
    # missing or the provider is not an exact line, jasper-voice stays parked.
    [[ -n "$provider" && -r "$VOICE_PROVIDER_IDS_FILE" ]] || return 1
    grep -Fxq -- "$provider" "$VOICE_PROVIDER_IDS_FILE"
}

restart_outputd_if_needed() {
    local require_success="${1:-}"
    if [[ "$OUTPUTD_RESTART_NEEDED" == "1" ]]; then
        reset_failed_units jasper-outputd.service
        if "$SYSTEMCTL" restart jasper-outputd.service; then
            OUTPUTD_RESTART_NEEDED=0
        elif [[ "$require_success" == "strict" ]]; then
            log "failed to restart jasper-outputd with final chip-reference configuration"
            return 1
        else
            OUTPUTD_RESTART_NEEDED=0
        fi
    fi
}

stop_voice() {
    # Only ever reached when no candidate LOCAL mic is present. That is only
    # half the voice-input question: a paired accessory microphone is a usable
    # push-to-talk input on its own, and parking voice would gate the remote's
    # button shut (issue #2205). So consult the accessory half first, and park
    # only when BOTH are absent — which is what the marker claims. Note the
    # scope: this opens the START GATE. Whether the daemon can then serve an
    # accessory-only box is the other half of #2205 and is not decided here.
    if accessory_mic_present; then
        log "no candidate local microphone, but accessory microphone(s) present (${ACCESSORY_MIC_SOURCES}); keeping jasper-voice up for push-to-talk"
        # DEFERRED, not immediate: restart_voice queues the systemd job with
        # --no-block, and the callers below still have JASPER_MIC_DEVICE
        # fixups to write. Starting voice here would race it into reading the
        # stale device. Mirrors OUTPUTD_RESTART_NEEDED.
        ACCESSORY_VOICE_RESTART_NEEDED=1
        return
    fi
    # Say which of the two we know. Either way voice parks (fail-closed), but
    # the reason reaches /state.microphone.reason and the doctor headline, so it
    # must not claim a check that did not happen.
    if [[ "$ACCESSORY_MIC_PROBE_STATUS" == "resolved" ]]; then
        mark_voice_input_absent "no candidate microphone present and no accessory microphone paired"
    else
        mark_voice_input_absent "no candidate microphone present; accessory microphone state could not be determined (probe ${ACCESSORY_MIC_PROBE_STATUS}) — check the journal for jasper-aec-reconcile"
    fi
    run_systemctl stop jasper-voice.service
    reset_failed_units jasper-voice.service
}

# Flush the deferred accessory-mic voice restart. Called at the end of every
# path that can reach stop_voice, AFTER that path's env writes have landed.
#
# Abort behaviour, since deferring is one step weaker than the immediate write
# it replaced: if the pass dies between the decision and this flush, nothing has
# been written, so the marker keeps whatever the previous pass left. Present =>
# voice stays gated (fail-closed, the safe direction). Absent => voice may start
# and, with no openable device, exit 66 into a clean park. Both are bounded and
# the next pass converges; neither can crash-loop.
restart_voice_for_accessory_mic() {
    if [[ "$ACCESSORY_VOICE_RESTART_NEEDED" == "1" ]]; then
        ACCESSORY_VOICE_RESTART_NEEDED=0
        restart_voice
    fi
}

load_env_file "$ENV_FILE"
# Snapshot the pass-start world BEFORE anything can move it: the env-file
# values before any resolver eval overwrites them, and the installed build
# before any env write — so every mark_voice_restart_if_changed comparison
# and the restart gate below see the same pass-start view.
snapshot_pass_start_env
read_installed_build_id
if [[ "$COMMISSION_ARM" != "1" ]]; then
    ensure_mode_file
    # Declared intent beats change detection — but only on a pass that can
    # act on it; an arm-only pass must leave the marker for the real one
    # (the arm dispatch never restarts voice).
    consume_voice_restart_intent
fi
load_env_file "$MODE_FILE"
observe_mic_profile_state

AEC_MODE="$(normalize_mode "${JASPER_AEC_MODE:-auto}")"
AUDIO_INPUT_PROFILE="${JASPER_AUDIO_INPUT_PROFILE:-custom}"
read_audio_input_profile --profile="$AUDIO_INPUT_PROFILE" || true
if [[ "$AUDIO_INPUT_PROFILE_KNOWN" != "1" ]]; then
    log "unknown JASPER_AUDIO_INPUT_PROFILE=${JASPER_AUDIO_INPUT_PROFILE:-}; treating as custom"
fi
AEC_MIC_DEVICE="${JASPER_AEC_MIC_DEVICE:-}"
AEC_UDP_PORT="${JASPER_AEC_UDP_PORT:-9876}"
AEC_UDP_PORT_RAW="${JASPER_AEC_UDP_PORT_RAW:-9877}"
AEC_UDP_PORT_DTLN="${JASPER_AEC_UDP_PORT_DTLN:-9878}"
AEC_UDP_PORT_CHIP_AEC_150="${JASPER_AEC_UDP_PORT_CHIP_AEC_150:-9887}"
AEC_UDP_PORT_CHIP_AEC_210="${JASPER_AEC_UDP_PORT_CHIP_AEC_210:-9888}"
AEC_OUTPUTD_REF_UDP_PORT="${JASPER_AEC_OUTPUTD_REF_UDP_PORT:-9891}"
OUTPUTD_CHIP_REF_SAMPLE_RATE="${JASPER_XVF_CHIP_REF_RATE:-16000}"
OUTPUTD_CHIP_REF_PERIOD_FRAMES="${JASPER_XVF_CHIP_REF_PERIOD:-128}"
OUTPUTD_CHIP_REF_BUFFER_FRAMES="${JASPER_XVF_CHIP_REF_BUFFER:-256}"
UDP_DEVICE="udp:${AEC_UDP_PORT}"
MIC_DEVICE_CANDIDATES_DEFAULT="$DEFAULT_MIC_DEVICE_CANDIDATES"
if [[ -n "${JASPER_XVF_ALSA_CARD:-}" ]]; then
    MIC_DEVICE_CANDIDATES_DEFAULT="${JASPER_XVF_ALSA_CARD},${DEFAULT_MIC_DEVICE_CANDIDATES}"
fi
split_candidates "${JASPER_MIC_DEVICE_CANDIDATES:-${AEC_MIC_DEVICE:-$MIC_DEVICE_CANDIDATES_DEFAULT}}"
prime_measurement_usb_ids
derive_profile_managed_aec_mic_device
if [[ -z "$AEC_MIC_DEVICE" ]]; then
    if AEC_MIC_DEVICE="$(first_present_candidate)"; then
        :
    else
        AEC_MIC_DEVICE="$(first_candidate)"
    fi
fi
if profile_managed_mic_resolution && [[ -n "${JASPER_XVF_ALSA_CARD:-}" ]]; then
    OUTPUTD_CHIP_REF_PCM="${JASPER_XVF_CHIP_REF_PCM_ACCESS:-hw}:CARD=${AEC_MIC_DEVICE},DEV=${JASPER_XVF_CHIP_REF_DEVICE:-0}"
else
    OUTPUTD_CHIP_REF_PCM="${JASPER_OUTPUTD_CHIP_REF_PCM:-hw:CARD=${AEC_MIC_DEVICE},DEV=0}"
fi

if [[ "$COMMISSION_ARM" == "1" ]]; then
    # Arm-only dispatch, reached ONLY by the commissioner's own reason-keyed
    # call while its marker is live: publish the final chip-reference vector —
    # the same write_leg_env "reference" arm activate_managed_chip_aec parks
    # with (legs off, ref UDP target clear, chip-ref writer armed) — and hand
    # it to jasper-outputd, strictly: the commissioner aborts on this exit
    # code, so it must not claim success over a writer that is not running.
    # Everything else this script does below stays excluded: the commissioner
    # owns voice/bridge/init, the wizard files, and the alignment record.
    # (The read-only derivation above may still log a
    # aec_reconcile.aec_mic_device_derived/_rederived event; nothing it
    # derives is persisted on this path except the vector.) The commissioner
    # calls with its services already stopped, so the outputd hand-off is a
    # plain start; its cleanup reconcile runs marker-free and re-derives the
    # resting vector.
    write_leg_env "reference" "0" "0" "1" "0" "0"
    if ! restart_outputd_if_needed "strict"; then
        log "commission arm: jasper-outputd failed to start on the final chip-reference vector"
        exit 1
    fi
    log "commission arm: published final chip-reference vector chip_ref_pcm=${OUTPUTD_CHIP_REF_PCM}"
    exit 0
fi

CURRENT_MIC="${JASPER_MIC_DEVICE:-}"
# Additive wake-detection legs (see write_leg_env for the mapping).
# JASPER_AEC_MODE remains the master toggle; these only matter when
# the bridge is running. Defaults — RAW on (cheap, gives OR-fusion
# wake-rate recovery for ~5 MB), DTLN off (~75 MB + 25% one core,
# opt-in via /system/ wake-detection card).
LEG_RAW="$(normalize_bool "${JASPER_WAKE_LEG_RAW:-1}")"
LEG_DTLN="$(normalize_bool "${JASPER_WAKE_LEG_DTLN:-0}")"
# Chip-AEC profile selection — mic-profile/DAC-conditional and mutually
# exclusive with raw/DTLN (see write_leg_env). Extra chip-beam wake
# detectors are separate opt-ins below.
LEG_CHIP_AEC="$(normalize_bool "${JASPER_WAKE_LEG_CHIP_AEC:-0}")"
LEG_CHIP_AEC_150="$(normalize_bool "${JASPER_WAKE_LEG_CHIP_AEC_150:-0}")"
LEG_CHIP_AEC_210="$(normalize_bool "${JASPER_WAKE_LEG_CHIP_AEC_210:-0}")"
# Opt-in chip-ref observe mode (default off). Read like the LEG_* booleans
# (mode_file_value + normalize_bool) so a hand-edited yes/true also works.
# Only the software-AEC3 leg path in write_leg_env acts on it.
CHIP_REF_OBSERVE="$(normalize_bool "$(mode_file_value JASPER_AEC_CHIP_REF_OBSERVE 0)")"
AUDIO_DAC_ID="$(normalize_output_dac_id "${JASPER_AUDIO_DAC_ID:-unknown}")"
apply_audio_input_profile
if [[ "$AUDIO_INPUT_PROFILE" == "custom" && "$LEG_CHIP_AEC" == "1" ]]; then
    if ! chip_aec_mic_supported; then
        log "custom chip-AEC leg requested but mic cannot produce chip-AEC beams: $(chip_aec_mic_detail); clearing chip-AEC leg"
        LEG_CHIP_AEC="0"
        LEG_CHIP_AEC_150="0"
        LEG_CHIP_AEC_210="0"
    elif ! chip_aec_dac_supported "$AUDIO_DAC_ID" "0"; then
        # ADR-0101: DAC approval is a quality signal, not an admission gate, and
        # this leg is an operator's explicit intent. Honour it; this line is the
        # disclosure. The mic arm above stays a refusal — a mic with no beam
        # plan cannot emit chip-AEC beams at all.
        log "custom chip-AEC leg requested on output_dac=${AUDIO_DAC_ID}, which is not approved for production chip-AEC: $(chip_aec_dac_detail "$AUDIO_DAC_ID" "0"); honouring the explicit leg"
    fi
fi
refresh_chip_aec_dac_gate "$AUDIO_DAC_ID" "$CHIP_AEC_TESTING_REQUESTED"

FALLBACK_MIC="$(first_candidate)"
PRESENT_MIC=""
if PRESENT_MIC="$(first_present_candidate)"; then
    :
else
    PRESENT_MIC=""
fi

log "profile=${AUDIO_INPUT_PROFILE} mode=${AEC_MODE} current_mic=${CURRENT_MIC:-<unset>} aec_mic=${AEC_MIC_DEVICE} candidates=${MIC_CANDIDATES[*]:-<none>} legs=raw:${LEG_RAW},dtln:${LEG_DTLN},chip_aec:${LEG_CHIP_AEC},chip_aec_150:${LEG_CHIP_AEC_150},chip_aec_210:${LEG_CHIP_AEC_210}"
write_mic_profile_env
write_local_mic_presence_env
if profile_managed_mic_resolution; then
    set_env_var "$ENV_FILE" JASPER_AEC_MIC_DEVICE "$AEC_MIC_DEVICE"
fi
write_chip_aec_gate_env
if [[ "$MIC_PROFILE_RESOLUTION_STATUS" == "resolved" \
    && "$AUDIO_INPUT_PROFILE" != "custom" \
    && "$AUDIO_INPUT_PROFILE" == xvf_* ]] \
    && ! managed_xvf_card_present; then
    publish_alignment_record xvf_absent || true
fi

if grouping_voice_parked; then
    # Role park wins over every profile/mic shape below — including the
    # custom-mic early exit, which deliberately leaves voice untouched.
    # `disable --now` (not stop): voice must not boot-start its ~240 MB
    # of models for a few seconds on every reboot only to be re-parked
    # when this reconciler runs. restart_voice's un-park path already
    # re-enables. JASPER_MIC_DEVICE is left as-is: parking is role
    # state, not a mic decision, and the next solo/leader reconcile
    # resumes from an unchanged mic config. The voice-input marker is
    # left alone for the same reason — a follower's mic is usable, so
    # marking absence would lie to /state.microphone.reason, and
    # `disable --now` already holds voice down harder than the gate.
    log "bonded follower (grouping-voice.env park flag): parking jasper-voice + AEC stack"
    run_systemctl disable --now jasper-voice.service
    reset_failed_units jasper-voice.service
    stop_aec_and_clear_legs
    exit 0
fi

if managed_xvf_policy_applies; then
    if aec_ready "$AEC_MIC_DEVICE"; then
        ensure_capture_mixer_open "$AEC_MIC_DEVICE"
    fi
    if [[ "$LEG_CHIP_AEC" != "1" ]]; then
        if [[ -n "${MANAGED_XVF_PARK_REASON:-}" ]]; then
            publish_alignment_record xvf_unusable \
                --reason "$MANAGED_XVF_PARK_REASON" || true
            # Park first: the marker has to exist before the bridge goes down
            # (see mark_voice_input_absent). stop_aec_and_clear_legs then
            # disables the bridge and publishes the resting leg vector.
            park_managed_xvf "$MANAGED_XVF_PARK_REASON"
            stop_aec_and_clear_legs
            exit 0
        fi
        # ADR-0101: the capability gate is a quality signal, not an admission
        # gate — the mic is usable, so the box keeps hearing and discloses.
        publish_alignment_record "${MANAGED_XVF_DISCLOSURE_ARGS[@]}" \
            --reason "${MANAGED_XVF_DISCLOSURE:-managed XVF chip-AEC is unavailable}" \
            || true
        disclose_stale_chip_aec
        exit 0
    fi
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$UDP_DEVICE"
    activate_managed_chip_aec || true
    exit 0
fi

if ! is_owned_mic_value "$CURRENT_MIC" "$UDP_DEVICE"; then
    log "custom JASPER_MIC_DEVICE=${CURRENT_MIC}; leaving voice config untouched"
    # We don't manage custom mics, so we must not gate them: clear any
    # stale presence marker so jasper-voice can start and try the operator's
    # device. If it can't open, the daemon's exit-66 park (not a crash-loop)
    # is the safety net. Mirrors the "leave voice config untouched" contract.
    clear_voice_input_absent
    stop_aec_and_clear_legs
    exit 0
fi

if [[ "$AEC_MODE" == "disabled" ]]; then
    if [[ -z "$PRESENT_MIC" ]]; then
        stop_voice
    fi
    stop_aec_and_clear_legs
    if [[ -n "$PRESENT_MIC" ]]; then
        if [[ "$CURRENT_MIC" != "$PRESENT_MIC" ]]; then
            set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$PRESENT_MIC"
            log "AEC disabled; selected direct mic ${PRESENT_MIC}"
        else
            log "AEC disabled; direct mic already ${PRESENT_MIC}"
        fi
        restart_voice
    else
        if [[ "$CURRENT_MIC" == udp:* || -z "$CURRENT_MIC" ]]; then
            set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$FALLBACK_MIC"
            log "AEC disabled and no candidate mic present; cleared stale UDP to ${FALLBACK_MIC}"
        else
            log "AEC disabled and no candidate mic present"
        fi
    fi
    restart_voice_for_accessory_mic
    exit 0
fi

if aec_ready "$AEC_MIC_DEVICE"; then
    ensure_capture_mixer_open "$AEC_MIC_DEVICE"
    if [[ "$CURRENT_MIC" != "$UDP_DEVICE" ]]; then
        set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$UDP_DEVICE"
        log "6-channel ${AEC_MIC_DEVICE} present; selected AEC UDP mic ${UDP_DEVICE}"
    else
        log "6-channel ${AEC_MIC_DEVICE} present; AEC UDP mic already selected"
    fi
    write_leg_env "1" "$LEG_RAW" "$LEG_DTLN" "$LEG_CHIP_AEC" "$LEG_CHIP_AEC_150" "$LEG_CHIP_AEC_210"
    restart_outputd_if_needed
    if aec_stack_bounce_can_be_skipped; then
        # The skip still has to re-admit the live bridge for its NEXT start;
        # enable_start_aec publishes on the other branch.
        publish_aec_bridge_ready
        log "event=aec_reconcile.aec_stack_bounce_skipped reason=no_voice_relevant_change profile=${AUDIO_INPUT_PROFILE}"
    else
        enable_start_aec
    fi
    restart_voice
    exit 0
fi

if [[ -z "$PRESENT_MIC" ]]; then
    stop_voice
fi
stop_aec_and_clear_legs
if [[ -n "$PRESENT_MIC" ]]; then
    if [[ "$CURRENT_MIC" != "$PRESENT_MIC" ]]; then
        set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$PRESENT_MIC"
        log "AEC mic not 6-channel; selected direct mic ${PRESENT_MIC}"
    else
        log "AEC mic not 6-channel; direct mic already ${PRESENT_MIC}"
    fi
    restart_voice
    exit 0
fi

if [[ "$CURRENT_MIC" == udp:* || -z "$CURRENT_MIC" || "$CURRENT_MIC" =~ ^hw:[0-9]+,1$ ]]; then
    set_env_var "$ENV_FILE" JASPER_MIC_DEVICE "$FALLBACK_MIC"
    log "no candidate mic present; cleared stale ${CURRENT_MIC:-<unset>} to ${FALLBACK_MIC}"
else
    log "no candidate mic present"
fi
restart_voice_for_accessory_mic
