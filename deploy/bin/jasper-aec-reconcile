#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
REASON=manual
while [[ $# -gt 0 ]]; do
    case "$1" in
        --reason)
            [[ $# -ge 2 ]] || { echo 'Usage: jasper-aec-reconcile [--reason TEXT]' >&2; exit 2; }
            REASON="$2"; shift 2 ;;
        -h|--help)
            echo 'Usage: jasper-aec-reconcile [--reason TEXT]'; exit 0 ;;
        *) echo "unknown argument: $1" >&2; exit 2 ;;
    esac
done

# Withdraw before importing: a partial runtime must not leave a bridge admitted
# into its StartLimitAction=reboot loop (ADR-0224).
AEC_BRIDGE_READY_MARKER="${JASPER_AEC_BRIDGE_READY_MARKER:-/run/jasper-aec-reconcile/aec-bridge-ready}"
rm -f "$AEC_BRIDGE_READY_MARKER" 2>/dev/null || true
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${SCRIPT_DIR}/../../jasper" ]]; then
    PACKAGE_ROOT="${SCRIPT_DIR}/../.."
else
    PACKAGE_ROOT=/opt/jasper
fi
export PYTHONPATH="${PACKAGE_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
PYTHON="${JASPER_MIC_PROFILE_PYTHON:-/opt/jasper/.venv/bin/python}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
    PYTHON=python3
fi
if command -v "$PYTHON" >/dev/null 2>&1; then
    rc=0
    "$PYTHON" -c '
import sys
try:
    from jasper.aec.reconcile.runtime import main
except ImportError as exc:
    print(f"event=aec_reconcile.runtime status=unavailable error={exc}", file=sys.stderr)
    raise SystemExit(69)
raise SystemExit(main(sys.argv[1:]))
' "--reason=$REASON" || rc=$?
    [[ "$rc" == 69 ]] || exit "$rc"
fi

COMMISSION="${JASPER_AEC_COMMISSION_MARKER:-/run/jasper-chip-aec-commission/active}"
if [[ -r "$COMMISSION" && "$REASON" != chip-aec-commission-arm ]]; then
    IFS= read -r line < "$COMMISSION" || line=""
    pid="${line#pid=}"
    if [[ "$line" == "pid=$pid" && "$pid" =~ ^[1-9][0-9]*$ && -d "${JASPER_PROC_ROOT:-/proc}/$pid" ]]; then
        exit 0
    fi
fi

# No observation owner: retain running routes and their last quality records.
# The withdrawn verdict prevents a failed bridge from reboot-looping; an
# already active bridge keeps running. The next good pass converges.
printf '%s\n' 'event=aec_reconcile.runtime status=unavailable action=retain_running_state' >&2
exit 69
