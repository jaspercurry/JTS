#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Render the system-wide ALSA config from the persisted JTS audio-quality
# preference. Web toggles only mutate /var/lib/jasper/audio_quality.env;
# this script turns that small state file into the real asound.conf.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE_LIB="${JASPER_ENV_FILE_LIB:-}"
if [[ -z "$ENV_FILE_LIB" ]]; then
    ENV_FILE_LIB="${SCRIPT_DIR}/../lib/jasper-env-file.sh"
    [[ -r "$ENV_FILE_LIB" ]] || ENV_FILE_LIB="/usr/local/lib/jasper/jasper-env-file.sh"
fi
[[ -r "$ENV_FILE_LIB" ]] || { echo "jasper-render-asound-conf: env-file library missing: ${ENV_FILE_LIB}" >&2; exit 66; }
# shellcheck disable=SC1090
source "$ENV_FILE_LIB"
declare -F jasper_env_file_get >/dev/null \
    || { echo "jasper-render-asound-conf: unusable env-file library: ${ENV_FILE_LIB}" >&2; exit 66; }

STATE_FILE="${JASPER_AUDIO_QUALITY_FILE:-/var/lib/jasper/audio_quality.env}"
TEMPLATE="${JASPER_ASOUND_TEMPLATE:-/etc/jasper/asoundrc.jasper.template}"
OUTPUT="${JASPER_ASOUND_CONF:-/var/lib/jasper-asound/asound.conf}"

converter="samplerate_medium"
if value="$(jasper_env_file_get "$STATE_FILE" JASPER_ALSA_RATE_CONVERTER)"; then
    converter="$value"
fi

case "$converter" in
    medium|balanced) converter="samplerate_medium" ;;
    best|maximum|max) converter="samplerate_best" ;;
    samplerate_medium|samplerate_best) ;;
    *)
        echo "jasper-render-asound-conf: invalid converter: $converter" >&2
        exit 64
        ;;
esac

if [[ ! -f "$TEMPLATE" ]]; then
    echo "jasper-render-asound-conf: template missing: $TEMPLATE" >&2
    exit 66
fi

# Skip if it exists: GNU install -d chmods existing dirs too, and this now
# runs as jasper-control against a root:jasper dir it doesn't own.
[[ -d "$(dirname "$OUTPUT")" ]] || install -d -m 0755 "$(dirname "$OUTPUT")"
tmp="${OUTPUT}.tmp.$$"
trap 'rm -f "$tmp"' EXIT
sed "s/__RATE_CONVERTER__/${converter}/g" "$TEMPLATE" > "$tmp"
chmod 0644 "$tmp"
mv "$tmp" "$OUTPUT"
trap - EXIT

echo "jasper-render-asound-conf: wrote $OUTPUT with $converter"
