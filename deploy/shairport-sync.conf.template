// JTS shairport-sync config TEMPLATE — AirPlay 2 receiver into its
// private fan-in lane (snd-aloop, or the SHM ring when the airplay
// renderer lane is armed — U3/P6d). Rendered to /etc/shairport-sync.conf
// by `jasper-apply-airplay-mode` (script installed to /usr/local/sbin/).
// The renderer substitutes `__DISABLE_SYNCHRONIZATION__` based on
// `JASPER_AIRPLAY_FREE_RUNNING` in /var/lib/jasper/airplay_mode.env,
// and `__RENDERER_DEVICE__` from the renderer-lane map (see the alsa
// block below).
// Default = no (synced). The shipped sync set is
// drift_tolerance_in_seconds=0.002, resync_threshold_in_seconds=0.2, and
// audio_backend_buffer_desired_length_in_seconds=0.5. Toggle via
// http://jts.local/airplay/ or `jasper-airplay-mode set
// [free-running|synced]`. See jasper/web/airplay_setup.py for the toggle UX.
// SYNC-CONSTANT PROVENANCE: drift tolerance has SHM-ring evidence for the
// regular out-of-date/order event class. The resync threshold, backend target,
// and latency offset are unchanged and still need their own ring reliability
// and A/V validation; see the U3 note above drift_tolerance.
//
// Requires source-built shairport-sync with --with-airplay-2 plus
// nqptp.service running (UDP 319/320). The Debian Trixie apt package
// is AP1-only — install.sh source-builds the AP2 variant.

general = {
    name = "__AIRPLAY_NAME__";
    // "auto" picks soxr when CPU has slack, falls back to "basic"
    // (linear) when the audio_backend_buffer is shallow. soxr alone
    // bogged down during voice + AEC concurrency and produced the
    // 17-second underrun cadence visible in the journal.
    interpolation = "auto";
    output_backend = "alsa";
    // U3/P6d RING PROVENANCE — read before retuning the sync values below.
    // The SHM ioplug reports honest occupancy-derived delay (jts_ring_delay,
    // c/jts-ring-ioplug/pcm_jts_ring.c). drift_tolerance has direct ring
    // evidence for the event class below. resync_threshold, the latency
    // offset, and buffer_desired_length were held unchanged in that trial;
    // keep them unchanged until their own ring reliability and A/V validation.
    // The arm CLI prints the same advisory.
    //
    // A JTS4 SHM-ring A/B trial on 2026-08-18 isolated 0.002 s for its regular
    // out-of-date/order pairs: lowering drift eliminated them while the ring
    // stayed at the same 15/16 occupancy, so that occupancy was not sufficient
    // to produce the events. Ring-validation gaps remain.
    drift_tolerance_in_seconds = 0.002;
    // shairport's drift correction has two paths:
    // - Continuous ±1-sample stuffing (gated by drift_tolerance) —
    //   smooth, inaudible.
    // - Discrete do_flush + silence injection (gated by
    //   resync_threshold) — drops ~6,600 source frames + injects up
    //   to 250 ms of zeros = audible "tear".
    // resync_threshold=0.2 prevents the historical large-error path from
    // flushing early. It was held constant in the JTS4 ring A/B and still
    // needs its own long-run ring validation.
    resync_threshold_in_seconds = 0.2;
    // Derived by jasper-apply-airplay-mode as:
    //   -((target_level - chunksize + fanin_output_buffer + outputd_dac_buffer) / samplerate)
    // where target_level/chunksize/samplerate come from the active
    // CamillaDSP config, fanin_output_buffer comes from jasper-fanin's
    // output buffer setting, and outputd_dac_buffer
    // comes from JASPER_OUTPUTD_DAC_BUFFER_FRAMES. While this speaker is an
    // active bonded leader, jasper-grouping-reconcile also folds in the
    // Snapcast round-trip playout buffer (JASPER_AIRPLAY_BONDED_EXTRA_DELAY_SEC);
    // it is absent on solo/follower, so the solo value is unchanged. The retired renderer-side and
    // final-output dmix path is gone from the outputd topology; shairport
    // writes its private fan-in lane while jasper-fanin handles
    // WiFi burst absorption and jasper-outputd owns the DAC.
    // This offset tells shairport about the fixed downstream delay
    // invisible to its ALSA handle so video/multi-room sync stays
    // honest. It was unchanged in the JTS4 ring A/B; end-to-end ring A/V
    // validation remains open. Renders as -0.106667 with production values
    // (chunksize=1024, target_level=2048, fan-in output=1024,
    // outputd DAC=3072).
    audio_backend_latency_offset_in_seconds = __AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__;
    // Held at 0.5 s in the JTS4 ring A/B. A 64 ms trial changed occupancy but
    // is not adopted: longer WiFi-disruption, reliability, and A/V validation
    // is required first.
    audio_backend_buffer_desired_length_in_seconds = 0.5;
};

sessioncontrol = {
    // Release the loopback device 1s after AP2 idle so other
    // renderers (librespot, bluealsa-aplay) can take over
    // immediately when the user switches sources. With
    // `latest-source-wins` arbitration in jasper-mux the user's
    // expectation is "I selected Spotify on my phone, it should
    // play right now" — not "wait N seconds for the dead AirPlay
    // session to time out." Keep small but non-zero so a brief
    // transport glitch on Mac doesn't destroy the session and force
    // re-establishing.
    session_timeout = 1;
};

alsa = {
    // AirPlay's private fan-in lane, substituted from the renderer-lane
    // map (/var/lib/jasper/renderer_lanes.env, single writer
    // `jasper-audio-config renderer-lanes`): shairport_substream — the
    // snd-aloop lane, and the fallback when no map exists — or
    // shairport_ring_lane when the airplay lane is armed (U3/P6d). Both
    // are plug wrappers that handle shairport's native 44100 → 48000
    // S16_LE conversion through libsamplerate (samplerate_medium by
    // default, toggleable at /system/); only the slave under the wrapper
    // differs. shairport-sync still only
    // accepts output_rate values that are integer multiples of 44100, so
    // 44100 stays here as shairport's native AirPlay rate.
    output_device = "__RENDERER_DEVICE__";
    output_rate = 44100;
    // S32 stays for the same reason it did before -- efficient when
    // the plug layer above the fan-in lane only has to downconvert
    // format (S32 -> the lane's own width). This is the fan-in ingress
    // hop, NOT the DAC edge: jasper-outputd declares the edge per DAC
    // profile from DacProfile.final_edge_format, which for the Apple
    // USB-C dongle (APPLE_USB_C_DONGLE in jasper/audio_hardware/dac.py)
    // is S24_3LE, not S16_LE.
    output_format = "S32";
    use_mmap_if_available = "no";
    // Templated — see file header. With JTS's snd-aloop -> CamillaDSP
    // -> outputd -> USB DAC chain, shairport's sample-stuffing fires
    // audible glitches every ~60s before the resync_threshold fix
    // (mikebrady/shairport-sync#1980). Free-running ("yes") is kept
    // as a fallback — it trades A/V sync for video AirPlay and inter-
    // speaker sync for multi-room. Default for JTS is "no" (synced).
    disable_synchronization = "__DISABLE_SYNCHRONIZATION__";
};

metadata = {
    enabled = "yes";
    include_cover_art = "no";
};

diagnostics = {
    // Raised from default 1 → 2 on 2026-05-21 to log the post-SETUP
    // RECORD / cipher / PTP-sync state for an open AP2 failure mode:
    // shairport accepts the SETUP, logs "Connection N. AP2 Realtime
    // Audio Stream." at rtsp.c:3304, then silently fails to start
    // audio. Level 1 stops logging at that line — level 2 emits
    // enough downstream detail to name the failing component on the
    // next recurrence.
    // EARMARK: drop back to log_verbosity = 1 once this failure is
    // closed — this level-2 detail is ~55% of shairport's log volume
    // (~40 PTP-anchor lines/min).
    log_verbosity = 2;
    log_show_file_and_line_numbers = "no";
};
