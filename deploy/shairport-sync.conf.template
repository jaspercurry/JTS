// JTS shairport-sync config TEMPLATE — AirPlay 2 receiver into its
// private fan-in lane (snd-aloop, or the SHM ring when the airplay
// renderer lane is armed — U3/P6d). Rendered to /etc/shairport-sync.conf
// by `jasper-apply-airplay-mode` (script installed to /usr/local/sbin/).
// The renderer substitutes `__DISABLE_SYNCHRONIZATION__` based on
// `JASPER_AIRPLAY_FREE_RUNNING` in /var/lib/jasper/airplay_mode.env,
// and `__RENDERER_DEVICE__` from the renderer-lane map (see the alsa
// block below).
// Default = no (synced). Toggle via http://jts.local/airplay/ or
// `jasper-airplay-mode set [free-running|synced]`. See
// jasper/web/airplay_setup.py for the toggle UX.
//
// LANE GEOMETRY — every seconds-valued sync knob below is sized against
// it. Declared by the jts_ring_lane_airplay block in
// deploy/alsa/conf.d/61-jts-renderer-lanes.conf, at that lane's 48 kHz:
//   16 slots x 256 frames = 4096 frames = 85.333 ms of whole-slot depth,
//   and the consumer drains exactly one slot per 5.333 ms, DAC-locked.
// So the lane's snd_pcm_delay() reports pure ring fill: it steps in
// 5.333 ms grains and saturates at 16x256+255 = 4351 frames (~90.6 ms),
// the .delay callback counting staged frames too. A knob that does not
// clear that grain servos on quantization noise, and a target above the
// lane's ~90.6 ms saturation point can never be reached.
// These targets are only actively held in synced mode — free-running
// (__DISABLE_SYNCHRONIZATION__ = "yes") skips the corrector entirely.
//
// Requires source-built shairport-sync with --with-airplay-2 plus
// nqptp.service running (UDP 319/320). The Debian Trixie apt package
// is AP1-only — install.sh source-builds the AP2 variant.

general = {
    name = "__AIRPLAY_NAME__";
    // "auto" benchmarks soxr at startup and can silently settle on
    // "basic" — a single inserted/dropped sample per correction, which
    // is the click — on Pi-class CPUs. soxr is compiled in
    // (--with-soxr, deploy/lib/install/renderers.sh), so pin it.
    interpolation = "soxr";
    output_backend = "alsa";
    // Continuous ±1-frame-per-packet stuffing, the smooth correction path.
    // shairport draws a per-packet random threshold uniform in [1x, 2x]
    // this value: under 1x it never corrects, over 2x it always does.
    // LOWER BOUND: 2x must exceed one 5.333 ms lane grain, or a single
    // slot of ring-fill quantization reads as drift and parks the
    // corrector in its always-correct regime with nothing to correct.
    // 0.010 => never under 10 ms (1.9 grains), always over 20 ms (3.8).
    drift_tolerance_in_seconds = 0.010;
    // The other correction path: discrete do_flush + silence injection,
    // which drops ~6,600 source frames and injects up to 250 ms of zeros
    // = an audible tear. Stays far above the stuffing band so only a
    // genuine large error reaches it.
    resync_threshold_in_seconds = 0.2;
    // The fixed downstream delay the lane's own snd_pcm_delay() cannot
    // see, so video and multi-room sync stay honest. Computed at every
    // render by jasper-apply-airplay-mode, never a constant. Full ledger
    // and empirical validation path: ADR-0205.
    //   -( (ring_a_frames + camilla_frames + ring_b_frames + outputd_frames)
    //      / samplerate + bonded_extra_sec )
    // ring_a_frames — Ring A (fan-in -> CamillaDSP), richest evidence
    //   first: jasper-fanin STATUS output.snd_pcm_delay_frames (the real
    //   ALSA queue depth — correct on a loopback box); else
    //   output.ring.occupancy x output.period_frames (the ring's LIVE
    //   fill, refreshed every render period — what a ring box actually
    //   uses, since fan-in reaches CamillaDSP over SHM with no ALSA delay
    //   to sample, ADR-0100); else a jasper.ring_assets parse of the
    //   shipped deploy/alsa/conf.d/60-jts-ring.conf (period_frames x
    //   n_slots); else a hardcoded default matching that same file. Ring A
    //   runs pinned full in steady state (STATUS full_waits/published
    //   ratio ~1.0), which is why its parsed/default tiers count the full
    //   slot capacity, not just one slot.
    // camilla_frames — max(target_level - chunksize, 0) + chunksize, from
    //   the ACTIVE CamillaDSP config's samplerate/chunksize/target_level:
    //   Camilla holds at least one full chunk, plus any extra fill
    //   target_level asks for above that baseline.
    // ring_b_frames — Ring B (CamillaDSP -> outputd): jasper-outputd
    //   STATUS shm_ring.occupancy x shm_ring.slot_frames (live fill,
    //   refreshed every DAC period) when the ring is configured; else the
    //   same jasper.ring_assets parse's period_frames ALONE — the one-slot
    //   floor, not x n_slots, because (unlike Ring A) there is no
    //   pinned-full evidence for Ring B, so only the proven minimum is
    //   charged; else a hardcoded default. Downstream of both shairport's
    //   private lane and CamillaDSP, so shairport's own snd_pcm_delay()
    //   cannot see it either.
    // outputd_frames — jasper-outputd STATUS dac.snd_pcm_delay_frames,
    //   else JASPER_OUTPUTD_DAC_BUFFER_FRAMES. The live delay can exceed
    //   the requested buffer, so it wins when offered.
    // bonded_extra_sec — Snapcast round-trip playout, written by
    //   jasper-grouping-reconcile only while this speaker is an active
    //   bonded leader; 0 on solo and followers.
    audio_backend_latency_offset_in_seconds = __AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__;
    // Servo target for lane fill. Must be reachable inside the lane's
    // ~90.6 ms saturation ceiling with room on both sides, or the servo
    // saturates one-sided and the ring pins near full with nothing left
    // to give back.
    // 0.045 s = 2160 frames = 8.4 of the lane's 16 slots (53 % of the
    // 85.333 ms whole-slot depth): ~40 ms of growth room, 45 ms of drain
    // room, both far over the 5.333 ms grain.
    audio_backend_buffer_desired_length_in_seconds = 0.045;
    // Under this delay shairport abandons soxr for "basic" stuffing (the
    // click). The ALSA-backend default of 0.120 exceeds the lane's
    // ~90.6 ms saturation, so it can never be met and soxr never engages
    // at all. 0.020 sits 25 ms (4.7 grains) under the target above, so a
    // multi-slot dip keeps soxr.
    // HARD CONSTRAINT: shairport die()s at startup when this exceeds
    // audio_backend_buffer_desired_length_in_seconds (audio.c).
    audio_backend_buffer_interpolation_threshold_in_seconds = 0.020;
    // INBOUND VOLUME (ADR-0206). Fired with the raw AirPlay volume
    // (-30..0 dB, plus the -144 mute sentinel) on every volume message and
    // once at stream start. The hook maps it onto the canonical percent
    // scale and posts it to jasper-control as a source-attributed
    // observation, so a sender's volume keys move the JTS master fader
    // through CamillaDSP's 400 ms ramp. Outbound stays closed: AirPlay 2
    // senders expose no writable slider (ADR-0176).
    run_this_when_volume_is_set = "/usr/local/sbin/jasper-airplay-volume";
    // Unity softvol (fix_volume = 65536): shairport applies no gain of its
    // own, so this S16 lane stays full-scale and attenuation happens once,
    // in CamillaDSP's float master. Without it the sender's gain would
    // compound with the master AND quantize in 16 bits. The hook above
    // still fires on every volume message.
    ignore_volume_control = "yes";
};

sessioncontrol = {
    // 60 is the FLOOR shairport-sync accepts, not a tuned value:
    // shairport.c:1203-1216 rejects anything in 1..59 with a warning and
    // silently substitutes 60 (4.3.7 took any integer, so this lane ran
    // at 1 until the 5.2.3 bump). 0 means "never time out", which holds
    // the lane forever — strictly worse. So 60 is the only reachable
    // value below "never".
    // This is the passive path only. Source switching does NOT wait for
    // it: `latest-source-wins` arbitration in jasper-mux actively calls
    // the native D-Bus DropSession (jasper/mux.py) when another renderer
    // claims the output, so "I selected Spotify, it should play right
    // now" still holds. What changes is how long a dead AirPlay session
    // squats the lane when nothing else claims it.
    session_timeout = 60;
    // Fires BEFORE the connect-time volume push, so the volume hook above
    // can tell that snapshot from a user's nudge and mark it
    // `observation_initial` — which keeps connecting a sender from
    // clearing a latched mute (ADR-0206). Marker only; no audio effect.
    run_this_before_play_begins = "/usr/local/sbin/jasper-airplay-volume --session-start";
};

alsa = {
    // AirPlay's private fan-in lane, substituted from the renderer-lane
    // map (/var/lib/jasper/renderer_lanes.env, single writer
    // `jasper-audio-config renderer-lanes`): shairport_substream — the
    // snd-aloop lane, and the fallback when no map exists — or
    // shairport_ring_lane when the airplay lane is armed (U3/P6d). Both
    // are plug wrappers over a 48000 slave; only the slave under the
    // wrapper differs.
    // MUST EQUAL THE LANE'S SLAVE RATE. 5.x probes the device once at
    // startup and calls snd_pcm_hw_params_set_rate_resample(..., 0)
    // before snd_pcm_hw_params_test_rate(..., 0) -- resampling off,
    // exact rate only (audio_alsa.c:329). So the plug wrapper cannot
    // convert during the probe and only the slave's own 48000 passes.
    // A rate that fails is struck from config.rate_set
    // (audio_alsa.c:339); once that set is empty the
    // permissible_configurations table is never filled
    // (audio_alsa.c:379), every later lookup returns EINVAL, and the
    // session dies at player.c:2432 "An unknown format was encountered
    // while choosing output bit depth". 4.3.7 had no such probe and let
    // the plug layer resample, which is why 44100 worked there.
    // shairport now does the 44.1 -> 48 conversion itself (soxr/FFmpeg)
    // instead of the plug layer, so this also drops one resample.
    output_device = "__RENDERER_DEVICE__";
    output_rate = 48000;
    // S32 stays for the same reason it did before -- efficient when
    // the plug layer above the fan-in lane only has to downconvert
    // format (S32 -> the lane's own width). This is the fan-in ingress
    // hop, NOT the DAC edge: jasper-outputd declares the edge per DAC
    // profile from DacProfile.final_edge_format, which for the Apple
    // USB-C dongle (APPLE_USB_C_DONGLE in jasper/audio_hardware/dac.py)
    // is S24_3LE, not S16_LE.
    output_format = "S32";
    // Pinned for the same reason as output_rate/output_format above. 5.0
    // added multichannel: `output_channels` now defaults to "auto" (match
    // the source) while `six_channel_mode`/`eight_channel_mode` default to
    // "on", so a sender may offer 5.1/7.1. This lane is `type plug` over a
    // 2-channel slave (deploy/alsa/conf.d/61-jts-renderer-lanes.conf), and
    // plug accepts any channel count — it would route/fold surround into
    // stereo instead of letting shairport's own `mixdown` do it. Pinning 2
    // keeps the 4.3.7 stereo-only behaviour this lane's geometry assumes.
    output_channels = 2;
    use_mmap_if_available = "no";
    // Templated — see file header. Free-running ("yes") is the fallback
    // that stops chasing the sender clock entirely: it trades A/V sync
    // for video AirPlay and inter-speaker sync for multi-room. JTS
    // defaults to "no" (synced).
    disable_synchronization = "__DISABLE_SYNCHRONIZATION__";
};

metadata = {
    enabled = "yes";
    include_cover_art = "no";
};

diagnostics = {
    // Raised from default 1 → 2 on 2026-05-21 to log the post-SETUP
    // RECORD / cipher / PTP-sync state for an open AP2 failure mode:
    // shairport accepts the SETUP, logs "Connection N. AP2 Realtime
    // Audio Stream." at rtsp.c:3304, then silently fails to start
    // audio. Level 1 stops logging at that line — level 2 emits
    // enough downstream detail to name the failing component on the
    // next recurrence.
    // EARMARK: drop back to log_verbosity = 1 once this failure is
    // closed — this level-2 detail is ~55% of shairport's log volume
    // (~40 PTP-anchor lines/min).
    log_verbosity = 2;
};
