// JTS shairport-sync config TEMPLATE — AirPlay 2 receiver into its
// private fan-in lane (snd-aloop, or the SHM ring when the airplay
// renderer lane is armed — U3/P6d). Rendered to /etc/shairport-sync.conf
// by `jasper-apply-airplay-mode` (script installed to /usr/local/sbin/).
// The renderer substitutes `__DISABLE_SYNCHRONIZATION__` based on
// `JASPER_AIRPLAY_FREE_RUNNING` in /var/lib/jasper/airplay_mode.env,
// and `__RENDERER_DEVICE__` from the renderer-lane map (see the alsa
// block below).
// Default = no (synced). Toggle via http://jts.local/airplay/ or
// `jasper-airplay-mode set [free-running|synced]`. See
// jasper/web/airplay_setup.py for the toggle UX.
//
// LANE GEOMETRY — every seconds-valued sync knob below is sized against
// it (c/jts-ring-ioplug, at the fan-in lane's 48 kHz):
//   16 slots x 256 frames = 4096 frames = 85.333 ms of depth, and the
//   consumer drains exactly one slot per 5.333 ms, DAC-locked.
// So the lane's snd_pcm_delay() reports pure ring fill: it steps in
// 5.333 ms grains and saturates near 90.6 ms. A knob that does not clear
// that grain servos on quantization noise, and a target above 85.333 ms
// can never be reached.
//
// Requires source-built shairport-sync with --with-airplay-2 plus
// nqptp.service running (UDP 319/320). The Debian Trixie apt package
// is AP1-only — install.sh source-builds the AP2 variant.

general = {
    name = "__AIRPLAY_NAME__";
    // "auto" benchmarks soxr at startup and can silently settle on
    // "basic" — a single inserted/dropped sample per correction, which
    // is the click — on Pi-class CPUs. soxr is compiled in
    // (--with-soxr, deploy/lib/install/renderers.sh), so pin it.
    interpolation = "soxr";
    output_backend = "alsa";
    // Continuous ±1-frame-per-packet stuffing, the smooth correction path.
    // shairport draws a per-packet random threshold uniform in [1x, 2x]
    // this value: under 1x it never corrects, over 2x it always does.
    // LOWER BOUND: 2x must exceed one 5.333 ms lane grain, or a single
    // slot of ring-fill quantization reads as drift and parks the
    // corrector in its always-correct regime with nothing to correct.
    // 0.010 => never under 10 ms (1.9 grains), always over 20 ms (3.8).
    drift_tolerance_in_seconds = 0.010;
    // The other correction path: discrete do_flush + silence injection,
    // which drops ~6,600 source frames and injects up to 250 ms of zeros
    // = an audible tear. Stays far above the stuffing band so only a
    // genuine large error reaches it.
    resync_threshold_in_seconds = 0.2;
    // The fixed downstream delay the lane's own snd_pcm_delay() cannot
    // see, so video and multi-room sync stay honest. Computed at every
    // render by jasper-apply-airplay-mode, never a constant:
    //   -( ((target_level - chunksize) + fanin_frames + outputd_frames)
    //      / samplerate + bonded_extra_sec )
    // samplerate/chunksize/target_level — the ACTIVE CamillaDSP config
    //   (target_level defaults to chunksize when absent, so the term is
    //   the buffer ABOVE Camilla's implicit one-chunk baseline).
    // fanin_frames — jasper-fanin STATUS output.snd_pcm_delay_frames,
    //   else the script's ring-queue stand-in; fan-in reaches CamillaDSP
    //   over SHM (ADR-0100), which has no ALSA delay to sample, so a ring
    //   box always takes the stand-in.
    // outputd_frames — jasper-outputd STATUS dac.snd_pcm_delay_frames,
    //   else JASPER_OUTPUTD_DAC_BUFFER_FRAMES. The live delay can exceed
    //   the requested buffer, so it wins when offered.
    // bonded_extra_sec — Snapcast round-trip playout, written by
    //   jasper-grouping-reconcile only while this speaker is an active
    //   bonded leader; 0 on solo and followers.
    audio_backend_latency_offset_in_seconds = __AUDIO_BACKEND_LATENCY_OFFSET_SECONDS__;
    // Servo target for lane fill. Must be reachable INSIDE the 85.333 ms
    // lane with room on both sides, or the servo saturates one-sided and
    // the ring pins near full with nothing left to give back.
    // 0.045 s = 2160 frames = 8.4 of the lane's 16 slots (53 % depth):
    // ~40 ms of growth room, 45 ms of drain room, both far over the
    // 5.333 ms grain.
    audio_backend_buffer_desired_length_in_seconds = 0.045;
    // Under this delay shairport abandons soxr for "basic" stuffing (the
    // click). The ALSA-backend default of 0.120 exceeds the lane's
    // ~90.6 ms saturation, so it can never be met and soxr never engages
    // at all. 0.020 sits 25 ms (4.7 grains) under the target above, so a
    // multi-slot dip keeps soxr.
    // HARD CONSTRAINT: shairport die()s at startup when this exceeds
    // audio_backend_buffer_desired_length_in_seconds (audio.c).
    audio_backend_buffer_interpolation_threshold_in_seconds = 0.020;
};

sessioncontrol = {
    // Release the loopback device 1s after AP2 idle so other
    // renderers (librespot, bluealsa-aplay) can take over
    // immediately when the user switches sources. With
    // `latest-source-wins` arbitration in jasper-mux the user's
    // expectation is "I selected Spotify on my phone, it should
    // play right now" — not "wait N seconds for the dead AirPlay
    // session to time out." Keep small but non-zero so a brief
    // transport glitch on Mac doesn't destroy the session and force
    // re-establishing.
    session_timeout = 1;
};

alsa = {
    // AirPlay's private fan-in lane, substituted from the renderer-lane
    // map (/var/lib/jasper/renderer_lanes.env, single writer
    // `jasper-audio-config renderer-lanes`): shairport_substream — the
    // snd-aloop lane, and the fallback when no map exists — or
    // shairport_ring_lane when the airplay lane is armed (U3/P6d). Both
    // are plug wrappers that handle shairport's native 44100 → 48000
    // S16_LE conversion through libsamplerate (samplerate_medium by
    // default, toggleable at /system/); only the slave under the wrapper
    // differs. shairport-sync still only
    // accepts output_rate values that are integer multiples of 44100, so
    // 44100 stays here as shairport's native AirPlay rate.
    output_device = "__RENDERER_DEVICE__";
    output_rate = 44100;
    // S32 stays for the same reason it did before -- efficient when
    // the plug layer above the fan-in lane only has to downconvert
    // format (S32 -> the lane's own width). This is the fan-in ingress
    // hop, NOT the DAC edge: jasper-outputd declares the edge per DAC
    // profile from DacProfile.final_edge_format, which for the Apple
    // USB-C dongle (APPLE_USB_C_DONGLE in jasper/audio_hardware/dac.py)
    // is S24_3LE, not S16_LE.
    output_format = "S32";
    use_mmap_if_available = "no";
    // Templated — see file header. Free-running ("yes") is the fallback
    // that stops chasing the sender clock entirely: it trades A/V sync
    // for video AirPlay and inter-speaker sync for multi-room. JTS
    // defaults to "no" (synced).
    disable_synchronization = "__DISABLE_SYNCHRONIZATION__";
};

metadata = {
    enabled = "yes";
    include_cover_art = "no";
};

diagnostics = {
    // Raised from default 1 → 2 on 2026-05-21 to log the post-SETUP
    // RECORD / cipher / PTP-sync state for an open AP2 failure mode:
    // shairport accepts the SETUP, logs "Connection N. AP2 Realtime
    // Audio Stream." at rtsp.c:3304, then silently fails to start
    // audio. Level 1 stops logging at that line — level 2 emits
    // enough downstream detail to name the failing component on the
    // next recurrence.
    // EARMARK: drop back to log_verbosity = 1 once this failure is
    // closed — this level-2 detail is ~55% of shairport's log volume
    // (~40 PTP-anchor lines/min).
    log_verbosity = 2;
    log_show_file_and_line_numbers = "no";
};
