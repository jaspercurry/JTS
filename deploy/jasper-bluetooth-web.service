[Unit]
Description=Jasper Bluetooth control panel (web at /bluetooth/)
# Socket-activated by jasper-bluetooth-web.socket — daemon exits after
# 10 min idle, .socket re-activates it on next request.
Requires=jasper-bluetooth-web.socket
After=jasper-bluetooth-web.socket network-online.target bluetooth.service
# Wants= (not Requires=) so a bluetoothd restart doesn't cascade-stop
# us; the engine reconnects to the system bus on the next request.
Wants=network-online.target bluetooth.service
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
# Type=notify — daemon sends READY=1 after fd adoption. WATCHDOG=1
# keeps systemd from killing us; hang gets re-spawned by next request.
Type=notify
WatchdogSec=30s
EnvironmentFile=-/etc/jasper/jasper.env
# Args ignored when socket-activated (daemon adopts inherited fd)
# but kept for direct CLI invocation in dev.
ExecStart=/opt/jasper/.venv/bin/jasper-bluetooth-web --host 127.0.0.1 --port 8769
# Restart=on-failure (NOT always) so clean idle-exit stays exited.
Restart=on-failure
RestartSec=2

# Runs as the shared wizard identity, like jasper-chat-web. Each privileged
# surface this panel drives has a non-root mechanism:
#   * org.bluez (adapter power/discoverable, StartDiscovery, Pair/Connect/
#     Forget, and the Agent1 pairing agent) — the `bluetooth` supplementary
#     group. That is a D-Bus policy grant (`send_destination="org.bluez"` for
#     the group), not polkit and not a capability; jasper-web already holds it
#     for the /speaker BlueZ rename.
#   * source-intent writes + the reconcile that follows — the fixed root
#     oneshot, started through jasper-control's restart broker (manage_units).
#     The broker only accepts the known service users, jasper-web among them.
#   * `systemctl is-active` / `show` — read-only probes systemd allows any uid.
# The HTTP listener binds 127.0.0.1, fronted by nginx on jts.local/bluetooth/.
User=jasper-web
Group=jasper
SupplementaryGroups=bluetooth
CapabilityBoundingSet=
SystemCallFilter=@system-service
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_UNIX: the system D-Bus socket, the restart broker, sd_notify, journald.
# AF_INET/AF_INET6: the systemd-passed loopback listener.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# State for the {mac: handler_id} role map and the shared source-intent file.
ReadWritePaths=/var/lib/jasper

# Single async loop + a handful of dbus + http threads. The observer
# keeps an in-memory device map (a few hundred bytes per device).
MemoryHigh=100M
MemoryMax=160M

# Wizard: recoverable dashboard, idle-exits already — make it one of
# OOM's first picks (jasper/_oom_adj.py wizard tier).
OOMScoreAdjust=200

[Install]
# Enabling the .socket pulls in the service on demand. Use:
#   systemctl enable jasper-bluetooth-web.socket
