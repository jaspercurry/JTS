[Unit]
Description=Jasper streambox web setup wizards (renderer/DSP + assistant) — socket
# Static file, so it binds every port a streambox may host: renderer/DSP
# plus the assistant wizards, which appear when the tier holds
# Capability.ASSISTANT. Wake-side ports stay off (no WAKE_DETECTION here).

[Socket]
# Order is undefined per systemd issue #16647, so the Python side matches by
# getsockname()[1] (port) rather than by fd index.
ListenStream=127.0.0.1:8765
ListenStream=127.0.0.1:8767
ListenStream=127.0.0.1:8768
ListenStream=127.0.0.1:8771
ListenStream=127.0.0.1:8773
ListenStream=127.0.0.1:8775
ListenStream=127.0.0.1:8777
ListenStream=127.0.0.1:8778
ListenStream=127.0.0.1:8779
ListenStream=127.0.0.1:8783
ListenStream=127.0.0.1:8784
ListenStream=127.0.0.1:8785
ListenStream=127.0.0.1:8786
Accept=no
TriggerLimitIntervalSec=10s
TriggerLimitBurst=100

[Install]
WantedBy=sockets.target
