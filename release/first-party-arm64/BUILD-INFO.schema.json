{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaspercurry/JTS/blob/main/release/first-party-arm64/BUILD-INFO.schema.json",
  "title": "JTS first-party ARM64 runtime BUILD-INFO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_set",
    "bundle_format_version",
    "release_version",
    "source",
    "target",
    "build",
    "artifacts",
    "cargo_graphs",
    "notices"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_set": {"const": "jts-first-party-runtime"},
    "bundle_format_version": {"const": 1},
    "release_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_commit", "dirty", "source_date_epoch"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"const": false},
        "source_date_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triple",
        "architecture",
        "elf_class",
        "elf_machine",
        "os",
        "distribution",
        "distribution_codename",
        "platform"
      ],
      "properties": {
        "triple": {"const": "aarch64-unknown-linux-gnu"},
        "architecture": {"const": "aarch64"},
        "elf_class": {"const": "ELF64"},
        "elf_machine": {"const": "AArch64"},
        "os": {"const": "linux"},
        "distribution": {"const": "debian"},
        "distribution_codename": {"const": "trixie"},
        "platform": {"const": "raspberry-pi-os-trixie-arm64"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "host_machine",
        "toolchain",
        "system_packages",
        "reproducible_environment"
      ],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "host_machine": {"enum": ["aarch64", "arm64"]},
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["python", "rustc", "cargo", "cc", "readelf"],
          "properties": {
            "python": {"type": "string", "minLength": 1},
            "rustc": {"type": "string", "minLength": 1},
            "cargo": {"type": "string", "minLength": 1},
            "cc": {"type": "string", "minLength": 1},
            "readelf": {"type": "string", "minLength": 1}
          }
        },
        "system_packages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/systemPackage"}
        },
        "reproducible_environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "cargo_graphs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/cargoGraph"}
    },
    "notices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_path",
        "cargo_package_count",
        "toolchain_notice_count",
        "license_file_count",
        "scope"
      ],
      "properties": {
        "index_path": {"const": "THIRD-PARTY-NOTICES.md"},
        "cargo_package_count": {"type": "integer", "minimum": 1},
        "toolchain_notice_count": {"const": 2},
        "license_file_count": {"type": "integer", "minimum": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "path",
        "install_path",
        "mode",
        "size",
        "sha256",
        "elf"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(bin|lib)/"},
        "install_path": {"type": "string", "pattern": "^/"},
        "mode": {"enum": ["0755", "0644"]},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "elf": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class",
            "machine",
            "type",
            "interpreter",
            "needed",
            "rpath",
            "runpath",
            "required_symbols"
          ],
          "properties": {
            "class": {"const": "ELF64"},
            "machine": {"const": "AArch64"},
            "type": {"const": "DYN"},
            "interpreter": {"type": ["string", "null"]},
            "needed": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "rpath": {"const": null},
            "runpath": {"const": null},
            "required_symbols": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "cargoGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "lockfile", "lockfile_sha256", "packages"],
      "properties": {
        "root": {"enum": ["jasper-fanin", "jasper-outputd"]},
        "lockfile": {"type": "string", "pattern": "^rust/.+/Cargo.lock$"},
        "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/cargoPackage"}
        }
      }
    },
    "cargoPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source", "checksum"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "checksum": {"type": ["string", "null"]}
      }
    },
    "systemPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    }
  }
}
