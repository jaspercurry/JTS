#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

# Resolve the script's own directory BEFORE the `cd`: `${BASH_SOURCE[0]}` is
# caller-relative, so computing it afterwards resolves against the repo root
# and a relative invocation from a subdirectory fails to find the sibling
# resolver -- before the resolver's own error handling exists to say so.
_lane_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$(git rev-parse --show-toplevel)"

# shellcheck source=scripts/_test_lane.sh
source "${_lane_dir}/_test_lane.sh"

# Registered before resolve_lane_tool runs, so this is the lane's single
# verdict point regardless of where an exit happens (issue #1850). The
# temp-file variables are initialized empty (not left unset) so cleanup is
# safe under `set -u` even if the trap fires before their mktemp lines run.
phase_tmp=""
changed_file_tmp=""
selected_test_tmp=""
_lane_passed_total=0
# Set true as the literal LAST statement of this script: the EXIT trap cannot
# tell "finished" from "died partway" out of the pending status alone. Why not
# -- see lane_emit_verdict, which owns that story.
_lane_finished=false
cleanup() {
  # Captured FIRST, before any other command: `$?` reflects only the most
  # recent command, and the `rm` below would otherwise clobber it before
  # lane_emit_verdict ever saw the real value.
  local exit_status=$?
  # `|| true`: cleanup is best-effort, and must never be able to stop
  # lane_emit_verdict from running. A missing/failing `rm` (this repo's own
  # test sandbox has no coreutils on PATH by design) would otherwise abort
  # this function right here under `set -e`, silently swallowing the one
  # line the #1850 fix exists to guarantee.
  rm -f "${phase_tmp}" "${changed_file_tmp}" "${selected_test_tmp}" 2>/dev/null || true
  lane_emit_verdict test-fast "${exit_status}"
}
trap cleanup EXIT

base_ref="${TEST_BASE:-origin/main}"
pytest_bin="$(resolve_lane_tool test-fast pytest PYTEST)" || exit 1

export JASPER_VOICE_PROVIDER="${JASPER_VOICE_PROVIDER:-gemini}"

phase_tmp="$(mktemp "${TMPDIR:-/tmp}/jts-test-fast-phase.XXXXXX")"

echo "==> pytest CI routing policy"
if ! routing_policy_output="$(
  python3 scripts/ci-classify.py --routing-policy-pytest-targets
)"; then
  echo "FATAL: could not resolve CI routing-policy tests" >&2
  exit 1
fi
routing_policy_tests=()
while IFS= read -r target; do
  [[ -n "${target}" ]] && routing_policy_tests+=("${target}")
done <<< "${routing_policy_output}"
if (( ${#routing_policy_tests[@]} == 0 )); then
  echo "FATAL: CI routing policy returned no pytest targets" >&2
  exit 1
fi
lane_pipe_pytest "${phase_tmp}" "${pytest_bin}" -q --tb=short "${routing_policy_tests[@]}"
_lane_passed_total=$(( _lane_passed_total + $(lane_extract_passed_count "${phase_tmp}") ))

ruff_bin="$(resolve_lane_tool test-fast ruff RUFF)" || exit 1

changed_file_tmp="$(mktemp "${TMPDIR:-/tmp}/jts-test-fast-files.XXXXXX")"
selected_test_tmp="$(mktemp "${TMPDIR:-/tmp}/jts-test-fast-tests.XXXXXX")"

collect_changed_files() {
  if git rev-parse --verify "${base_ref}" >/dev/null 2>&1; then
    git diff --name-only --diff-filter=ACMR "${base_ref}...HEAD"
  fi
  git diff --name-only --diff-filter=ACMR
  git diff --cached --name-only --diff-filter=ACMR
  git ls-files --others --exclude-standard
}

collect_changed_files | awk 'NF' | sort -u > "${changed_file_tmp}"

add_test_if_present() {
  local path="$1"
  if [[ -f "${path}" ]]; then
    printf '%s\n' "${path}" >> "${selected_test_tmp}"
  fi
}

# Like add_test_if_present, but accepts a pytest node id qualified with
# `::test_name` (as scripts/ci-classify.py's --landing-pytest-targets emits
# for its one function-scoped target): the existence check is against the
# file portion only, while the full id -- file plus `::`-suffix -- is what
# gets queued, so pytest runs just that one function rather than the whole
# file.
add_pytest_target_if_present() {
  local target="$1"
  local file="${target%%::*}"
  if [[ -f "${file}" ]]; then
    printf '%s\n' "${target}" >> "${selected_test_tmp}"
  fi
}

# issue #1973: deploy/index.html and other deploy/assets/* changes were
# invisible to the changed-file mapping below, so editing the landing page
# gave a green test-fast while its test sat red at the same tree. Read the
# registered bundle from ci-classify.py's own --landing-pytest-targets rather
# than copying the list here, so the two lanes cannot drift apart; guarded so
# a diff touching several landing paths pays for one subprocess invocation.
#
# Captured into a variable and exit-status-checked, not `done < <(...)`: a
# `while read` loop fed by a failing process substitution can't see that
# command's exit code, so a broken ci-classify.py could silently queue zero
# landing tests and this lane would go green with nothing checked.
_landing_tests_added=false
add_landing_tests_if_needed() {
  if [[ "${_landing_tests_added}" == true ]]; then
    return
  fi
  _landing_tests_added=true
  local landing_output
  if ! landing_output="$(
    python3 scripts/ci-classify.py --landing-pytest-targets
  )"; then
    echo "FATAL: could not resolve landing-page pytest targets" >&2
    exit 1
  fi
  local landing_targets=()
  while IFS= read -r landing_target; do
    [[ -n "${landing_target}" ]] && landing_targets+=("${landing_target}")
  done <<< "${landing_output}"
  if (( ${#landing_targets[@]} == 0 )); then
    echo "FATAL: ci-classify.py --landing-pytest-targets returned no pytest targets" >&2
    exit 1
  fi
  for landing_target in "${landing_targets[@]}"; do
    add_pytest_target_if_present "${landing_target}"
  done
}

add_globbed_tests() {
  local pattern="$1"
  local matched=false
  local path
  while IFS= read -r path; do
    matched=true
    printf '%s\n' "${path}" >> "${selected_test_tmp}"
  done < <(find tests -maxdepth 1 -type f -name "${pattern}" | sort)
  [[ "${matched}" == true ]]
}

while IFS= read -r changed; do
  case "${changed}" in
    tests/test_*.py)
      add_test_if_present "${changed}"
      ;;
    tests/*_fixtures.py)
      # A shared fixtures module has no jasper/*.py path component and its
      # several importers aren't named by the jasper arms' module-name
      # convention below — so, like the deploy/bin arm's fallback further
      # down, grep for the module's own basename across every test file
      # that imports it.
      fixtures_module="${changed##*/}"
      fixtures_module="${fixtures_module%.py}"
      while IFS= read -r fixtures_test; do
        add_test_if_present "${fixtures_test}"
      done < <(grep -l -- "${fixtures_module}" tests/test_*.py 2>/dev/null || true)
      ;;
    wake_training/*)
      # wake_training/ lives outside jasper/ (laptop-side training tooling,
      # not shipped) so the jasper/*/*.py arm below never sees it — without
      # this arm an edit here selects zero tests, same failure mode the
      # rust/ and experiments/*/* arms exist to close.
      add_test_if_present "tests/test_build_wake_feature_bank.py"
      add_test_if_present "tests/test_build_wake_negative_feature_bank.py"
      add_test_if_present "tests/test_wake_training_feature_bank.py"
      ;;
    tests/voice_eval/*)
      ;;
    jasper/secret_redaction.py|scripts/_diagnostic_redaction.sh)
      # The Python and bash redactors are pinned side by side against one
      # case table, so an edit to either has to run both files' tests.
      # Without this arm scripts/_diagnostic_redaction.sh matches no arm at
      # all and jasper/secret_redaction.py routes only to its own test.
      add_test_if_present "tests/test_secret_redaction.py"
      add_test_if_present "tests/test_diagnostic_redaction_scripts.py"
      # These five run redact_secrets on the surfaces the non-negotiable
      # covers, so a rule change breaks them with nothing in their own
      # subject moved.
      add_test_if_present "tests/test_failure_detail.py"
      add_test_if_present "tests/test_doctor_core.py"
      add_test_if_present "tests/test_web_wifi_setup.py"
      add_test_if_present "tests/test_voice_setup.py"
      add_test_if_present "tests/test_web_transit_setup.py"
      ;;
    jasper/*/*.py)
      # issue #3142: a module nested one directory deeper than the top-level
      # package only has `package` (e.g. "cli") and `module` to route with,
      # which doesn't match the doctor family's tests/test_doctor_<module>.py
      # convention. `parent` is the immediate containing directory (equal to
      # `package` when the file sits directly under it, so this is a no-op
      # arm then, not a special case for one package).
      package="${changed#jasper/}"
      package="${package%%/*}"
      module="${changed##*/}"
      module="${module%.py}"
      parent="${changed%/*}"
      parent="${parent##*/}"
      add_test_if_present "tests/test_${module}.py"
      add_test_if_present "tests/test_${package}.py"
      add_test_if_present "tests/test_${parent}_${module}.py"
      add_test_if_present "tests/test_${parent}.py"
      add_globbed_tests "test_${package}_*.py" >/dev/null || true
      add_globbed_tests "test_${module}_*.py" >/dev/null || true
      add_globbed_tests "test_${parent}_*.py" >/dev/null || true
      ;;
    jasper/*.py)
      module="${changed#jasper/}"
      module="${module%.py}"
      add_test_if_present "tests/test_${module}.py"
      add_globbed_tests "test_${module}_*.py" >/dev/null || true
      ;;
    .github/workflows/tests.yml|pyproject.toml|uv.lock|CONTRIBUTING.md|AGENTS.md|scripts/test-*|scripts/_test_lane.sh|scripts/check-rust.sh|scripts/rust-ci-needed)
      add_test_if_present "tests/test_dependency_groups.py"
      add_test_if_present "tests/test_check_rust_script.py"
      # `scripts/test-*` does not match the leading-underscore resolver, and
      # nothing else routes the lanes' own guards — so editing the lanes ran
      # everything except the tests written for them (issue #1836).
      add_test_if_present "tests/test_test_lane_tool_resolution.py"
      ;;
    deploy/assets/*/js/*.js|tests/js/*.mjs)
      add_test_if_present "tests/test_dialog_helper.py"
      add_test_if_present "tests/test_local_web_host_js.py"
      ;;
    deploy/index.html|deploy/assets/*)
      # Listed after the js/*.js arm above on purpose: a page-module JS
      # change keeps matching that narrower, earlier arm and its own tests
      # only (case runs the first match, not every match); a landing-page or
      # other shared-asset change (app.css, a new page dir) falls through to
      # here.
      add_landing_tests_if_needed
      ;;
    deploy/bin/*)
      # These are shell scripts the tests reach through subprocess, so no
      # import graph routes them and the jasper/*.py arms above never match.
      # About half are pinned by a test named for the script minus its
      # `jasper-` prefix; the rest are pinned by contract tests named for the
      # SUBJECT instead (e.g. jasper-apply-airplay-mode is covered by
      # tests/test_airplay_render.py). The glob below runs unconditionally after the convention
      # checks; the `grep` fallback runs only when no convention candidate matched, so a
      # convention hit skips grep and the glob is what still catches a pattern-named test like
      # tests/test_aec_reconcile_rule_pins.py (issue #3846). Grep itself is the fallback,
      # not the rule, because the reconcile scripts are named in ~28 files each, several
      # of them slow.
      script="${changed##*/}"
      script_module="${script#jasper-}"
      script_module="${script_module//-/_}"
      script_matched=false
      for candidate in \
        "tests/test_${script_module}.py" \
        "tests/test_${script_module}_script.py"; do
        if [[ -f "${candidate}" ]]; then
          add_test_if_present "${candidate}"
          script_matched=true
        fi
      done
      add_globbed_tests "test_${script_module}_*.py" >/dev/null || true
      if [[ "${script_matched}" != true ]]; then
        while IFS= read -r script_test; do
          add_test_if_present "${script_test}"
        done < <(grep -l -- "${script}" tests/test_*.py 2>/dev/null || true)
      fi
      ;;
    rust/*)
      # The Rust crates' static source guards are Python tests (cargo can't
      # run in every dev env). Run them in the fast lane, not only the merge
      # lane, so a Rust edit that trips them fails immediately.
      add_test_if_present "tests/test_rust_runtime_panic_freedom.py"
      add_test_if_present "tests/test_outputd_wiring.py"
      add_test_if_present "tests/test_usbsink_impulse_tap_contract.py"
      ;;
    experiments/*/*)
      # Same reasoning as the rust arm above: an experiment kit's guards are
      # Python tests under tests/, so without this an edit to a kit selects
      # nothing and its layout/path pins first run in the merge lane. The
      # directory name is the test name (experiments/usb-turntable ->
      # tests/test_usb_turntable_experiment.py), so this stays one arm
      # however many kits land.
      experiment="${changed#experiments/}"
      experiment="${experiment%%/*}"
      add_test_if_present "tests/test_${experiment//-/_}_experiment.py"
      ;;
  esac
done < "${changed_file_tmp}"

sort -u "${selected_test_tmp}" -o "${selected_test_tmp}"

echo "==> ruff"
"${ruff_bin}" check .

echo "==> pytest last failures"

# issue #1758: when EVERY cached --last-failed id is stale (renamed/deleted,
# or outside the given scope), pytest's own --last-failed machinery silently
# degrades into collecting and running the FULL suite serially --
# `--last-failed-no-failures none` only guards an EMPTY cache, not this case.
# A cache mixing live and stale ids is unaffected; pytest deselects the stale
# entries on its own.
#
# Fix: read the cache ourselves and validate before ever passing
# --last-failed. One combined --collect-only probe (cheap -- it only imports
# the files these specific ids reference) checks whether ANY are stale; only
# then do we pay for the slower per-id probe, so the common case costs one
# extra quick pytest start, not N of them.
lastfailed_file=".pytest_cache/v/cache/lastfailed"
lastfailed_ids=()
if [[ -f "${lastfailed_file}" ]]; then
  while IFS= read -r node_id; do
    [[ -n "${node_id}" ]] && lastfailed_ids+=("${node_id}")
  done < <(python3 -c '
import json, sys

try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, ValueError):
    data = {}
for key in data:
    print(key)
' "${lastfailed_file}")
fi

resolved_lastfailed_ids=()
if (( ${#lastfailed_ids[@]} > 0 )); then
  if "${pytest_bin}" --collect-only -q "${lastfailed_ids[@]}" >/dev/null 2>&1; then
    resolved_lastfailed_ids=("${lastfailed_ids[@]}")
  else
    stale_ids=()
    for node_id in "${lastfailed_ids[@]}"; do
      if "${pytest_bin}" --collect-only -q "${node_id}" >/dev/null 2>&1; then
        resolved_lastfailed_ids+=("${node_id}")
      else
        stale_ids+=("${node_id}")
      fi
    done
    if (( ${#stale_ids[@]} > 0 )); then
      echo "==> pruning ${#stale_ids[@]} stale last-failed id(s) (renamed/removed test?):"
      printf '  %s\n' "${stale_ids[@]}"
    fi
    # Rewrite the cache to match what actually resolved, so a tool reading it
    # directly (or a future run, if this run's own pytest invocation below
    # never gets that far) does not see the stale id again. The real pytest
    # run below will overwrite this with its own results regardless -- this
    # write only matters if that run never happens or never completes.
    if (( ${#resolved_lastfailed_ids[@]} > 0 )); then
      python3 -c '
import json, sys

path = sys.argv[1]
keep = set(sys.argv[2:])
try:
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, ValueError):
    data = {}
data = {k: v for k, v in data.items() if k in keep}
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh)
' "${lastfailed_file}" "${resolved_lastfailed_ids[@]}"
    else
      python3 -c '
import json, sys

with open(sys.argv[1], "w", encoding="utf-8") as fh:
    json.dump({}, fh)
' "${lastfailed_file}"
    fi
  fi
fi

if (( ${#resolved_lastfailed_ids[@]} > 0 )); then
  # Deliberate: passing both is a UNION, not `"$@"` scoping the cached ids --
  # pytest runs the resolved ids AND whatever `"$@"` names, exactly the same
  # union `--last-failed` itself had with trailing args before this fix.
  # Harmless: a caller-supplied path only adds tests to the phase, it can
  # never cause a cached failure to be silently skipped.
  lane_pipe_pytest "${phase_tmp}" "${pytest_bin}" -q --tb=short "${resolved_lastfailed_ids[@]}" "$@"
  _lane_passed_total=$(( _lane_passed_total + $(lane_extract_passed_count "${phase_tmp}") ))
else
  echo "no last-failed tests recorded"
fi

if [[ -s "${selected_test_tmp}" ]]; then
  echo "==> pytest changed-file selection"
  sed 's/^/  /' "${selected_test_tmp}"
  selected_tests=()
  while IFS= read -r path; do
    selected_tests+=("${path}")
  done < "${selected_test_tmp}"
  lane_pipe_pytest "${phase_tmp}" "${pytest_bin}" -q --tb=short "${selected_tests[@]}" "$@"
  _lane_passed_total=$(( _lane_passed_total + $(lane_extract_passed_count "${phase_tmp}") ))
else
  echo "==> no direct changed-file test mapping found"
fi

# Repo-wide scanners: each walks whole trees instead of testing one module, and
# none of them has an owning source file, so no changed-file mapping above can
# ever select one -- any diff could break them while this lane stayed green.
# test_deploy_wiring_guards covers deploy/systemd/* and deploy/lib/install/*,
# which match no case arm at all. test_correction_boundary_ssot and
# test_runtime_import_closure are the tuning-layer import-boundary pins. Only
# the cheap scanners run here; the slower unroutable ones
# (test_async_wait_contract, test_lazy_imports, test_env_vars_codified) stay
# in test-merge so this lane doesn't double in runtime. test_ci_classifier is
# already covered by the routing-policy phase above.
echo "==> pytest always-on fast guards"
lane_pipe_pytest "${phase_tmp}" "${pytest_bin}" -q --tb=short \
  tests/test_dependency_groups.py tests/test_lint_contracts.py \
  tests/test_deploy_wiring_guards.py tests/test_shell_awk_environ_convention.py \
  tests/test_docs_impact.py tests/test_correction_boundary_ssot.py \
  tests/test_runtime_import_closure.py "$@"
_lane_passed_total=$(( _lane_passed_total + $(lane_extract_passed_count "${phase_tmp}") ))

# LAST statement, deliberately: every phase the lane promises has now run, so
# the EXIT trap may print a verdict rather than INTERRUPTED. Keep it last.
_lane_finished=true
