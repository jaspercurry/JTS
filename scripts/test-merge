set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

source "$(dirname "${BASH_SOURCE[0]}")/_test_lane.sh"

pytest_bin="$(resolve_lane_tool test-merge pytest PYTEST "${PYTEST:-}")" || exit 1

export JASPER_VOICE_PROVIDER="${JASPER_VOICE_PROVIDER:-gemini}"

exec "${pytest_bin}" -q --tb=short --ignore=tests/voice_eval -n 4 "$@"
