#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

set -euo pipefail

# Resolve the script's own directory BEFORE the `cd`: `${BASH_SOURCE[0]}` is
# caller-relative, so computing it afterwards resolves against the repo root
# and a relative invocation from a subdirectory fails to find the sibling
# resolver -- before the resolver's own error handling exists to say so.
_lane_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$(git rev-parse --show-toplevel)"

# shellcheck source=scripts/_test_lane.sh
source "${_lane_dir}/_test_lane.sh"

# Registered before resolve_lane_tool runs, so this is the lane's single
# verdict point regardless of where an exit happens (issue #1850).
# `_lane_output_tmp` is initialized empty (not left unset) so the cleanup
# call is safe under `set -u` even if the trap fires before the mktemp line
# ever runs.
_lane_output_tmp=""
_lane_passed_total=0
# Set true as the literal LAST statement of this script: the EXIT trap cannot
# tell "finished" from "died partway" out of the pending status alone. Why not
# -- see lane_emit_verdict, which owns that story.
_lane_finished=false
cleanup() {
  # Captured FIRST, before any other command: `$?` reflects only the most
  # recent command, and the `rm` below would otherwise clobber it before
  # lane_emit_verdict ever saw the real value.
  local exit_status=$?
  # `|| true`: cleanup is best-effort, and must never be able to stop
  # lane_emit_verdict from running -- see the matching comment in
  # scripts/test-fast.
  [[ -n "${_lane_output_tmp}" ]] && { rm -f "${_lane_output_tmp}" 2>/dev/null || true; }
  lane_emit_verdict test-merge "${exit_status}"
}
trap cleanup EXIT

pytest_bin="$(resolve_lane_tool test-merge pytest PYTEST)" || exit 1
mypy_bin="$(resolve_lane_tool test-merge mypy MYPY)" || exit 1

# issue #1910: no local lane ran mypy at all, so a new unbaselined package
# could get full strictness while the rest of the tree rode the lenient
# baseline, with type errors surfacing only at CI's py3.13 gate. Bare
# invocation, deliberately no flags: config (python_version, the
# `files = ["jasper"]` scope, and per-module baseline overrides) comes
# entirely from pyproject.toml's [tool.mypy] table, mirroring CI's own mypy
# step. `set -e` with no `if`/`&&` guard means a nonzero exit here aborts the
# script immediately -- pytest never starts, and the EXIT trap above still
# prints the lane's `==> test-merge: FAILED` sentinel as the true last line.
echo "==> mypy (lenient baseline; config from pyproject.toml)"
"${mypy_bin}"

export JASPER_VOICE_PROVIDER="${JASPER_VOICE_PROVIDER:-gemini}"

_lane_output_tmp="$(mktemp "${TMPDIR:-/tmp}/jts-test-merge-output.XXXXXX")"

# Not `exec`: the lane needs to run back after pytest to print the verdict
# sentinel, so it can no longer replace the shell process outright. A failing
# pipeline still aborts here under `set -e` (pipefail is on) with pytest's own
# exit code -- there is nothing to do differently on failure that `cleanup`
# doesn't already handle, so there is no `set +e`/capture dance to write.
lane_pipe_pytest "${_lane_output_tmp}" \
  "${pytest_bin}" -q --tb=short --ignore=tests/voice_eval -n 4 "$@"
_lane_passed_total="$(lane_extract_passed_count "${_lane_output_tmp}")"

# LAST statement, deliberately: everything the lane promises has now run, so
# the EXIT trap may print a verdict rather than INTERRUPTED. Keep it last.
_lane_finished=true
