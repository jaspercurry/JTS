#!/usr/bin/env bash

# SPDX-FileCopyrightText: 2026 Jasper Curry
#
# SPDX-License-Identifier: Apache-2.0

# Switch this checkout's active speaker without re-onboarding.
#
# Updates .env.local + CLAUDE.local.md to point at a different host.
# Doesn't ssh, doesn't run install.sh, doesn't add to ~/.ssh/config.
# Pure state-flip; like `kubectl config use-context`.
#
# Usage:
#   bash scripts/use jts2.local           # switch to jts2
#   bash scripts/use jts.local            # switch back
#   bash scripts/use kitchen.local jasper # override user
#   bash scripts/use 192.168.1.42 pi jts.local
#
# Prerequisite: the target must already be onboarded (the SSH alias
# in ~/.ssh/config has to exist). If it doesn't, run:
#   bash scripts/onboard.sh <hostname>
# That writes the alias + the state files + runs install.sh.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=_lib.sh
JTS_LIB_TARGET_OPTIONAL=1 . "${SCRIPT_DIR}/_lib.sh"  # the target is this script's argument, not _lib.sh's

HOST="${1:-}"
USR="${2:-pi}"
SPEAKER_HOSTNAME_ARG="${3:-}"

if [[ -z "$HOST" ]]; then
    echo "use: hostname required" >&2
    echo "     usage: bash scripts/use <ssh-target> [user] [speaker-hostname]" >&2
    echo "     example: bash scripts/use jts2.local" >&2
    exit 2
fi

# Alias derivation matches onboard.sh: hostname → strip .local suffix;
# raw IP → no alias (user falls back to ssh user@ip).
if is_ipv4_host "$HOST"; then
    ALIAS=""
else
    ALIAS="${HOST%%.*}"
fi

SPEAKER_HOSTNAME=""
if [[ -n "$SPEAKER_HOSTNAME_ARG" ]]; then
    if ! SPEAKER_HOSTNAME="$(normalize_speaker_hostname "$SPEAKER_HOSTNAME_ARG")"; then
        echo "use: speaker-hostname must be a hostname, not an IP: ${SPEAKER_HOSTNAME_ARG}" >&2
        exit 2
    fi
fi

ENV_LOCAL="${REPO_ROOT}/.env.local"
env_local_value() {
    { grep -E "^$1=" "$ENV_LOCAL" 2>/dev/null || true; } | tail -n1 | cut -d= -f2- | tr -d '[:space:]'
}
named_speaker() { printf '%s %s\n' "$(env_local_value PI_HOST)" "$(env_local_value JASPER_HOSTNAME)"; }
OLD_SPEAKER="$(named_speaker)"
OLD_PEER_ID="$(env_local_value PI_PEER_ID)"

write_laptop_state "$HOST" "$USR" "$ALIAS" "$SPEAKER_HOSTNAME"

if [[ -n "$ALIAS" ]]; then
    echo "==> active: ssh ${ALIAS}  (${USR}@${HOST})"
else
    echo "==> active: ssh ${USR}@${HOST}"
fi
if [[ -n "$SPEAKER_HOSTNAME" ]]; then
    echo "    speaker hostname: ${SPEAKER_HOSTNAME}"
fi
if [[ -n "$OLD_PEER_ID" ]]; then
    # The record describes the speaker the file names (_lib.sh verify_or_record_peer_id).
    if [[ "$(named_speaker)" == "$OLD_SPEAKER" ]]; then
        printf 'PI_PEER_ID=%s\n' "$OLD_PEER_ID" >> "$ENV_LOCAL"
        echo "    speaker identity: kept (same speaker)"
    else
        echo "    speaker identity: cleared (new speaker; the next deploy records it)"
    fi
fi
echo "    .env.local + CLAUDE.local.md updated"
