__pycache__/
*.py[cod]
*.egg-info/
# No trailing slash — agent worktrees symlink the main checkout's
# .venv in (no .venv of their own), and a trailing slash only matches
# a directory, not a symlink of the same name (bit for real, PR #2740).
.venv
# Slash kept: this repo's venv is .venv; no `venv` symlink has been seen.
venv/
.env
.env.*
!.env.example
# .env.local for laptop-side voice-eval — gitignored to keep
# API keys out of the repo. See tests/voice_eval/README.md.
.env.local
.pytest_cache/
.ruff_cache/
# scripts/test-merge runs mypy, which writes this cache into the repo root —
# the sibling of the two above, and the one that was missing (a `git add -A`
# after a merge-lane run otherwise stages ~48 cache files).
.mypy_cache/
# Local multi-agent worktrees are disposable orchestration state, not source.
.worktrees/
build/
dist/
target/
*.onnx
*.tflite
.vscode/
.idea/
.DS_Store
# Pi log fetches — never commit log dumps (may contain transient
# state / device serial numbers etc.)
logs/*
!logs/.gitkeep

# Local measurement and diagnostic captures — large/private binaries.
# No trailing slash — same symlink reason as .venv above.
captures

# Voice-eval harness artifacts:
# - audio_cache/: OpenAI TTS-synthesized prompt WAVs (regenerate
#   from text on first run, cached by sha256 — no need to ship)
# - transcripts_out/: per-trial markdown + response WAV. Run-local.
# - traces_out/: per-trial JSONL traces. Run-local.
tests/voice_eval/audio_cache/*
!tests/voice_eval/audio_cache/.gitkeep
tests/voice_eval/transcripts_out/*
!tests/voice_eval/transcripts_out/.gitkeep
tests/voice_eval/traces_out/*
!tests/voice_eval/traces_out/.gitkeep
wake-events/

# Per-session scratch and WIP files used by Claude Code agents.
# Use `.claude/*` not `.claude/` so re-include below actually works —
# git can't un-ignore a file inside a fully-ignored parent directory.
.claude/*
# Slash commands ARE checked in — they're how users invoke flows
# like /onboard-pi.
!.claude/commands/
!.claude/commands/**
# Agent definitions, if added, should be tracked too — same unignore
# pattern as .claude/commands/ above, so a first-class subagent type is
# launchable rather than silently gitignored.
!.claude/agents/
!.claude/agents/**
# Skills, same reason: an untracked skill can't load for anyone else.
!.claude/skills/
!.claude/skills/**

# Per-laptop active-Pi marker, written by scripts/onboard.sh. Loaded
# into Claude Code's context via CLAUDE.md's @-import directive.
CLAUDE.local.md

# Reference voice recordings (whisper/yell/music/fast/slow) used as
# the stable A/B baseline for AEC engine + wake-word model swaps.
# User-specific audio; never ship to the repo.
reference-conditions/

# AEC3 v2.1 deep-tune spike — locally-built pybind11 extension
experiments/aec3-v2-deep-tune-spike/*.so
experiments/aec3-v2-deep-tune-spike/*.dylib

# S0-sync de-risk bench run artifacts (soak logs + acoustic WAVs) —
# large/throwaway, regenerate via scripts/s0-sync-bench.sh. The harness
# itself is tracked; only its captured run output is ignored.
s0-sync-bench/

# P0 multi-room feasibility-spike run output — machine/device-specific
# Wi-Fi and Ethernet-reference stats, budgets, and captures. Regenerate with
# scripts/multiroom-spike.sh; the harness and analyzer remain tracked.
/multiroom-spike/
/multiroom-spike-ethernet-reference/
