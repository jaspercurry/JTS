# =========================================================================
# .env.example is the install-time template for /etc/jasper/jasper.env
# (Pi-side config). install.sh copies it to that path during deploy.
# Settings here are NOT loaded by laptop-side scripts in scripts/.
# Any literal here that shadows a jasper.config.Config default must stay
# value-equal to that code default; tests/test_env_example_matches_config_defaults.py
# pins that contract so fresh-install seeds do not silently drift from runtime.
#
# For LAPTOP-side settings (which Pi to target, which SSH user), edit
# `.env.local` at the repo root — it's gitignored and auto-written by
# `bash scripts/onboard.sh <hostname>`. The two vars `scripts/_lib.sh`
# recognizes there are:
#
#   PI_HOST=jts.local    # default. Set per-checkout for multi-Pi
#   PI_USER=pi
#
# Multi-Pi: a second checkout (or worktree) targeting jts2.local has
# its own .env.local with PI_HOST=jts2.local. See QUICKSTART.md.
# =========================================================================

# ---- Voice provider — JASPER_VOICE_PROVIDER is wizard-owned, NOT set here
# (http://${JASPER_HOSTNAME}/voice writes /var/lib/jasper/voice_provider.env;
# a template default here would drift from runtime — for a non-interactive
# default, write voice_provider.env directly). Use
# scripts/switch-voice-provider.sh to flip it without a manual restart. ----

# ---- Gemini Live --------------------------------------------------------
GEMINI_API_KEY=
# Live API model; fallback gemini-2.5-flash-native-audio-preview-12-2025 via scripts/switch-gemini-model.sh 2.5 if 3.1 Live silently fails (0-token sessions, no exception). See CLAUDE.md "Gemini model switching".
JASPER_GEMINI_MODEL=gemini-3.1-flash-live-preview
# TTS voice; choices: Aoede, Charon, Fenrir, Kore, Puck, Leda, Orus, Zephyr.
JASPER_GEMINI_VOICE=Aoede

# ---- OpenAI Realtime ----------------------------------------------------
# gpt-realtime-2: reasoning-capable, 128K context; ~$0.30/min (~5x Gemini Live). Lighter: gpt-realtime-mini. Voices: marin (default), cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse.
OPENAI_API_KEY=
JASPER_OPENAI_MODEL=gpt-realtime-2
JASPER_OPENAI_VOICE=marin
# Reasoning effort: minimal|low|medium|high|xhigh; silently dropped on non-`-2` models.
JASPER_OPENAI_REASONING_EFFORT=low
# Input noise reduction: auto|off|near_field|far_field; auto derives from the active audio input contract.
JASPER_OPENAI_NOISE_REDUCTION=auto
# Seconds to retry the initial WebSocket connect at daemon startup before exiting non-zero for systemd restart; 0 = single attempt (auth/config errors always propagate immediately).
JASPER_OPENAI_INITIAL_CONNECT_BUDGET_SEC=600

# ---- xAI Grok Voice Agent -----------------------------------------------
# grok-voice-think-fast-1.0, OpenAI-Realtime-protocol-compatible; bills flat $3/hour (not token-based — JASPER_DAILY_SPEND_CAP_USD under-counts, daemon warns at startup). Voices: eve (default), ara, rex, sal, leo.
XAI_API_KEY=
JASPER_GROK_MODEL=grok-voice-think-fast-1.0
JASPER_GROK_VOICE=eve

# Active wake-word model: a bundled openWakeWord name (alexa, hey_jarvis, hey_mycroft) or an absolute .onnx path under /var/lib/jasper/wake/. Wizard-owned (http://${JASPER_HOSTNAME}/wake/, scripts/switch-wake-word.sh write /var/lib/jasper/wake_model.env, which overrides this). Registry: jasper/wake_models.py.
JASPER_WAKE_MODEL=hey_jarvis
# openWakeWord confidence threshold (0-1); raise toward 0.40 if music false-fires, lower toward 0.20 if wakes are missed.
JASPER_WAKE_THRESHOLD=0.30
# Per-event WAV storage cap (bytes) at /var/lib/jasper/wake-events/; rolls oldest-first when full, DB rows kept forever. 128 MiB ≈ 230 events (3 WAVs/event) ≈ 4-8 days.
JASPER_WAKE_EVENTS_MAX_AUDIO_BYTES=134217728
# ---- jasper-doctor ------------------------------------------------------
# Max concurrent doctor checks; clamped 1..16.
JASPER_DOCTOR_MAX_CONCURRENCY=8
# Outer per-check timeout (seconds); above the 5-10s subprocess/socket timeouts individual checks already own. Keep this above the low-level probe timeouts.
JASPER_DOCTOR_CHECK_TIMEOUT_SECONDS=15
# ---- Voice tool catalog (/tools/ wizard) --------------------------------
# Comma-separated tool names off in the /tools/ wizard; wizard-owned in /var/lib/jasper/tool_state.env, not here. Missing/malformed file = all tools on (fail toward more functionality).
# JASPER_DISABLED_TOOLS=
# Mic source for jasper-voice; reconciler-owned for standard choices (Array or udp:<port>), hand-set only to bypass that. PortAudio device (substring match, e.g. Array = XVF3800 processed channel, UMIK-2) or udp:<port>/udp://<host>:<port> (paired with jasper-aec-bridge, enables software AEC).
JASPER_MIC_DEVICE=Array
# Push-to-talk mics that bypass wake detection while a hardware button is held. Format: source_id=device, comma-separated; empty unless a reconciler/operator activated one (e.g. wiim_remote_2=udp:9892).
JASPER_MANUAL_MIC_SOURCES=
# AEC reconciler's published "does this speaker have its own mic": 1, 0, or unknown. Deliberately unseeded (a frozen literal would outrank the reconciler); absent = unknown. Do not set by hand.
# JASPER_LOCAL_MIC_PRESENT=
# AEC reconciler runtime outputs: JASPER_AEC_MIC_DEVICE is the concrete PortAudio/ALSA capture card (reconciler-owned under JASPER_AUDIO_INPUT_PROFILE=auto/xvf_chip_aec/xvf_software_aec3/direct_mic; use `custom` to hand-pin). JASPER_MIC_DEVICE_CANDIDATES is the direct-mic fallback list (comma-separated card/device names).
JASPER_AEC_MIC_DEVICE=Array
JASPER_MIC_DEVICE_CANDIDATES=Array,L16K6Ch
# Smaller XVF input buffer request: unset (default) | `low` | seconds in (0, 0.25]. Keep unset unless an on-device A/B run proves lower latency with no stalls; bridge logs event=aec.mic_stream_latency.
# JASPER_AEC_CAPTURE_LATENCY=
# Read-only XVF geometry/profile facts the AEC reconciler derives via jasper-xvf-profile; do not hand-edit. Legacy square/circular firmware -> geometry=square; Flex LINEAR-4 -> geometry=linear (no production chip beam plan yet).
# JASPER_XVF_VARIANT=
# JASPER_XVF_GEOMETRY=
# JASPER_XVF_CHIP_BEAM_PLAN=
# JASPER_XVF_CHIP_AEC_SUPPORTED=0
# Read-only chip-AEC DAC gate facts the AEC reconciler derives from the active output DAC + outputd clock evidence; do not hand-edit. DAC_STATUS: approved|testing|needs_calibration. TESTING_REQUESTED records an explicit operator request; DAC_ID/DAC_SOURCE/DAC_DETAIL record which DAC the gate was resolved against.
# JASPER_AEC_CHIP_AEC_TESTING_REQUESTED=0
# JASPER_AEC_CHIP_AEC_DAC_ID=unknown
# JASPER_AEC_CHIP_AEC_DAC_STATUS=needs_calibration
# JASPER_AEC_CHIP_AEC_DAC_SOURCE=
# JASPER_AEC_CHIP_AEC_DAC_DETAIL=
# JASPER_AEC_MODE lives in /var/lib/jasper/aec_mode.env, not here: auto (default) | disabled.
#
# JASPER_AUDIO_INPUT_PROFILE and the wake-leg booleans (JASPER_WAKE_LEG_RAW,
# JASPER_WAKE_LEG_DTLN, JASPER_WAKE_LEG_CHIP_AEC, JASPER_WAKE_LEG_CHIP_AEC_150,
# JASPER_WAKE_LEG_CHIP_AEC_210) also live in aec_mode.env, written by /wake/.
# Defaults: RAW=1, DTLN=0, CHIP_AEC_150=0, CHIP_AEC_210=0. The reconciler maps
# them each pass to JASPER_MIC_DEVICE_RAW, JASPER_MIC_DEVICE_DTLN,
# JASPER_AEC_DTLN_ENABLED, JASPER_MIC_DEVICE_CHIP_AEC_150,
# JASPER_MIC_DEVICE_CHIP_AEC_210, and JASPER_AEC_CHIP_AEC_ENABLED in this
# file — do not set those directly; a hand-set value is overwritten every
# reconcile pass.
# Bridge<->voice-daemon UDP wiring for AEC'd mic; jasper-voice listens on JASPER_MIC_DEVICE=udp:<port>. Loopback-only; change only if 9876 collides.
JASPER_AEC_UDP_HOST=127.0.0.1
JASPER_AEC_UDP_PORT=9876
# ---- Software-AEC tuning knobs -----------------------------------------
# "Software AEC3 tuning" table ---------------------------------------------
# Ref-signal gain (dB) into the AEC engine; positive values risk ref clipping.
JASPER_AEC_REF_GAIN_DB=0
# Post-AEC noise suppression: NS_ENABLED 0/1; NS_LEVEL low|moderate|high|very_high.
JASPER_AEC_NS_ENABLED=1
JASPER_AEC_NS_LEVEL=low
# WebRTC AGC1 (kAdaptiveDigital): ENABLED 0/1; TARGET_DBFS 0-31 (dBFS-below-zero); MAX_GAIN_DB 0-90 (compression_gain_db, not a hard ceiling).
JASPER_AEC_AGC1_ENABLED=1
JASPER_AEC_AGC1_TARGET_DBFS=9
JASPER_AEC_AGC1_MAX_GAIN_DB=18
# WebRTC AGC2; no-op on this binding (adaptive_digital sub-config is off) — kept for compat, use AGC1.
JASPER_AEC_AGC2=0
# JASPER_AEC_BINDING: auto (verify+prefer v2/BEST_A, default) | v2 (prefer, same gate) | v1 (force legacy). Rollback knob; deliberately unset here.
# Static gain (dB) applied to AEC engine output before openWakeWord; soft-clipped via tanh.
JASPER_AEC_MIC_GAIN_DB=6
# Cleaned USB-mic export stream: `primary` (follows voice's AEC output/beam, default) or a published chip-beam leg token (e.g. chip_aec_150); stale/unavailable legs fall back safely.
JASPER_USB_MIC_LEG=primary
# Consecutive-empty-second threshold before the bridge bails non-zero for systemd restart; 0 = disabled (log forever).
JASPER_AEC_STALL_RESTART_SEC=5
# Consecutive low-rate ~10s windows (rolling frame-rate check) before the same bail, catching a slow-drip stall the empty-second counter misses; 0 = disabled.
JASPER_AEC_STALL_DRIP_MAX_WINDOWS=3
# PortAudio capture rate/channels (UDP transport is always 16 kHz mono, unaffected). XVF chip raw: 16000/6ch (use Array + ch=6 to bypass the bridge). UMIK-2 etc.: 48000/2.
JASPER_MIC_CAPTURE_RATE=16000
JASPER_MIC_CAPTURE_CHANNELS=1
# TTS IPC transport to jasper-fanin (48 kHz stereo PCM + gain metadata, pre-DSP). `outputd` is the only supported value; `sounddevice` is rejected by Config.validate (no dynamic loudness matching).
JASPER_TTS_TRANSPORT=outputd
JASPER_TTS_OUTPUTD_SOCKET=/run/jasper-fanin/tts.sock
# Legacy sounddevice-only device name; unreachable under the supported outputd transport. Value stays only because test_env_example_matches_config_defaults pins it.
JASPER_TTS_DEVICE=jasper_out
# outputd IPC rate (Hz); TtsPlayout upsamples 24 kHz provider/cue PCM to this (factor 2, exact).
JASPER_TTS_OUTPUT_RATE=48000
# Provider/model/voice loudness profile store; seeds/learns source loudness for final assistant gain.
JASPER_ASSISTANT_LOUDNESS_PROFILE_PATH=/var/lib/jasper/assistant_loudness_profiles.json

# Seconds of program silence before the last qualified music loudness stops being the assistant reference. Recommended range: 60-1800.
JASPER_FANIN_HELD_CONTENT_TTL_SEC=600

# Max drift (dB) of the last achieved quiet-room TTS level from the deterministic speech envelope. Recommended range: 4-12.
JASPER_FANIN_ASSISTANT_ENVELOPE_OFFSET_LIMIT_LU=8
# Off by default (no implicit provider TTS spend on restart); the /voice/ wizard's "Save and Test" runs one bounded seed. Opt into a startup seed with JASPER_ASSISTANT_LOUDNESS_AUTO_SEED=1.
# Assistant loudness policy; consumed by fan-in (packaged pre-DSP TTS path) and by outputd only in rollback/lab IPC mode. Retune in /var/lib/jasper/fanin.env, not here.
JASPER_OUTPUTD_ASSISTANT_OFFSET_LU=1.5
JASPER_OUTPUTD_ASSISTANT_MAX_PEAK_DBFS=-3.0
JASPER_OUTPUTD_ASSISTANT_FALLBACK_SOURCE_LUFS=-24.0
JASPER_OUTPUTD_ASSISTANT_FALLBACK_SOURCE_PEAK_DBFS=-6.0
JASPER_FANIN_ASSISTANT_DEFAULT_TTS_ENVELOPE_LUFS=-41.0

# Last achieved assistant speaker loudness, so a no-music restart resumes at the user's last heard level; separate from speaker_volume.json (fan-in is sole writer, updates only after assistant speech materially changes the reference).
JASPER_FANIN_ASSISTANT_REFERENCE_PATH=/var/lib/jasper/assistant_volume_reference.json
JASPER_OUTPUTD_CONTENT_SILENCE_LUFS=-60.0
# CamillaDSP websocket (ducking, gain reads, content-activity telemetry); loopback-only, no auth. Change the port only if 1234 collides.
JASPER_CAMILLA_HOST=127.0.0.1
JASPER_CAMILLA_PORT=1234
# camilla#2: the per-driver endpoint-crossover instance on an active-leader box; dormant until jasper-camilla-crossover.service is armed, never runs on an ordinary speaker. Loopback, no auth; port 1235 avoids colliding with camilla#1. Statefile is camilla#2's own persisted config, separate from camilla#1's; install.sh seeds a tweeter-safe baseline.
JASPER_CAMILLA2_HOST=127.0.0.1
JASPER_CAMILLA2_PORT=1235
JASPER_CAMILLA2_STATEFILE=/var/lib/camilladsp/crossover-statefile.yml
# CamillaDSP chunksize/target_level for generated loopback/correction/active-speaker configs (the ring-coupled graph has its own fixed geometry). Leave UNSET unless deliberately tuning latency with a zero-xrun soak; malformed/zero/negative falls back to default. Positive integers, powers of two conventional. Shipped loopback defaults: chunksize 1024 (~21ms), target 2048 (~43ms) @ 48kHz — validated safe on a 1GB Pi 5. Apply by regenerating the active config.
# JASPER_CAMILLA_CHUNKSIZE=1024
# JASPER_CAMILLA_TARGET_LEVEL=2048
# Audio route profile: `corrected_48k` (default, safe — all sources through CamillaDSP, outputd sole DAC owner) or `usb_low_latency_48k` (fixed 48kHz, fan-in direct UAC2 capture + resampler, doctor-gated route-latency artifact p95<=40ms/p99<=60ms). `bitperfect_passthrough_declared` is a declared-future contract only, inactive. Apply via jasper-audio-hardware-reconcile.
JASPER_AUDIO_ROUTE_PROFILE=corrected_48k
# Music attenuation (dB) while the model is listening/speaking; -25 balances audibility against wake-word pickup. Applied in fan-in so TTS itself isn't ducked.
JASPER_DUCK_DB=-25
JASPER_DUCK_TRANSPORT=fanin
# Shallower duck (dB, <=0) for a standalone quick cue (mute sparkle, wake/end chirps) vs a full conversation; 0 = no duck for these cues. Only the segment-driven auto-duck path uses it.
JASPER_FANIN_TTS_CUE_DUCK_DB=-6
# Duck attack/release glide time (ms), avoiding the click/pump of a hard step. Attack range 1..200, release 1..2000.
JASPER_FANIN_TTS_DUCK_ATTACK_MS=15
JASPER_FANIN_TTS_DUCK_RELEASE_MS=150
# Pre-response idle watchdog (seconds): after activity_end with zero audio/server activity, close the turn and un-duck. Separate from the hardcoded 5s NO_SPEECH_ABORT_SEC. Tool dispatches/server events reset the anchor.
JASPER_IDLE_TIMEOUT_SEC=20
# Response-stall watchdog (seconds): last-resort turn close if a provider wedges mid-response with no new output chunk and no turn_complete.
JASPER_RESPONSE_STALL_TIMEOUT_SEC=120
# jasper-control HTTP surface (management/accessories/automation); no auth, home network only. Its port is fixed at 8780 (jasper/control/client.py CONTROL_PORT), shared by the Avahi advert, nginx and every peer URL.
#
# JASPER_CONTROL_HOST (server bind) defaults to 0.0.0.0 in code; deliberately
# NOT seeded here — a frozen literal would shadow future code defaults, and
# `Host: 0.0.0.0` is rejected by the management-host guard when misread as a
# connect host. jasper.control.client maps unspecified bind to 127.0.0.1.
# Uncomment only to bind elsewhere (e.g. 127.0.0.1 to hide from the LAN).
# JASPER_CONTROL_HOST=0.0.0.0
# Extra comma-separated local Host/Origin aliases jasper-control should accept beyond localhost/loopback/private-IP/JASPER_HOSTNAME/this host.
JASPER_MANAGEMENT_ALLOWED_HOSTS=
JASPER_CONTROL_MAX_POST_BYTES=4096
# Mandatory invisible control-token gate (SECURITY.md): protects high-impact mutations (power/reboot/mic-mute/grouping) from drive-by/CSRF/casual curl. jasper-control auto-generates it; the management UI delivers it behind the read guard. JASPER_CONTROL_TOKEN_FILE overrides the token path (default /var/lib/jasper/control_token, mode 0640 group jasper) — set only for tests/headless imaging. The token value itself is never in env.
# JASPER_CONTROL_TOKEN_FILE=/var/lib/jasper/control_token
# Household credential for cross-speaker control: one secret per household, minted at bonding (/rooms/), presented as X-JTS-Household. Not seeded (absence = not yet paired). JASPER_HOUSEHOLD_SECRET_FILE overrides the path (default /var/lib/jasper/household_secret, mode 0640 group jasper) — set only for tests/headless imaging. The secret itself is never in env.
# JASPER_HOUSEHOLD_SECRET_FILE=/var/lib/jasper/household_secret
# Unix socket for external session triggers (e.g. WiiM Remote 2 via jasper-control); lives in /run, systemd-cleaned at stop.
JASPER_VOICE_CONTROL_SOCKET=/run/jasper/voice.sock
# Idle context reset: OFF (0) by default — persistent session context grows unbounded only up to provider limits (OpenAI: 128K/60min). Set e.g. 21600 (6h) only if you see stale-context glitches; each reset costs ~$0.008 (OpenAI cache bust) and blocks the wake event 1-6s. Per-provider; JASPER_LIVE_CONTEXT_RESET_SEC (legacy) supplies a global default when a specific var is unset.
JASPER_OPENAI_CONTEXT_RESET_SEC=0
JASPER_GEMINI_CONTEXT_RESET_SEC=0
JASPER_GROK_CONTEXT_RESET_SEC=0
# Silero speech-probability threshold (0-1) for in-session barge-in during assistant speech; 0.5 = Silero default, raise toward 0.7 if TTS/music bleed trips it. Barge-in is OFF by default, enabled per-provider via JASPER_BARGE_IN_<PROVIDER>=1 (e.g. JASPER_BARGE_IN_GEMINI=1) in the wizard-owned /var/lib/jasper/voice_provider.env; ignored on a direct_mic profile (no AEC reference).
JASPER_VAD_BARGE_IN_THRESHOLD=0.5

# Server-side VAD experiment (OpenAI/Grok only): switches end-of-utterance detection to server_vad while music plays. Default OFF — local Silero wins production A/B. create_response/interrupt_response stay false regardless.
JASPER_SERVER_VAD_ENABLED=0
JASPER_SERVER_VAD_THRESHOLD=0.5
JASPER_SERVER_VAD_SILENCE_MS=350
JASPER_SERVER_VAD_PREFIX_MS=300

# Daily voice-API spend ceiling (USD); crossing it refuses new turns + plays spend_cap_reached. Cost estimated per jasper/usage.py (token-billed: Gemini/OpenAI; time-billed: Grok $3/hr). 0 disables the cap.
JASPER_DAILY_SPEND_CAP_USD=1.00
# Safety multiplier (>=1.0) the spend cap applies to rolling-24h spend before comparing to the ceiling; does not affect the displayed spend-card estimate. 1.25 default trips at ~80% of ceiling.
JASPER_DAILY_SPEND_CAP_SAFETY_MULTIPLIER=1.25
# SQLite usage-tracking DB (session token counts + time-billed uptime intervals); survives deploys under /var/lib/jasper.
JASPER_USAGE_DB=/var/lib/jasper/usage.db

# Conversation-history capture: default-off opt-in; skipped during mic mute; reviewable/clearable at /chat/.
JASPER_CONVERSATION_CAPTURE=0
# SQLite file for opt-in conversation-history turns; lives under /var/lib/jasper so it survives deploys.
JASPER_CONVERSATION_HISTORY_DB=/var/lib/jasper/conversation_history.db
# Max age (days) for saved conversation-history turns; code default 30 (conversation_history.DEFAULT_RETENTION_DAYS). Blank/0 disables age pruning.
#JASPER_CONVERSATION_HISTORY_RETENTION_DAYS=30
# Max row count for saved conversation-history turns; code default 500 (conversation_history.DEFAULT_RETENTION_MAX_ROWS). Blank/0 disables row pruning.
#JASPER_CONVERSATION_HISTORY_MAX_ROWS=500

# SQLite store for async research jobs, so a finished-but-unannounced report survives a restart and gets re-announced.
JASPER_RESEARCH_DB=/var/lib/jasper/research_jobs.db
# Per-job wall-clock ceiling (seconds); timed-out jobs are marked failed and best-effort cancelled server-side.
JASPER_RESEARCH_MAX_RUNTIME_SEC=300
# Max simultaneous research jobs; both slots busy declines immediately with a speakable retry message.
JASPER_RESEARCH_CONCURRENCY=2
# Hard character cap for a stored/spoken research answer (model is prompted for <30s reports; this is the drift backstop).
JASPER_RESEARCH_MAX_RESULT_CHARS=600
# Terminal (done/failed) research jobs retained in SQLite + memory; RUNNING jobs are never pruned. 0 keeps none past announcement.
JASPER_RESEARCH_RETENTION=200
# Research text model override; code default gpt-5.4. Any override must have a matching row in jasper/data/model_pricing.json or /var/lib/jasper/pricing.json (else cost records as $0, logged event=pricing.unpriced).
# JASPER_RESEARCH_OPENAI_MODEL=gpt-5.4

# P6 tuning assistant (/correction/ "explain my room" + confirm-gated proposer); OpenAI-only, reuses the OpenAI voice key from jasper-secrets. Hidden with a nudge (never broken) when the household is on Gemini/Grok. Model must be reasoning-capable GPT-5-class (a non-reasoning id fails at call time); code default gpt-5.4.
# JASPER_TUNING_LLM_MODEL=gpt-5.4
# Per-tap HTTP timeout (seconds) for a tuning interpret/propose call; only ever fired by an explicit user tap, never polled.
# JASPER_TUNING_LLM_TIMEOUT_SEC=90

# Optional JSON pricing overlay (default rates built into jasper/data/model_pricing.json). Keys are exact model IDs; inner keys are Pricing fields, e.g. {"models": {"<model-id>": {"audio_input_per_million_usd": 3.0}}}. Missing/malformed file falls back to built-in rates (fail-soft, logged).
JASPER_PRICING_FILE=/var/lib/jasper/pricing.json

# Speaker's mDNS hostname (single source of truth for JASPER_MANAGEMENT_URL / JASPER_SPOTIFY_SETUP_URL defaults and scripts/'s PI_HOST fallback). install.sh auto-derives this from the OS hostname on fresh installs; deploy-to-pi.sh passes it explicitly (highest precedence).
JASPER_HOSTNAME=jts.local

# Spotify Web API multi-account routing; PKCE auth (no client secret). Paste the Client ID at http://${JASPER_HOSTNAME}/spotify, which writes /var/lib/jasper-intsecrets/spotify_credentials.env.
# Redirect URI defaults to the hosted GitHub Pages bounce page (jaspercurry/spotify-oauth-callback), which reads `?host=` to bounce back to any speaker. Override to http://127.0.0.1:8888/callback for manual paste-back. Leave unset for the default — an EMPTY assignment here is a real systemd override that suppresses it.
# SPOTIFY_REDIRECT_URI=
# Legacy single-account spotipy cache path, kept only to migrate pre-multi-account tokens; new per-account OAuth tokens live under /var/lib/jasper-intsecrets/spotify/caches. Leave default unless migrating a custom legacy cache.
SPOTIFY_CACHE_PATH=/var/lib/jasper-intsecrets/.spotify-cache
# Speaker display name: wizard-owned at http://${JASPER_HOSTNAME}/speaker/, persisted in /var/lib/jasper/speaker_name.env as JASPER_SPEAKER_NAME. Defaults to "JTS"; feeds Spotify Connect, AirPlay, Bluetooth, USB Audio.
# Default location for bare get_weather queries: wizard-owned at http://jts.local/weather/, persisted in /var/lib/jasper/weather.env. Set a geocodable fallback here for headless/CI installs; the wizard migrates it out on deploy.
JASPER_DEFAULT_LOCATION=
# Optional lat/lon that skips geocoding for bare weather queries (Open-Meteo forecast direct); DISPLAY_NAME is what the voice prompt sees.
JASPER_WEATHER_LAT=
JASPER_WEATHER_LON=
JASPER_WEATHER_DISPLAY_NAME=
# get_weather temperature units: celsius (default) | fahrenheit; invalid values fall back to celsius. Also wizard-owned.
JASPER_WEATHER_UNITS=celsius
# NYC subway/bus/Citi Bike: configured via the wizard at http://jts.local/transit/ (geocode, pick nearby stops, save). Wizard owns /var/lib/jasper/transit.env; never put transit vars in jasper.env directly.
#
# Schema there (for reference; you shouldn't edit by hand): JASPER_SUBWAY_STATION_ID
# (e.g. B12), JASPER_SUBWAY_DEFAULT_DIRECTION (uptown/downtown/""=both),
# JASPER_MTA_BUSTIME_KEY (free key, bustime.mta.info/wiki/Developers/Index,
# ~30min approval), JASPER_BUS_STOPS ("id|label,id|label", both directions =
# two entries), JASPER_CITIBIKE_STATIONS ("id|label,id|label", GBFS UUIDs from
# gbfs.citibikenyc.com, keyless), JASPER_CITIBIKE_EBIKE_ONLY (1 = suppress
# classic-bike counts).
#
# Google Routes ETA/directions share the /transit/ page (uses the saved speaker
# location as origin). The billable key's canonical file is
# /var/lib/jasper-secrets/google_routes.env as GOOGLE_ROUTES_API_KEY; this
# empty placeholder just documents the name.
GOOGLE_ROUTES_API_KEY=
# Household default travel mode for "how long to get to..." when unspoken: transit|drive|walk|bicycle. Wizard-owned in transit.env; "drive to"/"walk to" override per call.
JASPER_TRAVEL_DEFAULT_MODE=transit

# ---- Advanced escape hatches (none assigned — code defaults are right
#      for every install; set one here only while diagnosing the specific
#      behaviour it gates, and remove it after) -----------------------------
# JASPER_MUX_SPOTIFY_PREEMPT_RESTART=disabled: revert Spotify preemption to Web-API-pause-only, mix-on-failure.
# JASPER_AIRPLAY_METADATA_GATE=disabled: revert airplay_playing() to MPRIS PlaybackStatus alone, no metadata corroboration.
# JASPER_USBSINK_PREEMPT=disabled: turn off mux's fan-in MUTE/UNMUTE preemption for USB (it then mixes briefly like Bluetooth). Restart jasper-control after editing.
# All three: exact literal `disabled` (case-insensitive) only; any other value logs a warning and stays enabled.

# ---- USB management network (composite gadget) ---------------------------
# Kill switch for the always-on USB management NCM link (laptop on the USB-C port reaches http://<JASPER_HOSTNAME>/ with no Wi-Fi). No fleet-wide fixed-IP fallback — 10.12.194.1 belongs only to Raspberry Pi Imager's rescue gadget or a preserved legacy migration. On by default; this is the only opt-out (independent of the wizard-toggled uac2.usb0 audio function).
# JASPER_USB_NETWORK=disabled — exact literal `disabled` (case-insensitive) drops ncm.usb0 from the composite gadget; any other value logs a warning and stays enabled, mirroring JASPER_SHAIRPORT_SUPERVISOR / JASPER_SYSTEM_SUPERVISOR. Read directly by deploy/usbsink/jasper-usbgadget-compose.sh, the truth table jasper-usbgadget-{up,wanted,converge} share, not a Python Config field.

# ---- USB Audio Input (jasper-usbsink) ------------------------------------
# On/off switch: http://jts.local/sources/, intent stored in source_intent.env. Fan-in owns hw:UAC2Gadget capture + geometry/clock controls (JASPER_FANIN_USB_DIRECT_* below); jasper-usbsink.service is a process-free readiness marker.
# JASPER_USBSINK_MIXER_CARD (default UAC2Gadget) — kernel short card name for the host-volume observer (amixer -c <name>); change only for nonstandard gadget hardware.

# ---- fan-in output buffer ----
# fan-in's per-lane INPUT rings are WiFi-burst headroom (not a latency lever). The OUTPUT leg is the fan-in -> CamillaDSP SHM ring (ADR-0100), not an ALSA buffer; its depth lever is JASPER_FANIN_RING_SLOTS, documented in the fan-in -> CamillaDSP coupling section below.
#
# Removed: JASPER_FANIN_ADAPTIVE_BUFFER, JASPER_FANIN_ADAPTIVE_SHRUNK_FRAMES — the opt-in adaptive shrink arm, never passed an on-device soak; superseded by the combo flags + SHM-ring coupling below. Nothing reads either key; a stale value in fanin.env is inert.
#
# Removed: JASPER_FANIN_OUTPUT_PCM, JASPER_FANIN_OUTPUT_BUFFER_FRAMES — the ALSA playback device and its buffer, retired with fan-in's output arm (ADR-0100): the program leaves over Ring A, which is sized by JASPER_FANIN_RING_SLOTS and has no ALSA buffer to declare. Nothing reads either key; a stale value in fanin.env is inert.
#
# JASPER_AUDIO_RUNTIME_OVERRIDES_PATH (default /var/lib/jasper/audio_runtime_overrides.json) — path for the expiring lab override artifact used by jasper-audio-config overrides-* and the runtime plan. Leave unset for normal deployments.

# ---- fan-in → CamillaDSP coupling (low-latency endgame) ----
# Local program transport: fan-in -> CamillaDSP -> outputd over the `shm_ring` SHM ring pair (Ring A + Ring B), the one central transport (ADR-0100). Both Rust daemons and jasper.fanin_coupling MUST agree; the reconciler (`jasper-fanin-coupling-reconcile`) is the SINGLE writer of every key in this section — never hand-set them.
#
# JASPER_FANIN_CAMILLA_COUPLING (default unset = the ring) — Ring A transport declaration. Unset, empty and `shm_ring` are all SERVED: the SHM ring is fan-in's only transport toward CamillaDSP (ADR-0100), and empty is how this repo's env writers clear a key. There is NO fail-safe — any other value, a persisted `loopback` above all, is a config-class fault that parks the unit at exit 78 rather than playing over a transport the operator did not ask for. The `--auto` boot pass writes shm_ring.
# JASPER_OUTPUTD_CONTENT_BRIDGE (default `shm_ring`) — outputd's content source. UNDECLARED is the one transport (ADR-0100): Ring B, the coherent partner of Ring A. `direct` still parses so the park refusals can name the retired snd-aloop route a box asked for; a box that resolves it has no transport and parks (a passive composite at #2982, a bonded member at the round-trip lane's own bridge requirement, anything else at the first period). An unrecognized value fails loud (exit 78) at outputd startup — a stale `rate_match` (the removed rate-matched lab bridge) fails loud too, parking with a logged event=outputd.content_bridge.removed_value rather than falling back to `direct`.
# JASPER_FANIN_RING_PATH (default /dev/shm/jts-ring/program.ring) — Ring A SHM file (fan-in writes, CamillaDSP reads via the jts_ring ioplug).
# JASPER_FANIN_RING_SLOTS (default 2, must match the ioplug conf.d `n_slots`) — Ring A slot count; out-of-range fails loud on both sides, neither side clamps.
# JASPER_FANIN_RING_WIRE_FORMAT (default S32_LE) — Ring A wire sample format: S16_LE | S32_LE, matching the ioplug conf.d `format` field and JASPER_OUTPUTD_CONTENT_FORMAT. The single input to the wire-width axis consumed by Rust and jasper.fanin_coupling.resolve_ring_wire_format alike; changing it requires re-running the hardware reconciler before arming. Present-but-unrecognized fails loud on both sides.
# JASPER_OUTPUTD_SHM_RING_PATH (default /dev/shm/jts-ring/content.ring) — Ring B SHM file (CamillaDSP writes, outputd reads).
# JASPER_OUTPUTD_SHM_RING_SLOTS (default 2, range 2..16) — Ring B slot count; out-of-range fails loud, no clamp.
#
# Removed: JASPER_OUTPUTD_CONTENT_BUFFER_FRAMES — outputd's ALSA content-capture buffer, retired with the content lane (ADR-0100): outputd reads Ring B and opens no content PCM, so /state's `content.buffer_frames` is a period-sized synthetic sitting beside the ring's true `content.ring.capacity_frames`. Nothing reads the key; a stale value in outputd.env is inert.
#
# Removed 2026-07-11: JASPER_FANIN_CAMILLA_PIPE, JASPER_OUTPUTD_LOCAL_CONTENT_PIPE,
# JASPER_OUTPUTD_LOCAL_CONTENT_PIPE_BYTES, JASPER_FANIN_CAMILLA_PIPE_BYTES (the deleted
# `transport_pipe` coupling, plus its `ratematch`/`rate-matched`/`rate_matched` spelling
# variants and JASPER_OUTPUTD_CONTENT_BRIDGE_RING_FRAMES / _TARGET_FRAMES /
# _MAX_ADJUST_PPM tuning keys) — all inert; a stale value in outputd.env is swept
# back off on the next reconcile pass. NOTE: a `usb_low_latency_48k` route claim
# still compares the RAW literal, so a box carrying a stale spelling reports an
# honest red claim rather than silently passing.

# ---- USB low-latency combo (P3 default on gadget boxes with USB audio on) ---
# Three fan-in flags in fanin.env that arm together for the certified USB-in low-latency path: JASPER_FANIN_USB_DIRECT (fan-in owns hw:UAC2Gadget capture directly), JASPER_FANIN_HOST_CLOCK (steers the gadget pitch ctl), JASPER_FANIN_RESAMPLER_CUSHION_DECAY (post-lock cushion decay). Each fails safe to OFF; arms only on the literal `enabled` (case-insensitive).
#
# The `--auto` boot/deploy pass arms the combo only when the gadget stack is available (dtoverlay=dwc2,dr_mode=peripheral) AND USB Audio Input is on (jasper-usbsink.service enabled); it writes the explicit off values on a DIRECT-ineligible box, never leaves them unset. The reconciler is the SINGLE writer in fanin.env; turning USB Audio Input off is what disarms the combo.

# ---- USB DIRECT gadget capture geometry (fan-in; lab lever) -------------
# JASPER_FANIN_USB_DIRECT_PERIOD_FRAMES (default 256, range 32..1024) — the gadget capture OPEN period on hw:UAC2Gadget for the USB DIRECT lane; capture buffer derives from it and stays deep (>=3 periods and >=768 frames). Lab lever only (JASPER_FANIN_USB_DIRECT=enabled); out-of-range fails loud at startup.

# ---- Combo-mode host-slaved USB clock (fan-in; default-OFF) -------------
# Fan-in steers the gadget's "Capture Pitch 1000000" ctl when USB DIRECT is armed (the daemon owning the capture owns the pitch ctl).
# JASPER_FANIN_HOST_CLOCK (default unset = disabled) — master opt-in; only the literal `enabled` arms it.
# JASPER_FANIN_HOST_CLOCK_PROBE_PPM (default 300, range 200..800) — per-session compliance probe's commanded pitch step (ppm); out-of-range rejected at startup.

# The Correction-mode probe duration is a fixed 15s (CORRECTION_PROBE_STEP_SECS), not an env knob — no target env either (the setpoint derives from JASPER_FANIN_INPUT_RESAMPLER_TARGET_FRAMES + JASPER_FANIN_INPUT_RESAMPLER_WARMUP_CUSHION_FRAMES).
#
# ---- Post-lock cushion decay (latency lever 1; fan-in; default-OFF) ------
# Decays the acquisition warm-up cushion (JASPER_FANIN_INPUT_RESAMPLER_WARMUP_CUSHION_FRAMES) toward a floor once locked, snapping back to the ceiling the instant lock is lost. Meaningful only with the host-clock DLL armed.
# JASPER_FANIN_RESAMPLER_CUSHION_DECAY (default unset = disabled) — master opt-in; only the literal `enabled` arms it.
# JASPER_FANIN_RESAMPLER_CUSHION_DECAY_FLOOR_FRAMES (default 576, hardware-validated; clamped into [max(target, minimum_safe_fill)+32, acquisition ceiling]) — the held-target floor the decay descends to.
# JASPER_FANIN_RESAMPLER_CUSHION_DECAY_STEP_FRAMES (default 6, range 1..64) — frames dropped from the held target per decay step (~125 ppm demanded rate, 4x headroom under the inner resampler's ±500 ppm authority; see issue #3466).
# JASPER_FANIN_RESAMPLER_CUSHION_DECAY_INTERVAL_MS (default 1000, range 250..10000) — wall interval between decay steps.
# Whenever a resampler is armed (JASPER_FANIN_INPUT_RESAMPLER=enabled, or implied by JASPER_FANIN_USB_DIRECT=enabled), the daemon fails loud at startup unless TARGET_FRAMES + WARMUP_CUSHION_FRAMES >= minimum_safe_fill + period + 32 (a too-small hand-tuned pair reboot-loops the box instead of lock-churning silently).

# ---- Observability ------------------------------------------------------
# JASPER_FLIGHT_RECORDER=disabled opts a daemon OUT of the in-RAM DEBUG flight recorder (dumped to the journal as event=flightrec.dump on anomaly); any other value/unset leaves it on. Deliberately unassigned — on is right everywhere.
#
# JASPER_LOG_JSON switches structured event= lines from logfmt to one JSON object per line. Default (unset/falsy) is logfmt, grep-friendly and journal-standard; set only for a log-shipping pipeline that wants JSON. Truthy: 1/true/yes/on/enabled. Only affects already-migrated log_event emitters.

# ---- Disk-pressure observability ----------------------------------------
# jasper-doctor's check_disk_space warns/fails on root-fs fullness; /state.resilience.disk surfaces live percent-used. The two storage checks below are READ-ONLY warnings (never delete data).
# JASPER_DISK_WARN_PERCENT (default 85) — root-fs %used WARN threshold; the FAIL threshold is a fixed 95% and always takes precedence, so a value <=0 or >=95 snaps back to 85.
# JASPER_CORRECTION_STORAGE_WARN_BYTES (default 536870912 = 512MiB) — total bytes under /var/lib/jasper/correction/sessions/ that trigger a WARN.
# JASPER_WAKE_EVENTS_STORAGE_WARN_BYTES — total bytes under /var/lib/jasper/wake-events/ that trigger a WARN; default is the configured JASPER_WAKE_EVENTS_MAX_AUDIO_BYTES cap plus a fixed 300 MiB DB/overshoot allowance, so a healthy oldest-first ring never warns and a breach means the ring drifted past its cap.
# All three deliberately unset — code defaults are right for every install.

# --- Browser mic capture ---------------------------------------------------
# The measurement pages capture from whatever microphone the household's browser exposes, over the Pi's own HTTPS origin (getUserMedia needs a secure context).
# JASPER_CAPTURE_ALIGNMENT_THRESHOLD — cross-correlation alignment-confidence gate (0..1) below which a capture is rejected as weak/ambiguous. Default 0.40, a conservative v1 placeholder; out-of-range/unparseable falls back to 0.40.
# JASPER_V2_FIRST_BEGIN_TIMEOUT_S — seconds (30..3600) the crossover-v2 flow waits for the household's first "Begin" tap. Default 300. The upper bound is capture_protocol.MAX_TTL_S, the sanity ceiling on a capture session's lifetime: values above 3600 are never honoured. Out-of-range/unparseable falls back to 300.
JASPER_V2_FIRST_BEGIN_TIMEOUT_S=
#
# --- Level-match ramp (P2, jasper.audio_measurement.ramp) ---
# The level-match ramp raises CamillaDSP main_volume from quiet until the reported mic level settles in a safe window, then locks. Every threshold below is a CONSERVATIVE PLACEHOLDER (H1 supplies measured numbers); out-of-range/unparseable falls back to the documented default, and a cross-field-invalid combination is dropped as a whole with a warning. The operative volume ceiling is the lower of original+CAP_BUMP_DB and CAP_CEIL_DB; CamillaDSP's independent 0dB hard clamp and the clipping/feed-liveness/exact-restore guards remain active regardless.
# JASPER_RAMP_WINDOW_LOW_DBFS (range -60..0, default -20) — bottom of the safe mic-level target window.
JASPER_RAMP_WINDOW_LOW_DBFS=
# JASPER_RAMP_WINDOW_HIGH_DBFS (range -60..0, default -12, must be above LOW) — top of the safe mic-level target window.
JASPER_RAMP_WINDOW_HIGH_DBFS=
# JASPER_RAMP_TRUST_MARGIN_DB (range 0..40, default 10) — dB above noise floor before a mic reading is trusted.
JASPER_RAMP_TRUST_MARGIN_DB=
# JASPER_RAMP_SETTLE_HOLD_S (range 0..30s, default 2.0, must be >= max loop latency) — hold time after crossing the pre-window before reading the settled level.
JASPER_RAMP_SETTLE_HOLD_S=
# JASPER_RAMP_MAX_LOOP_LATENCY_S (range 0..30s, default 2.0) — modeled worst-case round trip from a commanded volume change to the mic sample that reflects it; bounds staircase overshoot.
JASPER_RAMP_MAX_LOOP_LATENCY_S=
# JASPER_RAMP_CONFIRM_K (range 2..20, default 3) — consecutive in-window trusted samples required before locking.
JASPER_RAMP_CONFIRM_K=
# JASPER_RAMP_SETTLE_MIN_SAMPLES (range 1..10, default 3) — minimum post-latency samples before the settle-buffer median is trusted.
JASPER_RAMP_SETTLE_MIN_SAMPLES=
# JASPER_RAMP_FEED_TIMEOUT_S (range 2..60s, default 8) — no mic samples for this long aborts + restores (a vanished feed has no clip protection).
JASPER_RAMP_FEED_TIMEOUT_S=
# JASPER_RAMP_CAP_BUMP_DB (range 0..24dB, default 12) — max automatic rise above the user's listening main_volume.
JASPER_RAMP_CAP_BUMP_DB=
# JASPER_RAMP_CAP_CEIL_DB (range -30..0 dBFS, default -3) — absolute automatic-ramp ceiling.
JASPER_RAMP_CAP_CEIL_DB=
# JASPER_RAMP_AGC_SLOPE_MIN_SPAN_DB (range 1..20dB, default 6.0) — minimum commanded main_volume span the empirical AGC-verification evidence must cover before a verdict renders; under-span is indeterminate, never auto-passed.
JASPER_RAMP_AGC_SLOPE_MIN_SPAN_DB=
# JASPER_RAMP_AGC_SLOPE_MIN_STEPS (range 2..10, default 3) — secondary floor: distinct commanded levels needed before a verdict renders.
JASPER_RAMP_AGC_SLOPE_MIN_STEPS=
# JASPER_RAMP_AGC_SLOPE_THRESHOLD (range 0.1..1.0, default 0.7) — minimum OLS slope of reported rms_dbfs vs commanded main_volume_db for an unattested capture chain to be trusted; below it the ramp aborts (agc_suspected).
JASPER_RAMP_AGC_SLOPE_THRESHOLD=
# JASPER_SEAT_LEVEL_MIN_RISE_DB (range 1..20dB, default 6) — dB above measured ambient floor the loudest reading must sit at to count as "hearing the speaker".
JASPER_SEAT_LEVEL_MIN_RISE_DB=
# JASPER_SEAT_LEVEL_SETTLED_AGREE_DB (range 0.1..3dB, default 0.5) — max disagreement between two consecutive half-second mic windows before a level counts as settled and gets banked; published on the receipt (ramp.settle_agree_db) since widening it loosens both what settles and what banks.
JASPER_SEAT_LEVEL_SETTLED_AGREE_DB=
# JASPER_SEAT_LEVEL_SETTLE_TIMEOUT_S (range 2..30s, default 8) — how long one reading may wait for two windows to agree before refusing as spl_level_unsettled; every sample stays under the commissioning SPL stop regardless.
JASPER_SEAT_LEVEL_SETTLE_TIMEOUT_S=
# JASPER_RAMP_DRIFT_UNIFORM_DB (range 0..24dB, default 3.0) — |mean per-band dB shift| above this flags an amp/volume move and offers re-level.
JASPER_RAMP_DRIFT_UNIFORM_DB=
# JASPER_RAMP_DRIFT_BAND_TOL_DB (range 0..24dB, default 2.0) — max per-band deviation from the mean shift for a change to count as uniform (amp move) rather than acoustic.
JASPER_RAMP_DRIFT_BAND_TOL_DB=

# --- P4 deterministic verify-acceptance verdict (jasper/correction/acceptance.py)
# After a correction is applied and re-measured, these thresholds decide accept/surface/auto-revert against normal seat-to-seat measurement noise (4-6dB is NORMAL). All CONSERVATIVE PLACEHOLDERS pending H1 on-device repeatability data; out-of-range/unparseable falls back to the documented default.
# JASPER_ACCEPT_BAND_REGRESSION_DB (range 0.5..24dB, default 6.0) — a 1/3-octave band counts as "clearly worse" only past this much error-to-target growth.
JASPER_ACCEPT_BAND_REGRESSION_DB=
# JASPER_ACCEPT_OVERALL_RMS_REGRESSION_DB (range 0.1..12dB, default 1.0) — overall band-RMS error-to-target must worsen by more than this to count toward a clear regression (needs a band clearing the per-band floor too).
JASPER_ACCEPT_OVERALL_RMS_REGRESSION_DB=
# JASPER_ACCEPT_OVERALL_RMS_IMPROVEMENT_DB (range 0..12dB, default 0.5, must stay below the regression floor) — minimum RMS improvement to call ACCEPT rather than "surface"; 0 opts into accept-on-tie.
JASPER_ACCEPT_OVERALL_RMS_IMPROVEMENT_DB=
# JASPER_ACCEPT_SMOOTHING_FRACTION (range 1..6, default 3 = 1/3-octave, the audiometric floor) — fractional-octave band width for the per-band verdict; don't raise past ~6 without re-deriving the repeatability floor.
JASPER_ACCEPT_SMOOTHING_FRACTION=

# --- Active-speaker commissioning bundle (jasper/active_speaker/bundles.py) ---
# Durable, append-only forensic evidence for the guided active-crossover flow under /var/lib/jasper/active_speaker/sessions/; never read back as an apply-decision input. See docs/active-crossover-information-design.md "Durable evidence and observability".
# JASPER_ACTIVE_SPEAKER_SESSIONS_MAX_BYTES (default 1073741824 = 1GiB) — total bundle storage cap; whole bundles deleted oldest-first (never the live session) past this. Retention only — the 256MiB free-space-after-publish floor is separate and frozen (commissioning_evidence_store.MIN_FREE_SPACE_AFTER_PUBLISH_BYTES).
JASPER_ACTIVE_SPEAKER_SESSIONS_MAX_BYTES=1073741824
# JASPER_ACTIVE_SPEAKER_SESSIONS_MAX_BUNDLES (default 12) — secondary bundle-count cap independent of bytes (bytes usually binds first).
JASPER_ACTIVE_SPEAKER_SESSIONS_MAX_BUNDLES=12
